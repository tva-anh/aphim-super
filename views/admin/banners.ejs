<%- include('partials/head', { title: 'Quản Lý Banners & Hero Slider', activePage: 'banners' }) %>

<div class="admin-wrapper">
  <!-- Sidebar Navigation -->
  <%- include('partials/sidebar', { activePage: 'banners' }) %>

  <!-- Main Content Layout -->
  <div class="admin-main">
    <!-- Header -->
    <%- include('partials/header', { pageTitle: 'Banners & Hero Showcase' }) %>

    <!-- Page Body -->
    <main class="admin-content">
      <style>
        /* =========================================================
           ENTERPRISE HIGH-PERFORMANCE DARK DESIGN FOR ADMIN BANNERS
           ========================================================= */
        .admin-content {
          position: relative;
        }
        .admin-section-panel {
          position: relative;
          border-radius: 18px;
          background: #0f172a;
          background: linear-gradient(180deg, #111827 0%, #0b0f19 100%);
          border: 1px solid rgba(255, 255, 255, 0.08);
          box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
          margin-bottom: 24px;
          padding: 22px;
          transform: translateZ(0);
          contain: content;
          transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .admin-section-panel.panel-gold {
          border-color: rgba(245, 158, 11, 0.25);
        }
        .admin-section-panel.panel-gold:hover {
          border-color: rgba(245, 158, 11, 0.4);
          box-shadow: 0 10px 35px rgba(0, 0, 0, 0.55), 0 0 20px rgba(245, 158, 11, 0.06);
        }
        .admin-section-panel.panel-purple {
          border-color: rgba(168, 85, 247, 0.25);
        }
        .admin-section-panel.panel-purple:hover {
          border-color: rgba(168, 85, 247, 0.4);
          box-shadow: 0 10px 35px rgba(0, 0, 0, 0.55), 0 0 20px rgba(168, 85, 247, 0.06);
        }
        .admin-section-panel.panel-cyan {
          border-color: rgba(56, 189, 248, 0.25);
        }
        .admin-section-panel.panel-cyan:hover {
          border-color: rgba(56, 189, 248, 0.4);
          box-shadow: 0 10px 35px rgba(0, 0, 0, 0.55), 0 0 20px rgba(56, 189, 248, 0.06);
        }

        .panel-header-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          flex-wrap: wrap;
          gap: 14px;
          border-bottom: 1px solid rgba(255, 255, 255, 0.07);
          padding-bottom: 16px;
          margin-bottom: 18px;
        }

        /* Top Action Buttons */
        .btn-top-action {
          display: inline-flex;
          align-items: center;
          gap: 7px;
          padding: 8px 16px;
          border-radius: 9px;
          font-size: 12.5px;
          font-weight: 700;
          cursor: pointer;
          transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
          border: 1px solid transparent;
          text-decoration: none;
          transform: translateZ(0);
        }
        .btn-top-gold-outline {
          background: rgba(245, 158, 11, 0.08);
          border-color: rgba(245, 158, 11, 0.4);
          color: #fbbf24;
        }
        .btn-top-gold-outline:hover {
          background: rgba(245, 158, 11, 0.2);
          border-color: #f59e0b;
          color: #ffffff;
          box-shadow: 0 0 12px rgba(245, 158, 11, 0.25);
          transform: translateY(-1px);
        }
        .btn-top-gold-solid {
          background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
          color: #0b0f19;
          font-weight: 800;
          box-shadow: 0 3px 12px rgba(245, 158, 11, 0.25);
        }
        .btn-top-gold-solid:hover {
          background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
          color: #000000;
          box-shadow: 0 5px 18px rgba(245, 158, 11, 0.4);
          transform: translateY(-1px);
        }

        .btn-top-cyan-outline {
          background: rgba(56, 189, 248, 0.08);
          border-color: rgba(56, 189, 248, 0.4);
          color: #38bdf8;
        }
        .btn-top-cyan-outline:hover {
          background: rgba(56, 189, 248, 0.2);
          border-color: #38bdf8;
          color: #ffffff;
          box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
          transform: translateY(-1px);
        }
        .btn-top-cyan-solid {
          background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
          color: #ffffff;
          font-weight: 800;
          box-shadow: 0 3px 12px rgba(14, 165, 233, 0.25);
        }
        .btn-top-cyan-solid:hover {
          background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
          box-shadow: 0 5px 18px rgba(14, 165, 233, 0.4);
          transform: translateY(-1px);
        }

        /* =========================================================
           UNIFIED ACTION BUTTON BAR (EQUAL HEIGHTS & BALANCED LUXURY)
           ========================================================= */
        .unified-action-bar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 6px;
          border-top: 1px solid rgba(255, 255, 255, 0.07);
          padding-top: 8px;
          margin-top: 8px;
          width: 100%;
          box-sizing: border-box;
        }
        .u-btn-group {
          display: inline-flex;
          align-items: center;
          gap: 4px;
        }
        .u-btn {
          height: 28px !important;
          min-height: 28px !important;
          max-height: 28px !important;
          padding: 0 9px !important;
          border-radius: 7px !important;
          font-size: 11px !important;
          font-weight: 700 !important;
          display: inline-flex !important;
          align-items: center !important;
          justify-content: center !important;
          gap: 4px !important;
          border: 1px solid rgba(255, 255, 255, 0.12) !important;
          background: rgba(255, 255, 255, 0.05) !important;
          color: #cbd5e1 !important;
          transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease !important;
          cursor: pointer !important;
          text-decoration: none !important;
          user-select: none !important;
          line-height: 1 !important;
          box-sizing: border-box !important;
          white-space: nowrap !important;
          transform: translateZ(0);
        }
        .u-btn:hover:not(:disabled) {
          background: rgba(255, 255, 255, 0.12) !important;
          color: #ffffff !important;
          border-color: rgba(255, 255, 255, 0.25) !important;
          transform: translateY(-1px);
        }
        .u-btn:active:not(:disabled) {
          transform: scale(0.96) !important;
        }
        .u-btn:disabled {
          opacity: 0.25 !important;
          cursor: not-allowed !important;
          background: rgba(255, 255, 255, 0.02) !important;
          border-color: rgba(255, 255, 255, 0.04) !important;
          color: #475569 !important;
          pointer-events: none !important;
        }
        .u-btn.u-btn-icon {
          width: 28px !important;
          min-width: 28px !important;
          max-width: 28px !important;
          padding: 0 !important;
        }
        .u-btn.u-btn-cyan {
          border-color: rgba(56, 189, 248, 0.35) !important;
          color: #38bdf8 !important;
          background: rgba(56, 189, 248, 0.08) !important;
        }
        .u-btn.u-btn-cyan:hover:not(:disabled) {
          background: rgba(56, 189, 248, 0.22) !important;
          border-color: #38bdf8 !important;
          color: #ffffff !important;
          box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
        }
        .u-btn.u-btn-amber {
          border-color: rgba(245, 158, 11, 0.35) !important;
          color: #f59e0b !important;
          background: rgba(245, 158, 11, 0.08) !important;
        }
        .u-btn.u-btn-amber:hover:not(:disabled) {
          background: rgba(245, 158, 11, 0.22) !important;
          border-color: #f59e0b !important;
          color: #ffffff !important;
          box-shadow: 0 0 10px rgba(245, 158, 11, 0.3);
        }
        .u-btn.u-btn-rose {
          border-color: rgba(244, 63, 94, 0.35) !important;
          color: #f43f5e !important;
          background: rgba(244, 63, 94, 0.08) !important;
        }
        .u-btn.u-btn-rose:hover:not(:disabled) {
          background: rgba(244, 63, 94, 0.25) !important;
          border-color: #f43f5e !important;
          color: #ffffff !important;
          box-shadow: 0 0 10px rgba(244, 63, 94, 0.3);
        }

        /* =========================================================
           DISCOVERY CATEGORY CARDS ("BẠN ĐANG QUAN TÂM GÌ?")
           ========================================================= */
        .discovery-card-v2 {
          position: relative;
          border-radius: 14px;
          background: linear-gradient(180deg, #141a2b 0%, #0b0f1a 100%);
          border: 1px solid rgba(255, 255, 255, 0.08);
          overflow: hidden;
          padding: 14px 16px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
          transform: translateZ(0);
          contain: content;
          transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .discovery-card-v2:hover {
          transform: translateY(-2px);
          border-color: rgba(255, 255, 255, 0.2);
          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        }
        .discovery-backdrop-blend {
          position: absolute;
          right: 0;
          top: 0;
          bottom: 0;
          width: 55%;
          background-size: cover;
          background-position: center;
          opacity: 0.35;
          mask-image: linear-gradient(to right, transparent 0%, black 100%);
          -webkit-mask-image: linear-gradient(to right, transparent 0%, black 100%);
          pointer-events: none;
          transform: translateZ(0);
          transition: opacity 0.25s ease;
        }
        .discovery-card-v2:hover .discovery-backdrop-blend {
          opacity: 0.55;
        }

        /* =========================================================
           SPLIT 2-PART DESKTOP HERO SHOWCASE ADMIN
           ========================================================= */
        .desktop-hero-split-grid {
          display: grid;
          grid-template-columns: 390px 1fr;
          gap: 20px;
          align-items: start;
        }
        @media (max-width: 1200px) {
          .desktop-hero-split-grid {
            grid-template-columns: 1fr;
          }
        }
        .hero-part-panel {
          background: rgba(15, 23, 42, 0.65);
          border: 1px solid rgba(255, 255, 255, 0.09);
          border-radius: 16px;
          padding: 16px;
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
          transform: translateZ(0);
        }
        .hero-part-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding-bottom: 12px;
          margin-bottom: 14px;
          border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .hero-spotlight-card {
          border: 1.5px solid rgba(245, 158, 11, 0.55);
          border-radius: 16px;
          background: linear-gradient(180deg, #1a233a 0%, #0c111e 100%);
          overflow: hidden;
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
          transform: translateZ(0);
        }
        .hero-spotlight-preview {
          width: 100%;
          aspect-ratio: 16 / 9;
          position: relative;
          background: #000;
          overflow: hidden;
        }
        .hero-add-thumb-card {
          border: 2px dashed rgba(245, 158, 11, 0.35);
          border-radius: 14px;
          background: rgba(245, 158, 11, 0.03);
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          min-height: 190px;
          cursor: pointer;
          transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
          color: #f59e0b;
          text-align: center;
          padding: 16px;
          transform: translateZ(0);
        }
        .hero-add-thumb-card:hover {
          background: rgba(245, 158, 11, 0.1);
          border-color: #f59e0b;
          transform: translateY(-2px);
          box-shadow: 0 6px 16px rgba(245, 158, 11, 0.18);
        }
      </style>

      <!-- Section Header -->
      <div class="page-title-row">
        <div>
          <h1 class="page-main-title">Quản Lý Banners & Hero Showcase Trang Chủ</h1>
          <p class="page-sub-title">Cấu hình Hero Banner Điện ảnh Desktop (Phim Chính #1 + Dải Thumbnails Tiếp Theo), Cụm "Bạn đang quan tâm gì?" và Showcase 3D Mobile</p>
        </div>
      </div>

      <!-- ==============================================
           PHẦN 1: CẤU HÌNH HERO SHOWCASE DESKTOP (CHIA 2 PHẦN: BANNER CHÍNH 1 BÊN & THUMBNAILS 1 BÊN)
           ============================================== -->
      <div class="admin-section-panel panel-gold">
        <div class="panel-header-row">
          <div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="badge badge-gold" style="font-size: 11px; padding: 4px 10px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #000; font-weight: 800; border-radius: 6px;">
                <i data-lucide="monitor"></i> DESKTOP EXCLUSIVE (100vh Cinema)
              </span>
              <h2 id="desktopHeroSectionTitle" style="font-size: 18px; font-weight: 800; color: #ffffff; margin: 0;">Hero Showcase Điện Ảnh Desktop (Phim Chính #1 & Dải Thumbnails)</h2>
            </div>
            <p style="color: #94a3b8; font-size: 12.5px; margin: 5px 0 0 0;">Chia rõ 2 phần: Bên trái là Banner Hero chính mở đầu trang chủ; Bên phải là dải Thumbnails tiếp theo. Bạn có thể thêm, xóa, đổi thứ tự thumbnails tùy thích và trang chủ sẽ hiển thị chính xác theo cấu hình.</p>
          </div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <button class="btn-top-action btn-top-gold-outline" id="btnOpenAddDesktopHero" onclick="if(window.DesktopHeroAdmin){DesktopHeroAdmin.openHeroModal();}else{AdminNotice.toast('Đang tải công cụ, vui lòng thử lại sau 1 giây!','info');}">
              <i data-lucide="plus-circle"></i> Thêm Phim / Thumbnail
            </button>
            <button class="btn-top-action btn-top-gold-solid" onclick="if(window.DesktopHeroAdmin)DesktopHeroAdmin.saveHeroConfig()" id="btnSaveDesktopHero">
              <i data-lucide="save"></i> Lưu Cấu Hình Hero Desktop
            </button>
          </div>
        </div>

        <!-- Cấu hình Tự Động Chuyển Slide (Auto-Slide Carousel) -->
        <div class="hero-autoslide-config-card" style="margin-bottom: 18px; padding: 14px 18px; background: rgba(245, 158, 11, 0.05); border: 1.5px solid rgba(245, 158, 11, 0.25); border-radius: 14px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
          <div style="display: flex; align-items: center; gap: 12px; min-width: 260px;">
            <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); display: flex; align-items: center; justify-content: center; color: #fbbf24; font-size: 20px; flex-shrink: 0;">
              ⏱️
            </div>
            <div>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 14px; font-weight: 800; color: #ffffff;">Tự Động Chuyển Hero Banner (Auto-Slide)</span>
                <span id="heroAutoSlideStatusBadge" class="badge" style="font-size: 10.5px; padding: 2px 8px; border-radius: 6px; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-weight: 700;">Đang Bật</span>
              </div>
              <p style="margin: 2px 0 0 0; font-size: 12px; color: #94a3b8;">Tự động lướt chuyển lần lượt từng phim trong danh sách theo thời gian cấu hình (Giới hạn chuẩn: 3s – 10s)</p>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
            <!-- Toggle Bật/Tắt -->
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; font-size: 13px; font-weight: 700; color: #e2e8f0; background: rgba(0,0,0,0.3); padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08);">
              <input type="checkbox" id="heroAutoSlideToggle" checked onchange="DesktopHeroAdmin.handleAutoSlideToggle(this.checked)" style="width: 17px; height: 17px; accent-color: #f59e0b; cursor: pointer;">
              <span>Bật tự động chuyển</span>
            </label>

            <!-- Chọn khoảng thời gian (3s - 10s) -->
            <div style="display: flex; align-items: center; gap: 8px; background: rgba(0,0,0,0.35); padding: 5px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
              <span style="font-size: 12px; color: #94a3b8; font-weight: 600;">Thời gian:</span>
              <input type="number" id="heroAutoSlideIntervalInput" min="3" max="10" step="1" value="6" oninput="DesktopHeroAdmin.handleAutoSlideIntervalInput(this.value)" style="width: 52px; background: #1e293b; border: 1px solid rgba(245, 158, 11, 0.45); border-radius: 6px; color: #fbbf24; font-size: 13.5px; font-weight: 800; text-align: center; padding: 3px 0;">
              <span style="font-size: 12px; color: #fbbf24; font-weight: 700;">giây (s)</span>
            </div>

            <!-- Quick Presets -->
            <div style="display: flex; gap: 5px; align-items: center;">
              <button type="button" onclick="DesktopHeroAdmin.setAutoSlidePreset(3)" class="btn-preset" style="padding: 4px 8px; border-radius: 6px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); color: #cbd5e1; font-size: 11px; font-weight: 700; cursor: pointer;">3s</button>
              <button type="button" onclick="DesktopHeroAdmin.setAutoSlidePreset(5)" class="btn-preset" style="padding: 4px 8px; border-radius: 6px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); color: #cbd5e1; font-size: 11px; font-weight: 700; cursor: pointer;">5s</button>
              <button type="button" onclick="DesktopHeroAdmin.setAutoSlidePreset(7)" class="btn-preset" style="padding: 4px 8px; border-radius: 6px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); color: #cbd5e1; font-size: 11px; font-weight: 700; cursor: pointer;">7s</button>
              <button type="button" onclick="DesktopHeroAdmin.setAutoSlidePreset(10)" class="btn-preset" style="padding: 4px 8px; border-radius: 6px; background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.4); color: #fbbf24; font-size: 11px; font-weight: 800; cursor: pointer;" title="Thời gian tối đa 10s">10s (Tối đa)</button>
            </div>

            <!-- Checkbox Tạm dừng khi rê chuột -->
            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; user-select: none; font-size: 12px; color: #94a3b8;" title="Tự động tạm dừng đếm ngược khi người dùng di chuột vào banner">
              <input type="checkbox" id="heroAutoSlidePauseOnHover" checked onchange="DesktopHeroAdmin.handleAutoSlidePauseHover(this.checked)" style="width: 15px; height: 15px; accent-color: #f59e0b; cursor: pointer;">
              <span>Dừng khi di chuột</span>
            </label>
          </div>
        </div>

        <!-- 2-Part Split Layout: Bên Trái = Hero #1 Chính, Bên Phải = Dải Thumbnails Phim Tiếp Theo -->
        <div id="desktopHeroSplitLayout" class="desktop-hero-split-grid">
          <div id="desktopHeroSpotlightCol">
            <!-- Rendered by JS -->
          </div>
          <div id="desktopHeroThumbnailsCol">
            <!-- Rendered by JS -->
          </div>
        </div>
      </div>

      <!-- ==============================================
           PHẦN 2: CẤU HÌNH "BẠN ĐANG QUAN TÂM GÌ?" (INTERESTS CARDS)
           ============================================== -->
      <div class="admin-section-panel panel-purple">
        <div class="panel-header-row">
          <div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="badge" style="font-size: 11px; padding: 4px 10px; background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.4); font-weight: 800; border-radius: 6px;">
                <i data-lucide="compass"></i> DANH MỤC NỔI BẬT (6 Thẻ Khám Phá)
              </span>
              <h2 style="font-size: 18px; font-weight: 800; color: #ffffff; margin: 0;">Mục "Bạn Đang Quan Tâm Gì?" (Trang Chủ)</h2>
            </div>
            <p style="color: #94a3b8; font-size: 12.5px; margin: 5px 0 0 0;">Cấu hình 6 thẻ danh mục (Phim Bộ, Phim Mới, Hành Động, Tình Cảm, Hài Hước, Hoạt Hình...). Bấm "Tìm Ảnh / Sửa" để tìm kiếm phim và chọn ảnh trực tiếp.</p>
          </div>
        </div>

        <!-- Interests Cards Grid -->
        <div id="interestsAdminList" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px;">
          <div style="color: #64748b; font-size: 13px; text-align: center; grid-column: 1 / -1; padding: 20px;">
            ⏳ Đang tải danh mục "Bạn đang quan tâm gì?"...
          </div>
        </div>
      </div>

      <!-- ==============================================
           PHẦN 3: SHOWCASE 3D MOBILE TRANG CHỦ (GIỮ NGUYÊN 100% CỦA MOBILE)
           ============================================== -->
      <div class="admin-section-panel panel-cyan">
        <div class="panel-header-row">
          <div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="badge badge-cyan" style="font-size: 11px; padding: 4px 10px; border-radius: 6px;"><i data-lucide="smartphone"></i> MOBILE EXCLUSIVE</span>
              <h2 style="font-size: 18px; font-weight: 800; color: #ffffff; margin: 0;">Showcase Phim 3D Coverflow Mobile (Trang Chủ)</h2>
            </div>
            <p style="color: #94a3b8; font-size: 12.5px; margin: 5px 0 0 0;">Cấu hình danh sách phim hiển thị ở khối 3D trên giao diện điện thoại (nằm trên mục Phim Mới Đề Cử). Kéo thả hoặc bấm nút mũi tên để đổi thứ tự.</p>
          </div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <button class="btn-top-action btn-top-cyan-outline" id="btnOpenAddShowcase3D" onclick="if(window.MobileShowcaseAdmin){MobileShowcaseAdmin.openAddModal();}else{AdminNotice.toast('Đang tải công cụ, vui lòng thử lại sau 1 giây!','info');}">
              <i data-lucide="plus-circle"></i> Thêm Phim Vào 3D Showcase
            </button>
            <button class="btn-top-action btn-top-cyan-solid" onclick="if(window.MobileShowcaseAdmin)MobileShowcaseAdmin.saveConfig()" id="btnSave3DShowcase">
              <i data-lucide="save"></i> Lưu Cấu Hình 3D Mobile
            </button>
          </div>
