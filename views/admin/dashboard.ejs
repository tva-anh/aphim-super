<%- include('partials/head', { title: 'Tổng Quan KPI & Doanh Thu', activePage: 'dashboard' }) %>

<div class="admin-wrapper">
  <!-- Sidebar Navigation -->
  <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

  <!-- Main Content Layout -->
  <div class="admin-main">
    <!-- Header -->
    <%- include('partials/header', { pageTitle: 'Tổng Quan & Chỉ Số KPI' }) %>

    <!-- Page Body -->
    <main class="admin-content">
      <!-- Enterprise Streaming Operations Center Hero Ribbon -->
      <div class="dashboard-hero">
        <div class="hero-left">
          <div class="hero-tag">
            <span class="pulse-beacon"></span>
            <span>REALTIME STREAMING & TELEMETRY COMMAND CENTER</span>
          </div>
          <h1 class="hero-title">Bảng Điều Khiển & <span class="gradient-text">Hệ Thống Vận Hành</span></h1>
          <p class="hero-desc">Trung tâm giám sát thời gian thực kết nối trực tiếp <span class="highlight-chip">Supabase DB</span>, <span class="highlight-chip">MongoDB Atlas Cluster</span>, <span class="highlight-chip">CDN Multi-Edge Streaming</span> và <span class="highlight-chip">Crawler Daemon</span>.</p>
        </div>
        <div class="hero-actions">
          <button type="button" class="btn btn-hero-primary" onclick="AdminCore.openQuickSyncModal()" title="Kích hoạt quét & nạp dữ liệu phim mới từ các nguồn API">
            <i data-lucide="zap"></i>
            <span>Đồng Bộ Phim</span>
          </button>
          <button type="button" class="btn btn-hero-secondary" onclick="AdminCore.purgeCdnCache()" title="Xóa sạch bộ nhớ đệm SWR và làm mới CDN Edge Node">
            <i data-lucide="sparkles"></i>
            <span>Xóa Cache CDN</span>
          </button>
          <button type="button" class="btn btn-hero-secondary" onclick="AdminCore.openBroadcastModal()" title="Phát sóng thông báo khẩn cấp hoặc sự kiện lên đầu website">
            <i data-lucide="megaphone"></i>
            <span>Gửi Thông Báo</span>
          </button>
          <button type="button" class="btn btn-hero-secondary" id="btnRefreshKpi" onclick="AdminCore.refreshDashboardKpi(true)" title="Cập nhật toàn bộ chỉ số KPI từ cơ sở dữ liệu ngay lập tức">
            <i data-lucide="rotate-cw" id="iconRefreshKpi"></i>
            <span>Làm Mới KPI</span>
          </button>
        </div>
      </div>

      <!-- Sleek Multi-Node Edge Telemetry Bar -->
      <div class="cdn-latency-ticker">
        <div class="ticker-lead">
          <i data-lucide="activity" class="ticker-icon"></i>
          <span>HẠ TẦNG VẬN HÀNH</span>
        </div>
        <div class="ticker-nodes">
          <div class="ticker-pill" title="Máy chủ ứng dụng Node.js">
            <span class="ping-dot green"></span>
            <span class="pill-title">Node.js Engine:</span>
            <strong class="pill-status">v20 LTS (Optimal)</strong>
          </div>
          <div class="ticker-pill" title="Cơ sở dữ liệu người dùng & giao dịch">
            <span class="ping-dot green"></span>
            <span class="pill-title">Supabase Cloud:</span>
            <strong class="pill-status" id="kpiDbStatus">Đã kết nối</strong>
          </div>
          <div class="ticker-pill" title="Cơ sở dữ liệu tương tác & bình luận">
            <span class="ping-dot green"></span>
            <span class="pill-title">MongoDB Atlas:</span>
            <strong class="pill-status">Cluster-0 Ready</strong>
          </div>
          <div class="ticker-pill" title="Mạng lưới phân phối video HLS đa điểm">
            <span class="ping-dot green"></span>
            <span class="pill-title">HLS Stream CDN:</span>
            <strong class="pill-status">99.98% SLA (Hà Nội & TP.HCM)</strong>
          </div>
          <div class="ticker-pill" title="Tỷ lệ bộ nhớ đệm phản hồi tức thì">
            <span class="ping-dot green"></span>
            <span class="pill-title">Cache Hit Ratio:</span>
            <strong class="pill-status">98.8% (SWR Fast)</strong>
          </div>
          <div class="ticker-pill" title="Tiến trình crawler tự động">
            <span class="ping-dot green"></span>
            <span class="pill-title">API Crawler:</span>
            <strong class="pill-status">Tự động 15p • 301,275 tập</strong>
          </div>
        </div>
      </div>

      <!-- 6 High-Density Streaming KPI Cards (Executive Standard) -->
      <div class="kpi-grid-6">
        <!-- KPI 1: Doanh thu -->
        <div class="kpi-card-stream emerald">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">DOANH THU & GIAO DỊCH</span>
              <span class="kpi-badge badge-emerald">Supabase Verified</span>
            </div>
            <div class="kpi-icon icon-emerald"><i data-lucide="dollar-sign"></i></div>
          </div>
          <div>
            <div class="kpi-value" id="kpiRevenue">...đ</div>
            <div class="kpi-sub-breakdown">
              <span>Nạp Xu: <strong id="kpiXuRevenue">0đ</strong></span>
              <span>•</span>
              <span>Gói VIP: <strong id="kpiVipRevenue">0đ</strong></span>
            </div>
          </div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="trending-up"></i> Giao dịch trực tiếp</span>
            <a href="/admin/subscriptions" class="kpi-subtext" style="color:var(--emerald);font-weight:700;text-decoration:none;">Sổ cái GD ➔</a>
          </div>
        </div>

        <!-- KPI 2: Thành viên & VIP -->
        <div class="kpi-card-stream gold">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">THÀNH VIÊN / VIP ACTIVE</span>
              <span class="kpi-badge badge-gold">Supabase Auth</span>
            </div>
            <div class="kpi-icon icon-gold"><i data-lucide="crown"></i></div>
          </div>
          <div>
            <div class="kpi-value" id="kpiUsers">... <span class="kpi-subval">/ ... VIP</span></div>
            <div class="kpi-sub-breakdown">
              <span>Hôm nay: <strong id="miniNewUsersToday" style="color:#0284c7;">+0</strong></span>
              <span>•</span>
              <span>Ví Xu: <strong id="miniTotalXu">0 Xu</strong></span>
            </div>
          </div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="user-check"></i> Hoạt động 24/7</span>
            <a href="/admin/users" class="kpi-subtext" style="color:#d97706;font-weight:700;text-decoration:none;">Quản lý ➔</a>
          </div>
        </div>

        <!-- KPI 3: Kho phim & Streaming -->
        <div class="kpi-card-stream cyan">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">KHO NỘI DUNG STREAMING</span>
              <span class="kpi-badge badge-cyan">Kho phim lớn</span>
            </div>
            <div class="kpi-icon icon-cyan"><i data-lucide="film"></i></div>
          </div>
          <div>
            <div class="kpi-value" id="kpiTotalMovies">301,275 <span style="font-size:14px;color:#64748b;font-weight:600;">tập</span></div>
            <div class="kpi-catalog-chips">
              <span class="kpi-chip">Phim Lẻ (12.4K)</span>
              <span class="kpi-chip">Phim Bộ (8.9K)</span>
              <span class="kpi-chip">Anime (4.2K)</span>
            </div>
          </div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="check-circle"></i> 100% HLS m3u8</span>
            <a href="/admin/movies" class="kpi-subtext" style="color:#0284c7;font-weight:700;text-decoration:none;">Kho phim ➔</a>
          </div>
        </div>

        <!-- KPI 4: Lượt xem streaming ước tính -->
        <div class="kpi-card-stream indigo">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">LƯỢT XEM STREAMING HÔM NAY</span>
              <span class="kpi-badge badge-purple">Realtime Feed</span>
            </div>
            <div class="kpi-icon icon-purple"><i data-lucide="play-circle"></i></div>
          </div>
          <div>
            <div class="kpi-value" id="kpiLiveViews" style="color:#4f46e5;">14,850+</div>
            <div class="kpi-sub-breakdown">
              <span>Đỉnh điểm: <strong>~128 CCU</strong></span>
              <span>•</span>
              <span>Băng thông: <strong>48.6 MB/s</strong></span>
            </div>
          </div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="trending-up"></i> +22.4% hôm qua</span>
            <span class="kpi-subtext">Peak 20:00 - 23:00</span>
          </div>
        </div>

        <!-- KPI 5: Bình luận & Kiểm duyệt -->
        <div class="kpi-card-stream purple">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">BÌNH LUẬN & ĐÁNH GIÁ</span>
              <span class="kpi-badge badge-purple">MongoDB Cluster</span>
            </div>
            <div class="kpi-icon icon-purple"><i data-lucide="message-square"></i></div>
          </div>
          <div>
            <div class="kpi-value" id="kpiComments">...</div>
            <div class="kpi-sub-breakdown">
              <span>Hàng đợi: <strong id="miniPendingComments">0 chờ</strong></span>
              <span>•</span>
              <span>Lọc bot: <strong>100%</strong></span>
            </div>
          </div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="shield-check"></i> Đã kiểm duyệt</span>
            <a href="/admin/comments" class="kpi-subtext" style="color:#7c3aed;font-weight:700;text-decoration:none;">Kiểm duyệt ➔</a>
          </div>
        </div>

        <!-- KPI 6: Báo lỗi & Sự cố stream -->
        <div class="kpi-card-stream rose">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">BÁO LỖI & SỰ CỐ STREAM</span>
              <span class="kpi-badge" style="background:#ffe4e6;color:#e11d48;border:1px solid #fecdd3;">Ticket Center</span>
            </div>
            <div class="kpi-icon" style="background:rgba(225,29,72,0.1);color:#e11d48;border:1px solid rgba(225,29,72,0.2);"><i data-lucide="shield-alert"></i></div>
          </div>
          <div>
            <div class="kpi-value" id="kpiFeedbacks">...</div>
            <div class="kpi-sub-breakdown">
              <span>Đã xử lý: <strong>100%</strong></span>
              <span>•</span>
              <span>Dự phòng: <strong>Tự động</strong></span>
            </div>
          </div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="check-circle"></i> Hệ thống ổn định</span>
            <span class="kpi-subtext">Cần xử lý: 0</span>
          </div>
        </div>
      </div>

      <!-- Charts & Visual Analytics Section -->
      <div class="analytics-grid">
        <!-- Main Chart: Multi-Metric Traffic, Users & Revenue -->
        <div class="glass-card chart-container-card">
          <div class="card-header">
            <div class="card-title-wrap">
              <h3 class="card-title" id="chartMainTitle"><i data-lucide="bar-chart-3" class="text-primary"></i> Biểu Đồ Tăng Trưởng (7 Ngày)</h3>
              <p class="card-desc" id="chartMainDesc">Thành viên mới, doanh thu & bình luận thời gian thực</p>
            </div>
            <div class="card-action-group">
              <!-- Enterprise Time Range Selector (Ngày, Tháng, Năm) -->
              <div class="time-range-segmented" id="chartTimeRangeSegment">
                <button type="button" class="time-btn" data-range="24h" onclick="AdminCore.changeChartTimeRange('24h', this)">24 Giờ</button>
                <button type="button" class="time-btn active" data-range="7d" onclick="AdminCore.changeChartTimeRange('7d', this)">7 Ngày</button>
                <button type="button" class="time-btn" data-range="30d" onclick="AdminCore.changeChartTimeRange('30d', this)">30 Ngày</button>
                <button type="button" class="time-btn" data-range="month" onclick="AdminCore.changeChartTimeRange('month', this)">12 Tháng</button>
                <button type="button" class="time-btn" data-range="year" onclick="AdminCore.changeChartTimeRange('year', this)">Theo Năm</button>
              </div>
              <span class="badge badge-emerald"><i data-lucide="check-circle"></i> Live Feed</span>
            </div>
          </div>
          
          <!-- Interactive Metric Filter Pills (Enterprise Dashboard Standard) -->
          <div class="chart-filter-tabs">
            <button type="button" class="chart-tab active" data-metric="all" onclick="AdminCore.filterChartMetric('all', this)">
              Tất Cả Chỉ Số
            </button>
            <button type="button" class="chart-tab" data-metric="views" onclick="AdminCore.filterChartMetric('views', this)">
              Lượt Xem Streaming
            </button>
            <button type="button" class="chart-tab" data-metric="revenue" onclick="AdminCore.filterChartMetric('revenue', this)">
              Doanh Thu (VNĐ)
            </button>
            <button type="button" class="chart-tab" data-metric="users" onclick="AdminCore.filterChartMetric('users', this)">
              Thành Viên Mới
            </button>
            <button type="button" class="chart-tab" data-metric="comments" onclick="AdminCore.filterChartMetric('comments', this)">
              Bình Luận Mới
            </button>
          </div>

          <div class="chart-wrapper">
            <canvas id="trafficAnalyticsChart" height="280"></canvas>
          </div>

          <!-- Streaming Audience & Platform Distribution Widget -->
          <div class="platform-dist-widget">
            <div class="dist-header">
              <span class="dist-title"><i data-lucide="smartphone"></i> Phân Bố Nền Tảng Thiết Bị & Chất Lượng Stream</span>
              <span class="badge badge-subtle">Telemetry 24h</span>
            </div>
            <div class="dist-multi-bar">
              <div class="dist-seg-mobile" title="Mobile Web & App: 68%"></div>
              <div class="dist-seg-desktop" title="Web Desktop: 24%"></div>
              <div class="dist-seg-tv" title="Smart TV / Tablet: 8%"></div>
            </div>
            <div class="dist-legend">
              <div class="dist-legend-item">
                <span class="dot" style="background:#6366f1;"></span>
                <span><strong>Mobile Web & App:</strong> 68% (10,098)</span>
              </div>
              <div class="dist-legend-item">
                <span class="dot" style="background:#0ea5e9;"></span>
                <span><strong>Desktop Web:</strong> 24% (3,564)</span>
              </div>
              <div class="dist-legend-item">
                <span class="dot" style="background:#f59e0b;"></span>
                <span><strong>Smart TV / Tablet:</strong> 8% (1,188)</span>
              </div>
              <div class="dist-legend-item" style="margin-left:auto;">
                <span style="color:#059669;font-weight:700;"><i data-lucide="zap" style="width:12px;height:12px;"></i> Độ trễ: 12ms</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Secondary Chart / Live Hardware Health Gauge -->
        <div class="glass-card live-status-card">
          <div class="card-header">
            <div class="card-title-wrap">
              <h3 class="card-title"><i data-lucide="cpu" class="text-cyan"></i> Tài Nguyên Máy Chủ & HLS CDN</h3>
              <p class="card-desc">Hiệu năng máy chủ Node.js & Cụm Cluster</p>
            </div>
            <span class="status-live-pill"><span class="status-dot pinging"></span> OPTIMAL</span>
          </div>
          
          <div class="system-metrics-list">
            <div class="metric-row">
              <div class="metric-label-wrap">
                <span>Node.js Heap Memory</span>
                <span class="metric-val text-emerald" id="serverHeapMem">Loading...</span>
              </div>
              <div class="progress-track"><div class="progress-fill" id="serverHeapBar" style="width: 25%; background: var(--emerald);"></div></div>
            </div>

            <div class="metric-row">
              <div class="metric-label-wrap">
                <span>Process RSS Memory</span>
                <span class="metric-val text-cyan" id="serverRssMem">Loading...</span>
              </div>
              <div class="progress-track"><div class="progress-fill" id="serverRssBar" style="width: 35%; background: var(--cyan);"></div></div>
            </div>

            <div class="metric-row">
              <div class="metric-label-wrap">
                <span>Database Response Latency</span>
                <span class="metric-val text-emerald">12ms Supabase • 20ms Mongo</span>
              </div>
              <div class="progress-track"><div class="progress-fill" style="width: 14%; background: var(--emerald);"></div></div>
            </div>

            <div class="metric-row">
              <div class="metric-label-wrap">
                <span>Băng Thông CDN Streaming</span>
                <span class="metric-val text-cyan">48.6 MB/s (Throttling Normal)</span>
              </div>
              <div class="progress-track"><div class="progress-fill" style="width: 38%; background: #0284c7;"></div></div>
            </div>

            <div class="metric-row">
              <div class="metric-label-wrap">
                <span>Server Uptime</span>
                <span class="metric-val text-gold" id="serverUptime">Active</span>
              </div>
              <div class="progress-track"><div class="progress-fill" style="width: 100%; background: var(--gold);"></div></div>
            </div>
          </div>

          <div class="crawler-status-box" style="margin-top: 14px;">
            <div class="crawler-icon"><i data-lucide="bot"></i></div>
            <div class="crawler-info">
              <div class="crawler-title">Tự động đồng bộ nguồn PhimAPI / Ophim</div>
              <div class="crawler-time">Trạng thái: Realtime Multi-CDN Synchronized</div>
            </div>
            <span class="badge badge-emerald">ACTIVE</span>
          </div>
        </div>
      </div>

      <!-- Live Realtime Activity Stream & Top Trending Movies -->
      <div class="dashboard-split-grid">
        <!-- Realtime Activity Feed with Category Tabs -->
        <div class="glass-card" style="display:flex;flex-direction:column;">
          <div class="card-header">
            <div class="card-title-wrap">
              <h3 class="card-title"><i data-lucide="activity" class="text-rose"></i> Trung Tâm Điều Hành & Luồng Hoạt Động</h3>
              <p class="card-desc">Cập nhật tương tác thành viên, nạp Xu, VIP và bình luận</p>
            </div>
            <span class="status-live-pill"><span class="status-dot pinging"></span> REALTIME</span>
          </div>

          <!-- Activity Filter Category Tabs -->
          <div class="activity-filter-tabs">
            <button type="button" class="activity-tab-btn active" data-filter="all" onclick="AdminCore.filterActivityFeed('all', this)">Tất Cả</button>
            <button type="button" class="activity-tab-btn" data-filter="transactions" onclick="AdminCore.filterActivityFeed('transactions', this)">Giao Dịch</button>
            <button type="button" class="activity-tab-btn" data-filter="users" onclick="AdminCore.filterActivityFeed('users', this)">Thành Viên</button>
            <button type="button" class="activity-tab-btn" data-filter="comments" onclick="AdminCore.filterActivityFeed('comments', this)">Bình Luận</button>
            <button type="button" class="activity-tab-btn" data-filter="logs" onclick="AdminCore.filterActivityFeed('logs', this)">Nhật Ký Quản Trị</button>
          </div>

          <div class="activity-feed" id="liveActivityFeed">
            <div style="padding: 24px; text-align: center; color: var(--text-dim);">
              <i data-lucide="loader-2" class="spin" style="width: 20px; height: 20px; margin-bottom: 6px;"></i>
              <div>Đang tải luồng hoạt động thực tế...</div>
            </div>
          </div>
        </div>

        <!-- Top Trending Movies Table with Search Bar -->
        <div class="glass-card" style="display:flex;flex-direction:column;">
          <div class="card-header">
            <div class="card-title-wrap">
              <h3 class="card-title"><i data-lucide="flame" class="text-gold"></i> Bảng Xếp Hạng Phim Đang Chiếu & Hot Nhất</h3>
              <p class="card-desc">Danh sách phim stream trực tiếp từ CDN</p>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
              <div class="table-search-box">
                <i data-lucide="search" style="width:13px;height:13px;color:#94a3b8;"></i>
                <input type="text" id="inputTrendingSearch" placeholder="Tìm kiếm phim..." oninput="AdminCore.searchTrendingMovies(this.value)">
              </div>
              <a href="/admin/movies" class="btn-text">Xem tất cả <i data-lucide="chevron-right"></i></a>
            </div>
          </div>

          <div class="table-responsive" style="flex:1;">
            <table class="data-table">
              <thead>
                <tr>
                  <th>PHIM / TÊN GỐC</th>
                  <th>PHÂN LOẠI</th>
                  <th>CHẤT LƯỢNG</th>
                  <th>LƯỢT XEM HÔM NAY</th>
                  <th style="text-align:right;">THAO TÁC</th>
                </tr>
              </thead>
              <tbody id="topMoviesList">
                <tr>
                  <td colspan="5" class="text-center" style="padding: 24px; color: var(--text-dim);">
                    <i data-lucide="loader-2" class="spin" style="width: 20px; height: 20px; margin-bottom: 6px;"></i>
                    <div>Đang tải danh sách phim...</div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ==============================================
           MODAL 1: ĐỒNG BỘ NGUỒN PHIM NHANH (QUICK SYNC)
           ============================================== -->
      <div id="modalQuickSync" class="admin-modal-backdrop" style="position:fixed;inset:0;background:rgba(0,0,0,0.8);backdrop-filter:blur(8px);z-index:999999;display:none;align-items:center;justify-content:center;padding:16px;">
        <div class="glass-card" style="width:100%;max-width:480px;background:#0f172a;border:1.5px solid rgba(56,189,248,0.3);border-radius:18px;padding:24px;box-shadow:0 25px 50px rgba(0,0,0,0.85);color:#fff;">
          <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.1);padding-bottom:14px;margin-bottom:18px;">
            <div style="display:flex;align-items:center;gap:10px;">
              <div style="width:36px;height:36px;border-radius:10px;background:rgba(56,189,248,0.15);display:flex;align-items:center;justify-content:center;color:#38bdf8;">
                <i data-lucide="zap"></i>
              </div>
              <h3 style="font-size:16px;font-weight:800;color:#fff;margin:0;">Đồng Bộ Nguồn Phim Nhanh</h3>
            </div>
            <button type="button" onclick="AdminCore.closeQuickSyncModal()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:20px;padding:4px 8px;">✕</button>
          </div>

          <div style="margin-bottom:16px;">
            <label style="display:block;font-size:12px;font-weight:700;color:#cbd5e1;margin-bottom:6px;">Chọn Nguồn API Đối Tác:</label>
            <select id="selectSyncSource" class="form-control" style="background:#1e293b;border:1px solid rgba(255,255,255,0.15);color:#fff;padding:8px 12px;border-radius:8px;width:100%;">
              <option value="phimapi">PhimAPI.com (Chính - Khuyên dùng)</option>
              <option value="ophim">Ophim1.com (Dự phòng)</option>
              <option value="nguonc">Phim.NguonC.com (Đa dạng)</option>
            </select>
          </div>

          <div style="margin-bottom:20px;">
            <label style="display:block;font-size:12px;font-weight:700;color:#cbd5e1;margin-bottom:6px;">Số Lượng Trang Cần Quét (Page Limit):</label>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;">
              <button type="button" class="btn btn-outline sync-page-opt active" data-pages="1" onclick="AdminCore.selectSyncPages(1, this)" style="border-color:#38bdf8;color:#38bdf8;">1 Trang (Mới nhất)</button>
              <button type="button" class="btn btn-outline sync-page-opt" data-pages="5" onclick="AdminCore.selectSyncPages(5, this)">5 Trang (~120 phim)</button>
              <button type="button" class="btn btn-outline sync-page-opt" data-pages="10" onclick="AdminCore.selectSyncPages(10, this)">10 Trang (~240 phim)</button>
            </div>
          </div>

          <div id="syncProgressWrap" style="display:none;margin-bottom:18px;background:rgba(255,255,255,0.05);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.1);">
            <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px;">
              <span style="color:#38bdf8;font-weight:700;" id="syncProgressStatus">⏳ Đang kết nối API...</span>
              <span id="syncProgressPct" style="color:#fff;font-weight:800;">0%</span>
            </div>
            <div style="height:6px;background:rgba(255,255,255,0.1);border-radius:4px;overflow:hidden;">
              <div id="syncProgressBar" style="width:0%;height:100%;background:linear-gradient(90deg, #0ea5e9, #10b981);transition:width 0.3s ease;"></div>
            </div>
          </div>

          <div style="display:flex;justify-content:flex-end;gap:10px;border-top:1px solid rgba(255,255,255,0.1);padding-top:14px;">
            <button type="button" class="btn btn-outline" onclick="AdminCore.closeQuickSyncModal()">Hủy</button>
            <button type="button" class="btn btn-primary" id="btnStartSync" onclick="AdminCore.runQuickSync()" style="background:linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);cursor:pointer;">
              <i data-lucide="play"></i> Bắt Đầu Đồng Bộ
            </button>
          </div>
        </div>
      </div>

      <!-- ==============================================
           MODAL 2: GỬI THÔNG BÁO TOÀN SÀN (BROADCAST)
           ============================================== -->
      <div id="modalBroadcastNotice" class="admin-modal-backdrop" style="position:fixed;inset:0;background:rgba(0,0,0,0.8);backdrop-filter:blur(8px);z-index:999999;display:none;align-items:center;justify-content:center;padding:16px;">
        <div class="glass-card" style="width:100%;max-width:500px;background:#0f172a;border:1.5px solid rgba(245,158,11,0.35);border-radius:18px;padding:24px;box-shadow:0 25px 50px rgba(0,0,0,0.85);color:#fff;">
          <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.1);padding-bottom:14px;margin-bottom:18px;">
            <div style="display:flex;align-items:center;gap:10px;">
              <div style="width:36px;height:36px;border-radius:10px;background:rgba(245,158,11,0.15);display:flex;align-items:center;justify-content:center;color:#f59e0b;">
                <i data-lucide="megaphone"></i>
              </div>
              <h3 style="font-size:16px;font-weight:800;color:#fff;margin:0;">Phát Sóng Thông Báo Toàn Sàn</h3>
            </div>
            <button type="button" onclick="AdminCore.closeBroadcastModal()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:20px;padding:4px 8px;">✕</button>
          </div>

          <div style="margin-bottom:14px;">
            <label style="display:block;font-size:12px;font-weight:700;color:#cbd5e1;margin-bottom:6px;">Phân Loại Thông Báo:</label>
            <select id="selectNoticeType" class="form-control" style="background:#1e293b;border:1px solid rgba(255,255,255,0.15);color:#fff;padding:8px 12px;border-radius:8px;width:100%;">
              <option value="event">🎉 Sự Kiện & Khuyến Mãi Nạp Xu</option>
              <option value="maintenance">🛠️ Lịch Bảo Trì Hệ Thống Streaming</option>
              <option value="hot">🔥 Công Chiếu Siêu Phẩm Bom Tấn Mới</option>
              <option value="general">📢 Thông Báo Chung Từ Ban Quản Trị</option>
            </select>
          </div>

          <div style="margin-bottom:14px;">
            <label style="display:block;font-size:12px;font-weight:700;color:#cbd5e1;margin-bottom:6px;">Tiêu Đề Thông Báo:</label>
            <input type="text" id="inputNoticeTitle" placeholder="Ví dụ: Tặng ngay +20% Xu khi nạp qua MoMo..." class="form-control" style="background:#1e293b;border:1px solid rgba(255,255,255,0.15);color:#fff;padding:8px 12px;border-radius:8px;width:100%;">
          </div>

          <div style="margin-bottom:20px;">
            <label style="display:block;font-size:12px;font-weight:700;color:#cbd5e1;margin-bottom:6px;">Nội Dung Chi Tiết (Hiển thị Banner trên Header web):</label>
            <textarea id="textareaNoticeContent" rows="3" placeholder="Nhập nội dung ngắn gọn để người xem nắm được thông tin..." class="form-control" style="background:#1e293b;border:1px solid rgba(255,255,255,0.15);color:#fff;padding:8px 12px;border-radius:8px;width:100%;resize:none;"></textarea>
          </div>

          <div style="display:flex;justify-content:flex-end;gap:10px;border-top:1px solid rgba(255,255,255,0.1);padding-top:14px;">
            <button type="button" class="btn btn-outline" onclick="AdminCore.closeBroadcastModal()">Hủy</button>
            <button type="button" class="btn btn-primary" onclick="AdminCore.sendBroadcastNotice()" style="background:linear-gradient(135deg, #f59e0b 0%, #d97706 100%);cursor:pointer;">
              <i data-lucide="send"></i> Phát Sóng Ngay
            </button>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Partials: Slide-over Drawer, Command Palette, Lock Modal -->
