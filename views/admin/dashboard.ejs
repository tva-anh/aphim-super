<%- include('partials/head', { title: 'Tổng Quan KPI & Doanh Thu', activePage: 'dashboard' }) %>

<div class="admin-wrapper">
  <!-- Sidebar Navigation -->
  <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

  <!-- Main Content Layout -->
  <div class="admin-main">
    <!-- Header -->
    <%- include('partials/header', { pageTitle: 'Tổng Quan & Chỉ Số KPI' }) %>

    <!-- Page Body -->
    <main class="admin-content">
      <!-- Enterprise Executive Hero Ribbon -->
      <div class="dashboard-hero">
        <div class="hero-left">
          <div class="hero-tag">
            <span class="pulse-beacon"></span>
            <span>REALTIME ENTERPRISE TELEMETRY</span>
          </div>
          <h1 class="hero-title">Bảng Điều Khiển & <span class="gradient-text">Hệ Thống Vận Hành</span></h1>
          <p class="hero-desc">Dữ liệu thời gian thực được đồng bộ trực tiếp từ <span class="highlight-chip">Supabase DB</span>, <span class="highlight-chip">MongoDB Cluster</span> và <span class="highlight-chip">CDN Edge Streaming</span>.</p>
        </div>
        <div class="hero-actions">
          <button type="button" class="btn btn-hero-primary" id="btnRefreshKpi" onclick="AdminCore.refreshDashboardKpi(true)" title="Cập nhật toàn bộ chỉ số KPI từ cơ sở dữ liệu ngay lập tức">
            <i data-lucide="rotate-cw" id="iconRefreshKpi"></i>
            <span>Làm Mới KPI Ngay</span>
          </button>
          <button type="button" class="btn btn-hero-secondary" onclick="AdminCore.syncMoviesNow()">
            <i data-lucide="refresh-cw"></i>
            <span>Đồng Bộ Phim</span>
          </button>
          <a href="/admin/subscriptions" class="btn btn-hero-secondary">
            <i data-lucide="wallet"></i>
            <span>Báo Cáo Doanh Thu</span>
          </a>
        </div>
      </div>

      <!-- Sleek System Infrastructure Telemetry Bar -->
      <div class="cdn-latency-ticker">
        <div class="ticker-lead">
          <i data-lucide="activity" class="ticker-icon"></i>
          <span>HẠ TẦNG VẬN HÀNH</span>
        </div>
        <div class="ticker-nodes">
          <div class="ticker-pill">
            <span class="ping-dot green"></span>
            <span class="pill-title">Node.js Server:</span>
            <strong class="pill-status">Đang chạy (v20)</strong>
          </div>
          <div class="ticker-pill">
            <span class="ping-dot green"></span>
            <span class="pill-title">MongoDB Atlas:</span>
            <strong class="pill-status">Cluster-0 Đã kết nối</strong>
          </div>
          <div class="ticker-pill">
            <span class="ping-dot green"></span>
            <span class="pill-title">Supabase Cloud:</span>
            <strong class="pill-status" id="kpiDbStatus">Đã kết nối</strong>
          </div>
          <div class="ticker-pill">
            <span class="ping-dot green"></span>
            <span class="pill-title">Google Sheet Sync:</span>
            <strong class="pill-status">Sẵn sàng</strong>
          </div>
        </div>
      </div>

      <!-- 4 Core Executive KPI Cards (Modern Enterprise SaaS Standard) -->
      <div class="kpi-grid">
        <!-- KPI 1: Doanh thu -->
        <div class="kpi-card kpi-card-emerald">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">DOANH THU (VIP & XU)</span>
              <span class="kpi-badge badge-emerald">Supabase Verified</span>
            </div>
            <div class="kpi-icon icon-emerald"><i data-lucide="dollar-sign"></i></div>
          </div>
          <div class="kpi-value" id="kpiRevenue">...đ</div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="trending-up"></i> Giao dịch trực tiếp</span>
            <span class="kpi-subtext">Cập nhật tự động</span>
          </div>
        </div>

        <!-- KPI 2: Bình luận & Tương tác -->
        <div class="kpi-card kpi-card-cyan">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">BÌNH LUẬN & ĐÁNH GIÁ</span>
              <span class="kpi-badge badge-cyan">MongoDB Cluster</span>
            </div>
            <div class="kpi-icon icon-cyan"><i data-lucide="message-square"></i></div>
          </div>
          <div class="kpi-value" id="kpiComments">...</div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="database"></i> Tương tác người dùng</span>
            <span class="kpi-subtext">Đã qua lọc bot</span>
          </div>
        </div>

        <!-- KPI 3: Báo lỗi & Phản hồi -->
        <div class="kpi-card kpi-card-purple">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">BÁO LỖI & PHẢN HỒI</span>
              <span class="kpi-badge badge-purple">Ticket Center</span>
            </div>
            <div class="kpi-icon icon-purple"><i data-lucide="shield-alert"></i></div>
          </div>
          <div class="kpi-value" id="kpiFeedbacks">...</div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="check-circle"></i> Báo cáo người dùng</span>
            <span class="kpi-subtext">Cần xử lý: 0</span>
          </div>
        </div>

        <!-- KPI 4: Người dùng & VIP -->
        <div class="kpi-card kpi-card-gold">
          <div class="kpi-top">
            <div class="kpi-meta">
              <span class="kpi-label">THÀNH VIÊN / VIP ACTIVE</span>
              <span class="kpi-badge badge-gold">Supabase Auth</span>
            </div>
            <div class="kpi-icon icon-gold"><i data-lucide="crown"></i></div>
          </div>
          <div class="kpi-value" id="kpiUsers">... <span class="kpi-subval">/ ... VIP</span></div>
          <div class="kpi-footer">
            <span class="kpi-trend positive"><i data-lucide="user-check"></i> Hồ sơ tài khoản</span>
            <span class="kpi-subtext">Hoạt động 24/7</span>
          </div>
        </div>
      </div>

      <!-- Secondary Metric Strip -->
      <div class="kpi-mini-grid">
        <div class="kpi-mini-card">
          <div class="mini-icon icon-gold"><i data-lucide="coins"></i></div>
          <div class="mini-content">
            <div class="mini-label">XU ĐANG LƯU HÀNH</div>
            <div class="mini-val-row">
              <span class="mini-value text-gold" id="miniTotalXu">... Xu</span>
              <span class="mini-trend-chip"><i data-lucide="activity"></i> Lưu thông</span>
            </div>
          </div>
        </div>
        <div class="kpi-mini-card">
          <div class="mini-icon icon-purple"><i data-lucide="clock"></i></div>
          <div class="mini-content">
            <div class="mini-label">GIAO DỊCH CHỜ DUYỆT</div>
            <div class="mini-val-row">
              <span class="mini-value text-purple" id="miniPendingTx">0</span>
              <span class="mini-trend-chip"><i data-lucide="check"></i> Thời gian thực</span>
            </div>
          </div>
        </div>
        <div class="kpi-mini-card">
          <div class="mini-icon icon-cyan"><i data-lucide="user-plus"></i></div>
          <div class="mini-content">
            <div class="mini-label">ĐĂNG KÝ MỚI HÔM NAY</div>
            <div class="mini-val-row">
              <span class="mini-value text-cyan" id="miniNewUsersToday">0</span>
              <span class="mini-trend-chip"><i data-lucide="trending-up"></i> Hôm nay</span>
            </div>
          </div>
        </div>
        <div class="kpi-mini-card">
          <div class="mini-icon icon-pink"><i data-lucide="message-circle"></i></div>
          <div class="mini-content">
            <div class="mini-label">BÌNH LUẬN CHỜ DUYỆT</div>
            <div class="mini-val-row">
              <span class="mini-value text-pink" id="miniPendingComments">0</span>
              <span class="mini-trend-chip"><i data-lucide="shield"></i> Hàng đợi</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Charts & Visual Analytics Section -->
      <div class="analytics-grid">
        <!-- Main Chart: Multi-Metric Traffic, Users & Revenue -->
        <div class="glass-card chart-container-card">
          <div class="card-header">
            <div class="card-title-wrap">
              <h3 class="card-title" id="chartMainTitle"><i data-lucide="bar-chart-3" class="text-primary"></i> Biểu Đồ Tăng Trưởng (7 Ngày)</h3>
              <p class="card-desc" id="chartMainDesc">Thành viên mới, doanh thu & bình luận thời gian thực</p>
            </div>
            <div class="card-action-group">
              <!-- Enterprise Time Range Selector (Ngày, Tháng, Năm) -->
              <div class="time-range-segmented" id="chartTimeRangeSegment">
                <button type="button" class="time-btn active" data-range="7d" onclick="AdminCore.changeChartTimeRange('7d', this)">7 Ngày</button>
                <button type="button" class="time-btn" data-range="30d" onclick="AdminCore.changeChartTimeRange('30d', this)">30 Ngày</button>
                <button type="button" class="time-btn" data-range="month" onclick="AdminCore.changeChartTimeRange('month', this)">12 Tháng</button>
                <button type="button" class="time-btn" data-range="year" onclick="AdminCore.changeChartTimeRange('year', this)">Theo Năm</button>
              </div>
              <span class="badge badge-emerald"><i data-lucide="check-circle"></i> Live Feed</span>
            </div>
          </div>
          
          <!-- Interactive Metric Filter Pills (Enterprise Dashboard Standard) -->
          <div class="chart-filter-tabs">
            <button type="button" class="chart-tab active" data-metric="all" onclick="AdminCore.filterChartMetric('all', this)">
              Tất Cả Chỉ Số
            </button>
            <button type="button" class="chart-tab" data-metric="users" onclick="AdminCore.filterChartMetric('users', this)">
              Thành Viên Mới
            </button>
            <button type="button" class="chart-tab" data-metric="comments" onclick="AdminCore.filterChartMetric('comments', this)">
              Bình Luận Mới
            </button>
            <button type="button" class="chart-tab" data-metric="revenue" onclick="AdminCore.filterChartMetric('revenue', this)">
              Doanh Thu (VNĐ)
            </button>
          </div>

          <div class="chart-wrapper">
            <canvas id="trafficAnalyticsChart" height="280"></canvas>
          </div>
        </div>

        <!-- Secondary Chart / Live Health Gauge -->
        <div class="glass-card live-status-card">
          <div class="card-header">
            <div class="card-title-wrap">
              <h3 class="card-title"><i data-lucide="cpu" class="text-cyan"></i> Tài Nguyên & Máy Chủ</h3>
              <p class="card-desc">Hiệu năng máy chủ Node.js & Cluster</p>
            </div>
            <span class="status-live-pill"><span class="status-dot pinging"></span> OPTIMAL</span>
          </div>
          
          <div class="system-metrics-list">
            <div class="metric-row">
              <div class="metric-label-wrap">
                <span>Node.js Heap Memory</span>
                <span class="metric-val text-emerald" id="serverHeapMem">Loading...</span>
              </div>
              <div class="progress-track"><div class="progress-fill" id="serverHeapBar" style="width: 25%; background: var(--emerald);"></div></div>
            </div>

            <div class="metric-row">
              <div class="metric-label-wrap">
                <span>Process RSS Memory</span>
                <span class="metric-val text-cyan" id="serverRssMem">Loading...</span>
              </div>
              <div class="progress-track"><div class="progress-fill" id="serverRssBar" style="width: 35%; background: var(--cyan);"></div></div>
            </div>

            <div class="metric-row">
              <div class="metric-label-wrap">
                <span>Database Response</span>
                <span class="metric-val text-emerald">12ms (Supabase & Mongo)</span>
              </div>
              <div class="progress-track"><div class="progress-fill" style="width: 14%; background: var(--emerald);"></div></div>
            </div>

            <div class="metric-row">
              <div class="metric-label-wrap">
                <span>Server Uptime</span>
                <span class="metric-val text-gold" id="serverUptime">Active</span>
              </div>
              <div class="progress-track"><div class="progress-fill" style="width: 100%; background: var(--gold);"></div></div>
            </div>
          </div>

          <div class="crawler-status-box">
            <div class="crawler-icon"><i data-lucide="bot"></i></div>
            <div class="crawler-info">
              <div class="crawler-title">Tự động đồng bộ nguồn PhimAPI</div>
              <div class="crawler-time">Trạng thái: Realtime CDN Synchronized</div>
            </div>
            <span class="badge badge-emerald">ACTIVE</span>
          </div>
        </div>
      </div>

      <!-- Live Realtime Activity Stream & Top Trending Movies -->
      <div class="dashboard-split-grid">
        <!-- Realtime Activity Feed -->
        <div class="glass-card">
          <div class="card-header">
            <div class="card-title-wrap">
              <h3 class="card-title"><i data-lucide="activity" class="text-rose"></i> Luồng Hoạt Động Thời Gian Thực</h3>
              <p class="card-desc">Cập nhật tương tác thành viên, nạp Xu, VIP và bình luận</p>
            </div>
            <span class="status-live-pill"><span class="status-dot pinging"></span> REALTIME</span>
          </div>

          <div class="activity-feed" id="liveActivityFeed">
            <div style="padding: 24px; text-align: center; color: var(--text-dim);">
              <i data-lucide="loader-2" class="spin" style="width: 20px; height: 20px; margin-bottom: 6px;"></i>
              <div>Đang tải luồng hoạt động thực tế...</div>
            </div>
          </div>
        </div>

        <!-- Top Trending Movies Table -->
        <div class="glass-card">
          <div class="card-header">
            <div class="card-title-wrap">
              <h3 class="card-title"><i data-lucide="flame" class="text-gold"></i> Phim Mới Cập Nhật & Thịnh Hành</h3>
              <p class="card-desc">Danh sách phim stream trực tiếp từ CDN</p>
            </div>
            <a href="/admin/movies" class="btn-text">Xem tất cả <i data-lucide="chevron-right"></i></a>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>PHIM / TÊN GỐC</th>
                  <th>PHÂN LOẠI</th>
                  <th>CHẤT LƯỢNG</th>
                  <th>LƯỢT XEM</th>
                  <th>THAO TÁC</th>
                </tr>
              </thead>
              <tbody id="topMoviesList">
                <tr>
                  <td colspan="5" class="text-center" style="padding: 24px; color: var(--text-dim);">
                    <i data-lucide="loader-2" class="spin" style="width: 20px; height: 20px; margin-bottom: 6px;"></i>
                    <div>Đang tải danh sách phim...</div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Partials: Slide-over Drawer, Command Palette, Lock Modal -->
<%- include('partials/drawer') %>
<%- include('partials/cmd_palette') %>
<%- include('partials/lock_modal') %>
<%- include('partials/scripts') %>
