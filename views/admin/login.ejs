<%- include('partials/head', { title: 'Đăng Nhập Quản Trị Viên', activePage: 'login' }) %>

<div class="login-wrapper">
  <!-- Glowing Ambient Lights -->
  <div class="login-glow-1"></div>
  <div class="login-glow-2"></div>

  <div class="login-card glass-panel">
    <div class="login-header">
      <div class="brand-logo-icon large">
        <i data-lucide="clapperboard"></i>
      </div>
      <h1 class="login-brand-title">APHIM SUPER</h1>
      <div class="login-badge"><i data-lucide="shield-check"></i> CỔNG BẢO MẬT ENTERPRISE</div>
      <p class="login-sub-text">Đăng nhập tài khoản Super Admin để truy cập toàn bộ hệ thống</p>
    </div>

    <form id="adminLoginForm" onsubmit="event.preventDefault(); return AdminCore.handleLogin();">
      <input type="hidden" id="csrfToken" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

      <div class="form-group">
        <label class="form-label" for="loginEmail">Email hoặc Tên Đăng Nhập:</label>
        <div class="input-with-icon">
          <i data-lucide="user" class="input-icon"></i>
          <input type="text" id="loginEmail" class="form-control" required placeholder="admin@aphim.io.vn" autocomplete="username">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="loginPassword">Mật khẩu Quản Trị:</label>
        <div class="input-with-icon">
          <i data-lucide="lock" class="input-icon"></i>
          <input type="password" id="loginPassword" class="form-control" required placeholder="••••••••" autocomplete="current-password">
        </div>
      </div>

      <!-- Cloudflare Turnstile Protection (Bot & Brute-force Shield) -->
      <div class="turnstile-wrapper" style="display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 16px 0 12px 0; min-height: 68px;">
        <div class="cf-turnstile" id="cfTurnstileWidget" data-sitekey="<%= typeof turnstileSiteKey !== 'undefined' ? turnstileSiteKey : '0x4AAAAAAFg_6li9AZQECDb9' %>" data-theme="dark" data-callback="onTurnstileSuccess" data-expired-callback="onTurnstileExpired"></div>
      </div>

      <div class="login-options-row">
        <label class="remember-wrap">
          <input type="checkbox" checked id="rememberAdmin">
          <span>Ghi nhớ phiên đăng nhập</span>
        </label>
        <a href="javascript:void(0)" onclick="alert('Vui lòng liên hệ Trưởng nhóm DevOps để khôi phục mã khóa bảo mật!')" class="forgot-link">Quên mật khẩu?</a>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-login-submit" id="btnLoginSubmit">
        <i data-lucide="log-in"></i> Đăng Nhập Hệ Thống
      </button>

      <div class="login-security-notice">
        <i data-lucide="shield"></i> Bảo vệ bởi Cloudflare Turnstile, Cookie HttpOnly & Chống Brute-force
      </div>
    </form>
  </div>
</div>

<!-- Cloudflare Turnstile Script & Callbacks -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  window.turnstileToken = '';
  window.onTurnstileSuccess = function(token) {
    window.turnstileToken = token;
  };
  window.onTurnstileExpired = function() {
    window.turnstileToken = '';
  };
</script>

<%- include('partials/scripts') %>
