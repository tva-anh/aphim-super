<!-- Backdrop for Slide-over Drawer -->
<div class="drawer-backdrop" id="drawerBackdrop"></div>

<!-- Enterprise Slide-over Detail Drawer -->
<div class="slide-drawer" id="slideDrawer">
  <div class="drawer-header">
    <div class="drawer-header-left">
      <div class="drawer-icon-tag" id="drawerIconTag">
        <i data-lucide="eye"></i>
      </div>
      <div>
        <h3 class="drawer-title" id="drawerTitle">Chi Tiết Phim & Inspector</h3>
        <p class="drawer-subtitle" id="drawerSubtitle">Chỉnh sửa trạng thái, duyệt link streaming và thông số</p>
      </div>
    </div>
    <button class="drawer-close-btn" id="drawerCloseBtn" title="Đóng (Esc)">
      <i data-lucide="x"></i>
    </button>
  </div>

  <div class="drawer-body" id="drawerContent">
    <!-- Dynamic Content will be injected here via AdminInspector JS -->
  </div>

  <div class="drawer-footer" id="drawerFooter">
    <button class="btn btn-secondary" id="drawerSecondaryBtn">Đóng</button>
    <button class="btn btn-primary" id="drawerPrimaryBtn">Lưu Thay Đổi</button>
  </div>
</div>
