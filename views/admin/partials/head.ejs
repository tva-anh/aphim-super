<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">

    <!-- Immediate Authentication Guard (Synchronously runs before DOM paints to prevent unauthorized view) -->
    <% if (typeof activePage === 'undefined' || activePage !== 'login') { %>
    <script>
      (function() {
        var token = localStorage.getItem('aphim_admin_token');
        var cookieToken = (document.cookie.match(/(?:^|;\s*)aphim_admin_token=([^;]+)/) || [])[1];
        if (!token && !cookieToken) {
          window.location.replace('/admin/login?redirect=' + encodeURIComponent(window.location.pathname));
        }
      })();
    </script>
    <% } else { %>
    <script>
      (function() {
        var token = localStorage.getItem('aphim_admin_token');
        var cookieToken = (document.cookie.match(/(?:^|;\s*)aphim_admin_token=([^;]+)/) || [])[1];
        if (token || cookieToken) {
          var params = new URLSearchParams(window.location.search);
          var dest = params.get('redirect') || '/admin';
          window.location.replace(dest);
        }
      })();
    </script>
    <% } %>

    <title><%= typeof title !== 'undefined' ? title : 'Admin Suite' %> | APhim Super Enterprise</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@600;700;800&family=Montserrat:wght@800;900&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@600;700;800&family=Montserrat:wght@800;900&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@600;700;800&family=Montserrat:wght@800;900&display=swap">
    </noscript>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Chart.js for Pro Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Enterprise Master Admin Stylesheet -->
    <link rel="stylesheet" href="/css/admin-enterprise.css?v=114">
    
    <style>
      /* Smooth transitions and warm cream custom scrollbar */
      ::-webkit-scrollbar { width: 6px; height: 6px; }
      ::-webkit-scrollbar-track { background: #f5f0e6; }
      ::-webkit-scrollbar-thumb { background: #dcd3c4; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #4f46e5; }
    </style>
</head>
<body data-page="<%= typeof activePage !== 'undefined' ? activePage : 'dashboard' %>">
