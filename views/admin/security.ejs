<script>
  (function initSecMonitor() {
    function run() {
      if (window.AdminCore && typeof AdminCore.loadSecurityLogs === 'function') {
        AdminCore.loadSecurityLogs();
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
  })();
</script>
