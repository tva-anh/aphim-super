                      <button type="button" class="reels-action-btn" title="Chia sẻ">
                        <span style="font-size: 18px;">↗️</span>
                      </button>
                      <span>1.2K</span>
                    </div>
                    <div class="reels-action-item">
                      <div class="reels-music-disk" title="Âm thanh gốc"></div>
                    </div>
                  </div>

                  <!-- Bottom HUD Info -->
                  <div class="reels-bottom-info">
                    <div class="reels-author-header">
                      <img src="/icons/icon-192x192.png" onerror="this.src='https://graph.facebook.com/1307356335804337/picture?type=large'" class="reels-author-avatar" alt="Author">
                      <div class="reels-author-name">
                        <span>APhim Super</span>
                        <svg class="fb-badge-verify" viewBox="0 0 24 24" style="width: 14px; height: 14px;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                      </div>
                      <span class="reels-episode-tag" id="reelsEpisodeBadge">Tập 1</span>
                    </div>
                    <div class="reels-caption-text" id="reelsCaptionPreview">
                      ⚡ Đang chuẩn bị kịch bản Reels siêu cuốn...
                    </div>
                    <div class="reels-audio-tag">
                      <i data-lucide="music" style="width: 12px; height: 12px;"></i>
                      <span>Âm thanh gốc - APhim Super</span>
                    </div>
                  </div>
                </div>

                <!-- Reels Caption & Comment Editor Controls -->
                <div style="margin-top: 14px; background: #ffffff; border: 1px solid var(--border-default, #e7e0d3); border-radius: 14px; padding: 14px; box-shadow: 0 1px 4px rgba(0,0,0,0.04);">
                  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                    <span style="font-size: 12px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 5px;">
                      <i data-lucide="file-text" style="width: 13px; height: 13px; color: #ec4899;"></i> Caption Video Reels:
                    </span>
                    <button type="button" class="btn btn-outline" id="btnGenerateReelsCaption" style="font-size: 11px; padding: 3px 8px; color: #be185d; border-color: #fbcfe8; display: inline-flex; align-items: center; gap: 4px;" onclick="window.SocialStudio.generateReelsCaption()" title="Tạo lại caption Reels cuốn hút cho tập này">
                      <i data-lucide="sparkles" style="width: 12px; height: 12px;"></i> Tạo Lại Caption Reels
                    </button>
                  </div>
                  <textarea id="reelsCaptionInput" class="fb-post-textarea" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" style="min-height: 80px; font-size: 12.5px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 10px;" placeholder="Nhập hoặc để AI tự tạo caption Reels..."></textarea>

                  <div style="margin-top: 10px;">
                    <div style="font-size: 11.5px; font-weight: 700; color: #d97706; margin-bottom: 4px; display: flex; align-items: center; gap: 5px;">
                      <i data-lucide="pin" style="width: 12px; height: 12px;"></i> Bình Luận Ghim (Link Xem Trọn Bộ Phim):
                    </div>
                    <textarea id="reelsFirstCommentInput" class="fb-comment-textarea" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" style="min-height: 48px; font-size: 12px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 10px; width: 100%; box-sizing: border-box; background: #faf7f2;" placeholder="Bình luận kèm link aphim.store..."></textarea>
                  </div>
                </div>

                <!-- Publish Reels Button -->
                <div style="margin-top: 12px; display: flex; flex-direction: column; gap: 8px;">
                  <button type="button" class="btn-studio-publish" id="btnPublishReels" onclick="window.SocialStudio.publishReels()" style="background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%); box-shadow: 0 4px 18px rgba(236, 72, 153, 0.4);">
                    <i data-lucide="video" style="width: 17px; height: 17px;"></i>
                    <span id="labelPublishReels">ĐĂNG REELS TẬP NÀY LÊN FANPAGE APHIM SUPER</span>
                  </button>
                  <div style="display: flex; gap: 8px;">
                    <button type="button" class="btn btn-outline" style="flex: 1; font-size: 12.5px; padding: 7px 12px;" onclick="window.SocialStudio.copyReelsCaption()">
                      <i data-lucide="copy" style="width: 13px; height: 13px;"></i> Sao Chép Caption Reels
                    </button>
                    <a href="https://www.facebook.com/1307356335804337/reels/" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="font-size: 12.5px; padding: 7px 12px; text-decoration: none; display: inline-flex; align-items: center; gap: 5px;">
                      <i data-lucide="external-link" style="width: 13px; height: 13px;"></i> Kênh Reels Fanpage
                    </a>
                  </div>
                </div>

              </div>

            </div>
          </div>

        </div>

        <!-- 3. Nhật Ký Bài Đăng Gần Đây (Post History Log) -->
        <div class="studio-card" style="margin-top: 6px;">
          <div class="studio-card-title">
            <h3><i data-lucide="history" style="color: #7c3aed;"></i> Nhật Ký Đăng Bài Fanpage Gần Đây</h3>
            <button type="button" class="btn btn-outline" style="font-size: 12px; padding: 4px 10px;" onclick="window.SocialStudio.loadHistory()">
              <i data-lucide="rotate-ccw" style="width: 12px; height: 12px;"></i> Làm Mới
            </button>
          </div>

          <div style="overflow-x: auto;">
            <table class="admin-table" style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr style="text-align: left; font-size: 12px; color: #78716c; background: #faf7f2; border-bottom: 1px solid var(--border-default, #e7e0d3);">
                  <th style="padding: 10px 14px;">BỘ PHIM</th>
                  <th style="padding: 10px 14px;">ĐỊNH DẠNG</th>
                  <th style="padding: 10px 14px;">POST ID & LINK</th>
                  <th style="padding: 10px 14px;">MEDIA</th>
                  <th style="padding: 10px 14px;">COMMENT LINK</th>
                  <th style="padding: 10px 14px;">THỜI GIAN</th>
                  <th style="padding: 10px 14px; text-align: right;">HÀNH ĐỘNG</th>
                </tr>
              </thead>
              <tbody id="postHistoryTableBody">
                <tr>
                  <td colspan="7" style="text-align: center; padding: 20px; color: #78716c; font-size: 13px;">
                    Chưa có bài viết nào được đăng qua hệ thống.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Pagination Toolbar for Post History -->
          <div id="postHistoryPagination" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-top: 1px solid var(--border-default, #e7e0d3); flex-wrap: wrap; gap: 10px; background: #faf7f2; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;">
            <div style="font-size: 12px; color: #78716c; font-weight: 600;" id="historyPageInfo">
              Đang tải danh sách bài đăng...
            </div>
            <div style="display: flex; align-items: center; gap: 6px;" id="historyPageBtns">
              <!-- Dynamically populated page buttons -->
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>
</div>

<!-- Lightbox Modal for Photo Review -->
<div id="socialStudioLightbox" class="studio-lightbox-modal" style="display: none;" onclick="window.SocialStudio.closeLightbox(event)">
