<%- include('partials/head', { title: 'Social Studio — Marketing Fanpage AI', activePage: 'social-studio' }) %>

<style>
/* ═══════════════════════════════════════════════════════════════════
   APHIM SOCIAL STUDIO — CHAMPAGNE CINEMA ENTERPRISE DESIGN SYSTEM
   ═══════════════════════════════════════════════════════════════════ */

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.animate-spin {
  animation: spin 0.8s linear infinite !important;
  display: inline-block !important;
}

.studio-container {
  display: flex;
  flex-direction: column;
  gap: 18px;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* Control Toolbar & Ticker Row */
.studio-top-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

/* Layout Mode Buttons */
.layout-toggle-group {
  display: inline-flex;
  align-items: center;
  background: #ffffff;
  border: 1px solid var(--border-default, #e7e0d3);
  border-radius: 10px;
  padding: 3px;
  gap: 4px;
  box-shadow: 0 1px 4px rgba(78, 64, 45, 0.04);
}
.layout-toggle-btn {
  background: transparent;
  border: none;
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 700;
  color: #78716c;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
}
.layout-toggle-btn:hover {
  color: #1c1917;
  background: #faf7f2;
}
.layout-toggle-btn.active {
  background: #4f46e5;
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(79, 70, 229, 0.25);
}

/* 1. Google Trends Live Radar Ribbon */
.trends-radar-banner {
  background: #ffffff;
  border: 1px solid var(--border-default, #e7e0d3);
  border-radius: 14px;
  padding: 8px 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 2px 8px rgba(78, 64, 45, 0.04);
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.trends-radar-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 4px 10px;
  border-radius: 20px;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(249, 115, 22, 0.25);
}

.trends-radar-scroll {
  display: flex;
  align-items: center;
  gap: 8px;
  overflow-x: auto;
  white-space: nowrap;
  scrollbar-width: none;
  flex: 1;
  min-width: 0;
}
.trends-radar-scroll::-webkit-scrollbar { display: none; }

.trend-pill-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #faf7f2;
  border: 1px solid var(--border-default, #e7e0d3);
  padding: 4px 10px;
  border-radius: 99px;
  font-size: 11.5px;
  font-weight: 600;
  color: #44403c;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  user-select: none;
  flex-shrink: 0;
}
.trend-pill-item:hover {
  background: #fff7ed;
  border-color: #f97316;
  color: #ea580c;
  transform: translateY(-1px);
}
.trend-traffic-count {
  font-size: 10px;
  font-weight: 800;
  color: #ea580c;
  background: rgba(249, 115, 22, 0.12);
  padding: 2px 5px;
  border-radius: 8px;
}

/* 2. Workspace Split Grid Architecture — Anti-Overflow Guaranteed */
.studio-workspace-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(380px, 0.85fr);
  gap: 20px;
  align-items: start;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.studio-left-col, .studio-right-col {
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
}

/* Collapsed Left Panel Mode (Focus Preview Mode) */
.studio-workspace-grid.left-collapsed {
  grid-template-columns: 1fr;
}
.studio-workspace-grid.left-collapsed .studio-left-col {
  display: none;
}
.studio-workspace-grid.left-collapsed .studio-right-col {
  max-width: 580px;
  margin: 0 auto;
}

/* Master Studio Card */
.studio-card {
  background: #ffffff;
  border: 1px solid var(--border-default, #e7e0d3);
  border-radius: 16px;
  padding: 18px 20px;
  box-shadow: 0 2px 10px rgba(78, 64, 45, 0.05);
  transition: all 0.2s ease;
  min-width: 0;
  box-sizing: border-box;
}

.studio-card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.studio-card-title h3 {
  font-size: 14.5px;
  font-weight: 800;
  color: #1c1917;
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0;
}

/* Source Switcher Tabs inside Step 1 */
.source-tabs-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  border-bottom: 1px solid var(--border-default, #e7e0d3);
  padding-bottom: 8px;
}
.source-tab-btn {
  background: #faf7f2;
  border: 1px solid var(--border-default, #e7e0d3);
  border-radius: 8px;
  padding: 5px 12px;
  font-size: 12px;
  font-weight: 700;
  color: #78716c;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: all 0.2s ease;
}
.source-tab-btn:hover {
  background: #f5f0e6;
  color: #1c1917;
}
.source-tab-btn.active {
  background: #eef2ff;
  border-color: #4f46e5;
  color: #4f46e5;
}

/* Quick-Pick Horizontal Scroll Shelf */
.quick-pick-section {
  margin-bottom: 14px;
  min-width: 0;
  width: 100%;
}
.quick-pick-scroll {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 6px;
  scrollbar-width: thin;
  scrollbar-color: #dcd3c4 transparent;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}
.quick-pick-scroll::-webkit-scrollbar {
  height: 4px;
}
.quick-pick-scroll::-webkit-scrollbar-thumb {
  background: #dcd3c4;
  border-radius: 4px;
}
.quick-pick-chip {
  flex-shrink: 0;
  width: 95px;
  background: #faf7f2;
  border: 1px solid var(--border-default, #e7e0d3);
  border-radius: 10px;
  padding: 6px;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  text-align: center;
}
.quick-pick-chip:hover, .quick-pick-chip.active {
  background: #ffffff;
  border-color: #4f46e5;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.15);
}
.quick-pick-poster {
  width: 100%;
  height: 84px;
  object-fit: cover;
  border-radius: 6px;
  margin-bottom: 5px;
  background: #e7e0d3;
}
.quick-pick-name {
  font-size: 11px;
  font-weight: 700;
  color: #1c1917;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quick-pick-rating {
  font-size: 10px;
  font-weight: 700;
  color: #d97706;
}

/* Search input */
.movie-search-wrap {
  position: relative;
  width: 100%;
  margin-bottom: 12px;
}
.movie-search-input {
  width: 100%;
  background: #faf7f2;
  border: 1px solid var(--border-default, #e7e0d3);
  border-radius: 12px;
  padding: 10px 14px 10px 40px;
  color: #1c1917;
  font-size: 13.5px;
  font-weight: 500;
  outline: none;
  transition: all 0.2s ease;
  box-sizing: border-box;
}
.movie-search-input:focus {
  background: #ffffff;
  border-color: #4f46e5;
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
}
.movie-search-icon {
  position: absolute;
  top: 50%;
  left: 14px;
  transform: translateY(-50%);
  color: #78716c;
  pointer-events: none;
}
.movie-suggest-dropdown {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  background: #ffffff;
  border: 1px solid var(--border-default, #e7e0d3);
  border-radius: 12px;
  max-height: 280px;
  overflow-y: auto;
  z-index: 100;
  box-shadow: 0 12px 30px rgba(78, 64, 45, 0.12);
  display: none;
}
.movie-suggest-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 12px;
  cursor: pointer;
  border-bottom: 1px solid #f0eae0;
  transition: background 0.15s ease;
}
.movie-suggest-item:hover {
  background: #f5f0e6;
}
.movie-suggest-thumb {
  width: 34px;
  height: 48px;
  object-fit: cover;
  border-radius: 6px;
  background: #e7e0d3;
}

/* Selected Movie Card */
.selected-movie-card {
  background: #faf7f2;
  border: 1px solid var(--border-default, #e7e0d3);
  border-radius: 12px;
  padding: 12px;
  display: flex;
  gap: 12px;
  margin-top: 4px;
}
.selected-movie-poster {
  width: 65px;
  height: 94px;
  border-radius: 7px;
  object-fit: cover;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(78, 64, 45, 0.12);
  background: #e7e0d3;
}

/* Media Gallery Grid */
.media-gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 8px;
  max-height: 220px;
  overflow-y: auto;
  padding: 2px;
  margin-bottom: 12px;
  min-width: 0;
}
.media-thumb-item {
  position: relative;
  border-radius: 8px;
  overflow: hidden;
  aspect-ratio: 16/10;
  background: #faf7f2;
  border: 2px solid var(--border-default, #e7e0d3);
  cursor: pointer;
  transition: all 0.2s ease;
}
.media-thumb-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.media-thumb-item:hover {
  border-color: #4f46e5;
}
.media-thumb-item.selected {
  border-color: #4f46e5;
  box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.25);
}
.media-thumb-badge {
  position: absolute;
  top: 4px;
  right: 4px;
  background: rgba(0, 0, 0, 0.6);
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 10px;
}
.media-thumb-item.selected .media-thumb-badge {
  background: #4f46e5;
  color: #ffffff;
  font-weight: 800;
}

/* 3. Live Facebook Feed Simulator (Right Column) */
.fb-simulator-container {
  position: sticky;
  top: 18px;
  width: 100%;
  min-width: 0;
}

/* Authentic Facebook Post Card */
.fb-feed-card {
  background: #ffffff;
  border: 1px solid #ced0d4;
  border-radius: 12px;
  box-shadow: 0 4px 18px rgba(78, 64, 45, 0.08);
  color: #050505;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  overflow: hidden;
  transition: all 0.25s ease;
  width: 100%;
  box-sizing: border-box;
}

.fb-feed-card.theme-dark {
  background: #242526;
  border-color: #3e4042;
  color: #e4e6eb;
}
.fb-feed-card.theme-dark .fb-author-name { color: #e4e6eb; }
.fb-feed-card.theme-dark .fb-post-time { color: #b0b3b8; }
.fb-feed-card.theme-dark .fb-post-textarea { color: #e4e6eb; }
.fb-feed-card.theme-dark .fb-comment-preview-section { background: #18191a; border-top-color: #3e4042; }
.fb-feed-card.theme-dark .fb-comment-bubble { background: #3a3b3c; }
.fb-feed-card.theme-dark .fb-comment-author { color: #e4e6eb; }
.fb-feed-card.theme-dark .fb-comment-textarea { color: #e4e6eb; }
.fb-feed-card.theme-dark .fb-engagement-bar { border-top-color: #3e4042; color: #b0b3b8; }

.fb-post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px 6px 14px;
}
.fb-author-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.fb-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  object-fit: cover;
  border: 1px solid rgba(0, 0, 0, 0.1);
}
.fb-author-name {
  font-size: 14.5px;
  font-weight: 700;
  color: #050505;
  display: flex;
  align-items: center;
  gap: 4px;
}
.fb-badge-verify {
  width: 14px;
  height: 14px;
  fill: #1877f2;
}
.fb-post-time {
  font-size: 11.5px;
  color: #65676b;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* Post Content Editable Area */
.fb-post-content-wrap {
  padding: 4px 14px 10px 14px;
}
.fb-post-textarea {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  color: #050505;
  font-size: 14px;
  line-height: 1.5;
  resize: vertical;
  min-height: 160px;
  font-family: inherit;
  box-sizing: border-box;
  text-decoration: none !important;
  text-decoration-line: none !important;
}

/* Facebook Dynamic Photo Grid (1 - 4 photos) */
/* Facebook Dynamic Photo Grid (Hiển thị đầy đủ tất cả ảnh đã chọn) */
.fb-photo-grid {
  width: 100%;
  background: #f0f2f5;
  display: grid;
  gap: 3px;
  overflow: hidden;
  border-radius: 4px;
}
.fb-feed-card.theme-dark .fb-photo-grid {
  background: #18191a;
}
.fb-photo-grid.grid-1 {
  grid-template-columns: 1fr;
  max-height: 440px;
}
.fb-photo-grid.grid-1 img {
  width: 100%;
  max-height: 440px;
  object-fit: cover;
}
.fb-photo-grid.grid-2 {
  grid-template-columns: 1fr 1fr;
  height: 280px;
}
.fb-photo-grid.grid-2 img {
  width: 100%;
  height: 280px;
  object-fit: cover;
}
.fb-photo-grid.grid-3 {
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 1fr 1fr;
  height: 320px;
}
.fb-photo-grid.grid-3 .fb-photo-item:nth-child(1) {
  grid-row: 1 / span 2;
  height: 320px;
}
.fb-photo-grid.grid-3 img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.fb-photo-grid.grid-4 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  height: 320px;
}
.fb-photo-grid.grid-4 img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.fb-photo-grid.grid-5 {
  grid-template-columns: repeat(6, 1fr);
  grid-template-rows: 190px 150px;
  gap: 3px;
}
.fb-photo-grid.grid-5 .fb-photo-item:nth-child(1),
.fb-photo-grid.grid-5 .fb-photo-item:nth-child(2) {
  grid-column: span 3;
  height: 190px;
}
.fb-photo-grid.grid-5 .fb-photo-item:nth-child(3),
.fb-photo-grid.grid-5 .fb-photo-item:nth-child(4),
.fb-photo-grid.grid-5 .fb-photo-item:nth-child(5) {
  grid-column: span 2;
  height: 150px;
}
.fb-photo-grid.grid-6 {
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: 160px 160px;
  gap: 3px;
}
.fb-photo-grid.grid-many {
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 4px;
  max-height: 480px;
  overflow-y: auto;
  padding: 4px;
}
.fb-photo-grid.grid-many .fb-photo-item {
  height: 130px;
}

.fb-photo-item {
  position: relative;
  width: 100%;
  height: 100%;
  cursor: pointer;
  overflow: hidden;
  background: #000;
  border-radius: 2px;
}
.fb-photo-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.25s ease;
}
.fb-photo-item:hover img {
  transform: scale(1.04);
}
.fb-photo-item-badge {
  position: absolute;
  top: 6px;
  left: 6px;
  background: rgba(0, 0, 0, 0.75);
  color: #ffffff;
  font-size: 10px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 4px;
  pointer-events: none;
  backdrop-filter: blur(2px);
  z-index: 2;
}
.fb-photo-item-zoom {
  position: absolute;
  bottom: 6px;
  right: 6px;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s;
  z-index: 2;
}
.fb-photo-item:hover .fb-photo-item-zoom {
  opacity: 1;
}

.fb-photos-count-indicator {
  padding: 6px 12px;
  font-size: 11.5px;
  font-weight: 600;
  color: #4f46e5;
  background: rgba(79, 70, 229, 0.08);
  border-radius: 6px;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Lightbox Modal */
.studio-lightbox-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.88);
  z-index: 999999;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6px);
  animation: fadeIn 0.2s ease;
}
.studio-lightbox-content {
  position: relative;
  max-width: 90vw;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.studio-lightbox-content img {
  max-width: 85vw;
  max-height: 80vh;
  object-fit: contain;
  border-radius: 8px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
}
.studio-lightbox-close {
  position: absolute;
  top: -45px;
  right: 0;
  background: rgba(255, 255, 255, 0.15);
  border: none;
  color: #fff;
  font-size: 26px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.studio-lightbox-close:hover {
  background: rgba(255, 255, 255, 0.35);
  transform: rotate(90deg);
}
.studio-lightbox-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.15);
  border: none;
  color: #fff;
  font-size: 22px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.studio-lightbox-nav:hover {
  background: rgba(255, 255, 255, 0.4);
}
.studio-lightbox-nav.prev {
  left: -60px;
}
.studio-lightbox-nav.next {
  right: -60px;
}
.studio-lightbox-caption {
  margin-top: 12px;
  color: #e2e8f0;
  font-size: 13px;
  font-weight: 600;
  background: rgba(0, 0, 0, 0.6);
  padding: 4px 12px;
  border-radius: 20px;
}

/* Engagement Counter Bar */
.fb-engagement-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 14px;
  border-top: 1px solid #e4e6eb;
  font-size: 12.5px;
  color: #65676b;
}

/* Facebook First Comment Box */
.fb-comment-preview-section {
  padding: 10px 14px;
  background: #f7f8fa;
  border-top: 1px solid #e4e6eb;
}
.fb-comment-item {
  display: flex;
  gap: 8px;
}
.fb-comment-bubble {
  background: #f0f2f5;
  padding: 7px 11px;
  border-radius: 14px;
  flex: 1;
}
.fb-comment-author {
  font-size: 12.5px;
  font-weight: 700;
  color: #050505;
  margin-bottom: 2px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.fb-comment-badge-author {
  font-size: 10px;
  background: #e4e6eb;
  padding: 1px 5px;
  border-radius: 6px;
  color: #65676b;
}
.fb-comment-textarea {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  color: #050505;
  font-size: 12.5px;
  font-family: inherit;
  resize: none;
  min-height: 46px;
  text-decoration: none !important;
  text-decoration-line: none !important;
}

/* Action Control Buttons */
.btn-studio-primary {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  border: none;
  border-radius: 12px;
  padding: 10px 16px;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
