                            // 6. Bổ sung Nhãn Lồng tiếng nếu phim có (Hồng San Hô)
                            if (hasLt && leftPills.length < 5) {
                                leftPills.push(`<span class="ap-badge-rose">L.Tiếng</span>`);
                            }

                            return `
                                <div class="card-top-badges ${isSongNgu ? 'has-song-ngu' : ''}">
                                    <div class="card-pills-left">
                                        ${leftPills.join('')}
                                    </div>
