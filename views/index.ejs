                                    window.__INITIAL_DESKTOP_INTERESTS__ = <%- JSON.stringify(rawInterestsList) %>;
                                </script>
                                <% rawInterestsList.forEach(function(c, idx) { const noAuraClass=isNoAuraSSR(c)
                                    ? ' no-aura' : '' ; const textColor=c.textColor || '#ffffff' ; const
                                    cardRgbVal=getCardRgbSSR(c, idx); const rgbStyle=isNoAuraSSR(c) ?
                                    ('--card-text-color: ' + textColor + ' !important;') :
                                    ('--card-rgb: ' + cardRgbVal + ' !important; --card-text-color: ' + textColor + ' !important;'); const rawIcon=c.iconSvg ?
                                    c.iconSvg.replace(/14s1\.5\s*2\s*4\s*2\s*4-2(\s*4-2)?/g, '14c1.5 2 6.5 2 8 0' ) :
                                    defaultInterestsIcons[idx % defaultInterestsIcons.length]; %>
                                    <div class="interest-card<%= noAuraClass %>"
                                        onclick="window.location.href='<%= c.link || '#' %>'" style="<%- rgbStyle %>">
                                        <div class="interest-bg-img"
                                            style="background-image: url('<%= (c.imageUrl || '').replace(/'/g, '\\\'') %>');"></div>
