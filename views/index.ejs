                        /* Không box-shadow ở poster: 12 bóng đen chồng nhau thành vệt mờ lan ra nền kem.
                           Poster để opacity 1 (user: "hình phim nhỏ đang bị mờ") → phân biệt bản đang chiếu bằng viền trắng + nâng. */
                        .rap-thumb { width: 64px; border-radius: 10px; opacity: 1; box-shadow: none; }
                        /* Dọc poster (10:16 ≈ 102px) — nhỏ ngang nhưng vẫn cao, giãn cách 14px */
                        .rap-strip .rap-thumb img { aspect-ratio: 10 / 16; }
                        .rap-thumb:hover { opacity: 1; }
                        .rap-thumb.active { box-shadow: 0 0 0 2px rgba(255, 255, 255, .95); }
                        .rap-dots { display: none; }

                        /* Desktop: chữ ĐÈ TRÊN ẢNH nên cả 2 theme phải là chữ sáng.
                           light-mode.css có "html.light-mode main h3 / main p { color:#...!important }"
