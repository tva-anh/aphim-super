                                        if (!_top10MemoryCache.has(kLe) || !_top10MemoryCache.has(kBo)) {
                                            core.fetchMovieGridData('country', 'viet-nam', 1);
                                        }
                                    });
                                } catch (e) { }
                            }, 1200);
                        }

