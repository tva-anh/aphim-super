                <!-- Loaded via JS -->
            </div>
        </section>


        <!-- ==============================================
             SECTION 1: PHIM BỘ MỚI CẬP NHẬT (PHOTO #3 EXACT 5-COLUMN GRID: 12 ITEMS TOTAL)
             ============================================== -->
        <section>
            <div class="section-header">
                <div class="section-header-left">
                    <h2 class="section-header-title">PHIM BỘ MỚI CẬP NHẬT</h2>
                    <div class="section-header-tabs">
                        <button type="button" onclick="switchSectionTab(this, 'grid-phim-bo', 'https://phimapi.com/v1/api/danh-sach/phim-bo?page=1')" class="section-header-tab active">Mới cập nhật</button>
                        <button type="button" onclick="switchSectionTab(this, 'grid-phim-bo', 'https://phimapi.com/v1/api/quoc-gia/han-quoc?page=1')" class="section-header-tab inactive">Hàn Quốc</button>
                        <button type="button" onclick="switchSectionTab(this, 'grid-phim-bo', 'https://phimapi.com/v1/api/quoc-gia/trung-quoc?page=1')" class="section-header-tab inactive">Trung Quốc</button>
                        <button type="button" onclick="switchSectionTab(this, 'grid-phim-bo', 'https://phimapi.com/v1/api/quoc-gia/au-my?page=1')" class="section-header-tab inactive">Âu Mỹ</button>
                        <button type="button" onclick="switchSectionTab(this, 'grid-phim-bo', 'https://phimapi.com/v1/api/danh-sach/phim-bo?page=2')" class="section-header-tab inactive">Phim Bộ Full</button>
