            if (currentCommentTab === 'featured') {
                // Tab "Nổi Bật": Ưu tiên hiển thị các bình luận từ Admin, VIP, VIP PRO, danh hiệu cấp cao hoặc nhiều tương tác
                const isInfluential = (c) => {
                    const badge = (c.badge || '').toLowerCase();
                    const name = (c.userName || '').toLowerCase();
                    return c.isAdmin || 
                           c.isVip || 
                           name.includes('admin') || 
                           badge.includes('admin') || 
                           badge.includes('vip') || 
                           badge.includes('fan cứng') || 
                           badge.includes('cày phim') || 
                           badge.includes('top') ||
                           (c.reactionsCount && c.reactionsCount > 0) ||
                           (c.level && c.level >= 10);
                };

                const influentialOnly = items.filter(isInfluential);
                if (influentialOnly.length > 0) {
                    items = influentialOnly;
                }

                // Sắp xếp ưu tiên: Admin đứng đầu (100k điểm) -> VIP PRO / VIP (50k điểm) -> Level cao -> Lượt thích (thả tim)
                items.sort((a, b) => {
                    const getScore = (item) => {
                        const bName = (item.badge || '').toLowerCase();
                        const uName = (item.userName || '').toLowerCase();
                        let score = 0;
                        if (item.isAdmin || uName.includes('admin') || bName.includes('admin')) score += 100000;
                        if (item.isVip || bName.includes('vip')) score += 50000;
                        if (bName.includes('fan cứng') || bName.includes('cày phim') || bName.includes('top')) score += 10000;
                        score += (item.level || 0) * 100;
                        score += (item.reactionsCount || 0) * 50;
                        return score;
                    };
