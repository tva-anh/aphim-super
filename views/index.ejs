                        background: linear-gradient(92deg, #a78bfa 0%, #fbbf24 48%, #22d3ee 100%);
                        -webkit-background-clip: text; background-clip: text;
                        -webkit-text-fill-color: transparent; color: transparent;
                        text-shadow: none !important; filter: none !important;
                    }
                    html.light-mode .sn-frame-line2 {
                        background: linear-gradient(92deg, #7c3aed 0%, #b45309 48%, #0e7490 100%);
                        -webkit-background-clip: text; background-clip: text;
                        text-shadow: none !important; filter: none !important;
                    }
                    .sn-frame-link { display: inline-flex; align-items: center; gap: 5px; font-size: 13.5px; font-weight: 700; opacity: .72; transition: opacity .2s ease; text-shadow: none !important; }
                    .sn-frame-link:hover { opacity: 1; }

                    /* ---- Từng hàng quốc gia: ĐÃ XÓA đường kẻ ngang giữa các hàng + vạch nhỏ dưới tên nước (cả 2 màn) ---- */
                    .sn-country-row { display: flex; align-items: flex-start; gap: 18px; padding: 14px 0; }
                    .sn-country-row + .sn-country-row { padding-top: 14px; }
                    .sn-title-col { flex: 0 0 128px; width: 128px; padding-top: 4px; }
                    .sn-title { font-size: 17px; line-height: 1.22; font-weight: 900; margin-bottom: 6px; text-shadow: none !important; filter: none !important; }
                    .sn-title-bar { display: none; }
                    .sn-more { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 700; opacity: .6; transition: opacity .2s ease; text-shadow: none !important; }
                    .sn-more:hover { opacity: 1; }
                    .sn-korea .sn-title-col { color: #a78bfa; }
                    .sn-china .sn-title-col { color: #fbbf24; }
                    .sn-usuk .sn-title-col { color: #22d3ee; }
                    /* Tiêu đề là thẻ h2 nên phải thắng các quy định h2 set mau !important;
                       dung -webkit-text-fill-color !important de khong mau chu nao de duoc phan to chu */
                    .sn-korea .sn-title-col .sn-title {
                        background: linear-gradient(92deg, #a78bfa 0%, #c084fc 52%, #f0abfc 100%);
                        -webkit-background-clip: text; background-clip: text;
                        -webkit-text-fill-color: transparent !important; color: transparent !important;
                        text-shadow: none !important; filter: none !important;
                    }
                    .sn-china .sn-title-col .sn-title {
                        background: linear-gradient(92deg, #fde68a 0%, #fbbf24 55%, #fb923c 100%);
                        -webkit-background-clip: text; background-clip: text;
                        -webkit-text-fill-color: transparent !important; color: transparent !important;
                        text-shadow: none !important; filter: none !important;
                    }
                    .sn-usuk .sn-title-col .sn-title {
                        background: linear-gradient(92deg, #67e8f9 0%, #22d3ee 52%, #818cf8 100%);
                        -webkit-background-clip: text; background-clip: text;
                        -webkit-text-fill-color: transparent !important; color: transparent !important;
                        text-shadow: none !important; filter: none !important;
                    }
                    html.light-mode .sn-korea .sn-title-col { color: #7c3aed; }
                    html.light-mode .sn-china .sn-title-col { color: #b45309; }
                    html.light-mode .sn-usuk .sn-title-col { color: #0e7490; }
                    html.light-mode .sn-korea .sn-title-col .sn-title { background: linear-gradient(92deg, #7c3aed 0%, #a21caf 55%, #c026d3 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent !important; color: transparent !important; text-shadow: none !important; filter: none !important; }
                    html.light-mode .sn-china .sn-title-col .sn-title { background: linear-gradient(92deg, #d97706 0%, #b45309 55%, #be123c 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent !important; color: transparent !important; text-shadow: none !important; filter: none !important; }
                    html.light-mode .sn-usuk .sn-title-col .sn-title { background: linear-gradient(92deg, #0891b2 0%, #0e7490 52%, #4338ca 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent !important; color: transparent !important; text-shadow: none !important; filter: none !important; }

                    /* ---- Nút bấm chuyển hướng < > trên thanh tiêu đề hàng (Đồng bộ chuẩn như Phim Rạp & Phim Đề Cử) ---- */
                    .sn-title-right { display: inline-flex; align-items: center; gap: 10px; }
                    .sn-header-nav { display: inline-flex; align-items: center; gap: 6px; }
                    .sn-nav-arrow-btn {
                        width: 28px; height: 28px; border-radius: 9999px;
                        display: inline-flex; align-items: center; justify-content: center;
                        border: none; outline: none; cursor: pointer;
                        background: rgba(255, 255, 255, 0.12); color: #ffffff;
                        transition: all 0.2s ease; flex-shrink: 0;
                    }
                    .sn-nav-arrow-btn:hover { background: #ff6a00; color: #ffffff; transform: scale(1.08); }
                    .sn-korea .sn-nav-arrow-btn:hover { background: #a855f7; }
                    .sn-china .sn-nav-arrow-btn:hover { background: #fbbf24; color: #18181b; }
                    .sn-usuk .sn-nav-arrow-btn:hover { background: #22d3ee; color: #18181b; }
                    .sn-nav-arrow-btn svg { width: 14px; height: 14px; display: block; }
                    html.light-mode .sn-nav-arrow-btn { background: rgba(0, 0, 0, 0.07); color: #18181b; }
                    html.light-mode .sn-korea .sn-nav-arrow-btn:hover { background: #7c3aed; color: #fff; }
                    html.light-mode .sn-china .sn-nav-arrow-btn:hover { background: #b45309; color: #fff; }
                    html.light-mode .sn-usuk .sn-nav-arrow-btn:hover { background: #0e7490; color: #fff; }

                    /* ---- Hàng thẻ ngang (120FPS Native Hardware Glide Chuẩn như Phim Đề Cử & Phim Rạp) ---- */
                    .sn-body { position: relative; flex: 1; min-width: 0; }
                    .sn-track {
                        display: flex !important;
                        flex-wrap: nowrap !important;
                        gap: 12px !important;
                        overflow-x: auto !important;
                        overflow-y: hidden !important;
                        padding: 4px 2px 10px !important;
                        scrollbar-width: none !important;
                        -ms-overflow-style: none !important;
                        overscroll-behavior-x: contain !important;
                        -webkit-overflow-scrolling: touch !important;
                        touch-action: pan-x pan-y !important;
                        scroll-behavior: auto !important;
                        cursor: grab;
                        user-select: none !important;
                        -webkit-user-select: none !important;
                    }
                    .sn-track:active { cursor: grabbing; }
                    .sn-track::-webkit-scrollbar { display: none !important; width: 0 !important; height: 0 !important; }

                    /* Khóa kéo ảnh trên Mobile để vuốt lướt ngang mượt mà 100% không bị vấp */
                    .sn-country-frame .sn-track .sn-row-card img {
                        pointer-events: none !important;
                        -webkit-user-drag: none !important;
                        user-select: none !important;
                    }

                    /* ---- RỘNG THẺ DESKTOP ---- */
                    .sn-country-frame .sn-track .sn-row-card { flex: 0 0 auto !important; width: 268px !important; flex-shrink: 0 !important; }
                    @media (min-width: 1024px) and (max-width: 1279px) { .sn-country-frame .sn-track .sn-row-card { width: 232px !important; } }
                    @media (min-width: 1600px) { .sn-country-frame .sn-track .sn-row-card { width: 300px !important; } }
                    @media (min-width: 1900px) { .sn-country-frame .sn-track .sn-row-card { width: 324px !important; } }

                    /* ---- Mũi tên điều hướng nổi (desktop hover) ---- */
                    /* Đã hợp nhất nút chuyển hướng < > lên thanh tiêu đề chuẩn như Phim Rạp & Phim Đề Cử */
                    .sn-nav { display: none !important; }

                    /* ---- MOBILE (≤1023px): TIÊU ĐỀ Ở TRÊN + NÚT < > + HÀNG TRƯỢT NGANG LƯỚT ÊM KHÔNG SNAP ---- */
                    @media (max-width: 1023px) {
                        .sn-country-section { margin-top: 10px; }
                        .sn-frame-head { padding: 0 0 8px; gap: 10px; align-items: flex-start; }
                        .sn-frame-line1 { font-size: 18px; }
                        .sn-frame-line2 { font-size: 13px; }
                        .sn-frame-link { font-size: 12.5px; line-height: 1.72; }

                        .sn-country-row { flex-direction: column; align-items: stretch; gap: 4px; padding: 9px 0; }
                        .sn-country-row + .sn-country-row { padding-top: 9px; }

                        /* Tiêu đề quốc gia + "Xem toàn bộ >" + Nút < > nằm trên cùng 1 dòng */
                        .sn-title-col {
                            flex: 0 0 auto; width: 100%; padding-top: 0;
                            display: flex; align-items: center; justify-content: space-between; gap: 8px;
                        }
                        .sn-title { margin-bottom: 0; font-size: 15px; }
                        .sn-title-bar { display: none; }
                        .sn-title-right { display: inline-flex; align-items: center; gap: 8px; }
                        .sn-more { flex: 0 0 auto; font-size: 11.5px; opacity: .72; }

                        .sn-body { width: 100%; min-width: 0; }
                        /* Bỏ scroll-snap để lướt ngang tự nhiên 120fps chuẩn như mục Phim Đề Cử */
                        .sn-track {
                            gap: 10px !important;
                            padding: 4px 2px 8px !important;
                            scroll-snap-type: none !important;
                            -webkit-overflow-scrolling: touch !important;
                            touch-action: pan-x pan-y !important;
                            overscroll-behavior-x: contain !important;
                        }
                        /* Kích thước thẻ vừa vặn hiển thị 2.3 thẻ (thẻ thứ 3 nhô ra rõ rệt để báo hiệu lướt ngang) */
                        .sn-country-frame .sn-track .sn-row-card {
                            flex: 0 0 188px !important;
                            width: 188px !important;
                            max-width: 188px !important;
                            scroll-snap-align: none !important;
                        }
                        .sn-nav { display: none !important; }
                    }

                    /* Thu nhỏ dần theo cỡ màn điện thoại */
                    @media (max-width: 639px) {
                        .sn-frame-line1 { font-size: 16px; }
                        .sn-frame-line2 { font-size: 12px; }
                        .sn-title { font-size: 14px; }
                    }
                    @media (max-width: 480px) {
                        .sn-country-frame .sn-track .sn-row-card {
                            flex: 0 0 178px !important;
                            width: 178px !important;
                            max-width: 178px !important;
                        }
                    }
                    @media (max-width: 390px) {
                        .sn-frame-line1 { font-size: 14.5px; }
                        .sn-frame-line2 { font-size: 11.5px; }
                        .sn-title { font-size: 13.5px; }
                        .sn-country-frame .sn-track .sn-row-card {
                            flex: 0 0 168px !important;
                            width: 168px !important;
                            max-width: 168px !important;
                        }
                    }
                    @media (max-width: 360px) {
                        .sn-frame-line1 { font-size: 13.5px; }
                        .sn-title { font-size: 13px; }
                        .sn-country-frame .sn-track .sn-row-card {
                            flex: 0 0 156px !important;
                            width: 156px !important;
                            max-width: 156px !important;
                        }
                    }

                    /* ---- Bỏ lớp phủ nền đen loang lổ và bóng nhòe quanh tên phim theo yêu cầu ---- */
                    .sn-country-frame .sn-row-card .landscape-poster-wrap img {
                        filter: brightness(1.08) contrast(1.03) !important;
                    }
                    .sn-country-frame .sn-row-card .card-bottom-overlay,
                    html.light-mode .sn-country-frame .sn-row-card .card-bottom-overlay {
                        background: transparent !important;
                    }
                    .sn-country-frame .sn-row-card .card-title-vi,
                    html.light-mode .sn-country-frame .sn-row-card .card-title-vi {
                        text-shadow: none !important;
                        filter: none !important;
                    }
                    .sn-country-frame .sn-row-card .card-title-en,
                    html.light-mode .sn-country-frame .sn-row-card .card-title-en {
                        text-shadow: none !important;
                        filter: none !important;
                    }
                </style>

