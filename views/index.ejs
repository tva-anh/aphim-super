                            var deCuEl = document.getElementById('slider-de-cu');
                            var cachedDeCu = localStorage.getItem('aphim_de_cu_slider_trends_v43');
                            if (deCuEl && cachedDeCu && !cachedDeCu.includes('data:image/svg+xml')) {
                                deCuEl.innerHTML = cachedDeCu;
