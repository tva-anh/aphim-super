                        .rap-chip.rap-chip-tmdb .tmdb-v { display: flex; align-items: center; background: rgba(4, 12, 20, .82); padding: 4px 11px; border: 1.5px solid rgba(255, 255, 255, .42); border-left: none; border-radius: 0 7px 7px 0; }
