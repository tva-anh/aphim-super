                        async function loadTop10Section() {
                            fetchTop10Data();
                            prewarmTop10NearbyTabs();
                        }

                        function extractPosterColor(imgEl, item) {
                            if (item && item.glow_color) {
                                if (typeof item.glow_color === 'string' && item.glow_color.startsWith('#')) {
                                    const c = parseInt(item.glow_color.replace('#', ''), 16);
                                    return { r: (c >> 16) & 255, g: (c >> 8) & 255, b: c & 255 };
                                }
                                return item.glow_color;
                            }

                            // High-precision signature movie colors matching poster tones (0ms CPU/GPU cost)
                            const key = ((item?.name || '') + ' ' + (item?.slug || '') + ' ' + (item?.origin_name || '')).toLowerCase();
                            if (key.includes('doraemon')) return { r: 14, g: 165, b: 233 }; // Ocean Cyan
                            if (key.includes('deadpool') || key.includes('wolverine')) return { r: 239, g: 68, b: 68 }; // Ruby Crimson
                            if (key.includes('quat-mo') || key.includes('exhuma')) return { r: 13, g: 148, b: 136 }; // Teal Emerald
                            if (key.includes('conan')) return { r: 37, g: 99, b: 235 }; // Cobalt Blue
                            if (key.includes('lat-mat')) return { r: 245, g: 158, b: 11 }; // Amber Gold
                            if (key.includes('cong') || key.includes('executioner') || key.includes('thuc-thi')) return { r: 6, g: 182, b: 212 }; // Electric Cyan
                            if (key.includes('mai')) return { r: 244, g: 63, b: 94 }; // Rose Coral
                            if (key.includes('nhat-thuc') || key.includes('eclipse')) return { r: 168, g: 85, b: 247 }; // Purple Glow
                            if (key.includes('spider') || key.includes('nhan')) return { r: 225, g: 29, b: 72 }; // Crimson Red
                            if (key.includes('batman') || key.includes('hac-am')) return { r: 100, g: 116, b: 139 }; // Slate Frost
                            if (key.includes('one-piece') || key.includes('luffy')) return { r: 249, g: 115, b: 22 }; // Vivid Orange
                            if (key.includes('jujutsu') || key.includes('naruto')) return { r: 139, g: 92, b: 246 }; // Neon Violet

                            // Deterministic signature hue fallback
                            let hash = 0;
                            const str = item?.slug || item?.name || 'aphim-super';
                            for (let i = 0; i < str.length; i++) hash = str.charCodeAt(i) + ((hash << 5) - hash);
                            const palettes = [
                                { r: 14, g: 165, b: 233 },
                                { r: 245, g: 158, b: 11 },
                                { r: 239, g: 68, b: 68 },
                                { r: 16, g: 185, b: 129 },
                                { r: 168, g: 85, b: 247 },
                                { r: 6, g: 182, b: 212 },
                                { r: 249, g: 115, b: 22 },
                                { r: 236, g: 72, b: 153 }
                            ];
                            return palettes[Math.abs(hash) % palettes.length];
                        }

                        // Load Phim Mới Đề Cử Slider (Google Trends 24h + Phim Mới Nổi Bật)
                        async function loadDeCuSlider() {
                            const sliderEl = document.getElementById('slider-de-cu');
                            if (!sliderEl) return;
                            const cacheKey = 'aphim_de_cu_slider_trends_v30';
                            try {
                                const cached = localStorage.getItem(cacheKey);
                                if (cached && (!sliderEl.children.length || sliderEl.querySelector('.de-cu-skeleton-card'))) {
                                    sliderEl.innerHTML = cached;
                                }
                            } catch (e) { }

                            try {
                                // 1. Ưu tiên nạp danh sách từ Google Trends 24h (tự động cập nhật tức thì, chống cache trình duyệt)
                                let resp = null;
                                for (let attempt = 0; attempt < 3; attempt++) {
                                    try {
                                        resp = await fetch('/api/movies/trending-24h?_t=' + Date.now(), { cache: 'no-store' });
                                        if (resp && resp.ok) break;
                                    } catch (fetchErr) {
                                        if (attempt < 2) await new Promise(r => setTimeout(r, 600));
                                    }
                                }
                                
                                let items = [];
                                if (resp && resp.ok) {
                                    const data = await resp.json();
                                    if (data && data.success && Array.isArray(data.items) && data.items.length) {
                                        items = data.items;
                                    }
                                }

                                // 2. Dự phòng nạp phim mới cập nhật nếu API trends gặp sự cố
                                if (!items.length) {
                                    const core = await getAPhimCore();
                                    const res = await core.fetchMovieGridData('list', 'phim-moi-cap-nhat', 1);
                                    items = res.items || [];
                                }

                                if (sliderEl && items.length) {
                                    const html = items.slice(0, 24).map((m, idx) => createDeCuCardHTML(m, idx)).join('');
                                    const hasSkeleton = !sliderEl.children.length || !!sliderEl.querySelector('.de-cu-skeleton-card');
                                    if (hasSkeleton || sliderEl.innerHTML !== html) {
                                        const prevScroll = sliderEl.scrollLeft;
                                        sliderEl.innerHTML = html;
                                        if (prevScroll > 0) sliderEl.scrollLeft = prevScroll;
                                    }
                                    if (items.some(m => m.is_google_trend)) {
                                        try { localStorage.setItem(cacheKey, html); } catch (e) { }
                                    }
                                }
                            } catch (err) {
                                console.warn('Lỗi Slider Đề Cử Trends 24h:', err);
                            }
                        }

                        // ==========================================
                        // 🎥 SECTION 0.2: PHIM RẠP SẮP CHIẾU (TỰ ĐỘNG 100% TRỰC TIẾP TỪ MOMO CINEMA API)
                        // ==========================================
                        const CINEMA_HOT_CACHE_KEY = 'aphim_cinema_hot_momo_live_v11';
                        const CINEMA_HOT_MAX_DISPLAY = 20; // Giới hạn 20 phim hot nhất
                        let cinemaHotStoredItems = null;
                        let cinemaHotActiveIndex = 0;

                        function createCinemaHotCardHTML(movie, rank, extraAttr = '', idx = 0) {
                            const watchUrl = movie.slug ? '/phim/' + movie.slug : `/search?q=${encodeURIComponent(movie.name)}`;
                            const age = (movie.age || '16+').toUpperCase();
                            let ageClass = 'cinema-hot-badge-18';
                            if (age.includes('16')) ageClass = 'cinema-hot-badge-16';
                            else if (age.includes('13')) ageClass = 'cinema-hot-badge-13';
                            else if (age.includes('P') || age.includes('K')) ageClass = 'cinema-hot-badge-p';

                            let ratingHTML = '';
                            if (movie.rating) {
                                let countText = '';
                                if (movie.rating_count) {
                                    countText = movie.rating_count.includes('đánh giá') 
                                        ? ` (${movie.rating_count})` 
                                        : ` (${movie.rating_count} đánh giá)`;
                                }
                                ratingHTML = `
                                    <div class="cinema-hot-rating-row">
                                        <span class="cinema-hot-star">★</span>
                                        <span class="cinema-hot-score">${movie.rating}/10</span>
                                        ${countText ? `<span class="cinema-hot-reviews">${countText}</span>` : ''}
                                    </div>
                                `;
                            } else {
                                ratingHTML = `
                                    <div class="cinema-hot-rating-row">
                                        <span class="cinema-hot-star">★</span>
                                        <span class="cinema-hot-unrated">${movie.status_note || 'Sắp chiếu tại rạp'}</span>
                                    </div>
                                `;
                            }

                            const metaText = movie.genres || [movie.genres, movie.duration].filter(Boolean).join(' • ');
                            const rankHTML = rank ? `<div class="cinema-hot-rank-num" aria-hidden="true">${rank}</div>` : '';

                            return `
                                <div class="cinema-hot-card" ${extraAttr}>
                                    <a href="${watchUrl}" title="${movie.name}" style="text-decoration:none;" class="block group">
                                        <div class="cinema-hot-poster-wrap">
                                            <span class="cinema-hot-badge-age ${ageClass}">${age}</span>
                                            <img src="${movie.poster}" data-fallback="${movie.fallback_poster || ''}" data-slug="${movie.slug || ''}" alt="${movie.name}" loading="${idx < 4 ? 'eager' : 'lazy'}" decoding="async" ${idx < 2 ? 'fetchpriority="high"' : ''} onerror="if(this.dataset.fallback && this.src !== this.dataset.fallback){ this.src = this.dataset.fallback; } else { window.handleCardImgError(this); }" />
                                            ${rankHTML}
                                            <div class="phimmoi-play-overlay">
                                                <div class="phimmoi-play-btn">
                                                    ${PLAY_SVG_HTML}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="cinema-hot-info-wrap">
                                            ${ratingHTML}
                                            <div class="cinema-hot-title" title="${movie.name}">${movie.name}</div>
                                            ${metaText ? `<div class="cinema-hot-meta-row" title="${metaText}">${metaText}</div>` : ''}
                                        </div>
                                    </a>
                                </div>
                            `;
                        }

                        // 🎬 TỰ ĐỘNG CHUYỂN PHIM RẠP (AUTO-SLIDE 3D COVERFLOW) KHÔNG CHẠY NỀN, MƯỢT MÀ 60FPS
                        let _cinemaHotAutoTimer = null;
                        let _cinemaHotResumeTimer = null;
                        let _cinemaHotIsVisible = false;
                        let _cinemaHotIsUserInteracting = false;
                        const CINEMA_HOT_AUTO_INTERVAL = 6000; // 6.0 giây tự động chuyển phim tiếp theo
                        const CINEMA_HOT_RESUME_DELAY = 8000;  // 8.0 giây nghỉ hoàn toàn sau khi user lướt/chạm/click

                        function stopCinemaHotAuto() {
                            if (_cinemaHotAutoTimer) {
                                clearTimeout(_cinemaHotAutoTimer);
                                _cinemaHotAutoTimer = null;
                            }
                            if (_cinemaHotResumeTimer) {
                                clearTimeout(_cinemaHotResumeTimer);
                                _cinemaHotResumeTimer = null;
                            }
                        }

                        function advanceCinemaHot() {
                            const sliderEl = document.getElementById('slider-cinema-hot');
                            if (!sliderEl) return;
                            const isMobile = window.innerWidth < 640;
                            // Tuyệt đối không can thiệp tự động trượt trên Desktop để đảm bảo 120fps và triệt tiêu reflow
                            if (!isMobile) return;

                            const total = Math.min(cinemaHotStoredItems ? cinemaHotStoredItems.length : 20, CINEMA_HOT_MAX_DISPLAY);
                            if (total <= 1) return;

                            cinemaHotActiveIndex = (cinemaHotActiveIndex + 1) % total;
                            updateCinemaHot3DStage(sliderEl);
                        }

                        function scheduleCinemaHotAuto(delay = CINEMA_HOT_AUTO_INTERVAL) {
                            stopCinemaHotAuto();
                            // Chỉ chạy auto-slide trên màn hình Mobile cho hiệu ứng 3D Coverflow
                            if (window.innerWidth >= 640) return;
                            if (!_cinemaHotIsVisible || document.hidden || _cinemaHotIsUserInteracting) return;
                            _cinemaHotAutoTimer = setTimeout(() => {
                                if (window.innerWidth >= 640 || !_cinemaHotIsVisible || document.hidden || _cinemaHotIsUserInteracting) return;
                                advanceCinemaHot();
                                scheduleCinemaHotAuto(CINEMA_HOT_AUTO_INTERVAL);
                            }, delay);
                        }

                        function pauseCinemaHotOnUserAction() {
                            _cinemaHotIsUserInteracting = true;
                            stopCinemaHotAuto();
                        }
                        window.pauseCinemaHotOnUserAction = pauseCinemaHotOnUserAction;

                        function resumeCinemaHotAfterUserAction() {
                            _cinemaHotIsUserInteracting = false;
                            stopCinemaHotAuto();
                            _cinemaHotResumeTimer = setTimeout(() => {
                                _cinemaHotResumeTimer = null;
                                scheduleCinemaHotAuto(CINEMA_HOT_AUTO_INTERVAL);
                            }, CINEMA_HOT_RESUME_DELAY);
                        }
                        window.resumeCinemaHotAfterUserAction = resumeCinemaHotAfterUserAction;

                        function updateCinemaHot3DStage(sliderEl) {
                            if (!sliderEl) return;
                            const cards = sliderEl.querySelectorAll('.cinema-hot-card');
                            const total = cards.length;
                            if (!total) return;

                            cards.forEach((card, idx) => {
                                card.classList.remove('is-center', 'is-left', 'is-right', 'is-far-left', 'is-far-right', 'is-hidden');
                                let diff = (idx - cinemaHotActiveIndex + total) % total;
                                if (diff > total / 2) diff -= total;

                                if (diff === 0) {
                                    card.classList.add('is-center');
                                } else if (diff === -1) {
                                    card.classList.add('is-left');
                                } else if (diff === 1) {
                                    card.classList.add('is-right');
                                } else if (diff === -2) {
                                    card.classList.add('is-far-left');
                                } else if (diff === 2) {
                                    card.classList.add('is-far-right');
                                } else {
                                    card.classList.add('is-hidden');
                                }
                            });
                        }

                        window.handleCinemaHotCardClick = function (idx, e) {
                            if (window.innerWidth >= 640) return;
                            const sliderEl = document.getElementById('slider-cinema-hot');
                            if (!sliderEl) return;

                            if (idx !== cinemaHotActiveIndex) {
                                if (e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                }
                                cinemaHotActiveIndex = idx;
                                updateCinemaHot3DStage(sliderEl);
                                pauseCinemaHotOnUserAction();
                                resumeCinemaHotAfterUserAction();
                            }
                        };

                        function renderCinemaHotCards(sliderEl, items) {
                            if (!sliderEl || !Array.isArray(items) || !items.length) return;
                            cinemaHotStoredItems = items;
                            const isMobile = window.innerWidth < 640;
                            const topItems = items.slice(0, CINEMA_HOT_MAX_DISPLAY);

                            const buildMoreCard = () => {
                                if (items.length <= CINEMA_HOT_MAX_DISPLAY) return '';
                                const remaining = items.length - CINEMA_HOT_MAX_DISPLAY;
                                return `
                                    <div class="cinema-hot-card cinema-hot-more-card">
                                        <a href="/danh-sach?list=phim-chieu-rap" class="block w-full text-center" style="text-decoration:none;" title="Xem tất cả ${items.length} phim chiếu rạp">
                                             <div class="cinema-hot-more-inner">
                                                <div class="cinema-hot-more-body">
                                                    <div class="cinema-hot-more-icon-circle">
                                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                                            <polyline points="12 5 19 12 12 19"></polyline>
                                                        </svg>
                                                    </div>
                                                    <div class="cinema-hot-more-title">Xem tất cả</div>
                                                    <div class="cinema-hot-more-sub">+${remaining} phim rạp</div>
                                                </div>
                                            </div>
                                            <div class="cinema-hot-info-wrap" style="margin-top: 6px;">
                                                <div class="cinema-hot-meta-row" style="color: #ff6a00; font-weight: 700;">Khám phá toàn bộ ›</div>
                                            </div>
                                        </a>
                                    </div>
                                `;
                            };

                            // --- DESKTOP: Hiển thị 1 chu kỳ chuẩn từ trái sang phải với nút điều hướng ---
                            if (!isMobile) {
                                sliderEl.classList.remove('cinema-hot-stage-mobile');
                                let html = topItems.map((m, idx) => createCinemaHotCardHTML(m, idx + 1, '', idx)).join('');
                                html += buildMoreCard();
                                const hasSkeleton = !sliderEl.children.length || !!sliderEl.querySelector('.cinema-hot-skeleton-card');
                                if (hasSkeleton || (!sliderEl._userInteracted && sliderEl.scrollLeft === 0 && sliderEl.innerHTML !== html)) {
                                    const prevScroll = sliderEl.scrollLeft;
                                    sliderEl.innerHTML = html;
                                    if (prevScroll > 0) sliderEl.scrollLeft = prevScroll;
                                }
                                try { localStorage.setItem('aphim_cinema_hot_html_v10', html); } catch (e) { }
                            } else {
                                // --- MOBILE: 3D COVERFLOW STAGE CHUẨN HERO ẢNH SỐ 1 (0ms Lag, Căn giữa tuyệt đối 100%, Bỏ ô Xem tất cả) ---
                                sliderEl.classList.add('cinema-hot-stage-mobile');
                                sliderEl.scrollLeft = 0;

                                let html = topItems.map((m, idx) => {
                                    return createCinemaHotCardHTML(m, idx + 1, `data-index="${idx}" onclick="handleCinemaHotCardClick(${idx}, event)"`, idx);
                                }).join('');
                                if (sliderEl.innerHTML !== html || sliderEl.querySelector('.cinema-hot-skeleton-card')) {
                                    sliderEl.innerHTML = html;
                                }
                                try { localStorage.setItem('aphim_cinema_hot_html_v10', html); } catch (e) { }

                                // Giữ nguyên vị trí thẻ hiện tại nếu đang tương tác, hoặc đưa về 0
                                if (typeof cinemaHotActiveIndex !== 'number' || cinemaHotActiveIndex >= topItems.length) {
                                    cinemaHotActiveIndex = 0;
                                }
                                updateCinemaHot3DStage(sliderEl);
                            }

                            // 🎯 Khởi tạo một lần: Bộ theo dõi hiển thị (IntersectionObserver) để KHÔNG BAO GIỜ CHẠY NỀN
                            if (!sliderEl._observerInit) {
                                sliderEl._observerInit = true;
                                const targetSec = document.getElementById('cinemaHotSection') || sliderEl;
                                if ('IntersectionObserver' in window && targetSec) {
                                    const secObserver = new IntersectionObserver((entries) => {
                                        entries.forEach(entry => {
                                            _cinemaHotIsVisible = entry.isIntersecting;
                                            if (window.innerWidth < 640 && _cinemaHotIsVisible && !document.hidden && !_cinemaHotIsUserInteracting) {
                                                scheduleCinemaHotAuto(3500); // Khi cuộn vào khung nhìn trên Mobile, chờ 3.5s rồi tự động chuyển
                                            } else {
                                                stopCinemaHotAuto(); // Lập tức dừng khi cuộn ra khỏi màn hình
                                            }
                                        });
                                    }, { threshold: 0.15 });
                                    secObserver.observe(targetSec);
                                } else if (window.innerWidth < 640) {
                                    _cinemaHotIsVisible = true;
                                    scheduleCinemaHotAuto(3500);
                                }

                                // Dừng khi tab bị ẩn hoặc điện thoại khoá màn hình, bật lại khi mở trang
                                document.addEventListener('visibilitychange', () => {
                                    if (document.hidden) {
                                        stopCinemaHotAuto();
                                    } else if (window.innerWidth < 640 && _cinemaHotIsVisible && !_cinemaHotIsUserInteracting) {
                                        scheduleCinemaHotAuto(3000);
                                    }
                                });

                                // Dừng khi hover chuột vào toàn bộ khu vực Section trên desktop, chạy lại khi rê chuột ra
                                targetSec.addEventListener('mouseenter', () => pauseCinemaHotOnUserAction());
                                targetSec.addEventListener('mouseleave', () => resumeCinemaHotAfterUserAction());
                            } else if (_cinemaHotIsVisible && !_cinemaHotIsUserInteracting) {
                                scheduleCinemaHotAuto(CINEMA_HOT_AUTO_INTERVAL);
                            }

                            // Gắn bộ điều khiển cử chỉ vuốt chạm cảm ứng 60-120fps siêu mượt
                            if (!sliderEl._touchInit) {
                                sliderEl._touchInit = true;
                                let startX = 0;
                                let startY = 0;
                                let isSwiping = false;

                                sliderEl.addEventListener('touchstart', (e) => {
                                    pauseCinemaHotOnUserAction(); // Ngay khi user chạm tay vào, dừng tự động chạy
                                    if (!e.touches.length) return;
                                    startX = e.touches[0].clientX;
                                    startY = e.touches[0].clientY;
                                    isSwiping = false;
                                }, { passive: true });

                                sliderEl.addEventListener('touchmove', (e) => {
                                    if (!e.touches.length) return;
                                    const dx = e.touches[0].clientX - startX;
                                    const dy = e.touches[0].clientY - startY;
                                    if (Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy) * 1.1) {
                                        isSwiping = true;
                                    }
                                }, { passive: true });

                                sliderEl.addEventListener('touchend', (e) => {
                                    if (isSwiping && e.changedTouches.length) {
                                        const dx = e.changedTouches[0].clientX - startX;
                                        const total = Math.min(cinemaHotStoredItems ? cinemaHotStoredItems.length : 20, CINEMA_HOT_MAX_DISPLAY);
                                        if (dx < -25) {
                                            // Vuốt sang trái -> Xem phim tiếp theo (Top 2, Top 3...)
                                            cinemaHotActiveIndex = (cinemaHotActiveIndex + 1) % total;
                                            updateCinemaHot3DStage(sliderEl);
                                        } else if (dx > 25) {
                                            // Vuốt sang phải -> Xem phim trước đó (Top 20, Top 19...)
                                            cinemaHotActiveIndex = (cinemaHotActiveIndex - 1 + total) % total;
                                            updateCinemaHot3DStage(sliderEl);
                                        }
                                    }
                                    resumeCinemaHotAfterUserAction();
                                }, { passive: true });

                                // Khi xoay màn hình điện thoại hoặc resize, cập nhật lại trạng thái
                                let resizeTimer = null;
                                window.addEventListener('resize', () => {
                                    clearTimeout(resizeTimer);
                                    resizeTimer = setTimeout(() => {
                                        if (cinemaHotStoredItems) {
                                            renderCinemaHotCards(sliderEl, cinemaHotStoredItems);
                                        }
                                    }, 200);
                                }, { passive: true });
                            }
                        }

                        async function loadCinemaHotSlider() {
                            const sliderEl = document.getElementById('slider-cinema-hot');
                            if (!sliderEl) return;

                            // ⚡ 1. SWR: Nạp tức thì 0ms từ bộ nhớ đệm để không bị trễ hay giật giao diện
                            try {
                                const cachedHtml = localStorage.getItem('aphim_cinema_hot_html_v11');
                                if (cachedHtml && (!sliderEl.children.length || sliderEl.querySelector('.cinema-hot-skeleton-card'))) {
                                    sliderEl.innerHTML = cachedHtml;
                                    if (window.innerWidth < 640) {
                                        sliderEl.classList.add('cinema-hot-stage-mobile');
                                        updateCinemaHot3DStage(sliderEl);
                                    }
                                } else {
                                    const cached = localStorage.getItem(CINEMA_HOT_CACHE_KEY);
                                    if (cached) {
                                        const parsed = JSON.parse(cached);
                                        if (Array.isArray(parsed) && parsed.length > 0) {
                                            renderCinemaHotCards(sliderEl, parsed);
                                        }
                                    }
                                }
                            } catch (e) { }

                            // ⚡ 2. Tự động lấy danh sách phim rạp đang chiếu + sắp chiếu trực tiếp từ MoMo Cinema API (CGV, Lotte, BHD, Galaxy)
                            try {
                                const res = await fetch('/api/movies/cinema-hot');
                                if (res.ok) {
                                    const data = await res.json();
                                    if (data && data.success && Array.isArray(data.items) && data.items.length > 0) {
                                        if (!sliderEl._userInteracted || !sliderEl.children.length || sliderEl.querySelector('.cinema-hot-skeleton-card')) {
                                            renderCinemaHotCards(sliderEl, data.items);
                                        }
                                        try {
                                            localStorage.setItem(CINEMA_HOT_CACHE_KEY, JSON.stringify(data.items));
                                        } catch (e) { }
                                        return;
                                    }
                                }
                            } catch (err) {
                                console.warn('⚠️ Lỗi nạp phim rạp tự động:', err);
                            }

                            // ⚡ 3. Nguồn dự phòng: Nạp từ danh mục phim chiếu rạp hệ thống
                            try {
                                const core = await getAPhimCore();
                                const res = await core.fetchMovieGridData('list', 'phim-chieu-rap', 1);
                                const apiItems = (res && res.items) ? res.items : [];
                                if (apiItems.length && (!sliderEl.children.length || sliderEl.querySelector('.cinema-hot-skeleton-card'))) {
                                    const fallbackList = apiItems.map(m => ({
                                        name: m.name,
                                        slug: m.slug,
                                        age: '16+',
                                        rating: '8.8',
                                        rating_count: 'Rạp',
                                        status_note: m.year ? `Năm ${m.year}` : 'Chiếu Rạp',
                                        genres: (m.category && m.category[0] && m.category[0].name) || 'Chiếu Rạp',
                                        duration: m.time || m.episode_current || 'Full',
                                        poster: getImgUrl(m.poster_url || m.thumb_url),
                                        fallback_poster: getImgUrl(m.thumb_url || m.poster_url)
                                    }));
                                    renderCinemaHotCards(sliderEl, fallbackList);
                                }
                            } catch (err) { }
                        }

                        // ⚡ NẠP NGAY LẬP TỨC 0MS KHÔNG CHỜ DOMCONTENTLOADED
                        loadDeCuSlider();
                        loadCinemaHotSlider();


                        // ==========================================
                        // 💬 HOMEPAGE COMMUNITY COMMENTS SHOWCASE (0ms Instant Cache + SWR)
                        // ==========================================
                        const HOME_COMMENTS_CACHE_KEY = 'aphim_home_comments_cache_v5';
                        try {
                            localStorage.removeItem('aphim_home_comments_cache_v2');
                            localStorage.removeItem('aphim_home_comments_cache_v1');
                            localStorage.removeItem('aphim_home_comments_cache');
                        } catch (e) { }
                        let allHomeComments = [];
                        let currentCommentTab = 'latest';

                        // ⚡ Nạp tức thì từ bộ nhớ đệm LocalStorage trong 0ms (Không bao giờ chờ đợi hay hiện loading)
                        try {
                            const cachedComments = localStorage.getItem(HOME_COMMENTS_CACHE_KEY);
                            if (cachedComments) {
                                const parsed = JSON.parse(cachedComments);
                                if (Array.isArray(parsed) && parsed.length > 0) {
                                    allHomeComments = parsed;
                                }
                            }
                        } catch (e) { }

                        window.scrollHomeComments = function (delta) {
                            const track = document.getElementById('homeCommentsTrack');
                            if (track) {
                                track.scrollBy({ left: delta, behavior: 'smooth' });
                            }
                        };

                        window.toggleHomeComments = function (e) {
                            if (e && e.preventDefault) {
                                e.preventDefault();
                            }
                            const switchEl = document.getElementById('homeCommentSwitch');
                            const boxEl = document.getElementById('homeCommentsBox');
                            if (!switchEl || !boxEl) return;

                            const isCurrentlyActive = switchEl.classList.contains('active') || boxEl.classList.contains('expanded');
                            if (isCurrentlyActive) {
                                switchEl.classList.remove('active');
                                boxEl.classList.remove('expanded');
                            } else {
                                switchEl.classList.add('active');
                                boxEl.classList.add('expanded');
                            }
                        };

                        window.switchHomeCommentTab = function (tab) {
                            currentCommentTab = tab;
                            const tabLatest = document.getElementById('homeCommentTabLatest');
                            const tabFeatured = document.getElementById('homeCommentTabFeatured');

                            if (tab === 'latest') {
                                tabLatest?.classList.add('active');
                                tabFeatured?.classList.remove('active');
                            } else {
                                tabFeatured?.classList.add('active');
                                tabLatest?.classList.remove('active');
                            }
                            renderHomeComments();
                        };

                        const HOME_FALLBACK_FRAMES = [
                            'https://cdn.jsdelivr.net/gh/AlanTran-IT/static-assets@main/frames/a_0c0eeb351ae2cf48c6e1eee2cae49d40.png',
                            'https://cdn.jsdelivr.net/gh/AlanTran-IT/static-assets@main/frames/a_0e839cd79500e7b68e2bbbed54790c28.png',
                            'https://cdn.jsdelivr.net/gh/AlanTran-IT/static-assets@main/frames/a_001e956faa73bd0410c455234c62818f.png',
                            'https://cdn.jsdelivr.net/gh/AlanTran-IT/static-assets@main/frames/a_1acbe609daec21fa5b866df9e5a42cb7.png',
                            'https://cdn.jsdelivr.net/gh/AlanTran-IT/static-assets@main/frames/a_3c97a2d37f433a7913a1c7b7a735d000.png',
                            'https://cdn.jsdelivr.net/gh/AlanTran-IT/static-assets@main/frames/a_777b7aa8e77a569766e4a2e2bf656f4e.png'
                        ];

                        function formatHomeCardContent(raw) {
                            if (!raw || typeof raw !== 'string') return { text: '', gifUrl: null };
                            let text = raw;
                            let gifUrl = null;
                            try {
                                const gifMatch = raw.match(/\[gif:(https?:\/\/[^\]\s]+)\]/i);
                                if (gifMatch) {
                                    gifUrl = gifMatch[1];
                                    text = raw.replace(/\[gif:(https?:\/\/[^\]\s]+)\]/gi, '').trim();
                                }
                            } catch (e) { }
                            return { text, gifUrl };
                        }

                        function renderHomeComments() {
                            const track = document.getElementById('homeCommentsTrack');
                            if (!track) return;

                            let items = Array.isArray(allHomeComments) ? [...allHomeComments] : [];
                            if (!items.length) {
                                return; // Giữ nguyên các thẻ ban đầu đã dựng sẵn trong HTML
                            }

                            try {
                                if (currentCommentTab === 'featured') {
                                    const isInfluential = (c) => {
                                        const badge = String(c?.badge || '').toLowerCase();
                                        const name = String(c?.userName || '').toLowerCase();
                                        return !!(c?.isAdmin ||
                                            c?.isVip ||
                                            name.includes('admin') ||
                                            badge.includes('admin') ||
                                            badge.includes('vip') ||
                                            badge.includes('fan cứng') ||
                                            badge.includes('cày phim') ||
                                            badge.includes('top') ||
                                            (c?.reactionsCount && c.reactionsCount > 0) ||
                                            (c?.level && c.level >= 10));
                                    };

                                    const influentialOnly = items.filter(isInfluential);
                                    if (influentialOnly.length > 0) {
                                        items = influentialOnly;
                                    }

                                    items.sort((a, b) => {
                                        const getScore = (item) => {
                                            const bName = String(item?.badge || '').toLowerCase();
                                            const uName = String(item?.userName || '').toLowerCase();
                                            let score = 0;
                                            if (item?.isAdmin || uName.includes('admin') || bName.includes('admin')) score += 100000;
                                            if (item?.isVip || bName.includes('vip')) score += 50000;
                                            if (bName.includes('fan cứng') || bName.includes('cày phim') || bName.includes('top')) score += 10000;
                                            score += (Number(item?.level) || 0) * 100;
                                            score += (Number(item?.reactionsCount) || 0) * 50;
                                            return score;
                                        };
                                        return getScore(b) - getScore(a);
                                    });
                                }

                                track.innerHTML = items.map((c, idx) => {
                                    if (!c) return '';
                                    const uName = String(c.userName || 'Thành viên APhim');
                                    const uAvatar = c.userAvatar || `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(uName)}`;
                                    const frameUrl = (c.equippedFrameUrl && typeof c.equippedFrameUrl === 'string' && c.equippedFrameUrl.startsWith('http'))
                                        ? c.equippedFrameUrl
                                        : (c.frameUrl && typeof c.frameUrl === 'string' && c.frameUrl.startsWith('http'))
                                            ? c.frameUrl
                                            : HOME_FALLBACK_FRAMES[idx % HOME_FALLBACK_FRAMES.length];

                                    const badgeHtml = c.badge ? (typeof renderUserBadgeHtml === 'function' ? renderUserBadgeHtml(c.badge) : `<span class="home-card-badge">${c.badge}</span>`) : '';
                                    const { text: cleanText, gifUrl } = formatHomeCardContent(c.content);
                                    const gifHtml = gifUrl
                                        ? `<div class="home-card-gif-preview"><img src="${gifUrl}" loading="lazy" alt="GIF"></div>`
                                        : '';
                                    const textHtml = cleanText ? `<div class="home-card-text">${cleanText}</div>` : '';
                                    const titleTooltip = cleanText || (gifUrl ? 'Đã gửi một GIF' : '');
                                    const nameColorCls = c.nameColor && c.nameColor !== 'color_default' ? `ap-nc-${c.nameColor} has-custom-name-color` : '';
                                    const mSlug = c.movieSlug || 'phim';
                                    const mName = c.movieName || 'Xem phim';
                                    const timeAgoStr = c.timeAgo || 'Gần đây';

                                    return `
                        <div class="home-comment-card">
                            <div>
                                <div class="home-card-user-row">
                                    <div class="home-card-avatar-wrap">
                                        <div class="home-card-avatar-circle">
                                            <img src="${uAvatar}" alt="${uName}" loading="lazy" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(uName)}';">
                                        </div>
                                        ${frameUrl ? `<img src="${frameUrl}" class="home-card-frame-img" alt="Khung Avatar" loading="lazy" onerror="this.style.display='none';">` : ''}
                                    </div>
                                    <div class="home-card-user-info">
                                        <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; line-height: 1.2;">
                                            <span class="home-card-username ${nameColorCls}" title="${uName}">${uName}</span>
                                            ${badgeHtml}
                                        </div>
                                        <span class="home-card-time">- ${timeAgoStr}</span>
                                    </div>
                                </div>

                                <div class="home-card-content" title="${titleTooltip}">
                                    ${textHtml}
                                    ${gifHtml}
                                </div>
                            </div>

                            <a href="/phim/${mSlug}" class="home-card-movie-link" title="Xem phim ${mName}">
                                <svg class="home-card-movie-icon" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4zm2 14H4V8h16v10z"/>
                                </svg>
                                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${mName}</span>
                            </a>
                        </div>
                    `;
                                }).join('');
                            } catch (renderErr) {
                                console.warn('Lỗi hiển thị bình luận:', renderErr);
                            }
                        }

                        async function loadHomeCommentsShowcase() {
                            // Render tức thì nếu đã có cache
                            if (allHomeComments.length > 0) {
                                renderHomeComments();
                            }

                            // Đồng bộ ngầm trong nền (SWR Background Fetch) không làm chậm hay hiện loading
                            try {
                                const res = await fetch('/api/comments/home-showcase');
                                const data = await res.json();
                                if (data && data.success && Array.isArray(data.data) && data.data.length > 0) {
                                    allHomeComments = data.data;
                                    try {
                                        localStorage.setItem(HOME_COMMENTS_CACHE_KEY, JSON.stringify(data.data));
                                    } catch (e) { }
                                    renderHomeComments();
                                }
                            } catch (err) {
                                console.warn('Lỗi đồng bộ bình luận ngầm:', err);
                            }
                        }

                        function loadWhenNearViewport(containerId, loadSection) {
                            const container = document.getElementById(containerId);
                            if (!container || !('IntersectionObserver' in window)) {
                                loadSection();
                                return;
                            }

                            const observer = new IntersectionObserver((entries) => {
                                if (entries.some(entry => entry.isIntersecting)) {
                                    observer.disconnect();
                                    loadSection();
                                }
                            }, { rootMargin: '600px 0px' });

                            observer.observe(container);
                        }

                        // ==========================================
                        // 3D MOBILE COVERFLOW SHOWCASE CONTROLLER
                        // ==========================================
                        let showcase3DItems = [];
                        let showcase3DIndex = 0;
                        let showcase3DAutoTimer = null;

                        async function loadMobile3DShowcase() {
                            const section = document.getElementById('mobile3DShowcaseSection');
                            if (!section) return;

                            try {
                                const res = await fetch('/api/settings/mobile-3d-showcase');
                                const data = await res.json();
                                if (data.success && Array.isArray(data.data) && data.data.length > 0) {
                                    showcase3DItems = data.data;
                                    initMobile3DShowcase();
                                }
                            } catch (err) {
                                console.warn('Lỗi tải Mobile 3D Showcase:', err);
                            }
                        }

                        function initMobile3DShowcase() {
                            const track = document.getElementById('showcase3DTrack');
                            const pagination = document.getElementById('showcase3DPagination');
                            if (!track || !showcase3DItems.length) return;

                            // Render 3D Cards with smart tap handling
                            track.innerHTML = showcase3DItems.map((item, idx) => `
                <div class="showcase-3d-card" data-index="${idx}" onclick="handle3DCardClick(${idx})" role="button" aria-label="${item.name || 'Phim'}">
                    <img src="${item.poster_url || item.thumb_url || 'https://phimimg.com/upload/vod/20240506-1/3ea3a7267104b2bfe6f481c4e72750db.jpg'}" alt="${item.name || 'Phim'}" loading="${idx < 3 ? 'eager' : 'lazy'}" onerror="this.src='/images/comment-mascot.webp'">
                </div>
            `).join('');

                            // Render Pagination Dots
                            if (pagination) {
                                pagination.innerHTML = showcase3DItems.map((_, idx) => `
                    <div class="showcase-dot ${idx === 0 ? 'active' : ''}" onclick="goTo3DShowcaseSlide(${idx})" role="button" aria-label="Chuyển sang phim ${idx + 1}"></div>
                `).join('');
                            }

                            update3DShowcasePositions();
                            start3DAutoPlay();

                            // Touch & Swipe Gestures for entire 3D Showcase Section
                            const showcaseSection = document.getElementById('mobile3DShowcaseSection');
                            if (showcaseSection && !showcaseSection.dataset.touchInit) {
                                showcaseSection.dataset.touchInit = 'true';
                                let startX = 0;
                                let startY = 0;
                                let isSwiping = false;

                                showcaseSection.addEventListener('touchstart', (e) => {
                                    if (!e.touches.length) return;
                                    startX = e.touches[0].clientX;
                                    startY = e.touches[0].clientY;
                                    isSwiping = false;
                                    stop3DAutoPlay();
                                }, { passive: true });

                                showcaseSection.addEventListener('touchmove', (e) => {
                                    if (!e.touches.length) return;
                                    const dx = e.touches[0].clientX - startX;
                                    const dy = e.touches[0].clientY - startY;
                                    if (Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy) * 1.1) {
                                        isSwiping = true;
                                    }
                                }, { passive: true });

                                showcaseSection.addEventListener('touchend', (e) => {
                                    if (isSwiping && e.changedTouches.length) {
                                        const dx = e.changedTouches[0].clientX - startX;
                                        if (dx < -25) {
                                            next3DShowcaseSlide();
                                        } else if (dx > 25) {
                                            prev3DShowcaseSlide();
                                        }
                                    }
                                    start3DAutoPlay();
                                }, { passive: true });
                            }
                        }

                        function updateShowcaseAmbientGlow(current, activeImg) {
                            const section = document.getElementById('mobile3DShowcaseSection');
                            if (!section) return;

                            const rgb = extractPosterColor(activeImg, current);
                            const glowRgba = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.65)`;
                            const ambientRgba = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.45)`;
                            const ambientSub = `rgba(${Math.round(rgb.r * 0.8)}, ${Math.round(rgb.g * 0.8)}, ${Math.round(rgb.b * 0.8)}, 0.15)`;
                            const glowSolid = `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`;

                            section.style.setProperty('--showcase-glow-color', glowRgba);
                            section.style.setProperty('--showcase-ambient-color', ambientRgba);
                            section.style.setProperty('--showcase-ambient-sub', ambientSub);
                            section.style.setProperty('--showcase-glow-solid', glowSolid);

                            const ambientLight = document.getElementById('showcase3DAmbientLight');
                            if (ambientLight) {
                                ambientLight.style.background = `radial-gradient(circle, ${ambientRgba} 0%, ${ambientSub} 45%, transparent 72%)`;
                            }
                        }

                        function update3DShowcasePositions() {
                            const cards = document.querySelectorAll('.showcase-3d-card');
                            const dots = document.querySelectorAll('.showcase-dot');
                            const total = showcase3DItems.length;
                            if (!total) return;

                            const current = showcase3DItems[showcase3DIndex];
                            if (!current) return;

                            // Update Info Section
                            const elTitle = document.getElementById('showcase3DTitle');
                            const elOrigin = document.getElementById('showcase3DOrigin');
                            const elBtnWatch = document.getElementById('showcase3DBtnWatch');
                            const elBtnInfo = document.getElementById('showcase3DBtnInfo');
                            const elImdb = document.getElementById('showcase3DImdb');
                            const elQuality = document.getElementById('showcase3DQuality');
                            const elYear = document.getElementById('showcase3DYear');
                            const elLang = document.getElementById('showcase3DLang');
                            const elEp = document.getElementById('showcase3DEp');
                            const elGenres = document.getElementById('showcase3DGenres');
                            const elDesc = document.getElementById('showcase3DDesc');

                            if (elTitle) elTitle.textContent = current.name || '';
                            if (elOrigin) elOrigin.textContent = current.origin_name || '';
                            if (elBtnWatch) elBtnWatch.href = `/xem-phim/${current.slug}/tap-1`;
                            if (elBtnInfo) elBtnInfo.href = `/phim/${current.slug}`;

                            // IMDb Badge
                            if (elImdb) elImdb.textContent = current.imdb || current.vote_average || '9.2';

                            // Quality
                            if (elQuality) elQuality.textContent = current.quality || 'FHD';

                            // Compact / Clean Lang (e.g., "VS.1", "LT", "VS + LT")
                            if (elLang) {
                                let l = (current.lang || 'Vietsub').trim();
                                if (l.toLowerCase().includes('vietsub') && l.toLowerCase().includes('lồng tiếng')) {
                                    l = 'VS + LT';
                                } else if (l.toLowerCase().includes('vietsub') && l.toLowerCase().includes('thuyết minh')) {
                                    l = 'VS + TM';
                                } else if (l.toLowerCase().includes('vietsub')) {
                                    l = 'VS.1';
                                } else if (l.toLowerCase().includes('thuyết minh')) {
                                    l = 'TM';
                                } else if (l.toLowerCase().includes('lồng tiếng')) {
                                    l = 'LT';
                                }
                                elLang.textContent = l;
                            }

                            // Episode / Type (e.g. "12 Tập", "Series", "Phim Lẻ")
                            if (elEp) {
                                let ep = current.episode_current || current.episode_total || current.episodes || '';
                                if (!ep) {
                                    if (current.type === 'single' || current.type === 'movie') ep = 'Phim Lẻ';
                                    else if (current.type === 'series') ep = 'Series';
                                    else ep = '12 Tập';
                                }
                                elEp.textContent = ep;
                            }

                            // Year
                            if (elYear) elYear.textContent = current.year || '2026';

                            // Colorful Pastel Genres (Image 1 style)
                            if (elGenres) {
                                const genreColors = ['genre-blue', 'genre-purple', 'genre-pink', 'genre-mint', 'genre-amber'];
                                let cats = current.category || current.categories || current.genres || [];
                                if (!Array.isArray(cats) || cats.length === 0) {
                                    if (typeof cats === 'string' && cats.trim()) {
                                        cats = cats.split(/[,/|]/).map(s => s.trim()).filter(Boolean);
                                    } else {
                                        // Intelligent fallback genres
                                        cats = ['Chính Kịch', 'Hài Hước', 'Tình Cảm'];
                                    }
                                }
                                elGenres.innerHTML = cats.slice(0, 4).map((c, i) => {
                                    const cName = typeof c === 'object' ? (c.name || c.title || '') : String(c);
                                    const colorClass = genreColors[i % genreColors.length];
                                    return `<span class="showcase-genre-pill ${colorClass}">${cName}</span>`;
                                }).join('');
                            }

                            if (elDesc) elDesc.textContent = current.content ? current.content.replace(/<[^>]*>/g, '').trim() : '';

                            // Update Pagination Dots
                            dots.forEach((dot, idx) => {
                                if (idx === showcase3DIndex) {
                                    dot.classList.add('active');
                                } else {
                                    dot.classList.remove('active');
                                }
                            });

                            // Update 3D Positions & Ambient Glow
                            let activeCardImg = null;
                            cards.forEach((card, idx) => {
                                card.className = 'showcase-3d-card';
                                let diff = (idx - showcase3DIndex + total) % total;
                                if (diff > total / 2) diff -= total;

                                if (diff === 0) {
                                    card.classList.add('is-center');
                                    activeCardImg = card.querySelector('img');
                                } else if (diff === -1 || (showcase3DIndex === 0 && idx === total - 1)) {
                                    card.classList.add('is-left');
                                } else if (diff === 1 || (showcase3DIndex === total - 1 && idx === 0)) {
                                    card.classList.add('is-right');
                                } else if (diff === -2) {
                                    card.classList.add('is-far-left');
                                } else if (diff === 2) {
                                    card.classList.add('is-far-right');
                                } else {
                                    card.classList.add('is-hidden');
                                }
                            });

                            // Trigger Dynamic Poster Ambient Glow Effect
                            updateShowcaseAmbientGlow(current, activeCardImg);
                        }

                        window.handle3DCardClick = function (idx) {
                            if (idx === showcase3DIndex) {
                                const current = showcase3DItems[idx];
                                if (current && current.slug) {
                                    window.location.href = `/xem-phim/${current.slug}/tap-1`;
                                }
                            } else {
                                goTo3DShowcaseSlide(idx);
                            }
                        };

                        window.goTo3DShowcaseSlide = function (idx) {
                            showcase3DIndex = (idx + showcase3DItems.length) % showcase3DItems.length;
                            update3DShowcasePositions();
                            stop3DAutoPlay();
                            start3DAutoPlay();
                        };

                        window.next3DShowcaseSlide = function () {
                            showcase3DIndex = (showcase3DIndex + 1) % showcase3DItems.length;
                            update3DShowcasePositions();
                        };

                        window.prev3DShowcaseSlide = function () {
                            showcase3DIndex = (showcase3DIndex - 1 + showcase3DItems.length) % showcase3DItems.length;
                            update3DShowcasePositions();
                        };

                        let isShowcaseVisible = true;

                        function start3DAutoPlay() {
                            stop3DAutoPlay();
                            if (!isShowcaseVisible || (typeof document !== 'undefined' && document.hidden)) return;
                            showcase3DAutoTimer = setInterval(next3DShowcaseSlide, 5000);
                        }

                        function stop3DAutoPlay() {
                            if (showcase3DAutoTimer) {
                                clearInterval(showcase3DAutoTimer);
                                showcase3DAutoTimer = null;
                            }
                        }

                        // ❄️ Tối ưu hóa GPU & Pin: Tự động ngắt timer khi cuộn ra ngoài màn hình để chống nóng máy
                        if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
                            const scObserver = new IntersectionObserver((entries) => {
                                entries.forEach(entry => {
                                    isShowcaseVisible = entry.isIntersecting;
                                    if (entry.isIntersecting) {
                                        start3DAutoPlay();
                                    } else {
                                        stop3DAutoPlay();
                                    }
                                });
                            }, { threshold: 0.15 });

                            const scEl = document.getElementById('mobile3DShowcaseSection');
                            if (scEl) scObserver.observe(scEl);
                        }

                        if (typeof document !== 'undefined') {
                            document.addEventListener('visibilitychange', () => {
                                if (document.hidden) {
                                    stop3DAutoPlay();
                                } else if (isShowcaseVisible) {
                                    start3DAutoPlay();
                                }
                            });
                        }

                        // Load the first row immediately; defer lower rows until the user is approaching them.
                        document.addEventListener('DOMContentLoaded', function () {
                            try {
                                Object.keys(sessionStorage).forEach(k => {
                                    if (k.startsWith('aphim_sec_v1_')) sessionStorage.removeItem(k);
                                });
                            } catch (e) { }

                            if (window.innerWidth >= 1024) {
                                if (typeof loadHeroBanner === 'function') loadHeroBanner();
                            } else {
                                loadMobile3DShowcase();
                            }

                            loadHomeCommentsShowcase();

                            // ✅ Các section dưới màn dùng IntersectionObserver + hard-timeout 4s
                            loadWhenNearViewport('grid-phim-bo', () => loadUnifiedSection('list', 'phim-bo', 'grid-phim-bo', 12));
                            loadWhenNearViewport('grid-top-10', loadTop10Section);
                            loadWhenNearViewport('grid-chieu-rap', () => loadUnifiedSection('list', 'phim-chieu-rap', 'grid-chieu-rap', 12));
                            loadWhenNearViewport('grid-trending', () => loadUnifiedSection('list', 'phim-moi-cap-nhat', 'grid-trending', 12));
                            loadWhenNearViewport('grid-anime', () => loadUnifiedSection('list', 'hoat-hinh', 'grid-anime', 12));
                        });
                    })();
                </script>
                <script src="/js/hero-banner.js?v=196" defer></script>
</body>

