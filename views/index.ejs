                        }

                        // 🎯 In-Memory Cache for Section Tabs (0ms Instant Tab Switching)
                        const _sectionTabCache = new Map();

                        // 🎯 Tab Switching Handler for Section Filters (Zero Layout Shift + 0ms Switch)
                        window.switchSectionTab = async function (btnElement, containerId, apiUrl) {
                            const tabsContainer = btnElement.closest('.section-header-tabs');
                            if (tabsContainer) {
                                const tabs = tabsContainer.querySelectorAll('.section-header-tab');
                                tabs.forEach(tab => {
                                    tab.classList.remove('active');
                                    tab.classList.add('inactive');
                                });
                                btnElement.classList.remove('inactive');
                                btnElement.classList.add('active');
                            }

                            const gridEl = document.getElementById(containerId);
                            if (!gridEl) return;

                            const cacheKey = `${containerId}_${apiUrl}`;
                            if (_sectionTabCache.has(cacheKey)) {
                                gridEl.innerHTML = _sectionTabCache.get(cacheKey);
                                gridEl.style.opacity = '1';
                                return;
                            }

                            // Giữ nguyên layout, chỉ làm mờ nhẹ trong lúc nạp ngầm để trang không bị giật nhảy lên xuống
                            gridEl.style.transition = 'opacity 0.15s ease';
                            gridEl.style.opacity = '0.5';
                            gridEl.style.pointerEvents = 'none';

                            await loadUnifiedSection(apiUrl, containerId, 12);

                            gridEl.style.opacity = '1';
                            gridEl.style.pointerEvents = '';
                        };

                        // 🎯 Helper to safely get APhimCore even if script finishes parsing after DOMContentLoaded
                        async function getAPhimCore() {
                            if (window.APhimCore && typeof window.APhimCore.fetchMovieGridData === 'function') {
                                return window.APhimCore;
                            }
                            return new Promise((resolve) => {
                                let attempts = 0;
                                const interval = setInterval(() => {
                                    attempts++;
                                    if (window.APhimCore && typeof window.APhimCore.fetchMovieGridData === 'function') {
                                        clearInterval(interval);
                                        resolve(window.APhimCore);
                                    } else if (attempts > 150) {
                                        clearInterval(interval);
                                        resolve(window.APhimCore || {});
                                    }
                                }, 40);
                            });
                        }

                        // 🎯 EXACT PHOTO #3 5-COLUMN RENDER LOGIC: 12 Items Total (1 Featured + 6 Right + 5 Bottom = 12 items, 3 FULL ROWS)
                        async function loadUnifiedSection(arg1, arg2, arg3, arg4 = 12) {
                            let type = 'list';
                            let paramVal = 'phim-moi-cap-nhat';
                            let containerId = '';
                            let limitCount = 12;

                            if (typeof arg1 === 'string' && (arg1.startsWith('http') || arg1.startsWith('/v1/api/'))) {
                                // Called via switchSectionTab(apiUrl, containerId, 12)
                                type = arg1;
                                paramVal = '';
                                containerId = arg2;
                                limitCount = arg3 || 12;
                            } else {
                                // Called via loadUnifiedSection(type, paramVal, containerId, limitCount)
                                type = arg1;
                                paramVal = arg2;
                                containerId = arg3;
                                limitCount = arg4 || 12;
                            }

                            const cacheKey = `${containerId}_${type}${paramVal ? '_' + paramVal : ''}`;
                            const sessionKey = `aphim_sec_v3_${cacheKey}`;
                            let cachedHTML = _sectionTabCache.get(cacheKey);
                            if (!cachedHTML) {
                                try {
                                    const saved = sessionStorage.getItem(sessionKey);
                                    if (saved) {
                                        cachedHTML = saved;
                                        _sectionTabCache.set(cacheKey, saved);
                                    }
                                } catch (e) { }
                            }
                            if (cachedHTML) {
                                const gridEl = document.getElementById(containerId);
                                if (gridEl) {
                                    gridEl.innerHTML = cachedHTML;
                                }
                                return;
                            }

                            try {
                                const core = await getAPhimCore();
                                const res = await core.fetchMovieGridData(type, paramVal, 1);
                                const items = res?.items || [];
                                if (!items.length) return;

                                const gridEl = document.getElementById(containerId);
                                if (gridEl) {
                                    const featuredHTML = createFeaturedCardHTML(items[0]);
                                    const normalCount = limitCount - 1; // 11 normal cards
                                    const normalHTML = items.slice(1, normalCount + 1).map((m, idx) => createNormalCardHTML(m, idx)).join('');
                                    const finalHTML = featuredHTML + normalHTML;
                                    _sectionTabCache.set(cacheKey, finalHTML);
                                    try { sessionStorage.setItem(sessionKey, finalHTML); } catch (e) { }
                                    gridEl.innerHTML = finalHTML;
                                }
                            } catch (err) {
                                console.warn('Lỗi API section:', type, paramVal, err);
                            }
                        }


                        // ==========================================
                        // 🎬 SHOWCASE "PHIM CHIẾU RẠP MỚI" — hero lớn + dải poster (desktop) / dots (mobile)
                        // ==========================================
                        // 15 poster cho dải desktop; mobile vẫn 12 chấm (giữ đúng như cũ)
                        const RAP_LIMIT_DESKTOP = 15;
                        const RAP_LIMIT_MOBILE = 12;
                        const rapLimit = function () {
                            try { return window.matchMedia('(min-width: 1024px)').matches ? RAP_LIMIT_DESKTOP : RAP_LIMIT_MOBILE; }
                            catch (e) { return RAP_LIMIT_DESKTOP; }
                        };
                        const RAP_ROTATE_MS = 7000;
                        const RAP_DESC_CACHE_KEY = 'aphim_rap_desc_v1';
                        let rapItems = [];
                        let rapIndex = 0;
                        let rapTimer = null;
                        let rapHoverPause = false;
                        const rapDescMemory = new Map();
                        // tmdb.id → URL backdrop lớn (1280px). phimimg chỉ có thumb 780×439 nên ảnh nền bị nhòe khi phóng ~1.8x
                        const rapBackdropMemory = new Map();

                        // Bỏ HTML trong mô tả phimapi → text thuần gọn để đè lên hero
                        function rapPlainHtml(html) {
                            return String(html || '')
                                .replace(/<\s*br\s*\/?\s*>/gi, ' ')
                                .replace(/<\/\s*p\s*>/gi, ' ')
                                .replace(/<[^>]+>/g, ' ')
                                .replace(/\s+/g, ' ')
                                .trim();
                        }

                        function rapEpisodeSlug(movie) {
                            const ep = String(movie.episode_current || '').trim();
                            if (!ep || /full|trọn\s*bộ|1080|480p|720p|hd\b/i.test(ep)) return 'full';
                            const num = ep.replace(/[^0-9]/g, '');
                            return num ? 'tap-' + num : 'full';
                        }

                        function rapWatchUrl(movie) {
                            return '/xem-phim/' + movie.slug + '/' + rapEpisodeSlug(movie);
                        }

                        function rapReadDescCache() {
                            try {
                                const raw = sessionStorage.getItem(RAP_DESC_CACHE_KEY);
                                if (!raw) return {};
                                const obj = JSON.parse(raw);
                                return (obj && typeof obj === 'object') ? obj : {};
                            } catch (e) { return {}; }
                        }

                        function rapWriteDescCache(slug, text) {
                            try {
                                const obj = rapReadDescCache();
                                obj[slug] = text || '';
                                sessionStorage.setItem(RAP_DESC_CACHE_KEY, JSON.stringify(obj));
                            } catch (e) { }
                        }

                        // Mô tả KHÔNG có trong payload danh sách ⇒ xin chi tiết cho riêng phim đang hiện (cache lại)
                        async function rapEnsureDesc(movie) {
                            if (!movie || !movie.slug) return '';
                            if (rapDescMemory.has(movie.slug)) return rapDescMemory.get(movie.slug);
                            const cached = rapReadDescCache();
                            if (typeof cached[movie.slug] === 'string') {
                                rapDescMemory.set(movie.slug, cached[movie.slug]);
                                return cached[movie.slug];
                            }
                            try {
                                const res = await fetch('/api/movie-merged/' + encodeURIComponent(movie.slug));
                                if (!res.ok) throw new Error('HTTP ' + res.status);
                                const json = await res.json();
                                const raw = (json && json.movie && (json.movie.content || json.movie.overview)) || '';
                                const text = rapPlainHtml(raw).slice(0, 320);
                                rapDescMemory.set(movie.slug, text);
                                rapWriteDescCache(movie.slug, text);
                                return text;
                            } catch (err) {
                                rapDescMemory.set(movie.slug, '');
                                return '';
                            }
                        }

                        // Lấy backdrop 1280px của TMDB (qua proxy /api/tmdb đã cache 15 phút ở server).
                        // Không có tmdb.id / không có backdrop_path → trả '' và giữ ảnh phimimg 780px.
                        async function rapEnsureBackdrop(movie) {
                            const t = movie && movie.tmdb;
                            const id = t && t.id;
                            if (!id) return '';
                            const key = String(id);
                            if (rapBackdropMemory.has(key)) return rapBackdropMemory.get(key);
                            try {
                                const res = await fetch('/api/tmdb/' + (t.type === 'tv' ? 'tv' : 'movie') + '/' + encodeURIComponent(id));
                                if (!res.ok) throw new Error('HTTP ' + res.status);
                                const json = await res.json();
                                const bp = json && json.backdrop_path;
                                const url = bp ? 'https://image.tmdb.org/t/p/w1280' + bp : '';
                                rapBackdropMemory.set(key, url);
                                return url;
                            } catch (err) {
                                rapBackdropMemory.set(key, '');
                                return '';
                            }
                        }

                        // Đổi src khi ảnh mới đã tải xong để không bị nháy/trắng giữa chừng
                        function rapApplyBackdrop(movie, hero) {
                            if (!hero) return;
                            const img = hero.querySelector('.rap-hero-media img');
                            if (!img) return;
                            const t = movie && movie.tmdb;
                            const key = t && t.id ? String(t.id) : '';
                            const use = function (url) {
                                if (!url || img.getAttribute('data-original-src') === url) return;
                                img.setAttribute('data-original-src', url);
                                img.setAttribute('data-src', url);
                                img.src = url;
                            };
                            if (key && rapBackdropMemory.has(key)) { use(rapBackdropMemory.get(key)); return; }
                            rapEnsureBackdrop(movie).then(function (url) {
                                if (!url) return;
                                if (!rapItems[rapIndex] || rapItems[rapIndex].slug !== movie.slug) return;
                                const pre = new Image();
                                pre.onload = function () {
                                    const cur = hero.querySelector('.rap-hero-media img');
                                    if (cur && rapItems[rapIndex] && rapItems[rapIndex].slug === movie.slug) use(url);
                                };
                                pre.src = url;
                            });
                        }

                        function rapHeroMetaHTML(movie) {
                            const chips = [];
                            const vote = movie.tmdb && Number(movie.tmdb.vote_average);
                            if (vote > 0) {
                                chips.push('<span class="rap-chip rap-chip-tmdb"><span class="tmdb-k">TMDB</span><span class="tmdb-v">' + vote.toFixed(1) + '</span></span>');
                            }
                            if (movie.year) chips.push('<span class="rap-chip">' + movie.year + '</span>');
                            const epLabel = String(movie.episode_current || '').trim() || 'Full';
                            chips.push('<span class="rap-chip">' + epLabel + '</span>');
                            if (movie.time) chips.push('<span class="rap-chip">' + movie.time + '</span>');
                            return chips.join('');
                        }

                        function rapHeroGenresHTML(movie) {
                            const cats = Array.isArray(movie.category) ? movie.category : [];
                            return cats.slice(0, 4).map(function (c) {
                                return '<span class="rap-genre">' + (c.name || '') + '</span>';
                            }).join('');
                        }

                        // desc = chuỗi mô tả;  desc = null → đặt skeleton 3 dòng trong lúc chờ API chi tiết
                        function rapHeroBodyHTML(movie, desc) {
                            const viTitle = movie.name || '';
                            const origin = movie.origin_name || '';
                            const descBlock = (desc === null)
                                ? '<div class="rap-hero-desc-skel">' + rapSkeletonDescHTML() + '</div>'
                                : '<p class="rap-hero-desc">' + (desc || '') + '</p>';
                            return '' +
                                '<h3 class="rap-hero-title"><a href="/phim/' + movie.slug + '" title="' + viTitle.replace(/"/g, '&quot;') + '">' + viTitle + '</a></h3>' +
                                (origin ? '<div class="rap-hero-origin">' + origin + '</div>' : '') +
                                '<div class="rap-hero-meta">' + rapHeroMetaHTML(movie) + '</div>' +
                                '<div class="rap-hero-genres">' + rapHeroGenresHTML(movie) + '</div>' +
                                descBlock +
                                '<div class="rap-hero-actions">' +
                                    '<a class="rap-play" href="' + rapWatchUrl(movie) + '" title="Xem ngay ' + viTitle.replace(/"/g, '&quot;') + '">' + PLAY_SVG_HTML + '</a>' +
                                    '<div class="rap-soft-btns">' +
                                        '<button type="button" class="rap-soft-btn" data-rap-fav aria-label="Thêm vào yêu thích">' +
                                            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>' +
                                        '</button>' +
                                        '<span class="rap-soft-divider"></span>' +
                                        '<a class="rap-soft-btn" href="/phim/' + movie.slug + '" aria-label="Thông tin phim">' +
                                            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="11" x2="12" y2="17"></line><line x1="12" y1="7.5" x2="12" y2="7.6"></line></svg>' +
                                        '</a>' +
                                    '</div>' +
                                '</div>';
                        }

                        // 5 đốm sáng vàng lơ lửng trên nền hero (chỉ hiện ở desktop)
                        function rapOrbsHTML() {
                            return '<i class="rap-hero-orb"></i><i class="rap-hero-orb"></i><i class="rap-hero-orb"></i>' +
                                '<i class="rap-hero-orb"></i><i class="rap-hero-orb"></i>';
                        }

                        function rapSkeletonDescHTML() {
                            return '<div class="rap-skel-line w85"><div class="skeleton-shimmer-bar"></div></div>' +
                                '<div class="rap-skel-line w85" style="width:72%"><div class="skeleton-shimmer-bar"></div></div>' +
                                '<div class="rap-skel-line w35"><div class="skeleton-shimmer-bar"></div></div>';
                        }

                        function rapRenderHero() {
                            const host = document.getElementById('rapShowcase');
                            if (!host || !rapItems.length) return;
                            const movie = rapItems[rapIndex];
                            let hero = host.querySelector('.rap-hero');
                            if (!hero) {
                                hero = document.createElement('div');
                                hero.className = 'rap-hero';
                                host.insertBefore(hero, host.firstChild);
                            }
                            const img = getImgUrl(movie.thumb_url || movie.poster_url);
                            const fallback = getImgUrl(movie.poster_url || movie.thumb_url);
                            const cachedDesc = rapDescMemory.has(movie.slug) ? (rapDescMemory.get(movie.slug) || '') : null;
                            // Dải poster nằm BÊN TRONG ô hero, mà innerHTML sẽ xóa sạch con → giữ lại rồi gắn lại sau
                            const strip = host.querySelector('#rapStrip');
                            hero.innerHTML =
                                '<a class="rap-hero-media" href="/phim/' + movie.slug + '" title="' + String(movie.name || '').replace(/"/g, '&quot;') + '">' +
                                    '<img src="' + img + '" data-original-src="' + img + '" data-fallback="' + fallback + '" data-slug="' + (movie.slug || '') + '" data-title="' + String(movie.name || '').replace(/"/g, '&quot;') + '" data-origin="' + String(movie.origin_name || '').replace(/"/g, '&quot;') + '" alt="' + movie.name + '" loading="eager" fetchpriority="' + (rapIndex === 0 ? 'high' : 'auto') + '" decoding="async" referrerpolicy="no-referrer" onerror="window.handleCardImgError(this)" />' +
                                    '<span class="rap-hero-fade"></span>' +
                                    '<span class="rap-hero-grain"></span>' +
                                    '<span class="rap-hero-orbs">' + rapOrbsHTML() + '</span>' +
                                '</a>' +
                                '<div class="rap-hero-body">' + rapHeroBodyHTML(movie, cachedDesc) + '</div>';
                            if (strip) hero.appendChild(strip);
                            rapApplyBackdrop(movie, hero);

                            if (cachedDesc !== null) return;
                            rapEnsureDesc(movie).then(function (text) {
                                // Chỉ điền nếu người xem vẫn đang ở đúng phim (đừng ghi đè sau khi đã chuyển)
                                if (!rapItems[rapIndex] || rapItems[rapIndex].slug !== movie.slug) return;
                                const body = host.querySelector('.rap-hero-body');
                                if (body) body.innerHTML = rapHeroBodyHTML(movie, text || '');
                            });
                        }

                        function rapRenderStrip() {
                            const strip = document.getElementById('rapStrip');
                            if (!strip) return;
                            strip.innerHTML = rapItems.map(function (m, i) {
                                const poster = getImgUrl(m.poster_url || m.thumb_url);
                                return '<div class="rap-thumb' + (i === rapIndex ? ' active' : '') + '" data-rap-idx="' + i + '" title="' + String(m.name || '').replace(/"/g, '&quot;') + '">' +
                                    '<img src="' + poster + '" alt="' + m.name + '" loading="lazy" decoding="async" referrerpolicy="no-referrer" />' +
                                '</div>';
                            }).join('');
                        }

                        function rapRenderDots() {
                            const dots = document.getElementById('rapDots');
                            if (!dots) return;
                            dots.innerHTML = rapItems.map(function (m, i) {
                                return '<button type="button" class="rap-dot' + (i === rapIndex ? ' active' : '') + '" data-rap-idx="' + i + '" aria-label="' + String(m.name || '').replace(/"/g, '&quot;') + '"></button>';
                            }).join('');
                        }

                        function rapMarkActive() {
                            document.querySelectorAll('#rapStrip .rap-thumb, #rapDots .rap-dot').forEach(function (el) {
                                el.classList.toggle('active', Number(el.getAttribute('data-rap-idx')) === rapIndex);
                            });
                        }

                        function rapGo(nextIdx, byUser) {
                            if (!rapItems.length) return;
                            const n = rapItems.length;
                            rapIndex = ((nextIdx % n) + n) % n;
                            const host = document.getElementById('rapShowcase');
                            const hero = host && host.querySelector('.rap-hero');
                            if (hero) hero.classList.add('is-swapping');
                            setTimeout(function () {
                                rapRenderHero();
                                rapMarkActive();
                                const h2 = host && host.querySelector('.rap-hero');
                                if (h2) h2.classList.remove('is-swapping');
                            }, hero ? 180 : 0);
                            if (byUser) rapRestartRotate();
                        }

                        function rapRestartRotate() {
                            if (rapTimer) clearInterval(rapTimer);
                            rapTimer = setInterval(function () {
                                if (rapHoverPause || document.hidden) return;
                                rapGo(rapIndex + 1, false);
                            }, RAP_ROTATE_MS);
                        }

                        function rapToggleFav(btn, movie) {
                            if (!movie) return;
                            if (typeof authService !== 'undefined' && !authService.isLoggedIn()) {
                                if (typeof showAuthModal === 'function') showAuthModal('login');
                                return;
                            }
                            if (typeof userService === 'undefined') return;
                            if (userService.isFavorite(movie.slug)) {
                                userService.removeFromFavorites(movie.slug);
                                if (typeof showNotification === 'function') showNotification('Đã xóa khỏi danh sách yêu thích', 'info');
                            } else {
                                userService.addToFavorites({ slug: movie.slug, name: movie.name, thumb_url: movie.thumb_url, year: movie.year || '' });
                                if (typeof showNotification === 'function') showNotification('Đã thêm vào danh sách yêu thích', 'success');
                            }
                            const svg = btn.querySelector('svg');
                            const on = userService.isFavorite(movie.slug);
                            if (svg) {
                                svg.setAttribute('fill', on ? '#ef4444' : 'none');
                                svg.style.color = on ? '#ef4444' : '#fff';
                            }
                        }

                        async function loadRapShowcase() {
                            const host = document.getElementById('rapShowcase');
                            if (!host || rapItems.length) return;
                            try {
                                const core = await getAPhimCore();
                                const res = await core.fetchMovieGridData('list', 'phim-chieu-rap', 1);
                                const items = (res && res.items) ? res.items.slice(0, rapLimit()) : [];
                                if (!items.length) return;
                                rapItems = items;
                                rapIndex = 0;

                                if (!host.querySelector('#rapStrip')) {
                                    const strip = document.createElement('div');
                                    strip.id = 'rapStrip';
                                    strip.className = 'rap-strip';
                                    host.appendChild(strip);
                                }
                                if (!host.querySelector('#rapDots')) {
                                    const dots = document.createElement('div');
                                    dots.id = 'rapDots';
                                    dots.className = 'rap-dots';
                                    host.appendChild(dots);
                                }

                                rapRenderHero();
                                rapRenderStrip();
                                rapRenderDots();
                                rapRestartRotate();

                                // Warm sẵn mô tả + backdrop 2 phim kế tiếp để chuyển hero là có nội dung/ảnh nét ngay
                                (async function () {
                                    for (let k = 1; k <= 2 && k < rapItems.length; k++) {
                                        await rapEnsureDesc(rapItems[k]);
                                        rapEnsureBackdrop(rapItems[k]);
                                    }
                                })();

                                // Desktop: hover vào hero thì tạm dừng tự xoay
                                host.addEventListener('mouseenter', function () { rapHoverPause = true; });
                                host.addEventListener('mouseleave', function () { rapHoverPause = false; });

                                // 1 chạm: poster / dot / nút yêu thích (delegated, không cần onclick inline)
                                host.addEventListener('click', function (ev) {
                                    const pick = ev.target.closest('[data-rap-idx]');
                                    if (pick) {
                                        ev.preventDefault();
                                        rapGo(Number(pick.getAttribute('data-rap-idx')), true);
                                        return;
                                    }
                                    const fav = ev.target.closest('[data-rap-fav]');
                                    if (fav) {
                                        ev.preventDefault();
                                        rapToggleFav(fav, rapItems[rapIndex]);
                                    }
                                });

                                // Mobile: vuốt trái/phải trên hero để đổi phim
                                let rapTouchX = null;
                                host.addEventListener('touchstart', function (ev) {
                                    rapTouchX = ev.touches[0].clientX;
                                    rapHoverPause = true;
                                }, { passive: true });
                                host.addEventListener('touchend', function (ev) {
                                    if (rapTouchX === null) return;
                                    const dx = (ev.changedTouches[0] || {}).clientX - rapTouchX;
                                    rapTouchX = null;
                                    rapHoverPause = false;
                                    if (Math.abs(dx) > 48) rapGo(rapIndex + (dx < 0 ? 1 : -1), true);
                                }, { passive: true });
                            } catch (err) {
                                console.warn('Lỗi showcase phim chiếu rạp:', err);
                            }
                        }


