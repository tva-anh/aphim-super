                <!-- Dynamic PhimMoi Render Script -->
                <script>
                    (function () {
                        try {
                            for (let i = sessionStorage.length - 1; i >= 0; i--) {
                                const k = sessionStorage.key(i);
                                if (k && (k.startsWith('tmdb_card_poster_') || k.startsWith('aphim_sec_v2_') || k.startsWith('aphim_api_cache_'))) {
                                    sessionStorage.removeItem(k);
                                }
                            }
                        } catch (_) {}

                        const API_BASE = 'https://phimapi.com';

                        function getImgUrl(url, cdnDomain, width = 500, quality = 85) {
                            if (!url) return '';
                            let u = String(url).trim();
                            if (u.startsWith('data:image')) return u;
                            if (u.includes('wsrv.nl')) return u;

                            // Tự động gỡ bỏ nhân đôi tiền tố uploads/movies/upload/vod/...
                            u = u.replace(/(?:https?:\/\/[^\/]+)?\/?(?:uploads\/movies\/)+(upload\/vod\/)/, '$1');
                            u = u.replace(/^(?:uploads\/movies\/)+(upload\/vod\/)/, '$1');

                            let full = '';
                            if (u.startsWith('http://') || u.startsWith('https://')) {
                                full = u.replace('img.ophimimg.com', 'phimimg.com')
                                    .replace('ophim1.com/uploads', 'phimimg.com/uploads')
                                    .replace('img.phimapi.com', 'phimimg.com');
                            } else {
                                let clean = u.replace(/^\//, '');
                                clean = clean.replace(/^(uploads\/movies\/)+/, 'uploads/movies/');
                                clean = clean.replace(/^(upload\/vod\/)+/, 'upload/vod/');
                                if (clean.startsWith('img/')) {
                                    full = 'https://oncdn.vip/' + clean;
                                } else if (clean.startsWith('upload/') || clean.startsWith('uploads/')) {
                                    full = 'https://phimimg.com/' + clean;
                                } else if (clean.match(/^\d{8}-\d+\//)) {
                                    full = 'https://phimimg.com/upload/vod/' + clean;
                                } else if (clean.includes('.vn/') || clean.includes('.com/') || clean.includes('.org/') || clean.includes('.net/')) {
                                    full = 'https://' + clean;
                                } else {
                                    full = 'https://phimimg.com/uploads/movies/' + clean;
                                }
                            }

                            // Trả về trực tiếp ảnh gốc (phimimg.com đã được Cloudflare CDN phục vụ siêu tốc)
                            return full;
                        }

                        // 🛡️ ULTRA ROBUST SELF-HEALING IMAGE RESTORATION
                        window.handleCardImgError = function (imgEl) {
                            if (!imgEl) return;
                            const curSrc = imgEl.src || '';
                            if (!imgEl.dataset.triedOncdn && curSrc.includes('phimimg.com/uploads/movies/img/')) {
                                imgEl.dataset.triedOncdn = '1';
                                imgEl.src = curSrc.replace('phimimg.com/uploads/movies/img/', 'oncdn.vip/img/');
                                return;
                            }
                            const fallbackUrl = imgEl.dataset.fallback || '';
                            const currentSrc = imgEl.src || '';
                            const title = imgEl.dataset.title || imgEl.alt || '';
                            const originTitle = imgEl.dataset.origin || '';
                            const slug = imgEl.dataset.slug || '';
                            const originalSrc = imgEl.dataset.originalSrc || currentSrc;

                            // BƯỚC 1: Thử fallbackUrl (ví dụ thumb_url thay vì poster_url hoặc ngược lại)
                            if (!imgEl.dataset.triedFallback && fallbackUrl && fallbackUrl !== currentSrc && !fallbackUrl.includes('no-poster') && fallbackUrl.startsWith('http')) {
                                imgEl.dataset.triedFallback = '1';
                                imgEl.src = fallbackUrl;
                                return;
                            }

                            // BƯỚC 2: Thử direct source từ origin nếu CDN proxy gặp sự cố
                            if (!imgEl.dataset.triedDirect && originalSrc && originalSrc.includes('wsrv.nl')) {
                                imgEl.dataset.triedDirect = '1';
                                const m = originalSrc.match(/url=([^&]+)/);
                                if (m && m[1]) {
                                    try {
                                        let decoded = decodeURIComponent(m[1]);
                                        if (decoded.includes('url=')) {
                                            const m2 = decoded.match(/url=([^&]+)/);
                                            if (m2 && m2[1]) decoded = decodeURIComponent(m2[1]);
                                        }
                                        if (decoded && decoded.startsWith('http') && decoded !== currentSrc) {
                                            imgEl.src = decoded;
                                            return;
                                        }
                                    } catch (_) {}
                                }
                            }

                            // BƯỚC 2.5: Thử TMDB Fast CDN WebP Poster (30ms) nếu server nguồn bị đơ/chậm
                            if (!imgEl.dataset.triedTmdb && slug) {
                                imgEl.dataset.triedTmdb = '1';
                                try {
                                    const cached = sessionStorage.getItem('tmdb_card_poster_' + slug);
                                    if (cached && cached !== currentSrc) {
                                        imgEl.src = cached;
                                        return;
                                    }
                                    const q = originTitle || title || slug.replace(/-/g, ' ');
                                    if (q) {
                                        fetch(`/api/tmdb/search/multi?query=${encodeURIComponent(q)}`)
                                            .then(r => r.ok ? r.json() : null)
                                            .then(data => {
                                                const match = data?.results?.[0];
                                                const p = match?.poster_path || match?.backdrop_path;
                                                if (p && imgEl.isConnected) {
                                                    const tmdbImg = `https://image.tmdb.org/t/p/w300${p}`;
                                                    try { sessionStorage.setItem('tmdb_card_poster_' + slug, tmdbImg); } catch (_) {}
                                                    imgEl.src = tmdbImg;
                                                } else {
                                                    renderCardFallbackSvg(imgEl, title || originTitle, slug, originalSrc);
                                                }
                                            })
                                            .catch(() => renderCardFallbackSvg(imgEl, title || originTitle, slug, originalSrc));
                                        return;
                                    }
                                } catch (_) {}
                            }

                            // BƯỚC 3: Render SVG fallback thanh lịch với tên phim
                            renderCardFallbackSvg(imgEl, title || originTitle, slug, originalSrc);
                        };

                        function renderCardFallbackSvg(imgEl, title, slug, originalSrc) {
                            if (!imgEl) return;
                            imgEl.onerror = null;
                            const cleanTitle = (title || slug.replace(/-/g, ' ')).replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                            const isLight = document.documentElement.classList.contains('light-mode') || document.body.classList.contains('light-mode');
                            const stopColor1 = isLight ? '%23f8f6f0' : '%23181b24';
                            const stopColor2 = isLight ? '%23ece6da' : '%230f1218';
                            const circleFill = isLight ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.06)';
                            const playFill = isLight ? '%23ea580c' : '%23f59e0b';
                            const textColor = isLight ? '%23475569' : '%23e2e8f0';

                            imgEl.src = "data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='400' height='225' viewBox='0 0 400 225'%3E%3Cdefs%3E%3ClinearGradient id='bg' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='" + stopColor1 + "'/%3E%3Cstop offset='100%25' stop-color='" + stopColor2 + "'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='400' height='225' fill='url(%23bg)'/%3E%3Ccircle cx='200' cy='95' r='32' fill='" + circleFill + "'/%3E%3Cpath d='M192 82 L214 95 L192 108 Z' fill='" + playFill + "'/%3E%3Ctext x='200' y='160' text-anchor='middle' fill='" + textColor + "' font-family='sans-serif' font-size='14' font-weight='700'%3E" + encodeURIComponent(cleanTitle.slice(0, 32)) + "%3C/text%3E%3C/svg%3E";

                            // 🔄 Tự động phục hồi lại ảnh gốc khi mạng rảnh rỗi (sau 4s)
                            if (originalSrc && !originalSrc.startsWith('data:')) {
                                setTimeout(function () {
                                    if (!imgEl || !imgEl.isConnected) return;
                                    const idleProbe = new Image();
                                    idleProbe.onload = function () {
                                        if (imgEl && imgEl.isConnected) {
                                            imgEl.src = idleProbe.src;
                                            imgEl.removeAttribute('data-err-step');
                                        }
                                    };
                                    idleProbe.src = originalSrc;
                                }, 4000);
                            }
                        }

                        window.scrollSlider = function (amount) {
                            const slider = document.getElementById('slider-de-cu');
                            if (!slider) return;
                            const cardWidth = window.innerWidth < 640 ? 170 : 215;
                            const scrollStep = Math.sign(amount) * (cardWidth * 2);
                            slider.scrollBy({ left: scrollStep, behavior: 'smooth' });
                        };

                        window.scrollCinemaHotSlider = function (amount) {
                            if (typeof window.pauseCinemaHotOnUserAction === 'function') {
                                window.pauseCinemaHotOnUserAction();
                            }
                            const slider = document.getElementById('slider-cinema-hot');
                            if (!slider) return;

                            if (slider.classList.contains('cinema-hot-stage-mobile') && typeof window.updateCinemaHot3DStage === 'function') {
                                const total = (slider.querySelectorAll('.cinema-hot-card') || []).length;
                                if (total > 0) {
                                    if (amount > 0) {
                                        cinemaHotActiveIndex = (cinemaHotActiveIndex + 1) % total;
                                    } else {
                                        cinemaHotActiveIndex = (cinemaHotActiveIndex - 1 + total) % total;
                                    }
                                    window.updateCinemaHot3DStage(slider);
                                    if (typeof window.resumeCinemaHotAfterUserAction === 'function') {
                                        window.resumeCinemaHotAfterUserAction();
                                    }
                                    return;
                                }
                            }

                            const cardWidth = window.innerWidth < 640 ? 160 : 208;
                            const scrollStep = Math.sign(amount) * (cardWidth * 2);
                            slider.scrollBy({ left: scrollStep, behavior: 'smooth' });

                            if (typeof window.resumeCinemaHotAfterUserAction === 'function') {
                                clearTimeout(window._cinemaHotNavResumeTimer);
                                window._cinemaHotNavResumeTimer = setTimeout(() => {
                                    window.resumeCinemaHotAfterUserAction();
                                }, 600);
                            }
                        };

                        // 🎯 ICONIC PHIMMOI HOLLOW STROKE PLAY TRIANGLE
                        const PLAY_SVG_HTML = `<svg viewBox="0 0 24 24"><polygon points="7,4 19,12 7,20"/></svg>`;

                        // 🌟 CHECK XEM PHIM CÓ PHỤ ĐỀ SONG NGỮ KHÔNG
                        function isMovieBilingual(movie) {
                            if (!movie) return false;
                            if (movie.is_song_ngu || movie.has_bilingual) return true;
                            const lang = (movie.lang || '').toLowerCase();
                            if (lang.includes('song ngữ') || lang.includes('song ngu')) return true;
                            const slug = (movie.slug || '').toLowerCase().trim();
                            if (window.__BILINGUAL_SLUGS__ && window.__BILINGUAL_SLUGS__.has(slug)) return true;
                            if (window.APhimCore && typeof window.APhimCore.isBilingualSlug === 'function' && window.APhimCore.isBilingualSlug(slug)) return true;
                            return false;
                        }

                        // 🌟 BỘ NHÃN CAO CẤP MỚI (CHUẨN CHẤT NHƯ SONG NGỮ, KHÔNG CHE POSTER)
                        // 🌟 1. BADGES CHO CARD NGANG (PHIM BỘ MỚI CẬP NHẬT, PHIM CHIẾU RẠP, TOP 10, PHIM LẺ...)
                        // Hiển thị đầy đủ nhãn Tập, Vietsub, Thuyết minh, Lồng tiếng chuyên nghiệp ở góc trên bên trái
                        function renderCardBadgesHeader(movie, options = {}) {
                            const isSongNgu = isMovieBilingual(movie);
                            
                            // Nhãn Song Ngữ tím độc lập ở góc trên bên phải
                            const songNguHTML = isSongNgu ? `
                                <div class="badge-song-ngu-pill" title="Phim có phụ đề song ngữ chất lượng cao">
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor">
                                        <path d="m12.87 15.07-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7 1.62-4.33L19.12 17h-3.24z"/>
                                    </svg>
                                    <span>Song Ngữ</span>
                                </div>
                            ` : '';

                            const lang = (movie.lang || 'Vietsub').toLowerCase();
                            const epRaw = (movie.episode_current || movie.episode || '').trim();
                            const type = movie.type || '';

                            // Lọc bỏ placeholder "Song Ngữ", "FHD", "HD" để không bị lỗi "Tập Song Ngữ"
                            const isPlaceholder = epRaw.toLowerCase().includes('song ngữ') || 
                                                 epRaw.toLowerCase().includes('song ngu') || 
                                                 epRaw.toLowerCase() === 'fhd' || 
                                                 epRaw.toLowerCase() === 'hd';
                            const cleanEpRaw = isPlaceholder ? '' : epRaw;

                            const hasSub = lang.includes('sub') || lang.includes('phụ đề') || lang.includes('phu de') || lang.includes('vietsub') || (!lang.includes('thuyết minh') && !lang.includes('lồng tiếng'));
                            const hasTm = lang.includes('thuyết minh') || lang.includes('thuyet minh') || lang.includes('t.minh');
                            const hasLt = lang.includes('lồng tiếng') || lang.includes('long tieng') || lang.includes('l.tiếng');

                            let leftPills = [];

                            // 1. Rank #1..10 nếu có (Top 10)
                            if (options.rank) {
                                leftPills.push(`<span class="ap-badge-rank">#${options.rank}</span>`);
                            }

                            // 2. Star Score nếu có (Top 10)
                            if (options.starRating) {
                                leftPills.push(`
                                    <span class="ap-badge-score">
                                        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                                        <span>${options.starRating}</span>
                                    </span>
                                `);
                            }

                            // 3. Nhãn số tập / Full (Vàng Hoàng Kim) - Chống tuyệt đối lỗi "Tập Song Ngữ"
                            let num = '';
                            if (cleanEpRaw) {
                                const numMatch = cleanEpRaw.match(/(\d+)\s*\/\s*(\d+)/);
                                if (numMatch) {
                                    num = numMatch[1];
                                } else {
                                    const singleNumMatch = cleanEpRaw.match(/(?:tập|tap)?\s*(\d+)/i);
                                    if (singleNumMatch) {
                                        num = singleNumMatch[1];
                                    }
                                }
                            }

                            const isFull = !num && (
                                !cleanEpRaw ||
                                cleanEpRaw.toLowerCase().includes('full') || 
                                cleanEpRaw.toLowerCase().includes('hoàn tất') || 
                                cleanEpRaw.toLowerCase().includes('hoan tat') || 
                                type === 'single' || 
                                type === 'phim-le' ||
                                isPlaceholder
                            );

                            const epLabel = isFull ? 'Full' : (num ? `Tập ${num}` : (cleanEpRaw ? (cleanEpRaw.toLowerCase().startsWith('tập') ? cleanEpRaw : `Tập ${cleanEpRaw}`) : 'Full'));
                            leftPills.push(`<span class="ap-badge-gold">${epLabel}</span>`);

                            // 4. Nhãn Phụ đề / Vietsub (Xanh Mint Ngọc Lục Bảo) - nếu chưa có nhãn Song Ngữ hoặc muốn hiển thị
                            if (hasSub && !isSongNgu) {
                                leftPills.push(`<span class="ap-badge-mint">Vietsub</span>`);
                            }

                            // 5. Bổ sung Nhãn Thuyết minh nếu phim có (Xanh Cyan Điện Quang)
                            if (hasTm) {
