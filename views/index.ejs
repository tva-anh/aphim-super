                <!-- ==============================================
             SECTION 2: PHIM CHIẾU RẠP MỚI (SHOWCASE HERO + DẢI POSTER, kiểu "Thế giới Anime")
             ============================================== -->
                <style>
                    /* ============ SHOWCASE PHIM CHIẾU RẠP MỚI ============ */
                    .rap-showcase { position: relative; width: 100%; }

                    /* ---- Hero ---- */
                    .rap-hero {
                        position: relative; border-radius: 16px; overflow: hidden;
                        background: #0f1115; box-shadow: 0 10px 28px rgba(0, 0, 0, .30);
                    }
                    html.light-mode .rap-hero { background: #f5f0e6; box-shadow: 0 8px 22px rgba(150, 120, 70, .16); }
                    .rap-hero-media { display: block; position: relative; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; text-decoration: none; }
                    .rap-hero-media img {
                        position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 28%;
                        display: block; transition: opacity .3s ease, transform 6s ease;
                    }
                    /* MOBILE ONLY (desktop ≥1024px ghi đè .rap-hero-fade trong media query):
                       user đòi giảm tiếp lần 3 ("mờ nền kem ở mục này trên mobile bạn giảm xuống thêm") →
                       dải tan chỉ còn 10% chiều cao ảnh và alpha nhẹ hơn hẳn. */
                    .rap-hero-fade {
                        position: absolute; inset: 0; pointer-events: none;
                        background: linear-gradient(to top, #0f1115 0%, rgba(15, 17, 21, .55) 3%, rgba(15, 17, 21, .14) 6%, transparent 10%);
                    }
                    html.light-mode .rap-hero-fade {
                        background: linear-gradient(to top, #f5f0e6 0%, rgba(245, 240, 230, .55) 3%, rgba(245, 240, 230, .14) 6%, transparent 10%);
                    }
                    .rap-hero-body { position: relative; z-index: 3; padding: 0 16px 18px; color: #1c1917; }
                    html:not(.light-mode) .rap-hero-body { color: #f5f5f4; }
                    .rap-hero-title { font-family: 'Nunito', 'Be Vietnam Pro', sans-serif; font-size: 21px; font-weight: 900; line-height: 1.3; letter-spacing: 0; margin: 0; }
                    .rap-hero-title a { color: inherit; text-decoration: none; }
                    .rap-hero-origin { font-family: 'Nunito', 'Be Vietnam Pro', sans-serif; font-size: 14px; font-weight: 800; color: #ea580c; margin-top: 6px; }
                    html:not(.light-mode) .rap-hero-origin { color: #fbbf24; }
                    .rap-hero-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; margin-top: 14px; }
                    .rap-chip {
                        font-family: 'Nunito', 'Be Vietnam Pro', sans-serif;
                        display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 800;
                        padding: 4px 11px; border-radius: 7px; border: 1.5px solid rgba(28, 25, 23, .55); color: inherit; line-height: 1.4;
                    }
                    html:not(.light-mode) .rap-chip { border-color: rgba(245, 245, 244, .55); }
                    /* Chip TMDB 2 mảnh trên mobile: wrapper phải padding:0 (rule này đứng SAU .rap-chip nên thắng)
                       + stretch để 2 mảnh cao bằng nhau + tự bo góc từng mảnh, không nhờ overflow:hidden. */
                    .rap-chip.rap-chip-tmdb { border: none; padding: 0; gap: 0; overflow: hidden; background: none; border-radius: 7px; align-items: stretch; }
                    .rap-chip.rap-chip-tmdb .tmdb-k { display: flex; align-items: center; background: linear-gradient(90deg, #0284c7, #22d3ee); color: #fff; font-weight: 900; padding: 4px 10px; border-radius: 7px 0 0 7px; }
                    .rap-chip.rap-chip-tmdb .tmdb-v { display: flex; align-items: center; background: rgba(2, 10, 18, .72); color: #fff; font-weight: 900; padding: 4px 11px; border: 1.5px solid rgba(255, 255, 255, .38); border-left: none; border-radius: 0 7px 7px 0; }
                    .rap-chip.rap-chip-tmdb b { font-weight: 900; }
                    .rap-hero-genres { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 13px; }
                    .rap-genre {
                        font-family: 'Nunito', 'Be Vietnam Pro', sans-serif;
                        font-size: 12px; font-weight: 700; padding: 5px 13px; border-radius: 8px;
                        background: rgba(120, 113, 108, .16); color: #57534e;
                    }
                    html:not(.light-mode) .rap-genre { background: rgba(255, 255, 255, .12); color: #e7e5e4; }
                    .rap-hero-desc {
                        font-family: 'Be Vietnam Pro', 'Inter', sans-serif;
                        margin: 14px 0 0; font-size: 13.5px; line-height: 1.7; color: #44403c;
                        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
                    }
                    html:not(.light-mode) .rap-hero-desc { color: rgba(245, 245, 244, .82); }
                    .rap-hero-actions { display: none; align-items: center; gap: 12px; margin-top: 18px; }
                    .rap-play {
                        width: 54px; height: 54px; border-radius: 50%; flex: 0 0 auto;
                        display: flex; align-items: center; justify-content: center; text-decoration: none;
                        background: radial-gradient(circle at 32% 28%, #fde68a, #f59e0b 62%, #d97706);
                        box-shadow: 0 8px 22px rgba(245, 158, 11, .42); transition: transform .2s ease, box-shadow .2s ease;
                    }
                    .rap-play:hover { transform: scale(1.07); box-shadow: 0 12px 28px rgba(245, 158, 11, .55); }
                    .rap-play svg { width: 22px; height: 22px; fill: #291a05; margin-left: 3px; }
                    .rap-soft-btns {
                        display: flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 999px;
                        background: rgba(255, 255, 255, .10); border: 1px solid rgba(255, 255, 255, .18);
                    }
                    .rap-soft-btn {
                        width: 34px; height: 30px; display: flex; align-items: center; justify-content: center;
                        background: none; border: none; color: #fff; cursor: pointer; text-decoration: none; opacity: .9;
                    }
                    .rap-soft-btn:hover { opacity: 1; }
                    .rap-soft-btn svg { width: 17px; height: 17px; }
                    .rap-soft-divider { width: 1px; height: 18px; background: rgba(255, 255, 255, .22); }
                    .rap-hero.is-swapping .rap-hero-media img,
                    .rap-hero.is-swapping .rap-hero-body { opacity: .25; }

                    /* ---- Dải poster (desktop) + dots (mobile) ---- */
                    .rap-strip { display: none; }
                    .rap-thumb {
                        flex: 0 0 auto; width: 88px; border-radius: 10px; overflow: hidden; cursor: pointer;
                        opacity: .52; transition: opacity .25s ease, transform .25s ease, box-shadow .25s ease; background: #14161b;
                    }
                    .rap-thumb img { display: block; width: 100%; aspect-ratio: 2 / 3; object-fit: cover; }
                    .rap-thumb:hover { opacity: .85; }
                    .rap-thumb.active { opacity: 1; transform: translateY(-6px) scale(1.05); box-shadow: 0 0 0 2px rgba(255, 255, 255, .92), 0 12px 24px rgba(0, 0, 0, .42); }
                    .rap-dots { display: flex; flex-wrap: wrap; justify-content: center; gap: 7px; margin-top: 12px; padding: 0 8px; }
                    .rap-dot { width: 8px; height: 8px; border-radius: 999px; background: rgba(120, 113, 108, .35); border: none; padding: 0; cursor: pointer; transition: all .25s ease; }
                    html:not(.light-mode) .rap-dot:not(.active) { background: rgba(255, 255, 255, .22); }
                    .rap-dot.active { width: 20px; background: #f59e0b; }

                    /* ---- Lớp trang trí nền (chỉ bật ở desktop, mobile ẩn hoàn toàn) ---- */
                    /* .rap-hero-grain = lớp chấm li ti trên ẢNH NỀN (user yêu cầu bật lại cho lớp ảnh này) */
                    .rap-hero-grain, .rap-hero-orbs { display: none; }
                    .rap-hero-grain {
                        position: absolute; inset: 0; z-index: 2; pointer-events: none;
                        background-image: radial-gradient(rgba(255, 255, 255, .5) .6px, transparent .85px);
                        background-size: 3px 3px; opacity: .085;
                    }
                    .rap-hero-orbs { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
                    .rap-hero-orb {
                        position: absolute; border-radius: 50%; filter: blur(10px); opacity: .34;
                        background: radial-gradient(circle at 35% 30%, rgba(253, 230, 138, .95), rgba(245, 158, 11, .34) 58%, transparent 74%);
                        animation: rapOrbFloat 15s ease-in-out infinite;
                    }
                    .rap-hero-orb:nth-child(1) { width: 54px; height: 54px; left: 52%; top: 18%; animation-duration: 16s; }
                    .rap-hero-orb:nth-child(2) { width: 30px; height: 30px; left: 68%; top: 44%; animation-duration: 12s; animation-delay: -4s; }
                    .rap-hero-orb:nth-child(3) { width: 22px; height: 22px; left: 40%; top: 66%; animation-duration: 19s; animation-delay: -8s; }
                    .rap-hero-orb:nth-child(4) { width: 38px; height: 38px; left: 82%; top: 24%; animation-duration: 14s; animation-delay: -2s; }
                    .rap-hero-orb:nth-child(5) { width: 16px; height: 16px; left: 62%; top: 74%; animation-duration: 11s; animation-delay: -6s; }
                    @keyframes rapOrbFloat {
                        0%, 100% { transform: translate3d(0, 0, 0); opacity: .20; }
                        50%      { transform: translate3d(-22px, -30px, 0); opacity: .42; }
                    }
                    @media (prefers-reduced-motion: reduce) { .rap-hero-orb { animation: none; } }

                    /* ---- DESKTOP ≥1024px: ảnh phủ toàn khung, chữ đè nửa trái, có nút Play + dải poster ---- */
                    @media (min-width: 1024px) {
                        /* Khung là ô bo góc GỌN GÀNG, ảnh cắt thẳng ở mép dưới (KHÔNG mask tan ra nền):
                           vệt tan tối màu trên nền kem bị user gọi là "mờ đen lan xuống dưới mép" → đã bỏ hẳn.
                           Dải poster vẫn nhô ra ngoài vì .rap-hero để overflow:visible, chỉ .rap-hero-media mới clip. */
                        .rap-hero, html.light-mode .rap-hero {
                            height: 540px; overflow: visible; background: transparent; box-shadow: none; border-radius: 0;
