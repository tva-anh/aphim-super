        <!-- ==============================================
             SECTION 1.5: BẢNG XẾP HẠNG PHIM HOT (HORIZONTAL 10-ITEM SHOWCASE MATCHING USER IMAGE)
             ============================================== -->
        <section style="margin-top: 24px; margin-bottom: 24px;">
            <div class="section-header">
                <div class="section-header-left">
                    <h2 class="section-header-title">
                        BẢNG XẾP HẠNG PHIM HOT
                    </h2>
                    <div class="section-header-tabs">
                        <button type="button" onclick="switchRankingTab(this, 'phim-bo')" class="section-header-tab active">Phim Bộ</button>
                        <button type="button" onclick="switchRankingTab(this, 'phim-le')" class="section-header-tab inactive">Phim Lẻ</button>
                        <button type="button" onclick="switchRankingTab(this, 'phim-moi-cap-nhat')" class="section-header-tab inactive">Mới Cập Nhật</button>
                        <button type="button" onclick="switchRankingTab(this, 'hoat-hinh')" class="section-header-tab inactive">Hoạt Hình</button>
                    </div>
                </div>
            </div>

            <div id="grid-bang-xep-hang" class="ranking-grid-container">
                <div class="col-span-full py-12 flex items-center justify-center text-gray-400">
                    <div class="inline-block w-8 h-8 border-4 border-[#ff9900] border-t-transparent rounded-full animate-spin"></div>
                    <span class="ml-3 text-sm font-medium">Đang tải Bảng Xếp Hạng...</span>
                </div>
            </div>
        </section>



        <!-- ==============================================
             SECTION 2: PHIM CHIẾU RẠP MỚI
             ============================================== -->
        <section>
            <div class="section-header">
                <div class="section-header-left">
                    <h2 class="section-header-title">PHIM CHIẾU RẠP MỚI</h2>
                    <div class="section-header-tabs">
                        <a href="#" class="section-header-tab active">Mới cập nhật</a>
                    </div>
                </div>
            </div>

            <div id="grid-chieu-rap" class="phimmoi-section-grid">
                <div class="animate-pulse bg-gray-800 w-full h-[210px] rounded-lg"></div>
            </div>
        </section>


        <!-- ==============================================
             SECTION 3: PHIM LẺ MỚI CẬP NHẬT
             ============================================== -->
        <section>
            <div class="section-header">
                <div class="section-header-left">
                    <h2 class="section-header-title">PHIM LẺ MỚI CẬP NHẬT</h2>
                    <div class="section-header-tabs">
                        <button type="button" onclick="switchSectionTab(this, 'grid-phim-le', 'https://phimapi.com/v1/api/danh-sach/phim-le?page=1')" class="section-header-tab active">Mới cập nhật</button>
                        <button type="button" onclick="switchSectionTab(this, 'grid-phim-le', 'https://phimapi.com/v1/api/the-loai/hanh-dong?page=1')" class="section-header-tab inactive">Hành Động</button>
                        <button type="button" onclick="switchSectionTab(this, 'grid-phim-le', 'https://phimapi.com/v1/api/the-loai/hoat-hinh?page=1')" class="section-header-tab inactive">Hoạt Hình</button>
                        <button type="button" onclick="switchSectionTab(this, 'grid-phim-le', 'https://phimapi.com/v1/api/the-loai/kinh-di?page=1')" class="section-header-tab inactive">Kinh Dị</button>
