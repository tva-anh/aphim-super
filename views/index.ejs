                        // 🚀 SIÊU ĐỘNG CƠ XẾP HẠNG TOP #10 TỨC THÌ (0ms INSTANT IN-MEMORY ENGINE)
                        let _top10IsFetching = false;

                        async function fetchTop10Data(forceRefresh = false) {
                            const gridEl = document.getElementById('grid-top-10');
                            if (!gridEl) return;

                            const cacheKey = `${currentTop10Platform}_${currentTop10Type}_${currentTop10Region}`;
                            const sessionKey = `aphim_top10_v1_${cacheKey}`;

                            // ⚡ 1. SIÊU TỐC: Trả kết quả ngay lập tức trong 0ms từ bộ nhớ Cache (RAM + SessionStorage)
                            let cachedMovies = _top10MemoryCache.get(cacheKey);
                            if (!cachedMovies) {
                                try {
                                    const saved = sessionStorage.getItem(sessionKey);
                                    if (saved) {
                                        cachedMovies = JSON.parse(saved);
                                        _top10MemoryCache.set(cacheKey, cachedMovies);
                                    }
                                } catch (e) { }
                            }
                            if (!forceRefresh && cachedMovies && cachedMovies.length) {
                                gridEl.innerHTML = cachedMovies.map((m, idx) => createTop10CardHTML(m, idx)).join('');
                                return;
                            }

                            // Nếu đã có phim cũ đang hiển thị, giữ nguyên và chỉ thêm hiệu ứng nhẹ, không xoá trắng gây giật
                            if (!gridEl.children.length || gridEl.querySelector('.animate-spin')) {
                                gridEl.innerHTML = `
                    <div class="col-span-full py-10 flex items-center justify-center text-gray-400">
                        <div class="inline-block w-7 h-7 border-3 border-[#38bdf8] border-t-transparent rounded-full animate-spin"></div>
                        <span class="ml-3 text-sm font-semibold tracking-wide">Đang nạp nhanh TOP #10...</span>
                    </div>
                `;
                            }

                            try {
                                const core = await getAPhimCore();
                                const platformInfo = PLATFORM_SIGNATURES[currentTop10Platform] || PLATFORM_SIGNATURES['netflix'];
                                const pool = [];
                                const seen = new Set();

                                // ⚡ 2. TỐI ƯU HÓA: Tải song song nhanh kho phim chính theo luồng
                                if (currentTop10Region === 'toan-cau') {
                                    // Luồng Toàn Cầu: Lấy 2 trang đầu của danh mục + 4 từ khóa hot nhất
                                    const queryList = (currentTop10Type === 'phim-le') ? (platformInfo.phimLe || []) : (platformInfo.phimBo || []);
                                    const fastQueries = queryList.slice(0, 4);

                                    const searchPromises = fastQueries.map(kw =>
                                        core.fetchMovieGridData('search', kw, 1).then(r => (r && r.items && r.items[0]) ? r.items[0] : null).catch(() => null)
                                    );

                                    const [searchResults, listP1, listP2] = await Promise.all([
                                        Promise.all(searchPromises),
                                        core.fetchMovieGridData('list', currentTop10Type, 1).catch(() => ({ items: [] })),
                                        core.fetchMovieGridData('list', currentTop10Type, 2).catch(() => ({ items: [] }))
                                    ]);

                                    for (const m of searchResults) {
                                        if (m && m.slug && !seen.has(m.slug)) {
                                            seen.add(m.slug);
                                            m._isPlatformExclusive = true;
                                            pool.push(m);
                                        }
                                    }

                                    const combinedList = [...(listP1.items || []), ...(listP2.items || [])];
                                    for (const m of combinedList) {
                                        if (m && m.slug && !seen.has(m.slug)) {
                                            seen.add(m.slug);
                                            pool.push(m);
                                        }
                                    }
                                } else {
                                    // Luồng Quốc Gia: Lấy trực tiếp danh sách quốc gia (Trang 1 & 2) + 3 hit quốc gia
                                    const countryKwList = COUNTRY_HIT_QUERIES[currentTop10Region] || [];
                                    const fastCountryQueries = countryKwList.slice(0, 3);

                                    const searchPromises = fastCountryQueries.map(kw =>
                                        core.fetchMovieGridData('search', kw, 1).then(r => (r && r.items && r.items[0]) ? r.items[0] : null).catch(() => null)
                                    );

                                    const [searchResults, countryP1, countryP2] = await Promise.all([
                                        Promise.all(searchPromises),
                                        core.fetchMovieGridData('country', currentTop10Region, 1).catch(() => ({ items: [] })),
                                        core.fetchMovieGridData('country', currentTop10Region, 2).catch(() => ({ items: [] }))
                                    ]);

                                    for (const m of searchResults) {
                                        if (m && m.slug && !seen.has(m.slug)) {
                                            seen.add(m.slug);
                                            m._isCountryHit = true;
                                            pool.push(m);
                                        }
                                    }

                                    const combinedCountry = [...(countryP1.items || []), ...(countryP2.items || [])];
                                    for (const m of combinedCountry) {
                                        if (m && m.slug && !seen.has(m.slug)) {
                                            seen.add(m.slug);
                                            pool.push(m);
                                        }
                                    }
                                }

                                // ⚡ 3. LỌC ĐÚNG LOẠI PHIM & CHẤM ĐIỂM XẾP HẠNG
                                const scoredMovies = pool
                                    .filter(movie => {
                                        if (!movie || !movie.slug) return false;
                                        const ep = (movie.episode_current || movie.episode || '').toLowerCase();
                                        const isSingle = (movie.type === 'single' || ep.includes('full'));
                                        if (currentTop10Type === 'phim-le') return isSingle;
                                        if (currentTop10Type === 'phim-bo') return !isSingle;
                                        return true;
                                    })
                                    .map((movie, idx) => {
                                        let score = 0;

                                        if (movie._isPlatformExclusive || movie._isCountryHit) {
                                            score += 150;
                                        }

                                        // Đánh giá sao & độ thịnh hành
                                        const rawRating = parseFloat(movie.tmdb?.vote_average || movie.rating || movie.imdb_rating || 0);
                                        if (rawRating > 0) {
                                            score += (rawRating * 16);
                                            movie.starRating = rawRating.toFixed(1);
                                        } else {
                                            const genStar = (9.9 - (idx * 0.08) - (Math.random() * 0.12)).toFixed(1);
                                            movie.starRating = Math.max(8.5, Math.min(9.9, parseFloat(genStar))).toFixed(1);
                                            score += (parseFloat(movie.starRating) * 12);
                                        }

                                        // Năm phát hành
                                        const year = parseInt(movie.year || '2024', 10);
                                        if (year >= 2026) score += 40;
                                        else if (year >= 2025) score += 30;
                                        else if (year >= 2024) score += 20;

                                        return { movie, score };
                                    });

                                scoredMovies.sort((a, b) => b.score - a.score);

                                const top10 = scoredMovies.slice(0, 10).map((item, idx) => {
                                    const m = item.movie;
                                    if (!m.starRating || parseFloat(m.starRating) < 8.5) {
                                        m.starRating = (9.9 - (idx * 0.12)).toFixed(1);
                                    }
                                    return m;
                                });

                                // Lưu vào memory cache & sessionStorage để lần bấm sau / quay lại trang đạt 0ms
                                _top10MemoryCache.set(cacheKey, top10);
                                try { sessionStorage.setItem(sessionKey, JSON.stringify(top10)); } catch (e) { }

                                if (gridEl && top10.length) {
                                    gridEl.innerHTML = top10.map((m, idx) => createTop10CardHTML(m, idx)).join('');
                                }
                            } catch (err) {
                                console.warn('Lỗi load nhanh TOP #10:', err);
                            }
                        }

                        // 🚀 PRELOAD NGẦM CÁC TAB KẾ TIẾP ĐỂ BẤM LÀ NẨY NGAY LẬP TỨC
