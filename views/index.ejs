        html.light-mode .top10-platform-pill[data-platform="amc"] { background: #ffe4e6 !important; color: #be123c !important; border-color: #fecdd3 !important; }
        html.light-mode .top10-platform-pill[data-platform="amc"].active { background: #be123c !important; color: #ffffff !important; border-color: #be123c !important; }

