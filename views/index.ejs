<!DOCTYPE html>
<html lang="vi">

<head>
    <%- include('partials/head') %>
        <% const _hero0Img=(typeof heroSlides !=='undefined' && Array.isArray(heroSlides) && heroSlides[0]) ?
            (heroSlides[0].rawImageUrl || heroSlides[0].imageUrl) : null; if (_hero0Img) { %>
            <link rel="preload" as="image" href="<%= _hero0Img %>" fetchpriority="high">
            <% } %>
        <% const _hero1Img=(typeof heroSlides !=='undefined' && Array.isArray(heroSlides) && heroSlides[1]) ?
            (heroSlides[1].rawImageUrl || heroSlides[1].imageUrl || heroSlides[1].thumb_url) : null; if (_hero1Img) { %>
            <link rel="prefetch" as="image" href="<%= _hero1Img %>">
            <% } %>
                <link rel="preconnect" href="https://image.tmdb.org" crossorigin>
                <link rel="preconnect" href="https://phimimg.com" crossorigin>
                <link rel="preconnect" href="https://static-cgv.vncdn.vn" crossorigin>
                <link rel="stylesheet" href="/css/avatar-frames.css">
                <link rel="stylesheet" href="/css/mobile-3d-showcase.css?v=23">
                <link rel="stylesheet" href="/css/hero-banner.css?v=191">
                <link rel="stylesheet" href="/css/interests-section.css?v=171">
                <link
                    href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Playfair+Display:wght@600;700;800&display=swap"
                    rel="stylesheet">
                <style>
                    /* Desktop Hero: 0px body padding on Desktop so hero image bleeds to browser top */
                    @media (min-width: 1024px) {
                        body,
                        body.has-desktop-hero,
                        html.light-mode body,
                        html.light-mode body.has-desktop-hero,
                        body:has(#desktopHeroShowcase),
                        html.light-mode body:has(#desktopHeroShowcase) {
                            padding-top: 0 !important;
                        }

                        /* Transparent Header on Homepage (Desktop Hero Only) */
                        #sofa-header:not(.scrolled),
                        header#sofa-header:not(.scrolled),
                        header:not(.scrolled),
                        html.light-mode #sofa-header:not(.scrolled),
                        html.light-mode header#sofa-header:not(.scrolled),
                        body.has-desktop-hero #sofa-header:not(.scrolled),
                        html.light-mode body.has-desktop-hero #sofa-header:not(.scrolled),
                        body:has(#desktopHeroShowcase) #sofa-header:not(.scrolled),
                        html.light-mode body:has(#desktopHeroShowcase) #sofa-header:not(.scrolled) {
                            background: transparent !important;
                            background-color: transparent !important;
                            backdrop-filter: none !important;
                            -webkit-backdrop-filter: none !important;
                            border: none !important;
                            border-bottom: none !important;
                            box-shadow: none !important;
                        }
                    }

                    @media (max-width: 1023px) {
                        body,
                        body.has-desktop-hero,
                        body:has(#desktopHeroShowcase),
                        html.light-mode body,
                        html.light-mode body:has(#desktopHeroShowcase) {
                            padding-top: 64px !important;
                        }
                    }

                    @media (max-width: 480px) {
                        body,
                        body.has-desktop-hero,
                        body:has(#desktopHeroShowcase),
                        html.light-mode body,
                        html.light-mode body:has(#desktopHeroShowcase) {
                            padding-top: 60px !important;
                        }
                    }

                        /* Horizontal Carousel Slider for PHIM MỚI ĐỀ CỬ (Scrollbar Completely Hidden) */
                        .de-cu-slider {
                            display: flex !important;
                            align-items: flex-start !important;
                            gap: 12px !important;
                            overflow-x: auto !important;
                            scroll-behavior: auto !important;
                            padding-bottom: 5px !important;
                            scrollbar-width: none !important;
                            /* Firefox */
                            -ms-overflow-style: none !important;
                            /* IE/Edge */
                            -webkit-overflow-scrolling: touch !important;
                            touch-action: pan-x pan-y !important;
                            overscroll-behavior-x: contain !important;
                        }

                        .de-cu-slider::-webkit-scrollbar {
                            display: none !important;
                            /* Chrome, Safari, Opera */
                            width: 0 !important;
                            height: 0 !important;
                        }

                        .badge-trend {
                            height: 18px !important;
                            min-height: 18px !important;
                            max-height: 18px !important;
                            line-height: 18px !important;
                            display: inline-flex !important;
                            flex-direction: row !important;
                            align-items: center !important;
                            justify-content: center !important;
                            gap: 2px !important;
                            background: linear-gradient(135deg, #ef4444, #f97316) !important;
                            color: #ffffff !important;
                            font-size: 8.5px !important;
                            font-weight: 800 !important;
                            padding: 0 4.5px !important;
                            border-radius: 4px !important;
                            text-transform: uppercase !important;
                            letter-spacing: 0.2px !important;
                            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3) !important;
                            border: none !important;
                            white-space: nowrap !important;
                            flex-shrink: 0 !important;
                        }
                        .badge-trend-icon {
                            font-size: 9.5px !important;
                            line-height: 1 !important;
                            display: inline-block !important;
                        }

                        /* ── HUY HIỆU TRENDS 24H TRÊN HEADER SLIDER ĐỀ CỬ: BỎ VIỀN BỌC 100% TRÊN NỀN ĐEN & NỀN TRẮNG ── */
                        .trends-24h-badge,
                        html.light-mode .trends-24h-badge {
                            border: none !important;
                            outline: none !important;
                            box-shadow: none !important;
                            -webkit-box-shadow: none !important;
                        }
                        html.light-mode .trends-24h-badge {
                            color: #ea580c !important;
                            background: rgba(249, 115, 22, 0.12) !important;
                        }

                        /* ── SECTION 0.2: ĐÁNG XEM TUẦN NÀY (MOMO CINEMA HOT SHOWCASE) ── */
                        .cinema-hot-slider {
                            display: flex !important;
                            align-items: flex-start !important;
                            gap: 14px !important;
                            overflow-x: auto !important;
                            scroll-behavior: auto !important;
                            padding-top: 6px !important;
                            padding-bottom: 8px !important;
                            scrollbar-width: none !important;
                            -ms-overflow-style: none !important;
                            -webkit-overflow-scrolling: touch !important;
                            touch-action: pan-x pan-y !important;
                            overscroll-behavior-x: contain !important;
                        }
                        .cinema-hot-slider::-webkit-scrollbar {
                            display: none !important;
                            width: 0 !important;
                            height: 0 !important;
                        }
                        .cinema-hot-card {
                            flex: 0 0 162px !important;
                            width: 162px !important;
                            max-width: 162px !important;
                            align-self: flex-start !important;
                            background: transparent !important;
                            border: none !important;
                            text-decoration: none !important;
                            display: block !important;
                            transition: transform 0.25s ease !important;
                            content-visibility: auto !important;
                            contain-intrinsic-size: 162px 280px !important;
                        }
                        /* 🌊 GIAO DIỆN GỢN SÓNG (WAVE CAROUSEL) TRÊN DESKTOP CHUẨN ẢNH SỐ 2 (NẰM TRÊN CÙNG 1 HÀNG) */
                        @media (min-width: 640px) {
                            .cinema-hot-slider {
                                padding-top: 26px !important;
                                padding-bottom: 20px !important;
                                overflow-y: visible !important;
                                gap: 10px !important; /* Đồng bộ khoảng cách 10px như slider Phim Mới Đề Cử */
                                align-items: flex-start !important;
                            }
                            #cinemaHotSection {
                                overflow: visible !important;
                            }
                            .cinema-hot-card {
                                flex: 0 0 198px !important; /* To bằng mục Phim Mới Đề Cử (198px) */
                                width: 198px !important;
                                max-width: 198px !important;
                                contain-intrinsic-size: 198px 360px !important;
                                display: flex !important;
                                flex-direction: column !important;
                                justify-content: flex-start !important;
                                position: relative !important;
                                margin: 0 !important;
                                transform: none !important; /* Toàn bộ thẻ nằm trên cùng 1 hàng phẳng */
                            }
                            .cinema-hot-poster-wrap {
                                border-radius: 12px !important;
                                overflow: hidden !important;
                                transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), 
                                            box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1) !important;
                                will-change: transform !important;
                                transform-origin: center center !important;
                            }
                            .cinema-hot-info-wrap {
                                margin-top: 14px !important;
                                position: relative !important;
                                z-index: 5 !important;
                            }

                            /* 🌊 Nhịp sóng trên cùng 1 hàng: Chuẩn 100% hướng sóng theo hình số 1 mẫu */
                            /* Thẻ lẻ (1, 3, 5, 7...): Bên trái nhô lên cao, bên phải hạ xuống thấp */
                            .cinema-hot-card:nth-child(odd) .cinema-hot-poster-wrap {
                                transform: skewY(3.4deg);
                            }
                            /* Thẻ chẵn (2, 4, 6, 8...): Bên trái hạ xuống thấp (nối tiếp điểm thấp của thẻ 1), bên phải nhô lên cao */
                            .cinema-hot-card:nth-child(even) .cinema-hot-poster-wrap {
                                transform: skewY(-3.4deg);
                            }

                            /* Hiệu ứng Hover: Đứng thẳng hoàn chỉnh, trồi lên mượt mà - TRIỆT TIÊU 100% ÁNH XẠ / BÓNG ĐEN */
                            .cinema-hot-card:hover {
                                z-index: 30 !important;
                            }
                            .cinema-hot-card:hover .cinema-hot-poster-wrap,
                            html.light-mode .cinema-hot-card:hover .cinema-hot-poster-wrap {
                                transform: skewY(0deg) translateY(-8px) scale(1.04) !important;
                                box-shadow: none !important;
                                -webkit-box-reflect: none !important;
                                filter: none !important;
                                z-index: 30 !important;
                            }

                            /* Thẻ Xem Tất Cả cuối slider */
                            .cinema-hot-card.cinema-hot-more-card .cinema-hot-more-inner {
                                border-radius: 12px !important;
                                transform: skewY(3.4deg);
                                box-shadow: none !important;
                                -webkit-box-reflect: none !important;
                                filter: none !important;
                                transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1) !important;
                            }
                            .cinema-hot-card.cinema-hot-more-card:hover .cinema-hot-more-inner {
                                transform: skewY(0deg) translateY(-8px) scale(1.04) !important;
                                box-shadow: none !important;
                                -webkit-box-reflect: none !important;
                                filter: none !important;
                            }
                        }

                        /* ── Áp dụng gợn sóng cho PHIM MỚI ĐỀ CỬ (CẢ TRÊN MOBILE VÀ DESKTOP): Mép dưới NGANG BẰNG 100%, Mép trên gợn sóng ── */
                        .de-cu-slider {
                            display: flex !important;
                            overflow-x: auto !important;
                            overflow-y: visible !important;
                            padding-top: 24px !important;
                            padding-bottom: 6px !important; /* Thu gọn khoảng cách đệm dưới đáy trên Mobile */
                            gap: 10px !important; /* Khoảng cách sát nhau hài hoà */
                            align-items: flex-end !important; /* Mép dưới các thẻ ngang bằng tuyệt đối trên cùng 1 đường thẳng */
                        }
                        .de-cu-card {
                            flex: 0 0 192px !important; /* To hơn, cân đối và nổi bật trên Mobile */
                            width: 192px !important;
                            max-width: 192px !important;
                            display: flex !important;
                            flex-direction: column !important;
                            justify-content: flex-end !important;
                            position: relative !important;
                            margin: 0 !important;
                            transform: none !important;
                        }
                        @media (min-width: 640px) {
                            .de-cu-slider {
                                padding-top: 26px !important;
                                padding-bottom: 16px !important;
                            }
                            .de-cu-card {
                                flex: 0 0 205px !important; /* To rộng rãi, hiển thị ấn tượng trên Desktop */
                                width: 205px !important;
                                max-width: 205px !important;
                            }
                        }
                        .de-cu-poster-wrap {
                            border-radius: 12px !important;
                            overflow: hidden !important;
                            box-shadow: none !important;
                            -webkit-box-reflect: none !important;
                            filter: none !important;
                            transform-origin: center center !important;
                            transition: transform 0.28s cubic-bezier(0.25, 1, 0.5, 1), filter 0.28s cubic-bezier(0.25, 1, 0.5, 1) !important;
                            will-change: transform, filter !important;
                        }
                        .de-cu-card .de-cu-top-badges {
                            position: absolute !important;
                            left: 7px !important;
                            right: 7px !important;
                            display: flex !important;
                            flex-direction: row !important;
                            flex-wrap: nowrap !important;
                            align-items: center !important;
                            gap: 2px !important;
                            z-index: 10 !important;
                            pointer-events: none !important;
                            overflow: visible !important;
                            transform-origin: left center !important;
                        }
                        /* Thẻ lẻ (1, 3, 5...): Mép trên dốc xéo xuống -> Hàng nhãn nghiêng xéo xuống theo khung hình */
                        .de-cu-card:nth-child(odd) .de-cu-top-badges {
                            top: 6px !important;
                            transform: rotate(4deg) !important;
                        }
                        /* Thẻ chẵn (2, 4, 6...): Mép trên dốc xéo lên -> Hàng nhãn nghiêng xéo lên theo khung hình */
                        .de-cu-card:nth-child(even) .de-cu-top-badges {
                            top: 15px !important;
                            transform: rotate(-4deg) !important;
                        }
                        /* Thu nhỏ gọn gàng các ô nhãn (TRENDS, P.Đề, T.Minh, FHD) trên Mobile tránh dính 2 bên mép */
                        .de-cu-card .de-cu-top-badges .badge-trend {
                            height: 15px !important;
                            min-height: 15px !important;
                            max-height: 15px !important;
                            line-height: 15px !important;
                            font-size: 7px !important;
                            font-weight: 800 !important;
                            padding: 0 3px !important;
                            border-radius: 3px !important;
                            letter-spacing: 0 !important;
                            flex-shrink: 0 !important;
                        }
                        .de-cu-card .de-cu-top-badges .badge-tag,
                        .de-cu-card .de-cu-top-badges .badge-fhd {
                            height: 15px !important;
                            min-height: 15px !important;
                            max-height: 15px !important;
                            line-height: 15px !important;
                            font-size: 7.5px !important;
                            font-weight: 800 !important;
                            padding: 0 3.5px !important;
                            border-radius: 3px !important;
                            letter-spacing: 0 !important;
                            box-sizing: border-box !important;
                            flex-shrink: 0 !important;
                        }
                        .de-cu-card .de-cu-bottom-badge {
                            height: 15px !important;
                            min-height: 15px !important;
                            max-height: 15px !important;
                            line-height: 15px !important;
                            font-size: 7.5px !important;
                            font-weight: 800 !important;
                            padding: 0 4px !important;
                            border-radius: 3px !important;
                        }
                        @media (min-width: 640px) {
                            .de-cu-card .de-cu-top-badges {
                                left: 8px !important;
                                right: 8px !important;
                                gap: 3px !important;
                            }
                            .de-cu-card:nth-child(odd) .de-cu-top-badges {
                                top: 7px !important;
                            }
                            .de-cu-card:nth-child(even) .de-cu-top-badges {
                                top: 18px !important;
                            }
                            .de-cu-card .de-cu-top-badges .badge-trend {
                                height: 18px !important;
                                min-height: 18px !important;
                                max-height: 18px !important;
                                line-height: 18px !important;
                                font-size: 8.5px !important;
                                padding: 0 4.5px !important;
                                border-radius: 4px !important;
                                letter-spacing: 0.2px !important;
                            }
                            .de-cu-card .de-cu-top-badges .badge-tag,
                            .de-cu-card .de-cu-top-badges .badge-fhd {
                                height: 19px !important;
                                min-height: 19px !important;
                                max-height: 19px !important;
                                line-height: 19px !important;
                                font-size: 9.5px !important;
                                padding: 0 6px !important;
                                border-radius: 4px !important;
                            }
                            .de-cu-card .de-cu-bottom-badge {
                                height: 20px !important;
                                min-height: 20px !important;
                                max-height: 20px !important;
                                line-height: 20px !important;
                                font-size: 10px !important;
                                padding: 0 7px !important;
                                border-radius: 4px !important;
                            }
                        }
                        .de-cu-title-wrap {
                            margin-top: 10px !important;
                            position: relative !important;
                            z-index: 5 !important;
                        }
                        /* Thẻ lẻ (1, 3, 5...): Bên trái nhô cao, bên phải hạ thấp, mép dưới phẳng tuyệt đối 100% */
                        .de-cu-card:nth-child(odd) .de-cu-poster-wrap {
                            clip-path: url(#wave-decu-odd);
                        }
                        /* Thẻ chẵn (2, 4, 6...): Bên trái hạ thấp (nối tiếp điểm của thẻ lẻ), bên phải nhô cao, mép dưới phẳng tuyệt đối 100% */
                        .de-cu-card:nth-child(even) .de-cu-poster-wrap {
                            clip-path: url(#wave-decu-even);
                        }
                        .de-cu-card:hover {
                            z-index: 30 !important;
                        }
                        /* Di chuột vào / bấm chạm: Ảnh phim thu lại tí xíu (scale 0.965) tạo cảm giác ấn vào hiện đại (press-in tactile) + Viền vàng gold contour sắc nét */
                        .de-cu-card:hover .de-cu-poster-wrap,
                        html.light-mode .de-cu-card:hover .de-cu-poster-wrap {
                            transform: scale(0.965) !important;
                            filter: drop-shadow(0 0 1.5px #f59e0b) drop-shadow(0 0 6px rgba(245, 158, 11, 0.85)) !important;
                            box-shadow: none !important;
                            -webkit-box-reflect: none !important;
                            z-index: 30 !important;
                        }
                        .de-cu-card:active .de-cu-poster-wrap {
                            transform: scale(0.935) !important;
                            transition-duration: 0.12s !important;
                        }
                        .de-cu-card:hover .de-cu-poster-wrap img {
                            transform: none !important;
                        }
                        .cinema-hot-poster-wrap {
                            position: relative !important;
                            width: 100% !important;
                            height: 0 !important;
                            padding-bottom: 148% !important; /* Tỉ lệ 148% đồng bộ với mục Phim Mới Đề Cử */
                            border-radius: 14px !important;
                            overflow: hidden !important;
                            background: #141721 !important;
                            border: 1px solid rgba(255, 255, 255, 0.08) !important;
                            box-shadow: none !important;
                            -webkit-box-reflect: none !important;
                            filter: none !important;
                        }
                        .cinema-hot-poster-wrap img {
                            position: absolute !important;
                            top: 0 !important; left: 0 !important;
                            width: 100% !important; height: 100% !important;
                            object-fit: cover !important;
                            display: block !important;
                            transition: transform 0.35s ease !important;
                        }
                        .cinema-hot-card:hover .cinema-hot-poster-wrap img {
                            transform: scale(1.05) !important;
                        }
                        .cinema-hot-badge-age {
                            position: absolute !important;
                            top: 8px !important; left: 8px !important;
                            z-index: 10 !important;
                            font-size: 11px !important;
                            font-weight: 800 !important;
                            line-height: 1 !important;
                            padding: 3.5px 7px !important;
                            border-radius: 6px !important;
                            backdrop-filter: blur(8px) !important;
                            -webkit-backdrop-filter: blur(8px) !important;
                            letter-spacing: 0.3px !important;
                        }
                        .cinema-hot-badge-18 {
                            background: rgba(220, 38, 38, 0.9) !important;
                            color: #ffffff !important;
                            border: 1px solid rgba(255, 255, 255, 0.3) !important;
                            box-shadow: 0 2px 8px rgba(220, 38, 38, 0.4) !important;
                        }
                        .cinema-hot-badge-16 {
                            background: rgba(234, 88, 12, 0.9) !important;
                            color: #ffffff !important;
                            border: 1px solid rgba(255, 255, 255, 0.3) !important;
                            box-shadow: 0 2px 8px rgba(234, 88, 12, 0.4) !important;
                        }
                        .cinema-hot-badge-13 {
                            background: rgba(217, 119, 6, 0.9) !important;
                            color: #ffffff !important;
                            border: 1px solid rgba(255, 255, 255, 0.3) !important;
                            box-shadow: 0 2px 8px rgba(217, 119, 6, 0.4) !important;
                        }
                        .cinema-hot-badge-p {
                            background: rgba(22, 163, 74, 0.9) !important;
                            color: #ffffff !important;
                            border: 1px solid rgba(255, 255, 255, 0.3) !important;
                            box-shadow: 0 2px 8px rgba(22, 163, 74, 0.4) !important;
                        }
                        .cinema-hot-info-wrap {
                            text-align: center !important;
                            width: 100% !important;
                        }
                        .cinema-hot-rating-row {
                            display: flex !important;
                            align-items: center !important;
                            justify-content: center !important;
                            gap: 4px !important;
                            margin-top: 8px !important;
                            margin-bottom: 2px !important;
                            font-size: 12px !important;
                            font-weight: 700 !important;
                            line-height: 16px !important;
                            height: 16px !important;
                            min-height: 16px !important;
                            max-height: 16px !important;
                            overflow: hidden !important;
                            white-space: nowrap !important;
                            text-overflow: ellipsis !important;
                            text-align: center !important;
                        }
                        .cinema-hot-star {
                            color: #facc15 !important;
                            display: inline-flex !important;
                            font-size: 12px !important;
                            flex-shrink: 0 !important;
                        }
                        .cinema-hot-score {
                            color: #f3f4f6 !important;
                            white-space: nowrap !important;
                            flex-shrink: 0 !important;
                        }
                        .cinema-hot-reviews {
                            color: #9ca3af !important;
                            font-weight: 500 !important;
                            font-size: 11px !important;
                            white-space: nowrap !important;
                            overflow: hidden !important;
                            text-overflow: ellipsis !important;
                        }
                        .cinema-hot-unrated {
                            color: #9ca3af !important;
                            font-weight: 500 !important;
                            font-size: 11px !important;
                            white-space: nowrap !important;
                            overflow: hidden !important;
                            text-overflow: ellipsis !important;
                            display: inline-block !important;
                            max-width: 140px !important;
                            text-align: center !important;
                        }
                        .cinema-hot-title {
                            font-size: 13px !important;
                            font-weight: 700 !important;
                            color: #ffffff !important;
                            line-height: 18px !important;
                            height: 36px !important;
                            min-height: 36px !important;
                            max-height: 36px !important;
                            display: -webkit-box !important;
                            -webkit-line-clamp: 2 !important;
