            <div class="section-header">
                <div class="section-header-left">
                    <h2 class="section-header-title">PHIM MỚI ĐỀ CỬ</h2>
                </div>
                <div class="flex items-center gap-2 section-header-nav">
                    <button onclick="scrollSlider(-350)" class="w-7 h-7 rounded-full bg-white/10 hover:bg-[#f97316] hover:text-black flex items-center justify-center text-white transition-colors">
                        <span class="material-icons-round text-sm">chevron_left</span>
                    </button>
                    <button onclick="scrollSlider(350)" class="w-7 h-7 rounded-full bg-white/10 hover:bg-[#f97316] hover:text-black flex items-center justify-center text-white transition-colors">
