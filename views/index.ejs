                                        m.posterUrl ||
                                        'https://phimimg.com/upload/vod/20260620-1/00083387b890aaac69f0490b3fda8c13.jpg';
                                        if (thumbImg && thumbImg.includes('image.tmdb.org/t/p/original/')) {
