                                        'image.tmdb.org/t/p/w500/');
                                        }
                                        %>
                                        <div class="hero-thumb-item <%= idx === 0 ? 'hero-thumb-active active' : '' %>"
                                            onclick="switchHeroSlide(<%= idx %>)" data-slide-index="<%= idx %>"
