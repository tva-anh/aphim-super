                        window.switchTop10Type = function (btnEl, type) {
                            currentTop10Type = type;
                            const btnLe = document.getElementById('top10TypePhimLe');
                            const btnBo = document.getElementById('top10TypePhimBo');
                            if (btnLe && btnBo) {
