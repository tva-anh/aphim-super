                        html.light-mode .rap-hero .rap-chip-tmdb .tmdb-v { background: rgba(4, 12, 20, .82) !important; color: #fff !important; border-color: rgba(255, 255, 255, .42) !important; }
                        html.light-mode .rap-hero .rap-genre { color: #a8a29e !important; background: rgba(255, 255, 255, .08) !important; }
                        html.light-mode .rap-hero .rap-play svg { fill: #1f2937 !important; }
                    }

