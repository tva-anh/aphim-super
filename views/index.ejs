                </div>
            </div>

            <div id="grid-phim-le" class="phimmoi-section-grid">
                <div class="animate-pulse bg-gray-800 w-full h-[210px] rounded-lg"></div>
            </div>
        </section>


        <!-- ==============================================
             SECTION 4: PHIM MỚI THỊNH HÀNH
             ============================================== -->
        <section>
            <div class="section-header">
                <div class="section-header-left">
                    <h2 class="section-header-title">PHIM MỚI THỊNH HÀNH</h2>
                    <div class="section-header-tabs">
                        <button type="button" onclick="switchSectionTab(this, 'grid-trending', 'https://phimapi.com/v1/api/danh-sach/phim-bo?page=1')" class="section-header-tab active">Phim Bộ</button>
                        <button type="button" onclick="switchSectionTab(this, 'grid-trending', 'https://phimapi.com/v1/api/danh-sach/phim-le?page=1')" class="section-header-tab inactive">Phim Lẻ</button>
                    </div>
                </div>
            </div>

            <div id="grid-trending" class="phimmoi-section-grid">
                <div class="animate-pulse bg-gray-800 w-full h-[210px] rounded-lg"></div>
            </div>
