                        <clipPath id="wave-decu-even" clipPathUnits="objectBoundingBox">
                            <path d="M 0,0.086 Q 0,0.045 0.061,0.045 L 0.939,0 Q 1,0 1,0.041 L 1,0.959 Q 1,1 0.939,1 L 0.061,1 Q 0,1 0,0.959 Z" />
