                <!-- Dynamic PhimMoi Render Script -->
                <script>
                    (function () {
                        const API_BASE = 'https://phimapi.com';

                        function getImgUrl(url, cdnDomain) {
                            if (!url) return '';
                            let u = String(url).trim();
                            if (u.startsWith('data:image')) return u;
                            if (u.startsWith('http://') || u.startsWith('https://')) {
                                return u.replace('img.ophimimg.com', 'phimimg.com')
                                    .replace('ophim1.com/uploads', 'phimimg.com/uploads')
                                    .replace('img.phimapi.com', 'phimimg.com');
                            }
                            const clean = u.replace(/^\//, '');
                            if (clean.startsWith('upload/') || clean.startsWith('uploads/')) {
                                return 'https://phimimg.com/' + clean;
                            }
                            if (clean.match(/^\d{8}-\d+\//)) {
                                return 'https://phimimg.com/upload/vod/' + clean;
                            }
                            return 'https://phimimg.com/uploads/movies/' + clean;
                        }

                        // 🛡️ ULTRA ROBUST AUTO-HEAL & LIVE MOVIE IMAGE RESTORATION (KHÔNG BAO GIỜ GẮN LOGO BRAND THAY ẢNH PHIM)
                        window.handleCardImgError = async function (imgEl) {
                            if (!imgEl) return;
                            const step = parseInt(imgEl.dataset.errStep || '0', 10) + 1;
                            imgEl.dataset.errStep = String(step);

                            const fallbackUrl = imgEl.dataset.fallback;
                            const currentSrc = imgEl.src || '';
                            const slug = imgEl.dataset.slug || '';
                            const title = imgEl.alt || '';

                            // Step 1: Thử link poster / thumb đối ứng ngay lập tức
                            if (step === 1 && fallbackUrl && fallbackUrl !== currentSrc && !fallbackUrl.includes('no-poster') && fallbackUrl.startsWith('http')) {
                                imgEl.src = fallbackUrl;
                                return;
                            }

                            // Step 2: Thử chuyển đổi giữa uploads/movies/ và upload/vod/ hoặc mirror CDN
                            if (step === 2) {
                                if (currentSrc.includes('/uploads/movies/')) {
                                    imgEl.src = currentSrc.replace('/uploads/movies/', '/upload/vod/');
                                    return;
                                } else if (currentSrc.includes('/upload/vod/')) {
                                    imgEl.src = currentSrc.replace('/upload/vod/', '/uploads/movies/');
                                    return;
                                } else if (currentSrc.includes('phimimg.com')) {
                                    imgEl.src = currentSrc.replace('https://phimimg.com/', 'https://img.phimapi.com/');
                                    return;
                                }
                            }

                            // Step 3: Gọi API PhimAPI trực tiếp để lấy link ảnh LIVE chính xác 100% của phim
                            if (step === 3 && slug) {
                                try {
                                    const res = await fetch('https://phimapi.com/phim/' + slug);
                                    if (res.ok) {
                                        const data = await res.json();
                                        if (data && data.movie) {
                                            const liveImg = data.movie.thumb_url || data.movie.poster_url;
                                            if (liveImg && liveImg !== currentSrc) {
                                                imgEl.src = liveImg.startsWith('http') ? liveImg : ('https://phimimg.com/' + liveImg.replace(/^\//, ''));
                                                return;
                                            }
                                        }
                                    }
                                } catch (e) { }
                            }

                            // Step 4: Tìm ảnh TMDB chất lượng cao theo tên phim
                            if (step === 4 && (title || slug)) {
                                try {
                                    const qName = (title || slug.replace(/-/g, ' ')).replace(/xem phim/gi, '').split('(')[0].trim();
                                    const res = await fetch('/api/tmdb/search/multi?query=' + encodeURIComponent(qName) + '&language=vi-VN');
                                    if (res.ok) {
                                        const data = await res.json();
                                        if (data && data.results && data.results.length > 0) {
                                            const tmdbMatch = data.results[0];
                                            const path = tmdbMatch.backdrop_path || tmdbMatch.poster_path;
                                            if (path) {
                                                imgEl.src = 'https://image.tmdb.org/t/p/w500' + path;
                                                return;
                                            }
                                        }
                                    }
                                } catch (e) { }
                            }

                            // Step 5: Fallback ảnh poster phim tối sang trọng có tên phim (Tuyệt đối KHÔNG dán logo brand thay ảnh phim)
                            const cleanTitle = (title || slug.replace(/-/g, ' ')).replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                            imgEl.onerror = null;
                            imgEl.src = "data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='400' height='225' viewBox='0 0 400 225'%3E%3Cdefs%3E%3ClinearGradient id='bg' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%23181b24'/%3E%3Cstop offset='100%25' stop-color='%230f1218'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='400' height='225' fill='url(%23bg)'/%3E%3Ccircle cx='200' cy='95' r='32' fill='rgba(255,255,255,0.06)'/%3E%3Cpath d='M192 82 L214 95 L192 108 Z' fill='%23f59e0b'/%3E%3Ctext x='200' y='160' text-anchor='middle' fill='%23e2e8f0' font-family='sans-serif' font-size='14' font-weight='700'%3E" + encodeURIComponent(cleanTitle.slice(0, 32)) + "%3C/text%3E%3C/svg%3E";
                        };

                        window.scrollSlider = function (amount) {
                            const slider = document.getElementById('slider-de-cu');
                            if (slider) {
                                const cardWidth = window.innerWidth < 640 ? 202 : 215;
                                const visibleCount = Math.max(1, Math.floor(slider.clientWidth / cardWidth));
                                const step = Math.sign(amount) * Math.max(cardWidth, (visibleCount - 1) * cardWidth);
                                slider.scrollBy({ left: step || amount, behavior: 'smooth' });
                            }
                        };

                        window.scrollCinemaHotSlider = function (amount) {
                            if (typeof window.pauseCinemaHotOnUserAction === 'function') {
                                window.pauseCinemaHotOnUserAction();
                            }
                            const slider = document.getElementById('slider-cinema-hot');
                            if (slider) {
                                const cardWidth = 190;
                                const visibleCount = Math.max(1, Math.floor(slider.clientWidth / cardWidth));
                                const step = Math.sign(amount) * Math.max(cardWidth, (visibleCount - 1) * cardWidth);
                                slider.scrollBy({ left: step || amount, behavior: 'smooth' });
                            }
                            if (typeof window.resumeCinemaHotAfterUserAction === 'function') {
                                window.resumeCinemaHotAfterUserAction();
                            }
                        };

                        // 🎯 ICONIC PHIMMOI HOLLOW STROKE PLAY TRIANGLE
                        const PLAY_SVG_HTML = `<svg viewBox="0 0 24 24"><polygon points="7,4 19,12 7,20"/></svg>`;

                        // Helper to format language badges matching Photo 2
                        function formatLangBadges(lang) {
                            if (!lang) return `<span class="badge-tag badge-tag-pd">Vietsub</span>`;
                            const str = lang.toLowerCase();
                            let badges = [];

                            const hasSn = str.includes('song ngữ') || str.includes('song ngu');
                            const hasSub = str.includes('sub') || str.includes('phụ đề') || str.includes('phu de') || str.includes('p.đề');
                            const hasTm = str.includes('thuyết minh') || str.includes('thuyet minh') || str.includes('t.minh');
                            const hasLt = str.includes('lồng tiếng') || str.includes('long tieng') || str.includes('l.tiếng');

                            if (hasSn) {
                                badges.push(`<span class="badge-tag badge-tag-sn">Song ngữ</span>`);
                            }
                            if (hasSub) {
                                badges.push(`<span class="badge-tag badge-tag-pd">${(hasTm || hasLt) ? 'P.Đề' : 'Vietsub'}</span>`);
                            }
                            if (hasTm) {
                                badges.push(`<span class="badge-tag badge-tag-tm">T.Minh</span>`);
                            }
                            if (hasLt) {
                                badges.push(`<span class="badge-tag badge-tag-lt">L.Tiếng</span>`);
                            }

                            if (badges.length === 0) {
                                badges.push(`<span class="badge-tag badge-tag-pd">${lang}</span>`);
                            }

                            return badges.join('');
                        }

                        // Helper to format episode badge (Yellow for Full / Hoàn Tất)
                        function getEpBadgeHTML(epText) {
                            const text = epText || 'Full';
                            const str = text.toLowerCase();
                            const isFull = str.includes('full') || str.includes('hoàn tất') || str.includes('hoan tat');
                            const badgeClass = isFull ? 'badge-ep-yellow' : 'badge-ep-orange';
                            return `<span class="${badgeClass}">${text}</span>`;
                        }

                        // 1. Render Vertical 2:3 Movie Card (For PHIM MỚI ĐỀ CỬ Slider Only)
                        function createDeCuCardHTML(movie) {
                            const watchUrl = '/phim/' + movie.slug;
                            const primaryImg = getImgUrl(movie.poster_url || movie.thumb_url);
                            const fallbackImg = getImgUrl(movie.thumb_url || movie.poster_url);
                            const epText = movie.episode_current || 'Tập 1';
                            const langBadges = formatLangBadges(movie.lang || 'Vietsub');
                            const isFull = epText.toLowerCase().includes('full') || epText.toLowerCase().includes('hoàn tất');

                            const trendBadge = movie.is_google_trend 
                                ? `<span class="badge-trend" title="Trends 24h: ${movie.trend_keyword || ''}">TRENDS</span>`
                                : '';

                            return `
                <div class="de-cu-card">
                    <a href="${watchUrl}" title="${movie.name}${movie.trend_keyword ? ' - Google Trends 24h: ' + movie.trend_keyword : ''}" style="text-decoration:none;" class="block">
                        <div class="de-cu-poster-wrap">
                            <div class="de-cu-top-badges">
                                ${trendBadge}
                                ${langBadges}
                                <span class="badge-fhd">FHD</span>
                            </div>

                            <img src="${primaryImg}" data-fallback="${fallbackImg}" data-slug="${movie.slug || ''}" alt="${movie.name}" loading="lazy" decoding="async" onerror="window.handleCardImgError(this)" />

                            <div class="phimmoi-play-overlay">
                                <div class="phimmoi-play-btn">
                                    ${PLAY_SVG_HTML}
                                </div>
                            </div>

                            <div class="de-cu-bottom-badge ${isFull ? 'badge-ep-yellow' : ''}">${epText}</div>
                        </div>

                        <div class="de-cu-title-wrap">
                            <div class="de-cu-title-vi">${movie.name}</div>
                            <div class="de-cu-title-en">${movie.is_google_trend && movie.trend_traffic ? `<span style="color:#ff6a00;font-weight:700;">🔥 ${movie.trend_traffic}</span> ` : ''}${movie.origin_name || (movie.trend_keyword ? movie.trend_keyword : '')}</div>
                        </div>
                    </a>
                </div>
            `;
                        }

                        // 2. Render Featured Card
                        function createFeaturedCardHTML(movie) {
                            const watchUrl = '/phim/' + movie.slug;
                            const primaryImg = getImgUrl(movie.thumb_url || movie.poster_url);
                            const fallbackImg = getImgUrl(movie.poster_url || movie.thumb_url);
                            const epText = movie.episode_current || 'Tập 1';
                            const epBadgeHTML = getEpBadgeHTML(epText);
                            const langBadges = formatLangBadges(movie.lang || 'Vietsub');

                            return `
                <div class="featured-card-item">
                    <a href="${watchUrl}" title="${movie.name}" class="block w-full h-full relative" style="text-decoration:none;">
                        <div class="landscape-poster-wrap">
                            <div class="card-top-badges">
                                ${epBadgeHTML}
                                ${langBadges}
                            </div>

                            <img src="${primaryImg}" data-fallback="${fallbackImg}" data-slug="${movie.slug || ''}" alt="${movie.name}" loading="lazy" decoding="async" class="single-feature-img" onerror="window.handleCardImgError(this)" />

                            <div class="phimmoi-play-overlay">
                                <div class="phimmoi-play-btn">
                                    ${PLAY_SVG_HTML}
                                </div>
                            </div>

                            <div class="card-bottom-overlay">
                                <div class="card-title-vi">${movie.name}</div>
                                <div class="card-title-en">${movie.origin_name || ''} ${movie.year ? '(' + movie.year + ')' : ''}</div>
                            </div>
                        </div>
                    </a>
                </div>
            `;
                        }

                        // 3. Render Normal Card Item (1x1 in Unified Grid)
                        function createNormalCardHTML(movie) {
                            const watchUrl = '/phim/' + movie.slug;
                            const primaryImg = getImgUrl(movie.thumb_url || movie.poster_url);
                            const fallbackImg = getImgUrl(movie.poster_url || movie.thumb_url);
                            const epText = movie.episode_current || 'Full';
                            const epBadgeHTML = getEpBadgeHTML(epText);
                            const langBadges = formatLangBadges(movie.lang || 'Vietsub');

                            return `
                <div class="normal-card-item">
                    <a href="${watchUrl}" title="${movie.name}" class="block" style="text-decoration:none;">
                        <div class="landscape-poster-wrap">
                            <div class="card-top-badges">
                                ${epBadgeHTML}
                                ${langBadges}
                            </div>

                            <img src="${primaryImg}" data-fallback="${fallbackImg}" data-slug="${movie.slug || ''}" alt="${movie.name}" loading="lazy" decoding="async" onerror="window.handleCardImgError(this)" />

                            <div class="phimmoi-play-overlay">
                                <div class="phimmoi-play-btn">
                                    ${PLAY_SVG_HTML}
                                </div>
                            </div>

                            <div class="card-bottom-overlay">
                                <div class="card-title-vi">${movie.name}</div>
                                ${movie.origin_name ? `<div class="card-title-en">${movie.origin_name}</div>` : ''}
                            </div>
                        </div>
                    </a>
                </div>
            `;
                        }

                        // 🎯 In-Memory Cache for Section Tabs (0ms Instant Tab Switching)
                        const _sectionTabCache = new Map();

                        // 🎯 Tab Switching Handler for Section Filters (Zero Layout Shift + 0ms Switch)
                        window.switchSectionTab = async function (btnElement, containerId, apiUrl) {
                            const tabsContainer = btnElement.closest('.section-header-tabs');
                            if (tabsContainer) {
                                const tabs = tabsContainer.querySelectorAll('.section-header-tab');
                                tabs.forEach(tab => {
                                    tab.classList.remove('active');
                                    tab.classList.add('inactive');
                                });
                                btnElement.classList.remove('inactive');
                                btnElement.classList.add('active');
                            }

                            const gridEl = document.getElementById(containerId);
                            if (!gridEl) return;

                            const cacheKey = `${containerId}_${apiUrl}`;
                            if (_sectionTabCache.has(cacheKey)) {
                                gridEl.innerHTML = _sectionTabCache.get(cacheKey);
                                gridEl.style.opacity = '1';
                                return;
                            }

                            // Giữ nguyên layout, chỉ làm mờ nhẹ trong lúc nạp ngầm để trang không bị giật nhảy lên xuống
                            gridEl.style.transition = 'opacity 0.15s ease';
                            gridEl.style.opacity = '0.5';
                            gridEl.style.pointerEvents = 'none';

                            await loadUnifiedSection(apiUrl, containerId, 12);

                            gridEl.style.opacity = '1';
                            gridEl.style.pointerEvents = '';
                        };

                        // 🎯 Helper to safely get APhimCore even if script finishes parsing after DOMContentLoaded
                        async function getAPhimCore() {
                            if (window.APhimCore && typeof window.APhimCore.fetchMovieGridData === 'function') {
                                return window.APhimCore;
                            }
                            return new Promise((resolve) => {
                                let attempts = 0;
                                const interval = setInterval(() => {
                                    attempts++;
                                    if (window.APhimCore && typeof window.APhimCore.fetchMovieGridData === 'function') {
                                        clearInterval(interval);
                                        resolve(window.APhimCore);
                                    } else if (attempts > 50) {
                                        clearInterval(interval);
                                        resolve(window.APhimCore || {});
                                    }
                                }, 30);
                            });
                        }

                        // 🎯 EXACT PHOTO #3 5-COLUMN RENDER LOGIC: 12 Items Total (1 Featured + 6 Right + 5 Bottom = 12 items, 3 FULL ROWS)
                        async function loadUnifiedSection(arg1, arg2, arg3, arg4 = 12) {
                            let type = 'list';
                            let paramVal = 'phim-moi-cap-nhat';
                            let containerId = '';
                            let limitCount = 12;

                            if (typeof arg1 === 'string' && (arg1.startsWith('http') || arg1.startsWith('/v1/api/'))) {
                                // Called via switchSectionTab(apiUrl, containerId, 12)
                                type = arg1;
                                paramVal = '';
                                containerId = arg2;
                                limitCount = arg3 || 12;
                            } else {
                                // Called via loadUnifiedSection(type, paramVal, containerId, limitCount)
                                type = arg1;
                                paramVal = arg2;
                                containerId = arg3;
                                limitCount = arg4 || 12;
                            }

                            const cacheKey = `${containerId}_${type}${paramVal ? '_' + paramVal : ''}`;
                            const sessionKey = `aphim_sec_v1_${cacheKey}`;
                            let cachedHTML = _sectionTabCache.get(cacheKey);
                            if (!cachedHTML) {
                                try {
                                    const saved = sessionStorage.getItem(sessionKey);
                                    if (saved) {
                                        cachedHTML = saved;
                                        _sectionTabCache.set(cacheKey, saved);
                                    }
                                } catch (e) { }
                            }
                            if (cachedHTML) {
                                const gridEl = document.getElementById(containerId);
                                if (gridEl) {
                                    gridEl.innerHTML = cachedHTML;
                                }
                                return;
                            }

                            try {
                                const core = await getAPhimCore();
                                const res = await core.fetchMovieGridData(type, paramVal, 1);
                                const items = res?.items || [];
                                if (!items.length) return;

                                const gridEl = document.getElementById(containerId);
                                if (gridEl) {
                                    const featuredHTML = createFeaturedCardHTML(items[0]);
                                    const normalCount = limitCount - 1; // 11 normal cards
                                    const normalHTML = items.slice(1, normalCount + 1).map(m => createNormalCardHTML(m)).join('');
                                    const finalHTML = featuredHTML + normalHTML;
                                    _sectionTabCache.set(cacheKey, finalHTML);
                                    try { sessionStorage.setItem(sessionKey, finalHTML); } catch (e) { }
                                    gridEl.innerHTML = finalHTML;
                                }
                            } catch (err) {
                                console.warn('Lỗi API section:', type, paramVal, err);
                            }
                        }


                        // 🎯 RENDER TOP #10 CARD (LANDSCAPE 16:9 WITH STAR RATING & PLATFORM RANK BADGES)
