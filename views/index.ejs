<body class="bg-[#1f2331] text-white antialiased has-desktop-hero">
    <%- include('partials/header') %>

        <!-- Runtime Desktop Transparent Header Enforcer -->
        <script>
            (function () {
                function applyDesktopHeaderTransparent() {
                    if (window.innerWidth < 1024) return;
                    var header = document.getElementById('sofa-header') || document.querySelector('header');
                    if (!header) return;
                    var scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
                    if (scrollY <= 50) {
                        header.classList.remove('scrolled', 'sofa-header-scrolled');
                        header.style.setProperty('background', 'transparent', 'important');
                        header.style.setProperty('background-color', 'transparent', 'important');
                        header.style.setProperty('border', 'none', 'important');
                        header.style.setProperty('border-bottom', 'none', 'important');
                        header.style.setProperty('box-shadow', 'none', 'important');
                        header.style.setProperty('backdrop-filter', 'none', 'important');
                        header.style.setProperty('-webkit-backdrop-filter', 'none', 'important');
                    } else {
                        header.classList.add('scrolled');
                        header.style.removeProperty('background');
                        header.style.removeProperty('background-color');
                        header.style.removeProperty('border');
                        header.style.removeProperty('border-bottom');
                        header.style.removeProperty('box-shadow');
                        header.style.removeProperty('backdrop-filter');
                        header.style.removeProperty('-webkit-backdrop-filter');
                    }
                }
                window.addEventListener('scroll', applyDesktopHeaderTransparent, { passive: true });
                window.addEventListener('resize', applyDesktopHeaderTransparent, { passive: true });
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', applyDesktopHeaderTransparent);
                } else {
                    applyDesktopHeaderTransparent();
                }
                window.addEventListener('load', applyDesktopHeaderTransparent);
                setTimeout(applyDesktopHeaderTransparent, 50);
                setTimeout(applyDesktopHeaderTransparent, 250);
            })();
        </script>

        <!-- ==============================================
         SECTION -0.2: DESKTOP HERO CINEMATIC SHOWCASE (STRICTLY DESKTOP ONLY: min-width: 1024px)
         Photo #1 + Photo #2 Replica - Seamless Top-to-Bottom 100vh Full Bleed
         ============================================== -->
        <% const ssrHeroList=(typeof heroSlides !=='undefined' && Array.isArray(heroSlides) && heroSlides.length> 0) ?
            heroSlides : null;
            const ssrHero0 = (ssrHeroList && ssrHeroList.length > 0) ? ssrHeroList[0] : null;
            let rawBgImg = ssrHero0 ? (ssrHero0.rawImageUrl || ssrHero0.imageUrl || ssrHero0.thumb_url ||
            ssrHero0.thumbUrl || ssrHero0.poster_url || ssrHero0.posterUrl) :
            'https://phimimg.com/upload/vod/20260620-1/00083387b890aaac69f0490b3fda8c13.jpg';
