                        src="<%= ssrBgImg %>" data-original-src="<%= rawBgImg %>" data-movie-slug="<%= ssrSlug %>"
                        fetchpriority="high" decoding="sync" />
                    <img id="heroImageLayerB" class="hero-bg-layer" alt="" src="<%= rawBgImg1 %>"
                        data-original-src="<%= rawBgImg1 %>" data-movie-slug="<%= ssrSlug1 %>"
                        style="opacity: 0;" loading="eager" decoding="async" />
                    <!-- Fallback element for compatibility -->
