                                colorRgb: '239, 68, 68',
                                iconSvg: defaultInterestsIcons[1]
                                },
                                {
                                id: 'hanh-dong',
                                title: 'Hành Động',
                                actionText: 'XEM NGAY',
                                link: '/categories?category=hanh-dong',
                                imageUrl:
                                'https://phimimg.com/upload/vod/20250821-1/1ec414f82adc729512410edd1b083996.jpg',
                                colorRgb: '249, 115, 22',
                                iconSvg: defaultInterestsIcons[2]
                                },
                                {
