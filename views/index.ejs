<body class="bg-[#1f2331] text-white antialiased has-desktop-hero">
    <%- include('partials/header') %>

        <!-- Runtime Desktop Transparent Header Enforcer -->
        <script>
            (function () {
                /* Trang thai header hien tai: null | 'top' | 'scrolled'
                   Dung de CHI ghi DOM/STYLE khi trang thai THAT SU doi. */
                var appliedState = null;

                function applyDesktopHeaderTransparent(force) {
                    /* Chi chay tren desktop (>=1024px) - giu nguyen hanh vi cu */
                    if (window.innerWidth < 1024) return;

                    var header = document.getElementById('sofa-header') || document.querySelector('header');
                    if (!header) return;

                    var scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
                    var nextState = (scrollY <= 50) ? 'top' : 'scrolled';

                    /* TOI UU: trang thai khong doi thi KHONG ghi DOM/STYLE gi ca.
                       Truoc day moi lan cuon deu goi 5-7 setProperty/removeProperty
                       (ke ca backdrop-filter) du header da dung trang thai -> gayGiat. */
                    if (appliedState === nextState && !force) return;
                    appliedState = nextState;

                    if (nextState === 'top') {
                        header.classList.remove('scrolled', 'sofa-header-scrolled');
                        header.style.setProperty('background', 'transparent', 'important');
                        header.style.setProperty('background-color', 'transparent', 'important');
                        header.style.setProperty('border', 'none', 'important');
                        header.style.setProperty('border-bottom', 'none', 'important');
                        header.style.setProperty('box-shadow', 'none', 'important');
                        header.style.setProperty('backdrop-filter', 'none', 'important');
                        header.style.setProperty('-webkit-backdrop-filter', 'none', 'important');
                    } else {
                        header.classList.add('scrolled');
                        header.style.removeProperty('background');
                        header.style.removeProperty('background-color');
                        header.style.removeProperty('border');
                        header.style.removeProperty('border-bottom');
                        header.style.removeProperty('box-shadow');
                        header.style.removeProperty('backdrop-filter');
                        header.style.removeProperty('-webkit-backdrop-filter');
                    }
                }

                /* Scroll/resize di qua requestAnimationFrame de gom vao MOT nhip ve.
                   Truoc day chay dong bo tren tung event -> giat khi luot. */
                var ticking = false;
                function scheduleUpdate() {
                    if (ticking) return;
                    ticking = true;
                    window.requestAnimationFrame(function () {
                        applyDesktopHeaderTransparent(false);
                    });
                }

                window.addEventListener('scroll', scheduleUpdate, { passive: true });
                window.addEventListener('resize', scheduleUpdate, { passive: true });

                /* Cac lan chay dau (va load) van chay TRUC TIEP de chac chan
                   header dung trang thai truoc khi trang ve, khong bi nhay. */
                function boot() {
                    applyDesktopHeaderTransparent(true);
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', boot);
                } else {
                    boot();
                }
                window.addEventListener('load', boot);
                setTimeout(boot, 50);
                setTimeout(boot, 250);
            })();
        </script>

        <!-- ==============================================
         SECTION -0.2: DESKTOP HERO CINEMATIC SHOWCASE (STRICTLY DESKTOP ONLY: min-width: 1024px)
         Photo #1 + Photo #2 Replica - Seamless Top-to-Bottom 100vh Full Bleed
         ============================================== -->
        <% const ssrHeroList=(typeof heroSlides !=='undefined' && Array.isArray(heroSlides) && heroSlides.length> 0) ?
            heroSlides : null;
            const ssrHero0 = (ssrHeroList && ssrHeroList.length > 0) ? ssrHeroList[0] : null;
            let rawBgImg = ssrHero0 ? (ssrHero0.rawImageUrl || ssrHero0.imageUrl || ssrHero0.thumb_url ||
            ssrHero0.thumbUrl || ssrHero0.poster_url || ssrHero0.posterUrl) :
            'https://phimimg.com/upload/vod/20260620-1/00083387b890aaac69f0490b3fda8c13.jpg';
            // ⚡ Ảnh đầu tiên (Slide 0): Ưu tiên 100% chất lượng gốc nguyên bản cao nhất
            const ssrBgImg = rawBgImg;

            // ⚡ Ảnh kế tiếp (Slide 1): Nạp sẵn chất lượng cũ gốc ngay vào Layer B để chuyển cảnh tức thì 0ms
            const ssrHero1 = (ssrHeroList && ssrHeroList.length > 1) ? ssrHeroList[1] : null;
            let rawBgImg1 = ssrHero1 ? (ssrHero1.rawImageUrl || ssrHero1.imageUrl || ssrHero1.thumb_url ||
            ssrHero1.thumbUrl || ssrHero1.poster_url || ssrHero1.posterUrl) : '';
            const ssrSlug1 = ssrHero1 ? (ssrHero1.movieSlug || ssrHero1.slug || '') : '';

            const ssrLogo = ssrHero0 ? (ssrHero0.logoUrl || '') :
            'https://image.tmdb.org/t/p/w500/uyABqIMLGBYCrLkeIrt6k7WEaK2.png';
            const ssrTitle = ssrHero0 ? (ssrHero0.name || 'Nhất Âu Xuân') : 'Nhất Âu Xuân';
            const ssrSub = ssrHero0 ? (ssrHero0.originName || ssrHero0.origin_name || 'Spring Of The Blade') : 'Spring Of The Blade';
            const ssrImdb = ssrHero0 ? (ssrHero0.imdb?.vote_average || ssrHero0.tmdb?.vote_average || '9.5') : '9.5';
            const ssrQuality = ssrHero0 ? (ssrHero0.quality || 'FHD') : 'FHD';
            const ssrYear = ssrHero0 ? (ssrHero0.year || '2026') : '2026';
            const ssrEp = ssrHero0 ? (ssrHero0.episodeCurrent || ssrHero0.episode_current || 'Tập 30') : 'Tập 30';
            const ssrSlug = ssrHero0 ? (ssrHero0.movieSlug || ssrHero0.slug || 'nhat-au-xuan') : 'nhat-au-xuan';
            const ssrDesc = ssrHero0 ? (ssrHero0.content || '"Người đàn ông sát phạt quyết đoán, thâm sâu mưu mô" Thẩm Nhuận và cô gái "thông minh tỉnh táo như bông sen đen" Tạ Thanh Viên trở thành lưỡi dao của nhau, cùng nhau bước trên con đường báo thù đan xen trong lý trí và tình cảm...') : '"Người đàn ông sát phạt quyết đoán, thâm sâu mưu mô" Thẩm Nhuận và cô gái "thông minh tỉnh táo như bông sen đen" Tạ Thanh Viên trở thành lưỡi dao của nhau, cùng nhau bước trên con đường báo thù đan xen trong lý trí và tình cảm...';
            %>
            <script>
                window.__INITIAL_HERO_SLIDES__ = <%- JSON.stringify(ssrHeroList || null) %>;
                window.__INITIAL_HERO_AUTOSLIDE__ = <%- JSON.stringify(typeof heroAutoSlide !== 'undefined' ? heroAutoSlide : null) %>;
            </script>
            <section id="desktopHeroShowcase" class="desktop-hero-showcase relative w-full select-none hidden lg:block">
                <!-- Background Image & Clean Vignettes (Zero Foggy Overlay, Dual-Layer 60fps Cinema Transitions) -->
