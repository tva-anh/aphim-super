            </div>
        </section>


        <!-- ==============================================
             SECTION 6: CÂU HỎI THƯỜNG GẶP (FAQ)
             ============================================== -->
        <%- include('partials/faq') %>

    </main>

    <%- include('partials/footer') %>

    <!-- Dynamic PhimMoi Render Script -->
    <script>
    (function() {
        const API_BASE = 'https://phimapi.com';

        function getImgUrl(url) {
            if (!url) return '/images/no-poster.jpg';
            if (url.startsWith('http')) return url;
            return 'https://phimimg.com/' + url.replace(/^\//, '');
        }

        window.scrollSlider = function(amount) {
            const slider = document.getElementById('slider-de-cu');
            if (slider) {
                slider.scrollBy({ left: amount, behavior: 'smooth' });
            }
        };

        // 🎯 ICONIC PHIMMOI HOLLOW STROKE PLAY TRIANGLE
        const PLAY_SVG_HTML = `<svg viewBox="0 0 24 24"><polygon points="7,4 19,12 7,20"/></svg>`;

        // Helper to format language badges matching Photo 2
        function formatLangBadges(lang) {
            if (!lang) return `<span class="badge-tag badge-tag-pd">Vietsub</span>`;
            const str = lang.toLowerCase();
            let badges = [];

            const hasSn = str.includes('song ngữ') || str.includes('song ngu');
            const hasSub = str.includes('sub') || str.includes('phụ đề') || str.includes('phu de') || str.includes('p.đề');
            const hasTm = str.includes('thuyết minh') || str.includes('thuyet minh') || str.includes('t.minh');
            const hasLt = str.includes('lồng tiếng') || str.includes('long tieng') || str.includes('l.tiếng');

            if (hasSn) {
                badges.push(`<span class="badge-tag badge-tag-sn">Song ngữ</span>`);
            }
            if (hasSub) {
                badges.push(`<span class="badge-tag badge-tag-pd">${(hasTm || hasLt) ? 'P.Đề' : 'Vietsub'}</span>`);
            }
            if (hasTm) {
                badges.push(`<span class="badge-tag badge-tag-tm">T.Minh</span>`);
            }
            if (hasLt) {
                badges.push(`<span class="badge-tag badge-tag-lt">L.Tiếng</span>`);
            }

            if (badges.length === 0) {
                badges.push(`<span class="badge-tag badge-tag-pd">${lang}</span>`);
            }

            return badges.join('');
        }

        // Helper to format episode badge (Yellow for Full / Hoàn Tất)
        function getEpBadgeHTML(epText) {
            const text = epText || 'Full';
            const str = text.toLowerCase();
            const isFull = str.includes('full') || str.includes('hoàn tất') || str.includes('hoan tat');
            const badgeClass = isFull ? 'badge-ep-yellow' : 'badge-ep-orange';
            return `<span class="${badgeClass}">${text}</span>`;
        }

        // 1. Render Vertical 2:3 Movie Card (For PHIM MỚI ĐỀ CỬ Slider Only)
        function createDeCuCardHTML(movie) {
            const watchUrl = '/phim/' + movie.slug;
            const img = getImgUrl(movie.thumb_url || movie.poster_url);
            const epText = movie.episode_current || 'Tập 1';
            const langBadges = formatLangBadges(movie.lang || 'Vietsub');
            const isFull = epText.toLowerCase().includes('full') || epText.toLowerCase().includes('hoàn tất');

            return `
                <div class="de-cu-card">
                    <a href="${watchUrl}" title="${movie.name}" style="text-decoration:none;" class="block">
                        <div class="de-cu-poster-wrap">
                            <div class="de-cu-top-badges">
                                ${langBadges}
                                <span class="badge-fhd">FHD</span>
                            </div>

                            <img src="${img}" alt="${movie.name}" loading="lazy" />

                            <div class="phimmoi-play-overlay">
                                <div class="phimmoi-play-btn">
                                    ${PLAY_SVG_HTML}
                                </div>
                            </div>

                            <div class="de-cu-bottom-badge ${isFull ? 'badge-ep-yellow' : ''}">${epText}</div>
                        </div>

                        <div class="de-cu-title-wrap">
                            <div class="de-cu-title-vi">${movie.name}</div>
                            <div class="de-cu-title-en">${movie.origin_name || ''}</div>
                        </div>
                    </a>
                </div>
            `;
        }

        // 2. Render Featured Card
        function createFeaturedCardHTML(movie) {
            const watchUrl = '/phim/' + movie.slug;
            const img = getImgUrl(movie.thumb_url || movie.poster_url);
            const epText = movie.episode_current || 'Tập 1';
            const epBadgeHTML = getEpBadgeHTML(epText);
            const langBadges = formatLangBadges(movie.lang || 'Vietsub');

            return `
                <div class="featured-card-item">
                    <a href="${watchUrl}" title="${movie.name}" class="block w-full h-full relative" style="text-decoration:none;">
                        <div class="landscape-poster-wrap">
                            <div class="card-top-badges">
                                ${epBadgeHTML}
                                ${langBadges}
                            </div>

                            <img src="${img}" alt="${movie.name}" loading="lazy" class="single-feature-img" />

                            <div class="phimmoi-play-overlay">
                                <div class="phimmoi-play-btn">
                                    ${PLAY_SVG_HTML}
                                </div>
                            </div>

                            <div class="card-bottom-overlay">
                                <div class="card-title-vi">${movie.name}</div>
                                <div class="card-title-en">${movie.origin_name || ''} ${movie.year ? '(' + movie.year + ')' : ''}</div>
                            </div>
                        </div>
                    </a>
                </div>
            `;
        }

        // 3. Render Normal Card Item (1x1 in Unified Grid)
        function createNormalCardHTML(movie) {
            const watchUrl = '/phim/' + movie.slug;
            const img = getImgUrl(movie.thumb_url || movie.poster_url);
            const epText = movie.episode_current || 'Full';
            const epBadgeHTML = getEpBadgeHTML(epText);
            const langBadges = formatLangBadges(movie.lang || 'Vietsub');

            return `
                <div class="normal-card-item">
                    <a href="${watchUrl}" title="${movie.name}" class="block" style="text-decoration:none;">
                        <div class="landscape-poster-wrap">
                            <div class="card-top-badges">
                                ${epBadgeHTML}
                                ${langBadges}
                            </div>

                            <img src="${img}" alt="${movie.name}" loading="lazy" />

                            <div class="phimmoi-play-overlay">
                                <div class="phimmoi-play-btn">
                                    ${PLAY_SVG_HTML}
                                </div>
                            </div>

                            <div class="card-bottom-overlay">
                                <div class="card-title-vi">${movie.name}</div>
                                ${movie.origin_name ? `<div class="card-title-en">${movie.origin_name}</div>` : ''}
                            </div>
                        </div>
                    </a>
                </div>
            `;
        }

        // 🎯 Tab Switching Handler for Section Filters
        window.switchSectionTab = function(btnElement, containerId, apiUrl) {
            const tabsContainer = btnElement.closest('.section-header-tabs');
            if (tabsContainer) {
                const tabs = tabsContainer.querySelectorAll('.section-header-tab');
                tabs.forEach(tab => {
                    tab.classList.remove('active');
                    tab.classList.add('inactive');
                });
                btnElement.classList.remove('inactive');
                btnElement.classList.add('active');
            }

            const gridEl = document.getElementById(containerId);
            if (gridEl) {
                gridEl.innerHTML = `
                    <div class="col-span-full py-12 flex items-center justify-center text-gray-400">
                        <div class="inline-block w-8 h-8 border-4 border-[#ff6a00] border-t-transparent rounded-full animate-spin"></div>
                        <span class="ml-3 text-sm font-medium">Đang tải phim...</span>
                    </div>
                `;
            }

            loadUnifiedSection(apiUrl, containerId, 12);
        };

        // 🎯 EXACT PHOTO #3 5-COLUMN RENDER LOGIC: 12 Items Total (1 Featured + 6 Right + 5 Bottom = 12 items, 3 FULL ROWS)
        async function loadUnifiedSection(arg1, arg2, arg3, arg4 = 12) {
            let type = 'list';
            let paramVal = 'phim-moi-cap-nhat';
            let containerId = '';
            let limitCount = 12;

            if (typeof arg1 === 'string' && (arg1.startsWith('http') || arg1.startsWith('/v1/api/'))) {
                // Called via switchSectionTab(apiUrl, containerId, 12)
                type = arg1;
                paramVal = '';
                containerId = arg2;
                limitCount = arg3 || 12;
            } else {
                // Called via loadUnifiedSection(type, paramVal, containerId, limitCount)
                type = arg1;
                paramVal = arg2;
                containerId = arg3;
                limitCount = arg4 || 12;
            }

            try {
                const res = await window.APhimCore.fetchMovieGridData(type, paramVal, 1);
                const items = res?.items || [];
                if (!items.length) return;

                const gridEl = document.getElementById(containerId);
                if (gridEl) {
                    const featuredHTML = createFeaturedCardHTML(items[0]);
                    const normalCount = limitCount - 1; // 11 normal cards
                    const normalHTML = items.slice(1, normalCount + 1).map(m => createNormalCardHTML(m)).join('');
                    gridEl.innerHTML = featuredHTML + normalHTML;
                }
            } catch (err) {
                console.warn('Lỗi API section:', type, paramVal, err);
            }
        }


        // 🎯 RENDER BẢNG XẾP HẠNG CARD (HORIZONTAL LAYOUT MATCHING USER IMAGE)
        function createRankingCardHTML(movie, index) {
            const watchUrl = '/phim/' + movie.slug;
            const img = getImgUrl(movie.thumb_url || movie.poster_url);
            const rank = index + 1;
            
            let rankClass = '';
            let numClass = '';
            if (rank === 1) { rankClass = 'ranking-card-1'; numClass = 'ranking-num-1'; }
            else if (rank === 2) { rankClass = 'ranking-card-2'; numClass = 'ranking-num-2'; }
            else if (rank === 3) { rankClass = 'ranking-card-3'; numClass = 'ranking-num-3'; }

            const lang = (movie.lang || 'Vietsub').toLowerCase();
            const epText = (movie.episode_current || 'Full').trim();

            let badgeVS_TM = '';
            if (lang.includes('thuyết minh') || lang.includes('thuyet minh') || lang.includes('t.minh')) {
                badgeVS_TM = `<span class="ranking-badge-pill badge-tm">TM.${epText.replace(/[^0-9]/g, '') || 'Full'}</span>`;
            } else {
                badgeVS_TM = `<span class="ranking-badge-pill badge-vs">VS.${epText.replace(/[^0-9]/g, '') || 'Full'}</span>`;
            }

            return `
                <a href="${watchUrl}" title="${movie.name}" class="ranking-card ${rankClass}">
                    <div class="ranking-num ${numClass} rank-delay-${index}">${rank}</div>
                    <div class="ranking-poster-box">
                        <img class="ranking-poster-img" src="${img}" alt="${movie.name}" loading="lazy" onError="window.APhimCore.handleImgError(this)" />
                    </div>
                    <div class="ranking-info">
                        <div class="ranking-title-vi" title="${movie.name}">${movie.name}</div>
                        <div class="ranking-title-en" title="${movie.origin_name || ''}">${movie.origin_name || ''}</div>
                        <div class="ranking-meta-row">
                            <span class="ranking-crown-icon">👑</span>
                            ${badgeVS_TM}
                        </div>
                    </div>
                </a>
            `;
        }

        window.switchRankingTab = async function(btnElement, paramVal) {
            const tabsContainer = btnElement.closest('.section-header-tabs');
            if (tabsContainer) {
                tabsContainer.querySelectorAll('.section-header-tab').forEach(tab => {
                    tab.classList.remove('active');
                    tab.classList.add('inactive');
                });
                btnElement.classList.remove('inactive');
                btnElement.classList.add('active');
            }

            const gridEl = document.getElementById('grid-bang-xep-hang');
            if (gridEl) {
                gridEl.innerHTML = `
                    <div class="col-span-full py-12 flex items-center justify-center text-gray-400">
                        <div class="inline-block w-8 h-8 border-4 border-[#ff9900] border-t-transparent rounded-full animate-spin"></div>
                        <span class="ml-3 text-sm font-medium">Đang cập nhật Bảng Xếp Hạng...</span>
                    </div>
                `;
            }

            try {
                const res = await window.APhimCore.fetchMovieGridData('list', paramVal, 1);
                const items = res.items || [];
                if (gridEl && items.length) {
                    gridEl.innerHTML = items.slice(0, 10).map((m, idx) => createRankingCardHTML(m, idx)).join('');
                }
            } catch (e) {
                console.warn('Lỗi load Bảng xếp hạng:', e);
            }
        };

        async function loadRankingSection() {
            try {
                const res = await window.APhimCore.fetchMovieGridData('list', 'phim-bo', 1);
                const items = res.items || [];
                const gridEl = document.getElementById('grid-bang-xep-hang');
                if (gridEl && items.length) {
                    gridEl.innerHTML = items.slice(0, 10).map((m, idx) => createRankingCardHTML(m, idx)).join('');
                }
            } catch (err) {
                console.warn('Lỗi Bảng Xếp Hạng:', err);
            }
        }

        // Load Phim Mới Đề Cử Slider (Vertical Cards)
        async function loadDeCuSlider() {
            try {
                const res = await window.APhimCore.fetchMovieGridData('list', 'phim-moi-cap-nhat', 1);
                const items = res.items || [];
                const sliderEl = document.getElementById('slider-de-cu');
                if (sliderEl && items.length) {
                    sliderEl.innerHTML = items.slice(0, 16).map(m => createDeCuCardHTML(m)).join('');
                }
            } catch (err) {
                console.warn('Lỗi Slider Đề Cử:', err);
            }
        }

        function loadWhenNearViewport(containerId, loadSection) {
            const container = document.getElementById(containerId);
            if (!container || !('IntersectionObserver' in window)) {
                loadSection();
                return;
            }

            const observer = new IntersectionObserver((entries) => {
                if (!entries.some(entry => entry.isIntersecting)) return;
                observer.disconnect();
                loadSection();
            }, { rootMargin: '250px 0px' });

            observer.observe(container);
        }

        // Load the first row immediately; defer lower rows until the user is approaching them.
        document.addEventListener('DOMContentLoaded', function() {
            loadDeCuSlider();
            loadWhenNearViewport('grid-phim-bo', () => loadUnifiedSection('list', 'phim-bo', 'grid-phim-bo', 12));
            loadWhenNearViewport('grid-bang-xep-hang', loadRankingSection);
            loadWhenNearViewport('grid-chieu-rap', () => loadUnifiedSection('list', 'phim-chieu-rap', 'grid-chieu-rap', 12));
            loadWhenNearViewport('grid-phim-le', () => loadUnifiedSection('list', 'phim-le', 'grid-phim-le', 12));
            loadWhenNearViewport('grid-trending', () => loadUnifiedSection('list', 'phim-moi-cap-nhat', 'grid-trending', 12));
            loadWhenNearViewport('grid-anime', () => loadUnifiedSection('list', 'hoat-hinh', 'grid-anime', 12));
        });
    })();
    </script>
</body>
</html>
