                                        <line x1="8" x2="8" y1="2" y2="6"></line>
                                        <line x1="3" x2="21" y1="10" y2="10"></line>
                                    </svg>
                                    <span>
                                        <%= ssrYear %>
                                    </span>
                                </span>
                                <span class="hero-badge-imdb">
                                    <span class="hero-badge-imdb-label">IMDb</span> <span class="hero-badge-imdb-val">
                                        <%= ssrImdb %>
                                    </span>
                                </span>
                                <div class="hero-feature-ribbon">
                                    <span class="hero-ribbon-seg hero-seg-vs" title="Phụ đề Vietsub">
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                                            <path
                                                d="M19 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-8 7H9.5v-.5h-2v3h2V13H11v1a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v1zm7 0h-1.5v-.5h-2v3h2V13H18v1a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v1z" />
                                        </svg>
                                        <span>VS</span>
                                    </span>
                                    <span class="hero-ribbon-seg hero-seg-age" title="Độ tuổi">
