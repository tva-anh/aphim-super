                        function renderCardFallbackSvg(imgEl, title, slug, originalSrc) {
                            if (!imgEl) return;
                            imgEl.onerror = null;
                            const cleanTitle = (title || slug.replace(/-/g, ' ')).replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                            const isLight = document.documentElement.classList.contains('light-mode') || document.body.classList.contains('light-mode');
                            const stopColor1 = isLight ? '%23f8f6f0' : '%23181b24';
                            const stopColor2 = isLight ? '%23ece6da' : '%230f1218';
                            const circleFill = isLight ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.06)';
                            const playFill = isLight ? '%23ea580c' : '%23f59e0b';
                            const textColor = isLight ? '%23475569' : '%23e2e8f0';

                            imgEl.src = "data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='400' height='225' viewBox='0 0 400 225'%3E%3Cdefs%3E%3ClinearGradient id='bg' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='" + stopColor1 + "'/%3E%3Cstop offset='100%25' stop-color='" + stopColor2 + "'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='400' height='225' fill='url(%23bg)'/%3E%3Ccircle cx='200' cy='95' r='32' fill='" + circleFill + "'/%3E%3Cpath d='M192 82 L214 95 L192 108 Z' fill='" + playFill + "'/%3E%3Ctext x='200' y='160' text-anchor='middle' fill='" + textColor + "' font-family='sans-serif' font-size='14' font-weight='700'%3E" + encodeURIComponent(cleanTitle.slice(0, 32)) + "%3C/text%3E%3C/svg%3E";

                            // 🔄 Tự động phục hồi lại ảnh gốc khi mạng rảnh rỗi (sau 4s)
                            if (originalSrc && !originalSrc.startsWith('data:')) {
                                setTimeout(function () {
                                    if (!imgEl || !imgEl.isConnected) return;
                                    const idleProbe = new Image();
                                    idleProbe.onload = function () {
                                        if (imgEl && imgEl.isConnected) {
                                            imgEl.src = idleProbe.src;
                                            imgEl.removeAttribute('data-err-step');
                                        }
                                    };
                                    idleProbe.src = originalSrc;
                                }, 4000);
                            }
                        }

