                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span>
                                        <%= ssrEp %>
                                    </span>
                                </span>
                                <span class="hero-badge-year">
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
                                        stroke-width="2.2">
                                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
