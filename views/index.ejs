        <!-- ==============================================
             SECTION 5: PHIM HOẠT HÌNH & ANIME
             ============================================== -->
        <section>
            <div class="section-header">
                <div class="section-header-left">
                    <h2 class="section-header-title">PHIM HOẠT HÌNH & ANIME</h2>
                    <div class="section-header-tabs">
                        <a href="#" class="section-header-tab active">Mới cập nhật</a>
                    </div>
                </div>
            </div>
