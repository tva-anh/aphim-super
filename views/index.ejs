                    <div class="hero-bottom-blend pointer-events-none"></div>
                </div>

                <!-- Content Area -->
                <div id="heroContent" class="relative w-full mx-auto z-20 opacity-100 transition-opacity duration-500">
                    <div class="hero-main-row">
