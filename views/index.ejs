                <!-- Dynamic PhimMoi Render Script -->
                <script>
                    (function () {
                        const API_BASE = 'https://phimapi.com';

                        function getImgUrl(url, cdnDomain) {
                            if (!url) return '';
                            let u = String(url).trim();
                            if (u.startsWith('data:image')) return u;
                            if (u.startsWith('http://') || u.startsWith('https://')) {
                                return u.replace('img.ophimimg.com', 'phimimg.com')
                                    .replace('ophim1.com/uploads', 'phimimg.com/uploads')
                                    .replace('img.phimapi.com', 'phimimg.com');
                            }
                            let clean = u.replace(/^\//, '');
                            clean = clean.replace(/^(uploads\/movies\/)+/, 'uploads/movies/');
                            clean = clean.replace(/^(upload\/vod\/)+/, 'upload/vod/');
                            if (clean.startsWith('upload/') || clean.startsWith('uploads/')) {
                                return 'https://phimimg.com/' + clean;
                            }
                            if (clean.match(/^\d{8}-\d+\//)) {
                                return 'https://phimimg.com/upload/vod/' + clean;
                            }
                            if (clean.includes('.vn/') || clean.includes('.com/') || clean.includes('.org/') || clean.includes('.net/')) {
                                return 'https://' + clean;
                            }
                            return 'https://phimimg.com/uploads/movies/' + clean;
                        }

                        // 🛡️ ULTRA ROBUST SELF-HEALING IMAGE RESTORATION WITH EXPONENTIAL RETRY
                        window.handleCardImgError = function (imgEl) {
                            if (!imgEl) return;
                            const step = parseInt(imgEl.dataset.errStep || '0', 10) + 1;
                            imgEl.dataset.errStep = String(step);

                            const fallbackUrl = imgEl.dataset.fallback || '';
                            const currentSrc = imgEl.src || '';
                            const title = imgEl.alt || '';
                            const slug = imgEl.dataset.slug || '';
                            const originalSrc = imgEl.dataset.originalSrc || currentSrc;

                            // Step 1: Thử link fallback đối ứng nếu có và khác link hiện tại
                            if (step === 1 && fallbackUrl && fallbackUrl !== currentSrc && !fallbackUrl.includes('no-poster') && fallbackUrl.startsWith('http')) {
                                imgEl.src = fallbackUrl;
                                return;
                            }

                            // Step 2, 3, 4: Thử lại tự động qua Image Probe với độ trễ tăng dần (450ms, 1000ms, 2000ms)
                            // Giúp vượt qua nghẽn kết nối mạng / socket pool ban đầu mà KHÔNG biến thành khung xám
                            if (step <= 4) {
                                const delays = [0, 450, 1000, 2000, 3000];
                                const waitMs = delays[step] || 1500;
                                const targetUrl = (step % 2 === 0 && fallbackUrl && fallbackUrl.startsWith('http')) ? fallbackUrl : originalSrc;

                                if (targetUrl && !targetUrl.startsWith('data:')) {
                                    setTimeout(function () {
                                        if (!imgEl || !imgEl.isConnected) return;
                                        const probe = new Image();
                                        probe.onload = function () {
                                            if (imgEl && imgEl.isConnected) {
                                                imgEl.src = probe.src;
                                                imgEl.removeAttribute('data-err-step');
                                            }
                                        };
                                        probe.onerror = function () {
                                            if (imgEl && imgEl.isConnected) {
                                                window.handleCardImgError(imgEl);
                                            }
                                        };
                                        probe.src = targetUrl;
                                    }, waitMs);
                                    return;
                                }
                            }

                            // Chỉ khi đã thử 4 lần liên tiếp mà vẫn không nạp được mới tạm thời hiện SVG
                            renderCardFallbackSvg(imgEl, title, slug, originalSrc);
