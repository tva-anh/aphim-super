            const ssrSub = ssrHero0 ? (ssrHero0.originName || ssrHero0.origin_name || 'Spring Of The Blade') : 'Spring Of The Blade';
            const ssrImdb = ssrHero0 ? (ssrHero0.imdb?.vote_average || ssrHero0.tmdb?.vote_average || '9.5') : '9.5';
            const ssrQuality = ssrHero0 ? (ssrHero0.quality || 'FHD') : 'FHD';
