                        // 3. Render Normal Card Item (1x1 in Unified Grid - 16:9 Sharp Display)
                        function createNormalCardHTML(movie, idx = 0) {
                            const watchUrl = '/phim/' + movie.slug;
                            const primaryImg = getImgUrl(movie.thumb_url || movie.poster_url, null, 500, 85);
                            const fallbackImg = getImgUrl(movie.poster_url || movie.thumb_url, null, 500, 85);
                            const badgesHeaderHTML = renderCardBadgesHeader(movie);

                            return `
                <div class="normal-card-item">
