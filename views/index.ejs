                                            <path
                                                d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm-1 5h2v2h-2V7zm0 4h2v6h-2v-6z" />
                                        </svg>
                                        <span>T13</span>
                                    </span>
                                    <span class="hero-ribbon-seg hero-seg-tm" title="Thuyết minh / Lồng tiếng">
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                                            <path
                                                d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
                                        </svg>
                                        <span>TM</span>
                                    </span>
                                    <span class="hero-ribbon-seg hero-seg-fhd" title="Chất lượng Full HD">
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                                            <path
                                                d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z" />
                                        </svg>
                                        <span>
                                            <%= ssrQuality %>
                                        </span>
                                    </span>
                                </div>
                            </div>

                            <!-- Genre Tag Pills (Exact Photo 1 Layout: 2 tags) -->
                            <div id="heroGenres" class="flex flex-wrap gap-2 items-center">
                                <% if (ssrHero0 && Array.isArray(ssrHero0.category) && ssrHero0.category.length> 0) { %>
                                    <% ssrHero0.category.slice(0, 2).forEach(cat=> { %>
