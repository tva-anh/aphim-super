<script>
let isFaqMobileExpanded = false;

function initFaqMobileState() {
    const faqSection = document.querySelector('.faq-section');
    if (!faqSection) return;
    
    if (window.innerWidth < 768) {
        if (!isFaqMobileExpanded) {
            faqSection.classList.add('faq-collapsed');
        } else {
            faqSection.classList.remove('faq-collapsed');
        }
    } else {
        faqSection.classList.remove('faq-collapsed');
    }
}

function toggleFaqMobile() {
    const faqSection = document.querySelector('.faq-section');
    const textEl = document.getElementById('faqToggleMobileText');
    const iconEl = document.getElementById('faqToggleMobileIcon');
    if (!faqSection) return;

    isFaqMobileExpanded = !isFaqMobileExpanded;

    if (isFaqMobileExpanded) {
        faqSection.classList.remove('faq-collapsed');
        if (textEl) textEl.textContent = 'Thu gọn';
        if (iconEl) iconEl.style.transform = 'rotate(180deg)';
    } else {
        faqSection.classList.add('faq-collapsed');
        if (textEl) textEl.textContent = 'Xem thêm';
        if (iconEl) iconEl.style.transform = 'rotate(0deg)';
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqMobileState);
} else {
    initFaqMobileState();
}
window.addEventListener('resize', initFaqMobileState);

function toggleFaqCard(btnEl) {
    const cardEl = btnEl.closest('.faq-card');
    const bodyEl = cardEl.querySelector('.faq-body');
    const iconEl = btnEl.querySelector('.faq-chevron');
    const isLight = document.documentElement.classList.contains('light-mode');

    const isHidden = window.getComputedStyle(bodyEl).display === 'none';

    if (isHidden) {
        bodyEl.style.display = 'block';
        iconEl.style.transform = 'rotate(180deg)';
        iconEl.style.fill = '#d97706';
        if (isLight) {
            cardEl.style.borderColor = '#d97706';
            cardEl.style.background = '#ffffff';
        } else {
            cardEl.style.borderColor = 'rgba(255, 255, 255, 0.22)';
            cardEl.style.background = '#20222e';
        }
    } else {
        bodyEl.style.display = 'none';
        iconEl.style.transform = 'rotate(0deg)';
        iconEl.style.fill = isLight ? '#78716c' : '#9ca3af';
        if (isLight) {
            cardEl.style.borderColor = '#e7e0d3';
            cardEl.style.background = '#ffffff';
        } else {
            cardEl.style.borderColor = 'rgba(255, 255, 255, 0.08)';
            cardEl.style.background = '#181921';
        }
    }
}
</script>

