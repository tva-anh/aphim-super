<script>
window.selectedAZ = '';
window.selectedCategoryPill = '';

window.toggleCustomDropdown = function(triggerEl) {
    const wrap = triggerEl.closest('.custom-dropdown-wrap');
    if (!wrap) return;
    const menu = wrap.querySelector('.custom-dropdown-menu');
    const chevron = wrap.querySelector('.dropdown-chevron');
    
    const isOpened = !menu.classList.contains('hidden');
    
    // Close all open dropdowns
    document.querySelectorAll('.custom-dropdown-menu').forEach(m => m.classList.add('hidden'));
    document.querySelectorAll('.dropdown-chevron').forEach(c => c.style.transform = 'rotate(0deg)');
    
    if (!isOpened) {
        menu.classList.remove('hidden');
        if (chevron) chevron.style.transform = 'rotate(180deg)';
    }
};

window.selectCustomOption = function(optionEl, val, labelText) {
    const wrap = optionEl.closest('.custom-dropdown-wrap');
    if (!wrap) return;
    
    // Update hidden select
    const select = wrap.querySelector('select');
    if (select) {
        select.value = val;
        select.dispatchEvent(new Event('change'));
    }
    
    // Update label text
    const labelSpan = wrap.querySelector('[id^="label_"]');
    if (labelSpan) {
        labelSpan.innerText = labelText;
    }
    
    // Highlight active option
    wrap.querySelectorAll('.dropdown-option').forEach(opt => {
        opt.classList.remove('bg-[#2c3048]', 'text-[#fcd576]', 'font-bold');
        opt.classList.add('text-gray-200');
    });
    optionEl.classList.add('bg-[#2c3048]', 'text-[#fcd576]', 'font-bold');
    optionEl.classList.remove('text-gray-200');
    
    // Close menu & reset chevron
    const menu = wrap.querySelector('.custom-dropdown-menu');
    const chevron = wrap.querySelector('.dropdown-chevron');
    if (menu) menu.classList.add('hidden');
    if (chevron) chevron.style.transform = 'rotate(0deg)';
};

// Close when clicking outside
if (!window.dropdownOutsideListenerAdded) {
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.custom-dropdown-wrap')) {
            document.querySelectorAll('.custom-dropdown-menu').forEach(m => m.classList.add('hidden'));
            document.querySelectorAll('.dropdown-chevron').forEach(c => c.style.transform = 'rotate(0deg)');
        }
    });
    window.dropdownOutsideListenerAdded = true;
}

window.updateFilterLabel = function(selectEl) {
    if (!selectEl) return;
    const lbl = document.getElementById('label_' + selectEl.id);
    if (lbl && selectEl.selectedIndex >= 0) {
        lbl.innerText = selectEl.options[selectEl.selectedIndex].text;
    }
};

window.selectAZFilter = function(btn, val) {
    document.querySelectorAll('.filter-az-btn').forEach(b => {
        b.classList.remove('active-filter-btn');
        b.classList.add('inactive-filter-btn');
    });
    btn.classList.remove('inactive-filter-btn');
    btn.classList.add('active-filter-btn');
    window.selectedAZ = val;
};

window.selectCategoryFilter = function(btn, val) {
    document.querySelectorAll('.filter-cat-btn').forEach(b => {
        b.classList.remove('active-filter-btn');
        b.classList.add('inactive-filter-btn');
    });
    btn.classList.remove('inactive-filter-btn');
    btn.classList.add('active-filter-btn');
    window.selectedCategoryPill = val;
};

window.resetFilterPanel = function() {
    const ids = ['filterTopic', 'filterCountry', 'filterStatus', 'filterYear', 'filterLang', 'filterList'];
    ids.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.value = '';
            window.updateFilterLabel(el);
        }
        const wrap = document.querySelector(`.custom-dropdown-wrap[data-dropdown="${id}"]`);
        if (wrap) {
            wrap.querySelectorAll('.dropdown-option').forEach((opt, idx) => {
                opt.classList.remove('bg-[#2c3048]', 'text-[#fcd576]', 'font-bold');
                opt.classList.add('text-gray-200');
                if (idx === 0) {
                    opt.classList.add('bg-[#2c3048]', 'text-[#fcd576]', 'font-bold');
                    opt.classList.remove('text-gray-200');
                }
            });
        }
    });

    const sort = document.getElementById('filterSort');
    if (sort) {
        sort.value = 'year';
        window.updateFilterLabel(sort);
    }
    const wrapSort = document.querySelector('.custom-dropdown-wrap[data-dropdown="filterSort"]');
    if (wrapSort) {
        wrapSort.querySelectorAll('.dropdown-option').forEach((opt, idx) => {
            opt.classList.remove('bg-[#2c3048]', 'text-[#fcd576]', 'font-bold');
            opt.classList.add('text-gray-200');
            if (idx === 0) {
                opt.classList.add('bg-[#2c3048]', 'text-[#fcd576]', 'font-bold');
                opt.classList.remove('text-gray-200');
            }
        });
    }

    const order = document.getElementById('filterOrder');
    if (order) {
        order.value = 'desc';
        window.updateFilterLabel(order);
    }
    const wrapOrder = document.querySelector('.custom-dropdown-wrap[data-dropdown="filterOrder"]');
    if (wrapOrder) {
        wrapOrder.querySelectorAll('.dropdown-option').forEach((opt, idx) => {
            opt.classList.remove('bg-[#2c3048]', 'text-[#fcd576]', 'font-bold');
            opt.classList.add('text-gray-200');
            if (idx === 0) {
                opt.classList.add('bg-[#2c3048]', 'text-[#fcd576]', 'font-bold');
                opt.classList.remove('text-gray-200');
            }
        });
    }

    // Reset A-Z pills
    const firstAZ = document.querySelector('.filter-az-btn');
    if (firstAZ) window.selectAZFilter(firstAZ, '');

    // Reset Category pills
    const firstCat = document.querySelector('.filter-cat-btn');
    if (firstCat) window.selectCategoryFilter(firstCat, '');
};

// Auto update labels on load
function initFilterLabels() {
    ['filterTopic', 'filterCountry', 'filterStatus', 'filterYear', 'filterLang', 'filterSort', 'filterOrder', 'filterList'].forEach(id => {
        const el = document.getElementById(id);
        if (el) window.updateFilterLabel(el);
    });
}
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilterLabels);
} else {
    initFilterLabels();
}
</script>
