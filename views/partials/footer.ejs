<script>
    function aphimOpenGuide(){
        var e = document.getElementById('aphim-guide-overlay');
        if(e){ e.style.display='flex'; document.body.style.overflow='hidden'; }
    }
    function aphimCloseGuide(){
        var e = document.getElementById('aphim-guide-overlay');
        if(e){ e.style.display='none'; document.body.style.overflow=''; }
    }
    document.addEventListener('keydown', function(e){ if(e.key==='Escape') aphimCloseGuide(); });
</script>

