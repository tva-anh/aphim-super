<style>
    /* Super Motchill Carbon Cinematic Styling */
    :root {
        --bg-main: #1f2331;
        --bg-card: #20222d;
        --bg-hover: #1e2230;
        --primary-orange: #ff9900;
        --primary-gold: #f2f20d;
        --badge-orange: #f97316;
    }
    html {
        background-color: #1f2331 !important;
        background: #1f2331 !important;
        color: #e2e8f0;
        font-family: 'Be Vietnam Pro', 'Nunito', sans-serif;
    }
    body {
        padding-top: 64px !important;
    }
    @media (max-width: 1280px) {
        body {
            padding-top: 60px !important;
        }
    }
    .motchill-section-title {
        color: #ffffff;
        font-weight: 900;
        font-size: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .motchill-section-title span.highlight {
        color: var(--primary-orange);
    }
    .motchill-filter-pill {
        background: rgba(255, 153, 0, 0.15);
        color: var(--primary-orange);
        border: 1px solid rgba(255, 153, 0, 0.3);
        font-size: 11px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
    }
    /* Feature Card Layout 1/3 vs 2/3 */
    .motchill-grid-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }
    @media (min-width: 1024px) {
        .motchill-grid-container {
            grid-template-columns: 3.5fr 8.5fr;
        }
    }
    .motchill-feature-card {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        background: var(--bg-card);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
        min-height: 420px;
    }
    .motchill-feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
        border-color: transparent;
    }
    .motchill-thumb-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }
    @media (min-width: 640px) {
        .motchill-thumb-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    .motchill-movie-card {
        position: relative;
        background: var(--bg-card);
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: all 0.3s ease;
    }
    .motchill-movie-card:hover {
        transform: translateY(-4px);
        border-color: transparent;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    }
    .motchill-poster-wrap {
        position: relative;
        aspect-ratio: 2/3;
        width: 100%;
        overflow: hidden;
    }
    .motchill-poster-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }
    .motchill-movie-card:hover .motchill-poster-wrap img {
        transform: scale(1.06);
    }
    .motchill-badge-stack {
        position: absolute;
        top: 8px;
        left: 8px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        z-index: 10;
    }
    .motchill-badge {
        font-size: 10px;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 4px;
        color: #fff;
        text-transform: uppercase;
        backdrop-filter: blur(4px);
    }
    .badge-orange { background: #f97316; }
    .badge-blue { background: #2563eb; }
    .badge-gold { background: #eab308; color: #000; }
    .badge-dark { background: rgba(0, 0, 0, 0.7); border: 1px solid rgba(255,255,255,0.2); }
</style>
