            <!-- Auth / Profile Container (Dynamically updated by user-ui.js when logged in) -->
            <div id="authContainer" style="display: inline-flex; align-items: center; gap: 10px;">
                <a href="#" onclick="if(window.showAuthModal){ event.preventDefault(); showAuthModal('login'); }"
                    class="sofa-icon-circle-btn" title="Thông báo" aria-label="Thông báo">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                        </path>
                    </svg>
                </a>
                <a href="/profile" onclick="if(window.showAuthModal){ event.preventDefault(); showAuthModal('login'); }"
                    class="sofa-login-rect-btn">Đăng nhập</a>
            </div>
            <script>
                // ⚡ ZERO-FLICKER INSTANT AUTH HYDRATION
                // Runs synchronously before the browser paints this section of the DOM
                (function () {
                    try {
                        var rawUser = localStorage.getItem('cinestream_user') || localStorage.getItem('A Phim_user') || localStorage.getItem('user');
                        var token = localStorage.getItem('cinestream_token');
                        if (rawUser && token) {
                            var u = JSON.parse(rawUser);
                            if (u && (u._id || u.id || u.name || u.displayName || u.email)) {
                                document.documentElement.classList.add('user-logged-in');
                                document.documentElement.classList.remove('user-guest');
                                var container = document.getElementById('authContainer');
                                if (container) {
                                    var userId = u._id || u.id || u.email;
                                    var displayName = u.displayName || u.name || u.fullName || 'Người dùng';
                                    var initial = displayName.charAt(0).toUpperCase();
                                    var avatarKey = userId ? ('avatar_' + userId) : 'user_avatar';
                                    var savedAvatar = (u.avatar || u.avatar_url) || localStorage.getItem(avatarKey) || localStorage.getItem('user_avatar') || '';

                                    // Unread notifications count
                                    var unreadCount = 0;
                                    var notifList = [];
                                    try {
                                        var rawNotifs = localStorage.getItem('ap_notifs_' + userId) || localStorage.getItem('cinestream_notifications');
                                        if (rawNotifs) {
                                            notifList = JSON.parse(rawNotifs);
                                            if (Array.isArray(notifList)) {
                                                unreadCount = notifList.filter(function (n) { return n && !n.isRead && !n.read; }).length;
                                            }
                                        }
                                    } catch (e) { }

                                    var frameId = (u.equippedFrame) || (u.equipped_frame) || localStorage.getItem('ap_frame_id') || localStorage.getItem('ap_equipped_frame') || '';
                                    var frameUrl = (u.equippedFrameUrl) || (u.equipped_frame_url) || localStorage.getItem('ap_frame_url') || localStorage.getItem('ap_equipped_frame_url') || '';
                                    var frameClass = (u.equippedFrameClass) || (u.equipped_frame_class) || localStorage.getItem('ap_frame_class') || '';

                                    if (!frameUrl && frameId) {
                                        if (typeof window.resolveFrameUrl === 'function') {
                                            frameUrl = window.resolveFrameUrl(frameId);
                                        } else if (window.DISCORD_FRAMES_MAP && window.DISCORD_FRAMES_MAP[frameId]) {
                                            frameUrl = window.DISCORD_FRAMES_MAP[frameId];
                                        }
                                        if (frameUrl) {
                                            try {
                                                localStorage.setItem('ap_frame_url', frameUrl);
                                                localStorage.setItem('ap_equipped_frame_url', frameUrl);
                                                u.equippedFrameUrl = frameUrl;
                                            } catch (e) { }
                                        }
                                    }

                                    var innerAvatar = savedAvatar
                                        ? '<img src="' + savedAvatar + '" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" onerror="this.outerHTML=\'<span style=\\\'color:#1a1100; font-weight:800; font-size:16px;\\\'>' + initial + '</span>\'"/>'
                                        : '<span style="color:#1a1100; font-weight:800; font-size:16px;">' + initial + '</span>';

                                    var avatarHtml = '';
                                    if (frameUrl) {
                                        avatarHtml = '<div class="user-avatar-frame-wrap" style="position:relative; display:inline-flex; align-items:center; justify-content:center; width:38px; height:38px; flex-shrink:0;">' +
                                            '<div class="user-avatar-inner" style="width:100%; height:100%; border-radius:50%; overflow:hidden; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #fcd576 0%, #f59e0b 100%) !important; position:relative; z-index:1; font-size:16px; font-weight:900; color:#1a1000 !important; box-shadow:0 4px 14px rgba(245,158,11,0.45);">' + innerAvatar + '</div>' +
                                            '<img src="' + frameUrl + '" style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); width:120%; height:120%; max-width:none; max-height:none; object-fit:contain; pointer-events:none; z-index:5;" alt="frame">' +
                                            '</div>';
                                    } else if (frameClass && frameClass !== 'none') {
                                        avatarHtml = '<div class="shop-frame-wrap size-xs ' + frameClass + '" style="width:38px; height:38px; flex-shrink:0; position:relative; z-index:2;">' + innerAvatar + '</div>';
                                    } else {
                                        avatarHtml = '<div class="ap-user-avatar-badge ap-avatar-no-frame" style="width:38px; height:38px; border-radius:50%; border:2px solid rgba(255,255,255,0.22); background:linear-gradient(135deg, #fcd576, #d97706); display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:900; color:#1a1000; overflow:hidden; flex-shrink:0; box-shadow:0 2px 8px rgba(0,0,0,0.2); position:relative; z-index:2;">' + innerAvatar + '</div>';
                                    }

                                    // Universal Navigation Handler for Profile Tabs (Keeps within Standalone PWA & handles in-page tabs)
                                    window.navigateToProfileTab = function (tabName, event) {
                                        if (event) {
                                            if (typeof event.preventDefault === 'function') event.preventDefault();
                                            if (typeof event.stopPropagation === 'function') event.stopPropagation();
                                        }
                                        if (typeof window.toggleUserNavDropdown === 'function') {
                                            window.toggleUserNavDropdown(null, false);
                                        } else {
                                            var dropdowns = document.querySelectorAll('.nav-profile-dropdown');
                                            dropdowns.forEach(function (d) { d.classList.remove('is-open'); });
                                            document.querySelectorAll('.ap-user-dropdown-menu').forEach(function (m) {
                                                m.style.opacity = '0';
                                                m.style.visibility = 'hidden';
                                            });
                                        }
                                        var targetTab = tabName || 'account';
                                        var targetUrl = '/profile?tab=' + encodeURIComponent(targetTab);
                                        if (window.location.pathname.startsWith('/profile')) {
                                            if (typeof window.switchTab === 'function') {
                                                window.switchTab(targetTab);
                                                try { history.replaceState(null, '', targetUrl); } catch (e) { }
                                                return;
                                            } else if (typeof window.switchProfileTab === 'function') {
                                                window.switchProfileTab(targetTab);
                                                try { history.replaceState(null, '', targetUrl); } catch (e) { }
                                                return;
                                            }
                                        }
                                        window.location.href = targetUrl;
                                    };

                                    var notifBadgeHtml = unreadCount > 0
                                        ? '<span id="navNotifBadge" class="nav-bell-badge" style="display:inline-flex;">' + (unreadCount > 99 ? '99+' : unreadCount) + '</span>'
                                        : '<span id="navNotifBadge" class="nav-bell-badge hidden" style="display:none;"></span>';

                                    var notifItemsHtml = '';
                                    if (Array.isArray(notifList) && notifList.length > 0) {
                                        notifItemsHtml = notifList.slice(0, 6).map(function(n) {
                                            if (!n || (!n.title && !n.message && !n.content)) return '';
                                            var isUnread = !n.isRead && !n.read;
                                            var notifId = n._id || n.id || '';
                                            var iconClass = 'system';
                                            var badgeText = 'Hệ thống';
                                            var iconSvg = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
                                            
                                            if (n.type === 'coin' || n.type === 'reward' || n.type === 'success') {
                                                iconClass = 'coin';
                                                badgeText = 'Xu & Quà';
                                                iconSvg = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 6.5v11"/></svg>';
                                            } else if (n.type === 'shop' || n.type === 'purchase') {
                                                iconClass = 'coin';
                                                badgeText = 'Cửa Hàng';
                                                iconSvg = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>';
                                            } else if (n.type === 'vip' || n.type === 'promotion') {
                                                iconClass = 'vip';
                                                badgeText = 'Ưu đãi VIP';
                                                iconSvg = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"/></svg>';
                                            } else if (n.type === 'movie') {
                                                iconClass = 'movie';
                                                badgeText = 'Phim mới';
                                                iconSvg = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.5"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg>';
                                            }
                                            var msgText = n.message || n.content || '';
                                            return '<div class="nav-notif-item ' + (isUnread ? 'unread' : 'read') + ' type-' + iconClass + '" onclick="event.stopPropagation(); if(window.handleNavNotifClick) window.handleNavNotifClick(\'' + notifId + '\');">' +
                                                '<div class="nav-notif-item-icon">' + iconSvg + '</div>' +
                                                '<div class="nav-notif-item-content">' +
                                                '<div class="nav-notif-item-top">' +
                                                '<span class="nav-notif-item-badge badge-' + iconClass + '">' + badgeText + '</span>' +
                                                '</div>' +
                                                '<div class="nav-notif-item-title">' + (n.title || 'Thông báo') + '</div>' +
                                                '<div class="nav-notif-item-msg">' + msgText + '</div>' +
                                                '</div>' +
                                                '</div>';
                                        }).join('');
                                    } else {
                                        notifItemsHtml = '<div class="nav-notif-empty">' +
                                            '<div class="nav-notif-empty-icon">' +
                                            '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/><line x1="2" y1="2" x2="22" y2="22"/></svg>' +
                                            '</div>' +
                                            '<div class="nav-notif-empty-title">Hộp thư thông báo trống</div>' +
                                            '<div class="nav-notif-empty-desc">Bạn đã xem hết các thông báo mới</div>' +
                                            '</div>';
                                    }

                                    var notifBell = '<div class="relative flex items-center" id="navNotificationBtn" onclick="if(window.toggleNavNotifPanel){window.toggleNavNotifPanel(event);}" style="cursor:pointer; z-index: 60; margin-right: 0px; flex-shrink:0;">' +
                                        '<button type="button" class="nav-bell-trigger relative" aria-label="Thông báo" title="Thông báo">' +
                                        '<svg class="nav-bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
                                        '<path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"></path>' +
                                        '</svg>' +
                                        notifBadgeHtml +
                                        '</button>' +
                                        '<div id="navNotifPanel" class="nav-notif-dropdown invisible opacity-0 translate-y-3 scale-95 transition-all duration-200">' +
                                        '<div id="notifArrow" class="nav-notif-arrow"></div>' +
                                        '<div class="nav-notif-header">' +
                                        '<div class="nav-notif-header-title">' +
                                        '<div class="nav-notif-title-row">' +
                                        '<span class="nav-notif-title-text">Thông Báo</span>' +
                                        '<span id="notifCountBadge" class="nav-notif-count-pill ' + (unreadCount > 0 ? '' : 'hidden') + '">' + unreadCount + ' Mới</span>' +
                                        '</div>' +
                                        '<span class="nav-notif-sub-text">Cập nhật tin tức &amp; ưu đãi VIP</span>' +
                                        '</div>' +
                                        '<button type="button" onclick="event.stopPropagation(); if(window.markAllNotifsRead) markAllNotifsRead();" class="nav-notif-mark-read-btn" title="Đánh dấu tất cả là đã đọc">' +
                                        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>' +
                                        '<span>Đã đọc</span>' +
                                        '</button>' +
                                        '</div>' +
                                        '<div id="notifListContainer" class="nav-notif-list custom-scrollbar">' + notifItemsHtml + '</div>' +
                                        '<div class="nav-notif-footer">' +
                                        '<a href="/profile?tab=notifications" class="nav-notif-view-all-btn">' +
                                        '<span>Xem tất cả thông báo</span>' +
                                        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">' +
                                        '<path d="M5 12h14M12 5l7 7-7 7"/>' +
                                        '</svg>' +
                                        '</a>' +
                                        '</div>' +
                                        '</div>' +
                                        '</div>';

                                    var profileLink = '<div id="userNavProfile" class="flex items-center" style="position: relative; z-index: 50; gap: 8px;" data-user-id="' + userId + '">' +
                                        notifBell +
                                        '<div class="relative group nav-profile-dropdown" style="padding: 0; overflow: visible !important;">' +
                                        '<div class="ap-user-bar-trigger flex items-center gap-2.5 px-2 py-1 rounded-full cursor-pointer transition-all duration-200" style="user-select: none;" title="' + displayName.replace(/"/g, '&quot;') + '" onclick="window.toggleUserNavDropdown(event)">' +
                                        avatarHtml +
                                        '<span class="ap-user-name-text" title="' + displayName.replace(/"/g, '&quot;') + '" style="font-size: 14.5px !important; font-weight: 900 !important; font-family: \'Montserrat\', \'Oswald\', \'Be Vietnam Pro\', system-ui, sans-serif !important; letter-spacing: 0.03em !important; text-transform: none !important; white-space: nowrap !important; max-width: 130px !important; overflow: hidden !important; text-overflow: ellipsis !important; vertical-align: middle !important;">' +
                                        displayName +
                                        '</span>' +
                                        '<svg class="ap-user-chevron-icon" style="width:14px; height:14px; flex-shrink:0; transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease; display:block;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">' +
                                        '<path d="m6 9 6 6 6-6"/>' +
                                        '</svg>' +
                                        '</div>' +
                                        '<div class="ap-user-dropdown-menu" style="position:absolute; right:0; top:calc(100% + 12px); opacity:0; visibility:hidden; transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s; z-index:999999; transform: scale(0.95) translateY(-6px); transform-origin: top right; width:280px; background:#1e2235; border:1px solid rgba(255,255,255,0.12); border-radius:20px; box-shadow:0 20px 60px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04); padding:20px 16px 16px 16px; backdrop-filter:blur(30px); -webkit-backdrop-filter:blur(30px);">' +
                                        '<div style="display:flex; align-items:center; gap:8px; padding:0 4px; margin-bottom:16px;">' +
                                        '<span class="ap-dropdown-user-name" onclick="window.navigateToProfileTab(\'account\', event)" style="color:#ffffff; font-size:16.5px; font-weight:900; font-family:\'Montserrat\', \'Oswald\', \'Be Vietnam Pro\', system-ui, sans-serif !important; letter-spacing:0.03em !important; text-transform:none !important; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:180px; display:inline-block; cursor:pointer;" title="' + displayName.replace(/"/g, '&quot;') + '">' + displayName + '</span>' +
                                        '<span class="ap-vip-modern-badge" title="Thành viên VIP" style="display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;">' +
                                        '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" style="display:block; filter:drop-shadow(0 2px 8px rgba(129,140,248,0.7));"><polygon points="12,1.5 9.5,9.5 12,12" fill="#a5b4fc"/><polygon points="12,1.5 14.5,9.5 12,12" fill="#818cf8"/><polygon points="22.5,12 14.5,9.5 12,12" fill="#c084fc"/><polygon points="22.5,12 14.5,14.5 12,12" fill="#f472b6"/><polygon points="12,22.5 14.5,14.5 12,12" fill="#ec4899"/><polygon points="12,22.5 9.5,14.5 12,12" fill="#7c3aed"/><polygon points="1.5,12 9.5,14.5 12,12" fill="#38bdf8"/><polygon points="1.5,12 9.5,9.5 12,12" fill="#67e8f9"/><polygon points="12,8.5 13.8,12 12,15.5 10.2,12" fill="#ffffff" opacity="0.9"/></svg>' +
                                        '</span>' +
                                        '<button type="button" class="ap-user-menu-close" onclick="window.toggleUserNavDropdown(event, false)" title="Đóng menu" style="margin-left:auto; width:28px; height:28px; border-radius:9px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.06); display:flex; align-items:center; justify-content:center; cursor:pointer; color:rgba(255,255,255,0.7); transition:all 0.2s ease;">' +
                                        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
                                        '</button>' +
