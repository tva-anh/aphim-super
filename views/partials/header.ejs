                                    // Global dropdown toggle cho User Profile Menu
                                    window.toggleUserNavDropdown = function(e, forceState) {
                                        if (e) {
                                            if (typeof e.preventDefault === 'function') e.preventDefault();
                                            if (typeof e.stopPropagation === 'function') e.stopPropagation();
                                        }
                                        var dropdowns = document.querySelectorAll('.nav-profile-dropdown');
                                        if (!dropdowns.length) return;

                                        dropdowns.forEach(function(dropdown) {
                                            var isOpen = dropdown.classList.contains('is-open');
                                            var nextState = (typeof forceState === 'boolean') ? forceState : !isOpen;

                                            if (nextState) {
                                                document.querySelectorAll('.sofa-logo-box.is-open').forEach(function(b) {
                                                    b.classList.remove('is-open');
                                                });
                                                var panel = document.getElementById('navNotifPanel');
                                                if (panel && panel.classList.contains('opacity-100')) {
                                                    panel.classList.add('invisible', 'opacity-0', 'scale-95', 'translate-y-3');
                                                    panel.classList.remove('opacity-100', 'visible', 'scale-100', 'translate-y-0');
                                                }
                                                dropdown.classList.remove('is-closing');
                                                dropdown.classList.add('is-open');
                                            } else {
                                                dropdown.classList.remove('is-open');
                                                dropdown.classList.add('is-closing');
                                                setTimeout(function() {
                                                    dropdown.classList.remove('is-closing');
                                                }, 300);
                                            }
                                        });
                                    };

                                    // Global dropdown toggle cho Notification Panel
                                    window.toggleNavNotifPanel = function(e) {
                                        if (e && e.stopPropagation) e.stopPropagation();
                                        var panel = document.getElementById('navNotifPanel');
                                        if (!panel) return;
                                        var isVisible = panel.classList.contains('opacity-100') && !panel.classList.contains('invisible');
                                        if (isVisible) {
                                            panel.classList.add('invisible', 'opacity-0', 'scale-95', 'translate-y-3');
                                            panel.classList.remove('opacity-100', 'visible', 'scale-100', 'translate-y-0');
                                        } else {
                                            panel.classList.remove('invisible', 'opacity-0', 'scale-95', 'translate-y-3');
                                            panel.classList.add('opacity-100', 'visible', 'scale-100', 'translate-y-0');
                                            if (typeof window.renderNotifications === 'function') {
                                                try { window.renderNotifications(); } catch (err) { }
                                            }
                                            if (typeof window.syncNotifications === 'function') {
                                                try { window.syncNotifications(true); } catch (err) { }
                                            }
                                        }
                                    };

                                    if (!document._apDropdownClickGuard) {
                                        document._apDropdownClickGuard = true;
                                        var closeDropdownsOutside = function(e) {
                                            if (!e.target.closest('#navNotificationBtn')) {
                                                var panel = document.getElementById('navNotifPanel');
                                                if (panel && panel.classList.contains('opacity-100')) {
                                                    panel.classList.add('invisible', 'opacity-0', 'scale-95', 'translate-y-3');
                                                    panel.classList.remove('opacity-100', 'visible', 'scale-100', 'translate-y-0');
                                                }
                                            }
                                            if (!e.target.closest('.nav-profile-dropdown')) {
                                                document.querySelectorAll('.nav-profile-dropdown.is-open').forEach(function(dropdown) {
                                                    dropdown.classList.remove('is-open');
                                                    dropdown.classList.add('is-closing');
                                                    setTimeout(function() { dropdown.classList.remove('is-closing'); }, 300);
                                                });
                                            }
                                        };
                                        document.addEventListener('click', closeDropdownsOutside);
                                        document.addEventListener('touchend', closeDropdownsOutside, { passive: true });
                                    }
                                }
                            }
                        }
                    } catch (e) { }
                })();
            </script>
        </div>
    </div>
</header>

