            <script>
                // ⚡ ZERO-FLICKER INSTANT AUTH HYDRATION
                // Runs synchronously before the browser paints this section of the DOM
                (function () {
                    try {
                        var rawUser = localStorage.getItem('cinestream_user') || localStorage.getItem('A Phim_user') || localStorage.getItem('user');
                        var token = localStorage.getItem('cinestream_token');
                        if (rawUser && token) {
                            var u = JSON.parse(rawUser);
                            if (u && (u._id || u.id || u.name || u.displayName || u.email)) {
                                document.documentElement.classList.add('user-logged-in');
                                document.documentElement.classList.remove('user-guest');
                                var container = document.getElementById('authContainer');
                                if (container) {
                                    var userId = u._id || u.id || u.email;
                                    var displayName = u.displayName || u.name || u.fullName || 'Người dùng';
                                    var initial = displayName.charAt(0).toUpperCase();
                                    var avatarKey = userId ? ('avatar_' + userId) : 'user_avatar';
                                    var savedAvatar = (u.avatar || u.avatar_url) || localStorage.getItem(avatarKey) || localStorage.getItem('user_avatar') || '';

                                    // Unread notifications count
                                    var unreadCount = 0;
                                    var notifList = [];
                                    try {
                                        var rawNotifs = localStorage.getItem('ap_notifs_' + userId) || localStorage.getItem('cinestream_notifications');
                                        if (rawNotifs) {
                                            notifList = JSON.parse(rawNotifs);
                                            if (Array.isArray(notifList)) {
                                                unreadCount = notifList.filter(function (n) { return n && !n.isRead && !n.read; }).length;
                                            }
                                        }
                                    } catch (e) { }

                                    var frameUrl = (u.equippedFrameUrl) || localStorage.getItem('ap_frame_url') || localStorage.getItem('ap_equipped_frame_url') || '';
                                    var frameClass = (u.equippedFrameClass) || localStorage.getItem('ap_frame_class') || '';

                                    var innerAvatar = savedAvatar
