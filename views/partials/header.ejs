<script>
    function toggleMobileHeaderMenu() {
        const drawer = document.getElementById('sofa-mobile-drawer');
        if (drawer) drawer.classList.toggle('open');
    }

    function toggleMobileSearchOverlay() {
        const overlay = document.getElementById('sofa-mobile-search-overlay');
        if (!overlay) return;
        if (overlay.classList.contains('open')) {
            closeMobileSearchOverlay();
        } else {
            overlay.classList.add('open');
            const input = overlay.querySelector('input[name="keyword"]');
            if (input) setTimeout(() => input.focus(), 50);
        }
    }

    function closeMobileSearchOverlay() {
        const overlay = document.getElementById('sofa-mobile-search-overlay');
        if (overlay) overlay.classList.remove('open');
    }

    function toggleDrawerAccordion(id) {
        const target = document.getElementById(id);
        if (!target) return;
        const isActive = target.classList.contains('active');

        document.querySelectorAll('.drawer-accordion-item').forEach(item => {
            item.classList.remove('active');
        });

        if (!isActive) {
            target.classList.add('active');
        }
    }

    (function () {
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }

        let ticking = false;
        let scrollTimer = null;

        function hasHeroOrBackdrop() {
            const isDesktop = window.innerWidth >= 1024;
            const desktopHero = document.getElementById('desktopHeroShowcase');
            const isDesktopHeroActive = isDesktop && !!desktopHero;
            const hasPhimNganHero = !isDesktop && !!(
                (document.getElementById('asHeroSection') && (!document.getElementById('asMainHub') || document.getElementById('asMainHub').style.display !== 'none')) ||
                (document.getElementById('asDramaDetailView') && document.getElementById('asDramaDetailView').style.display !== 'none') ||
                document.body.classList.contains('page-detail-mode') ||
                (document.body.classList.contains('page-phim-ngan') && !document.body.classList.contains('page-library-mode') && !document.body.classList.contains('page-search-mode'))
            );
            return !!(
                isDesktopHeroActive ||
                hasPhimNganHero ||
                document.querySelector('.movie-hero-backdrop-wrap') ||
                document.getElementById('movieHeroBackdrop') ||
                (isDesktop && document.querySelector('.has-desktop-hero')) ||
                document.body.classList.contains('page-phim-detail')
            );
        }

        function updateSofaHeaderScroll() {
            const header = document.getElementById('sofa-header') || document.querySelector('header');
            if (!header) return;

            const scrollY = window.pageYOffset || document.documentElement.scrollTop || window.scrollY || 0;
            if (scrollY > 50) {
                header.classList.add('scrolled');
                if (hasHeroOrBackdrop()) {
                    header.style.removeProperty('background');
                    header.style.removeProperty('background-color');
                    header.style.removeProperty('border');
                    header.style.removeProperty('border-bottom');
                    header.style.removeProperty('box-shadow');
                    header.style.removeProperty('backdrop-filter');
                    header.style.removeProperty('-webkit-backdrop-filter');
                }
            } else {
                header.classList.remove('scrolled', 'sofa-header-scrolled');
                if (hasHeroOrBackdrop()) {
                    header.style.setProperty('background', 'transparent', 'important');
                    header.style.setProperty('background-color', 'transparent', 'important');
                    header.style.setProperty('border', 'none', 'important');
                    header.style.setProperty('border-bottom', 'none', 'important');
                    header.style.setProperty('box-shadow', 'none', 'important');
                    header.style.setProperty('backdrop-filter', 'none', 'important');
                    header.style.setProperty('-webkit-backdrop-filter', 'none', 'important');
                } else {
                    header.style.backgroundColor = '';
                    header.style.background = '';
                }
            }
            ticking = false;
        }

        function forceHeaderTopState() {
            const header = document.getElementById('sofa-header') || document.querySelector('header');
            if (header) {
                const scrollY = window.pageYOffset || document.documentElement.scrollTop || window.scrollY || 0;
                if (scrollY <= 50) {
                    header.classList.remove('scrolled', 'sofa-header-scrolled');
                    if (hasHeroOrBackdrop()) {
                        header.style.setProperty('background', 'transparent', 'important');
                        header.style.setProperty('background-color', 'transparent', 'important');
                        header.style.setProperty('border', 'none', 'important');
                        header.style.setProperty('border-bottom', 'none', 'important');
                        header.style.setProperty('box-shadow', 'none', 'important');
                        header.style.setProperty('backdrop-filter', 'none', 'important');
                        header.style.setProperty('-webkit-backdrop-filter', 'none', 'important');
                    } else {
                        header.style.backgroundColor = '';
                        header.style.background = '';
                    }
                }
            }
        }

        function onScroll() {
            if (!ticking) {
                requestAnimationFrame(updateSofaHeaderScroll);
                ticking = true;
            }
            if (!document.body.classList.contains('is-scrolling')) {
                document.body.classList.add('is-scrolling');
            }
            clearTimeout(scrollTimer);
            scrollTimer = setTimeout(function () {
                document.body.classList.remove('is-scrolling');
            }, 150);
        }

        // Run immediately
        forceHeaderTopState();

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('load', forceHeaderTopState);
        window.addEventListener('pageshow', forceHeaderTopState);
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', forceHeaderTopState);
        } else {
            forceHeaderTopState();
        }
    })();
</script>

<!-- 🚀 YouTube-style Global Top Loading Progress Bar -->
<div id="aphim-nav-progress"></div>

<script>
    /* ⚡ INSTANT RECOGNITION & SMART PREFETCH FOR REELS */
    (function () {
        var reelsPrefetched = false;

        function prefetchReelsNow() {
            if (reelsPrefetched) return;
            reelsPrefetched = true;
            try {
                var link = document.createElement('link');
                link.rel = 'prefetch';
                link.href = '/reels';
                link.as = 'document';
                document.head.appendChild(link);
                if (window.fetch) {
                    fetch('/reels', { priority: 'low' }).catch(function () { });
                }
            } catch (e) { }
        }

        function triggerNavProgress() {
            var bar = document.getElementById('aphim-nav-progress');
            if (!bar) return;
            bar.style.display = 'block';
            bar.style.width = '30%';
            setTimeout(function () {
                if (bar) bar.style.width = '88%';
            }, 50);
        }

        function setupInstantReelsInteraction() {
            var btns = document.querySelectorAll('.reels-nav-pill, .drawer-pill-btn.reels-pill, a[href="/reels"]');
            btns.forEach(function (btn) {
                // 1. Prefetch instantly upon mouse hover or initial touch
                btn.addEventListener('pointerenter', prefetchReelsNow, { passive: true, once: true });
                btn.addEventListener('touchstart', prefetchReelsNow, { passive: true, once: true });

                // 2. Immediate tactile feedback on press down (0ms latency recognition)
                btn.addEventListener('pointerdown', function () {
                    btn.classList.add('is-pressed');
                    triggerNavProgress();
                }, { passive: true });

                // Clear press state on release
                btn.addEventListener('pointerup', function () {
                    btn.classList.remove('is-pressed');
                }, { passive: true });
                btn.addEventListener('pointercancel', function () {
                    btn.classList.remove('is-pressed');
                }, { passive: true });

                // 3. Mark navigating on click/tap
                btn.addEventListener('click', function () {
                    btn.classList.add('is-navigating');
                    triggerNavProgress();
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupInstantReelsInteraction);
        } else {
            setupInstantReelsInteraction();
        }
    })();

    // Đồng bộ chuyển đổi logo mượt mà khi vào trang Phim Ngắn & xử lý click logo trên mobile
    function handleSofaLogoClick(event) {
        var isPn = (window.location.pathname.indexOf('/phim-ngan') === 0) ||
            document.body.classList.contains('page-phim-ngan') ||
            (document.getElementById('sofa-header') && document.getElementById('sofa-header').classList.contains('is-phim-ngan'));

        if (isPn) {
            // Ngăn trình duyệt reload lại trang trên mobile khi chạm/click logo
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            var box = document.getElementById('sofaLogoBox') || (event && event.currentTarget && event.currentTarget.closest('.sofa-logo-box'));
            if (!box) return;

            var wasOpen = box.classList.contains('is-open');

            // Đóng tất cả nếu đang mở
            document.querySelectorAll('.sofa-logo-box.is-open').forEach(function(b) {
                b.classList.remove('is-open');
            });

            if (!wasOpen) {
                box.classList.add('is-open');

                var closeDropdown = function (e) {
                    if (!box.contains(e.target)) {
                        box.classList.remove('is-open');
                        document.removeEventListener('click', closeDropdown, true);
                        document.removeEventListener('touchend', closeDropdown, true);
                    }
                };

                setTimeout(function () {
                    document.addEventListener('click', closeDropdown, true);
                    document.addEventListener('touchend', closeDropdown, true);
                }, 50);
            }
        }
    }

    window.handleLogoPhimNganClick = function (event) {
        document.querySelectorAll('.sofa-logo-box.is-open').forEach(function (b) {
            b.classList.remove('is-open');
        });

        if (typeof window.showPhimNganView === 'function') {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            try {
                if (window.location.pathname !== '/phim-ngan') {
                    window.history.pushState({ view: 'home' }, '', '/phim-ngan');
                }
            } catch (err) {}

            window.showPhimNganView('home');

            if (typeof window.syncBottomNavActive === 'function') {
                window.syncBottomNavActive('home');
            }
            if (typeof window.syncTopNavActive === 'function') {
                window.syncTopNavActive('home');
            }
            return false;
        }
        return true;
    };

    (function () {
        function syncPhimNganLogo() {
            var isPn = (window.location.pathname.indexOf('/phim-ngan') === 0);
            var header = document.getElementById('sofa-header');
            if (header) {
                header.classList.toggle('is-phim-ngan', isPn);
            }
            if (document.body) {
                document.body.classList.toggle('page-phim-ngan', isPn);
            }
        }
        syncPhimNganLogo();
        window.addEventListener('popstate', syncPhimNganLogo);

        // Đảm bảo click logo trên mobile/touch luôn kích hoạt mở dropdown
        document.addEventListener('DOMContentLoaded', function () {
            var link = document.getElementById('sofaLogoLink');
            if (link) {
                link.addEventListener('click', handleSofaLogoClick);
            }
        });
    })();
</script>

