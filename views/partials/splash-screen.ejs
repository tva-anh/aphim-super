<!-- ==============================================
     APHIM CINEMATIC BRAND SPLASH SCREEN & PAGE TRANSITION
     1 Nền chuẩn SofaFlix (#191b24) — 100% Pure CSS GPU Compositor (60-120fps)
     Không phụ thuộc Main Thread JS -> Không bao giờ khựng khung hình
     ============================================== -->
<script>
    /* ⚡ KIỂM TRA ĐIỀU HƯỚNG QUAY VỀ / CHUYỂN TRANG NỘI BỘ NGAY LẬP TỨC */
    (function () {
        var suppressSplash = false;
        try {
            if (sessionStorage.getItem('aphim_nav_direction') === 'back') {
                suppressSplash = true;
                sessionStorage.removeItem('aphim_nav_direction');
            }
            var nav = window.performance && window.performance.getEntriesByType && window.performance.getEntriesByType('navigation');
            if (nav && nav.length > 0 && nav[0].type === 'back_forward') {
                suppressSplash = true;
            } else if (window.performance && window.performance.navigation && window.performance.navigation.type === 2) {
                suppressSplash = true;
            }
            // Chỉ bật Splash Screen thương hiệu 0.72s ở lần đầu vào website trong phiên;
            // Khi bấm chuyển trang nội bộ (Trang chủ -> Phim / Xem phim / Danh mục) thì vào thẳng tức thì 0ms.
            if (sessionStorage.getItem('aphim_splash_shown_v1') === '1') {
                suppressSplash = true;
            } else if (document.referrer && document.referrer.indexOf(window.location.origin) === 0) {
                suppressSplash = true;
                sessionStorage.setItem('aphim_splash_shown_v1', '1');
            } else {
                sessionStorage.setItem('aphim_splash_shown_v1', '1');
            }
        } catch (e) {}

        var root = document.documentElement;
        if (suppressSplash) {
            root.classList.add('aphim-suppress-splash');
        } else {
            root.classList.remove('aphim-enter');
            root.classList.add('aphim-splash-active');
        }
    })();
</script>

<style>
    /* 1. Duy nhất 1 nền cố định #191b24 — Chạy 100% trên GPU Compositor Thread (chỉ animate opacity) */
    #aphim-splash-wrap {
        position: fixed;
        inset: 0;
        z-index: 9999999;
        background-color: #191b24;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        animation: aphimBodyLoadEffect 0.72s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        will-change: opacity;
        transform: translate3d(0, 0, 0);
        -webkit-transform: translate3d(0, 0, 0);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* 2. Khi lùi trang (Back) hoặc sau khi hiệu ứng kết thúc: Tắt hoàn toàn 0ms */
    html.aphim-suppress-splash #aphim-splash-wrap,
    #aphim-splash-wrap.is-suppressed {
        display: none !important;
        opacity: 0 !important;
        animation: none !important;
        will-change: auto !important;
    }

    .aphim-splash-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        width: 100%;
        max-width: min(1200px, 100vw - 48px);
        padding: 0 24px;
        gap: 2rem;
        user-select: none;
        -webkit-user-select: none;
        animation: aphimLogoLoad 0.72s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        will-change: transform, opacity;
        transform: translate3d(0, 0, 0);
        -webkit-transform: translate3d(0, 0, 0);
    }

    /* 🔥 HOẠT ẢNH NGUYÊN BẢN SOFAFLIX TRÊN GPU (CHỈ OPACITY & TRANSFORM — KHÔNG BAO GIỜ KHỰNG) 🔥 */
    @keyframes aphimBodyLoadEffect {
        0%   { opacity: 1; }
        62%  { opacity: 1; }
        100% { opacity: 0; }
    }

    @keyframes aphimLogoLoad {
        0%   { opacity: 1; transform: translate3d(0, 0, 0) scale(1.04); }
        48%  { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
        78%  { opacity: 0; transform: translate3d(0, 0, 0) scale(0.6); }
        100% { opacity: 0; transform: translate3d(0, 0, 0) scale(0.6); }
    }

    .aphim-splash-logo-box {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .aphim-splash-logo-box picture {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .aphim-splash-logo {
        width: 60%;
        max-width: 320px;
        min-width: 200px;
        height: auto;
        display: block;
        margin: 0 auto;
    }

    .aphim-splash-text {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: rgba(255, 255, 255, 0.75);
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: -0.015em;
        gap: 0.35rem;
    }

    .aphim-splash-line1 {
        font-size: clamp(1.05rem, 2.2vw, 2.05rem);
        white-space: nowrap;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.78);
        line-height: 1.4;
        letter-spacing: -0.01em;
    }

    .aphim-splash-line2 {
        font-size: clamp(0.95rem, 1.9vw, 1.8rem);
        white-space: normal;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.68);
        line-height: 1.4;
        letter-spacing: -0.01em;
    }

    @media (min-width: 640px) {
        .aphim-splash-line2 {
            white-space: nowrap;
        }
    }
</style>

<div id="aphim-splash-wrap" role="status" aria-label="Đang tải trang">
    <div class="aphim-splash-inner">
        <div class="aphim-splash-logo-box">
            <picture>
                <source srcset="/logo-aphim-splash.webp" type="image/webp">
                <source srcset="/logo-aphim1.webp" type="image/webp">
                <img src="/logo-aphim1.png" alt="APhim" class="aphim-splash-logo" width="480" height="200" fetchpriority="high" decoding="async">
            </picture>
        </div>
        <div class="aphim-splash-text">
            <span class="aphim-splash-line1">Xem Phim Miễn Phí Cực Nhanh FullHD</span>
            <span class="aphim-splash-line2">Cập Nhật Liên Tục</span>
        </div>
    </div>
</div>

<script>
    (function () {
        var splash = document.getElementById('aphim-splash-wrap');
        if (!splash) return;

        var root = document.documentElement;

        function hideSplashCleanly() {
            if (!splash) return;
            splash.classList.add('is-suppressed');
            splash.style.setProperty('display', 'none', 'important');
            root.classList.remove('aphim-splash-active');
        }

        if (root.classList.contains('aphim-suppress-splash')) {
            hideSplashCleanly();
        } else {
            splash.addEventListener('animationend', function (e) {
                if (e.target === splash) {
                    hideSplashCleanly();
                }
            });
            setTimeout(hideSplashCleanly, 760);
        }

        // Khi người dùng bấm nút Back hoặc khôi phục từ bfcache: tắt ngay 0ms
        window.addEventListener('popstate', function () {
            try { sessionStorage.setItem('aphim_nav_direction', 'back'); } catch (e) {}
            hideSplashCleanly();
        });

        window.addEventListener('pageshow', function (e) {
            var isBack = e.persisted;
            try {
                var nav = window.performance && window.performance.getEntriesByType && window.performance.getEntriesByType('navigation');
                if (nav && nav.length > 0 && nav[0].type === 'back_forward') isBack = true;
                if (sessionStorage.getItem('aphim_nav_direction') === 'back') {
                    isBack = true;
                    sessionStorage.removeItem('aphim_nav_direction');
                }
            } catch (err) {}

            if (isBack) {
                hideSplashCleanly();
            }
        });
    })();
</script>
