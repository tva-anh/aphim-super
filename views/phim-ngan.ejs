            /* ── Mini Player Theme: Giao diện Sáng (Light Mode) thẩm mỹ tinh tế ── */
            html.light-mode .as-miniplayer {
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 248, 252, 0.98) 100%) !important;
