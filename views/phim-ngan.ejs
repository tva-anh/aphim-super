                        if (path.includes('/xem/') || path.includes('/thong-tin/')) {
                            // Đang ở trang xem/chi tiết -> hiện lại trang chi tiết và render đúng dữ liệu
                            const dramaMatch = path.match(/\/(?:xem|thong-tin)\/([^\/?#]+)/);
