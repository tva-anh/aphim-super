                                    tập
                                </div>
                                <div class="as-sidebar-ep-grid" id="asSidebarEpGrid">
                                    <!-- Render các nút tập 1, 2, 3... 6 cột -->
                                </div>
                            </div>

                            <!-- Bình Luận Trong Sidebar (Hình 1) -->
                            <div class="as-sidebar-comments-block">
                                <div class="as-sidebar-comments-title">Bình luận</div>
                                <form class="as-sidebar-comment-form" id="asSidebarCommentForm"
                                    onsubmit="event.preventDefault(); submitSidebarComment();">
                                    <input type="text" class="as-sidebar-comment-input" id="asSidebarCommentInput"
                                        maxlength="200" placeholder="Viết bình luận của bạn..." autocomplete="off">
                                    <button type="submit" class="as-sidebar-comment-send">Gửi</button>
                                </form>
                                <div class="as-sidebar-comment-hint">Mọi người xem phim này đều thấy bình luận của bạn.
                                </div>
                                <div id="asSidebarCommentsList" class="as-sidebar-comments-list"></div>
                                <div class="as-sidebar-comments-empty" id="asSidebarCommentsEmpty">
                                    Chưa có bình luận. Hãy là người đầu tiên!
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== MINI PLAYER: phim tiếp tục phát ở góc dưới khi thoát trình phát ===== -->
                <div class="as-miniplayer" id="asMiniPlayer" onclick="expandMiniPlayer()">
                    <div class="as-miniplayer-main">
                        <div class="as-miniplayer-video" id="asMiniVideoBox" onclick="expandMiniPlayer()"
                            title="Mở rộng trình phát"></div>
                        <div class="as-miniplayer-body" onclick="expandMiniPlayer()">
                            <div class="as-miniplayer-head">
                                <div class="as-miniplayer-meta">
                                    <div class="as-miniplayer-title" id="asMiniTitle">Đang phát</div>
                                    <div class="as-miniplayer-sub" id="asMiniSub">Tập 1</div>
                                </div>
                                <button class="as-mini-close" onclick="event.stopPropagation(); closeMiniPlayer();"
                                    title="Đóng">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="6" x2="6" y2="18" />
                                        <line x1="6" y1="6" x2="18" y2="18" />
                                    </svg>
                                </button>
                            </div>
                            <div class="as-miniplayer-bar" id="asMiniBar" onclick="event.stopPropagation(); seekMiniBar(event);">
                                <div class="as-miniplayer-bar-fill" id="asMiniBarFill"></div>
                            </div>
                            <div class="as-miniplayer-foot" onclick="event.stopPropagation();">
                                <div class="as-miniplayer-ctrl">
                                    <button class="as-mini-btn" onclick="event.stopPropagation(); miniSeek(-10);"
                                        title="Lùi 10 giây">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                                            <path d="M3 3v5h5" />
                                            <text x="12" y="15.5" text-anchor="middle" font-size="8.5" font-weight="800"
                                                font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"
                                                stroke="none" fill="currentColor">10</text>
                                        </svg>
                                    </button>
                                    <button class="as-mini-btn as-mini-play-btn" id="asMiniPlayBtn"
                                        onclick="event.stopPropagation(); toggleMiniPlay();" title="Phát/Tạm dừng">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="7 4 20 12 7 20 7 4" />
                                        </svg>
                                    </button>
                                    <button class="as-mini-btn" onclick="event.stopPropagation(); miniSeek(10);"
                                        title="Tiến 10 giây">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <path d="M21 12a9 9 0 1 1-9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                                            <path d="M21 3v5h-5" />
                                            <text x="12" y="15.5" text-anchor="middle" font-size="8.5" font-weight="800"
                                                font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"
                                                stroke="none" fill="currentColor">10</text>
                                        </svg>
                                    </button>
                                    <button class="as-mini-btn as-mini-expand-btn"
                                        onclick="event.stopPropagation(); expandMiniPlayer();"
                                        title="Mở rộng trình phát">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <path
                                                d="M7 4H5a2 2 0 0 0-2 2v2m16 0V6a2 2 0 0 0-2-2h-2m0 16h2a2 2 0 0 0 2-2v-2m-16 0v2a2 2 0 0 0 2 2h2" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer: Chỉ hiển thị ở các trang có danh sách cuộn (Trang chủ, Tìm kiếm, Thư viện), ẩn hoàn toàn ở Đề xuất -->
                <div id="asSiteFooterWrap"
                    style="<%= (typeof pnView !== 'undefined' && pnView === 'recommend') ? 'display:none;' : '' %>">
                    <%- include('partials/footer') %>
                </div>

                <!-- CLIENT SCRIPT -->
                <script>
                    const HERO_ITEMS = <%- JSON.stringify((typeof heroDramas !== 'undefined' && heroDramas && heroDramas.length > 0) ? heroDramas.slice(0, 6) : []) %>;
                    const PRIMARY_HERO = <%- JSON.stringify((typeof primaryHero !== 'undefined' && primaryHero) ? primaryHero : ((heroDramas && heroDramas.length > 0) ? heroDramas[0] : null)) %>;
                    const TRENDING_DRAMAS = <%- JSON.stringify((typeof trendingDramas !== 'undefined' && trendingDramas) ? [...trendingDramas].slice(0, 12) : []) %>;
                    const SEARCH_POOL = <%- JSON.stringify(typeof SEARCH_POOL_ITEMS !== 'undefined' ? SEARCH_POOL_ITEMS : []) %>;
                    const SEARCH_GENRES = <%- JSON.stringify(typeof SEARCH_GENRE_TITLES !== 'undefined' ? SEARCH_GENRE_TITLES : []) %>;
                    const SUGGEST_DRAMAS = <%- JSON.stringify([...(typeof latestDramas !== 'undefined' && latestDramas ? latestDramas : []), ...(typeof trendingDramas !== 'undefined' && trendingDramas ? trendingDramas : [])].slice(0, 12)) %>;
                    const INITIAL_REC_DRAMA = <%- JSON.stringify((typeof recDrama !== 'undefined' && recDrama) ? recDrama : null) %>;
                    const ALL_RECOMMEND_DRAMAS = <%- JSON.stringify([
                        ...(typeof heroDramas !== 'undefined' && heroDramas ? heroDramas : []),
                        ...(typeof trendingDramas !== 'undefined' && trendingDramas ? trendingDramas : []),
                        ...(typeof top10Dramas !== 'undefined' && top10Dramas ? top10Dramas : []),
                        ...(typeof popularDramas !== 'undefined' && popularDramas ? popularDramas : []),
                        ...(typeof latestDramas !== 'undefined' && latestDramas ? latestDramas : [])
                    ].map(d => ({
                        id: d.id,
                        slug: d.slug,
                        title: d.title,
                        cover: d.cover,
                        genre: d.genre,
                        totalEpisodes: d.totalEpisodes || 50,
                        streamUrl: d.streamUrl || '',
                        stats: d.stats,
                        labels: d.labels,
                        source: d.source
                    }))) %>;

                    // =======================================================
                    // 🛑 QUẢN LÝ DỪNG PHÁT VÀ TRIỆT TIÊU ÂM THANH CHẠY NGẦM
                    // =======================================================
                    var readyBadgeInterval = null;
                    var activeSubPoller = null;
                    var currentCues = [];

                    function stopCinemaPlayback(options = {}) {
                        const keepMini = options && options.keepMini === true;

                        // 1. Dừng các timer polling phụ đề và badge (nếu không giữ mini)
                        if (!keepMini) {
                            if (readyBadgeInterval) {
                                clearInterval(readyBadgeInterval);
                                readyBadgeInterval = null;
                            }
                            if (activeSubPoller) {
                                clearInterval(activeSubPoller);
                                activeSubPoller = null;
                            }
                            if (window._asSubInterval) {
                                clearInterval(window._asSubInterval);
                                window._asSubInterval = null;
                            }
                        }

                        // 2. Gỡ bỏ mọi listener tự bật lại âm thanh khi người dùng click/chạm
                        if (typeof window._asAutoplayCleanup === 'function') {
                            try { window._asAutoplayCleanup(); } catch (e) { }
                            window._asAutoplayCleanup = null;
                        }
                        if (typeof window._asReelsAutoplayCleanup === 'function') {
                            try { window._asReelsAutoplayCleanup(); } catch (e) { }
                            window._asReelsAutoplayCleanup = null;
                        }
                        if (typeof recSubPoller !== 'undefined' && recSubPoller) {
                            try { clearInterval(recSubPoller); } catch (e) { }
                            recSubPoller = null;
                        }

                        // 3. Dừng và giải phóng HLS + video element chính (CHỈ khi không giữ lại Mini Player)
                        const videoEl = document.getElementById('asVideoEl');
                        if (!keepMini && videoEl) {
                            videoEl.onerror = null;
                            videoEl.onplaying = null;
                            videoEl.ontimeupdate = null;
                            videoEl.onended = null;
                            videoEl.onpause = null;
                            if (videoEl._rescueTimer) {
                                clearTimeout(videoEl._rescueTimer);
                                videoEl._rescueTimer = null;
                            }
                            if (videoEl._spinnerSafety) {
                                clearTimeout(videoEl._spinnerSafety);
                                videoEl._spinnerSafety = null;
                            }
                            if (videoEl._spinnerGuard) {
                                clearInterval(videoEl._spinnerGuard);
                                videoEl._spinnerGuard = null;
                            }
                            try { videoEl.pause(); videoEl.muted = true; } catch (e) { }
                            if (videoEl._hlsInstance) {
                                try {
                                    videoEl._hlsInstance.stopLoad();
                                    videoEl._hlsInstance.detachMedia();
                                    videoEl._hlsInstance.destroy();
                                } catch (e) { }
                                videoEl._hlsInstance = null;
                            }
                            try {
                                videoEl.removeAttribute('src');
                                videoEl.src = '';
                                videoEl.load();
                            } catch (e) { }
                        }

                        // 3b. 🔥 DỪNG TRIỆT ĐỂ TẤT CẢ VIDEO KHÁC TRÊN TRANG (Reels, Đề xuất nền, v.v.)
                        const recVideo = document.getElementById('asRecVideoElement');
                        if (recVideo) {
                            try {
                                recVideo.pause();
                                recVideo.muted = true;
                                if (recVideo._hlsInstance) {
                                    try {
                                        recVideo._hlsInstance.stopLoad();
                                        recVideo._hlsInstance.detachMedia();
                                        recVideo._hlsInstance.destroy();
                                    } catch (e) { }
                                    recVideo._hlsInstance = null;
                                }
                            } catch (e) { }
                        }
                        const reelsVideo = document.getElementById('asReelsVideo');
                        if (reelsVideo) {
                            try {
                                reelsVideo.pause();
                                reelsVideo.muted = true;
                            } catch (e) { }
                        }

                        document.querySelectorAll('video').forEach(v => {
                            if (keepMini && v === videoEl) return;
                            try {
                                v.pause();
                                v.muted = true;
                                if (v._hlsInstance) {
                                    try {
                                        v._hlsInstance.stopLoad();
                                        v._hlsInstance.detachMedia();
                                        v._hlsInstance.destroy();
                                    } catch (e) { }
                                    v._hlsInstance = null;
                                }
                                if (v !== videoEl && v !== recVideo) {
                                    try {
                                        v.removeAttribute('src');
                                        v.src = '';
                                        v.load();
                                    } catch (e) { }
                                }
                            } catch (e) { }
                        });

                        // 4. Xóa sạch overlay phụ đề (chỉ khi không giữ Mini Player)
                        if (!keepMini) {
                            const subOverlay = document.getElementById('asSubOverlay');
                            if (subOverlay) subOverlay.textContent = '';
                            currentCues = [];
                        }

                        // 5. Đóng sạch mini player nếu không giữ lại (chỉ đóng khi mini đang chạy và không kích hoạt restoreView)
                        if (!keepMini) {
                            const mini = document.getElementById('asMiniPlayer');
                            if (miniPlayerActive || (mini && mini.classList.contains('active'))) {
                                if (typeof closeMiniPlayer === 'function') {
                                    closeMiniPlayer({ restoreView: false, fromStopPlayback: true });
                                } else if (typeof dismissMiniPlayerForNewWatch === 'function') {
                                    dismissMiniPlayerForNewWatch();
                                }
                            }
                            try { localStorage.removeItem('aphim_pn_mini_state'); } catch (e) { }
                        }
                    }
                    window.stopCinemaPlayback = stopCinemaPlayback;

                    // =======================================================
                    // 🧭 ĐIỀU HƯỚNG 4 VIEW: Trang chủ / Đề xuất / Tìm kiếm / Thư viện (SPA Siêu Mượt)
                    // =======================================================
                    let _isShowingPhimNganView = false;
                    function showPhimNganView(view) {
                        if (_isShowingPhimNganView) return;
                        _isShowingPhimNganView = true;
                        try {
                        // Rời trang Đề xuất (hoặc vào lại nó) thì thoát fullscreen để
                        // không bị kẹt lớp fullscreen che trang
                        const prevFs = document.fullscreenElement || document.webkitFullscreenElement;
                        if (prevFs && document.getElementById('asRecommendView') &&
                            document.getElementById('asRecommendView').contains(prevFs) && view !== 'recommend') {
                            forceExitFullscreen();
                        }

                        // Rời trang xem: Nếu vào tab Đề xuất (reels riêng) thì đóng mini player để tránh xung đột âm thanh
                        if (view === 'recommend') {
                            stopCinemaPlayback({ keepMini: false });
                        } else if (!miniPlayerActive) {
                            stopCinemaPlayback({ keepMini: false });
                        } else {
                            // Mini player đang chạy: chỉ tắt video Đề xuất/Reels nền
                            const recVideo = document.getElementById('asRecVideoElement');
                            if (recVideo) { try { recVideo.pause(); recVideo.muted = true; } catch (e) { } }
                        }

                        // Tắt âm thanh/video tab Đề xuất (reels) nếu chuyển sang tab khác
                        if (view !== 'recommend') {
                            const recVideo = document.getElementById('asRecVideoElement');
                            if (recVideo) {
                                try { recVideo.pause(); recVideo.muted = true; } catch (e) { }
                            }
                            if (typeof recSubPoller !== 'undefined' && recSubPoller) {
                                clearInterval(recSubPoller);
                                recSubPoller = null;
                            }
                            if (typeof window._asReelsAutoplayCleanup === 'function') {
                                try { window._asReelsAutoplayCleanup(); } catch (e) { }
                                window._asReelsAutoplayCleanup = null;
                            }
                        }

                        /* AN TOÀN: nếu rạp chiếu đang mở mà chuyển sang tab danh sách thì
                           PHẢI đóng rạp chiếu trước. Nếu không, CSS
                           body:has(.as-cinema-modal.active) #asMainHub sẽ ẩn main hub
                           trong khi rạp chiếu cũng không hiện -> trang TRẮNG. */
                        {
                            const modal = document.getElementById('asTheaterModal');
                            if (modal && modal.classList.contains('active')) {
                                modal.classList.remove('active', 'mobile-fs', 'cinema-fs');
                                modal.style.setProperty('display', 'none', 'important');
                                modal.style.pointerEvents = 'none';
                                document.body.style.overflow = '';
                                if (typeof forceExitFullscreen === 'function') forceExitFullscreen();
                            }
                        }
                        const hub = document.getElementById('asMainHub');
                        const search = document.getElementById('asSearchView');
                        const library = document.getElementById('asLibraryView');
                        const recommend = document.getElementById('asRecommendView');
                        const detailView = document.getElementById('asDramaDetailView');
                        const footerWrap = document.getElementById('asSiteFooterWrap');

                        // Ẩn trang chi tiết khi chuyển sang các tab danh sách
                        if (detailView) {
                            detailView.style.removeProperty('display');
                            detailView.style.setProperty('display', 'none', 'important');
                            detailView.classList.remove('as-view-active-enter');
                        }

                        // Xóa animation enter cũ để kích hoạt lại mượt mà
                        [hub, search, library, recommend].forEach(el => {
                            if (el) el.classList.remove('as-view-active-enter');
                        });

                        let activeEl = null;
                        // Xóa sạch thuộc tính display cũ có !important để tránh bị kẹt không hiển thị
                        if (hub) {
                            hub.style.removeProperty('display');
                            hub.style.removeProperty('visibility');
                            hub.style.removeProperty('pointer-events');
                            const isHome = (view === 'home' || !view);
                            hub.style.display = isHome ? '' : 'none';
                            if (isHome) {
                                activeEl = hub;
                                hub.style.removeProperty('display');
                            }
                        }
                        if (search) {
                            search.style.removeProperty('display');
                            search.style.removeProperty('visibility');
                            search.style.removeProperty('pointer-events');
                            search.style.display = (view === 'search') ? 'block' : 'none';
                            if (view === 'search') {
                                activeEl = search;
                                search.style.removeProperty('display');
                                search.style.setProperty('display', 'block', 'important');
                                if (typeof renderSearchResults === 'function') {
                                    renderSearchResults();
                                }
                            }
                        }
                        if (library) {
                            library.style.removeProperty('display');
                            library.style.removeProperty('visibility');
                            library.style.removeProperty('pointer-events');
                            library.style.display = (view === 'library') ? 'block' : 'none';
                            if (view === 'library') {
                                activeEl = library;
                                library.style.removeProperty('display');
                                library.style.setProperty('display', 'block', 'important');
                            }
                        }
                        if (recommend) {
                            recommend.style.removeProperty('display');
                            recommend.style.removeProperty('pointer-events');
                            recommend.style.removeProperty('visibility');
                            recommend.style.removeProperty('z-index');
                            recommend.style.display = (view === 'recommend') ? 'flex' : 'none';
                            if (view === 'recommend') {
                                activeEl = recommend;
                                recommend.style.removeProperty('display');
                                recommend.style.setProperty('display', 'flex', 'important');
                            }
                        }
                        if (footerWrap) {
                            footerWrap.style.removeProperty('display');
                            footerWrap.style.display = (view === 'recommend') ? 'none' : '';
                        }

                        // Kích hoạt hiệu ứng fade-lift mượt mà cho view được chọn
                        if (activeEl) {
                            activeEl.style.removeProperty('display');
                            if (view === 'recommend') activeEl.style.setProperty('display', 'flex', 'important');
                            else if (view === 'home') activeEl.style.display = '';
                            else activeEl.style.setProperty('display', 'block', 'important');
                            void activeEl.offsetWidth;
                            activeEl.classList.add('as-view-active-enter');
                        }

                        document.body.classList.remove('page-detail-mode');
                        document.body.classList.toggle('page-recommend-mode', view === 'recommend');
                        if (view !== 'recommend') {
                            document.body.style.overflow = '';
                            document.body.style.height = '';
                            document.body.style.touchAction = '';
                            document.documentElement.style.overflow = '';
                        }
                        // Cuộn tức thì: cuộn mượt gây cảm giác chậm khi đổi trang
                        window.scrollTo(0, 0);
                        try {
                            window.dispatchEvent(new Event('scroll'));
                        } catch (e) { }
                        if (view === 'library') {
                            const path = window.location.pathname;
                            let tab = currentLibraryTab || 'recent';
                            if (path.endsWith('/yeu-thich')) tab = 'fav';
                            else if (path.endsWith('/danh-sach-phat')) tab = 'playlist';
                            else if (path.endsWith('/da-xem')) tab = 'recent';
                            switchLibraryTab(tab, null, false);
                        }
                        if (view === 'recommend') initRecommendReels();

                        // Cập nhật Document Title chuẩn SEO cho từng tab
                        const viewTitles = {
                            'home': 'Phim Ngắn APhim - Kho Phim Đứng Full HD Vietsub Mới Nhất 2026',
                            'recommend': 'Đề xuất Phim Ngắn - Kịch Tính & Lôi Cuốn | APhim',
                            'search': 'Tìm kiếm Phim Ngắn | APhim',
                            'library': 'Thư viện Phim Ngắn Của Bạn | APhim'
                        };
                        if (viewTitles[view]) {
                            document.title = viewTitles[view];
                        }

                        // Đồng bộ trạng thái active trên Bottom Nav & Header Nav
                        syncTopNavActive(view);
                        if (typeof syncBottomNavActive === 'function') {
                            syncBottomNavActive(view);
                        }
                    } finally {
                        _isShowingPhimNganView = false;
                    }
                }
                window.showPhimNganView = showPhimNganView;

                    function syncTopNavActive(view) {
                        const navLinks = document.querySelectorAll('.as-nav-links .as-nav-link, .sofa-nav-links .as-pn-nav-link');
                        if (!navLinks.length) return;
                        const viewMap = {
                            'home': '/phim-ngan',
                            'recommend': '/phim-ngan/de-xuat',
                            'search': '/phim-ngan/tim-kiem',
                            'library': '/phim-ngan/thu-vien'
                        };
                        const targetHref = viewMap[view] || '/phim-ngan';
                        navLinks.forEach(link => {
                            const href = link.getAttribute('href');
                            const isMatch = (view !== 'detail' && (
                                href === targetHref ||
                                (view === 'home' && (href === '/phim-ngan' || href === '/phim-ngan/')) ||
                                (view === 'library' && (href === '/phim-ngan/thu-vien' || (href && href.startsWith('/phim-ngan/thu-vien/'))))
                            ));
                            link.classList.toggle('active', isMatch);
                            let dot = link.querySelector('.as-pn-dot');
                            if (isMatch) {
                                if (!dot) {
                                    dot = document.createElement('span');
                                    dot.className = 'as-pn-dot';
                                    link.appendChild(dot);
                                }
                                dot.style.display = '';
                            } else if (dot) {
                                dot.style.display = 'none';
                            }
                        });
                    }
                    window.syncTopNavActive = syncTopNavActive;

                    window.handlePhimNganTabClick = function (e, tab) {
                        if (e) {
                            try { e.preventDefault(); e.stopPropagation(); } catch (err) {}
                        }
                        const targetUrl = tab === 'recommend' ? '/phim-ngan/de-xuat' :
                                          tab === 'search' ? '/phim-ngan/tim-kiem' :
                                          tab === 'library' ? '/phim-ngan/thu-vien' : '/phim-ngan';
                        try {
                            if (window.location.pathname !== targetUrl) {
                                window.history.pushState({ view: tab }, '', targetUrl);
                            }
                        } catch (err) {}

                        if (typeof showPhimNganView === 'function') {
                            showPhimNganView(tab);
                        }
                        if (tab === 'recommend') {
                            document.title = 'Bảng Xếp Hạng & Đề Xuất Phim Ngắn Hot Nhất 2026 | APhim';
                        } else if (tab === 'search') {
                            document.title = 'Tìm Kiếm Phim Ngắn - Kho Phim Ngắn Vietsub Đầy Đủ Nhất | APhim';
                        } else if (tab === 'library') {
                            document.title = 'Thư Viện Phim Ngắn Của Bạn - Lịch Sử & Yêu Thích | APhim';
                        } else {
                            document.title = 'Phim Ngắn Hay Mới Nhất 2026 - Tuyển Tập Phim Ngắn Kịch Tính Vietsub Trọn Bộ | APhim';
                        }
                        if (typeof window.syncBottomNavActive === 'function') {
                            window.syncBottomNavActive(tab);
                        }
                        syncTopNavActive(tab);
                        return false;
                    };

                    let currentLibraryTab = (typeof <%- JSON.stringify(typeof initialLibraryTab !== 'undefined' ? initialLibraryTab : 'recent') %> !== 'undefined') ? <%- JSON.stringify(typeof initialLibraryTab !== 'undefined' ? initialLibraryTab : 'recent') %> : 'recent';
                    let libraryCurrentPage = 1;

                    // Số lượng phim hiển thị theo yêu cầu:
                    // - Mobile (<= 1023px): 3 dòng x 3 bộ = 9 bộ / trang (giữ nguyên chuẩn mobile)
                    // - Desktop:
                    //   * Màn rộng (>= 1300px): 6 cột x 2 dòng = 12 bộ / trang (thu nhỏ vừa vặn, lấp đầy chiều ngang)
                    //   * Màn vừa (1024px - 1299px): 5 cột x 2 dòng = 10 bộ / trang
                    function getLibraryItemsPerPage() {
                        if (window.innerWidth >= 1300) return 12;
                        if (window.innerWidth >= 1024) return 10;
                        return 9;
                    }

                    // Đường dẫn URL nhận diện riêng cho từng mục
                    function getLibraryTabPath(tab) {
                        if (tab === 'fav') return '/phim-ngan/thu-vien/yeu-thich';
                        if (tab === 'playlist') return '/phim-ngan/thu-vien/danh-sach-phat';
                        return '/phim-ngan/thu-vien/da-xem';
                    }

                    function switchLibraryTab(tab, btn, updateUrl = true) {
                        currentLibraryTab = tab;
                        libraryCurrentPage = 1; // Luôn reset về trang 1 khi đổi mục
                        window._pnActivePlaylistDetailId = null; // Reset trạng thái xem playlist chi tiết

                        document.querySelectorAll('.as-library-tab').forEach(b => {
                            const isMatch = (btn && b === btn) || (b.dataset.tab === tab);
                            b.classList.toggle('active', isMatch);
                        });

                        const sub = document.getElementById('asLibrarySubheading');
                        if (sub) {
                            sub.textContent = tab === 'recent' ? 'Đã xem gần đây' : (tab === 'fav' ? 'Yêu thích' : 'Danh sách phát');
                        }

                        // Cập nhật đường dẫn trên thanh địa chỉ trình duyệt để nhận diện từng mục riêng biệt
                        if (updateUrl && window.history && window.history.pushState) {
                            const targetPath = getLibraryTabPath(tab);
                            if (window.location.pathname !== targetPath) {
                                window.history.pushState({ view: 'library', tab: tab }, '', targetPath);
                            }
                        }

                        renderLibraryGrid(tab);
                    }

                    // Điều hướng sang trang khác (Nút Prev / Next mũi tên tròn chuẩn Ảnh 5)
                    function changeLibraryPage(delta) {
                        const totalPages = window._pnLibTotalPages || 1;
                        const newPage = libraryCurrentPage + delta;
                        if (newPage >= 1 && newPage <= totalPages) {
                            libraryCurrentPage = newPage;
                            renderLibraryGridDirect(currentLibraryTab);
                            const head = document.querySelector('.as-library-head') || document.getElementById('asLibraryView');
                            if (head) head.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    }

                    // Nhập số trang trực tiếp để chuyển trang
                    function jumpToLibraryPage(val) {
                        const totalPages = window._pnLibTotalPages || 1;
                        let page = parseInt(val, 10);
                        if (isNaN(page) || page < 1) page = 1;
                        if (page > totalPages) page = totalPages;
                        libraryCurrentPage = page;
                        renderLibraryGridDirect(currentLibraryTab);
                        const head = document.querySelector('.as-library-head') || document.getElementById('asLibraryView');
                        if (head) head.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }

                    // Cập nhật hiển thị bộ đếm chuyển trang chuẩn Ảnh số 5
                    function renderLibraryPagination(totalItems, perPage) {
                        const wrap = document.getElementById('asLibPaginationWrap');
                        if (!wrap) return;

                        const totalPages = Math.max(1, Math.ceil(totalItems / perPage));
                        window._pnLibTotalPages = totalPages;

                        // Nếu số lượng phim ít hơn hoặc bằng giới hạn 1 trang: ẩn bộ chuyển trang
                        if (totalItems <= perPage) {
                            wrap.style.display = 'none';
                            return;
                        }

                        wrap.style.display = 'flex';

                        const prevBtn = document.getElementById('asLibPrevBtn');
                        const nextBtn = document.getElementById('asLibNextBtn');
                        const pageInput = document.getElementById('asLibPageInput');
                        const totalPagesText = document.getElementById('asLibTotalPages');

                        if (prevBtn) prevBtn.disabled = libraryCurrentPage <= 1;
                        if (nextBtn) nextBtn.disabled = libraryCurrentPage >= totalPages;
                        if (pageInput) {
                            pageInput.value = libraryCurrentPage;
                            pageInput.max = totalPages;
                        }
                        if (totalPagesText) totalPagesText.textContent = totalPages;
                    }

                    // 1. Lấy danh sách phim đã xem gần đây (MongoDB nếu đã đăng nhập, localStorage nếu là khách)
                    function getRecentlyWatched() {
                        if (window._pnMongoLibrary && window._pnMongoLibrary.loggedIn && Array.isArray(window._pnMongoLibrary.history)) {
                            return window._pnMongoLibrary.history;
                        }
                        try {
                            const rawList = localStorage.getItem('aphim_pn_continue_list');
                            if (rawList) {
                                const list = JSON.parse(rawList);
                                if (Array.isArray(list) && list.length > 0) return list;
                            }
                            const raw = localStorage.getItem('aphim_pn_continue');
                            if (!raw) return [];
                            const data = JSON.parse(raw);
                            if (Array.isArray(data)) return data;
                            if (data && data.id) return [data];
                            return [];
                        } catch (e) { return []; }
                    }

                    // 2. Lấy danh sách phim yêu thích (MongoDB nếu đã đăng nhập, localStorage nếu là khách)
                    function getDramaFavorites() {
                        if (window._pnMongoLibrary && window._pnMongoLibrary.loggedIn && Array.isArray(window._pnMongoLibrary.favorites)) {
                            return window._pnMongoLibrary.favorites;
                        }
                        try {
                            const raw = localStorage.getItem('aphim_pn_favorites');
                            return raw ? JSON.parse(raw) : [];
                        } catch (e) { return []; }
                    }

                    // 3. Lấy danh sách phát (MongoDB nếu đã đăng nhập, localStorage nếu là khách)
                    function getDramaPlaylists() {
                        if (window._pnMongoLibrary && window._pnMongoLibrary.loggedIn && Array.isArray(window._pnMongoLibrary.playlists)) {
                            return window._pnMongoLibrary.playlists;
                        }
                        try {
                            const raw = localStorage.getItem('aphim_pn_playlists');
                            return raw ? JSON.parse(raw) : [];
                        } catch (e) { return []; }
                    }

                    // Thêm / xóa phim yêu thích thực tế (Lưu localStorage + MongoDB)
                    function toggleDramaFavorite(drama, btn) {
                        if (!drama || !drama.id) return;
                        const dramaId = String(drama.id);
                        let favs = getDramaFavorites();
                        const idx = favs.findIndex(f => f && String(f.id) === dramaId);
                        let isAdded = false;

                        if (idx === -1) {
                            favs.unshift({
                                id: dramaId,
                                title: drama.title || '',
                                cover: drama.cover || '',
                                epNo: drama.epNo || 1,
                                totalEpisodes: drama.totalEpisodes || (drama.episodes ? drama.episodes.length : 60),
                                timestamp: Date.now()
                            });
                            isAdded = true;
                        } else {
                            favs.splice(idx, 1);
                            isAdded = false;
                        }

                        // Lưu vào localStorage
                        localStorage.setItem('aphim_pn_favorites', JSON.stringify(favs));
                        if (window._pnMongoLibrary) {
                            window._pnMongoLibrary.favorites = favs;
                        }

                        if (btn) {
                            btn.classList.toggle('on', isAdded);
                            btn.classList.toggle('active', isAdded);
                        }
                        showToolToast(isAdded ? 'Đã thêm vào danh sách yêu thích' : 'Đã bỏ yêu thích');

                        // Lưu vào MongoDB nếu đã đăng nhập
                        try {
                            const token = localStorage.getItem('cinestream_token');
                            const headers = { 'Content-Type': 'application/json' };
                            if (token) headers['Authorization'] = 'Bearer ' + token;

                            fetch('/phim-ngan/api/favorite-toggle', {
                                method: 'POST',
                                headers: headers,
                                body: JSON.stringify({
                                    id: dramaId,
                                    title: drama.title || '',
                                    cover: drama.cover || '',
                                    epNo: drama.epNo || 1,
                                    totalEpisodes: drama.totalEpisodes || (drama.episodes ? drama.episodes.length : 60)
                                })
                            }).then(r => r.json()).then(res => {
                                if (res && res.success && res.loggedIn) {
                                    if (window._pnMongoLibrary) {
                                        window._pnMongoLibrary.favorites = res.favorites || [];
                                    }
                                }
                            }).catch(() => { });
                        } catch (e) { }

                        if (currentLibraryTab === 'fav') {
                            renderLibraryGridDirect('fav');
                        }
                    }

                    // Thêm / xóa phim danh sách phát thực tế (Lưu localStorage + MongoDB)
                    function toggleDramaPlaylist(drama, btn) {
                        if (!drama || !drama.id) return;
                        const dramaId = String(drama.id);
                        let pls = getDramaPlaylists();
                        const idx = pls.findIndex(p => p && String(p.id) === dramaId);
                        let isAdded = false;

                        if (idx === -1) {
                            pls.unshift({
                                id: dramaId,
                                title: drama.title || '',
                                cover: drama.cover || '',
                                epNo: drama.epNo || 1,
                                totalEpisodes: drama.totalEpisodes || (drama.episodes ? drama.episodes.length : 60),
                                timestamp: Date.now()
                            });
                            isAdded = true;
                        } else {
                            pls.splice(idx, 1);
                            isAdded = false;
                        }

                        localStorage.setItem('aphim_pn_playlists', JSON.stringify(pls));
                        if (window._pnMongoLibrary) {
                            window._pnMongoLibrary.playlists = pls;
                        }

                        if (btn) {
                            btn.classList.toggle('active', isAdded);
                        }
                        showToolToast(isAdded ? 'Đã lưu vào danh sách phát' : 'Đã xóa khỏi danh sách phát');

                        // Lưu vào MongoDB nếu đã đăng nhập
                        try {
                            const token = localStorage.getItem('cinestream_token');
                            const headers = { 'Content-Type': 'application/json' };
                            if (token) headers['Authorization'] = 'Bearer ' + token;

                            fetch('/phim-ngan/api/playlist-toggle', {
                                method: 'POST',
                                headers: headers,
                                body: JSON.stringify({
                                    id: dramaId,
                                    title: drama.title || '',
                                    cover: drama.cover || '',
                                    epNo: drama.epNo || 1,
                                    totalEpisodes: drama.totalEpisodes || (drama.episodes ? drama.episodes.length : 60)
                                })
                            }).then(r => r.json()).then(res => {
                                if (res && res.success && res.loggedIn) {
                                    if (window._pnMongoLibrary) {
                                        window._pnMongoLibrary.playlists = res.playlists || [];
                                    }
                                }
                            }).catch(() => { });
                        } catch (e) { }

                        if (currentLibraryTab === 'playlist') {
                            renderLibraryGridDirect('playlist');
                        }
                    }

                    // Tải dữ liệu thư viện từ MongoDB cho tài khoản đã đăng nhập
                    async function fetchLibraryFromMongo() {
                        try {
                            const token = localStorage.getItem('cinestream_token');
                            const headers = { 'Content-Type': 'application/json' };
                            if (token) headers['Authorization'] = 'Bearer ' + token;

                            const res = await fetch('/phim-ngan/api/library', { headers });
                            const json = await res.json();
                            if (json && json.success && json.loggedIn) {
                                window._pnMongoLibrary = {
                                    loaded: true,
                                    loggedIn: true,
                                    history: json.history || [],
                                    favorites: json.favorites || [],
                                    playlists: json.playlists || []
                                };

                                // Tự động đồng bộ các phim xem trước đó từ localStorage vào MongoDB
                                const localHistory = JSON.parse(localStorage.getItem('aphim_pn_continue_list') || '[]');
                                if (Array.isArray(localHistory) && localHistory.length > 0) {
                                    syncLocalLibraryToMongo(localHistory);
                                }
                            } else {
                                window._pnMongoLibrary = { loaded: true, loggedIn: false };
                            }
                        } catch (e) {
                            window._pnMongoLibrary = { loaded: true, loggedIn: false };
                        }
                    }

                    // Đồng bộ từ localStorage sang MongoDB khi user đã đăng nhập
                    function syncLocalLibraryToMongo(localHistory) {
                        try {
                            const token = localStorage.getItem('cinestream_token');
                            if (!token && !localStorage.getItem('cinestream_user')) return;
                            const headers = { 'Content-Type': 'application/json' };
                            if (token) headers['Authorization'] = 'Bearer ' + token;

                            let favs = [];
                            try { favs = JSON.parse(localStorage.getItem('aphim_pn_favorites') || '[]'); } catch (e) { }
                            let pls = [];
                            try { pls = JSON.parse(localStorage.getItem('aphim_pn_playlists') || '[]'); } catch (e) { }

                            fetch('/phim-ngan/api/sync-library', {
                                method: 'POST',
                                headers: headers,
                                body: JSON.stringify({
                                    history: localHistory,
                                    favorites: favs,
                                    playlists: pls
                                })
                            }).then(r => r.json()).then(res => {
                                if (res && res.success && res.loggedIn) {
                                    if (window._pnMongoLibrary) {
                                        window._pnMongoLibrary.history = res.history || [];
                                        window._pnMongoLibrary.favorites = res.favorites || [];
                                        window._pnMongoLibrary.playlists = res.playlists || [];
                                    }
                                    renderLibraryGridDirect(currentLibraryTab);
                                }
                            }).catch(() => { });
                        } catch (e) { }
                    }

                    // Render danh sách phim trong tab thư viện
                    async function renderLibraryGrid(tab) {
                        const grid = document.getElementById('asLibraryGrid');
                        if (!grid) return;

                        // Kiểm tra trạng thái đăng nhập
                        const token = localStorage.getItem('cinestream_token');
                        const isClientLoggedIn = !!(token || localStorage.getItem('cinestream_user'));

                        // Nếu user đã đăng nhập mà chưa có cache từ MongoDB: lấy từ MongoDB
                        if (isClientLoggedIn && (!window._pnMongoLibrary || !window._pnMongoLibrary.loaded)) {
                            grid.innerHTML = '<div class="as-library-empty" style="opacity:0.75;">Đang tải dữ liệu thư viện từ tài khoản...</div>';
                            await fetchLibraryFromMongo();
                        }

                        renderLibraryGridDirect(tab);
                    }

                    function handleCreatePlaylistStandalone(evt) {
                        if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
                        if (typeof window.openCreatePlaylistModalStandalone === 'function') {
                            window.openCreatePlaylistModalStandalone();
                        } else if (typeof openCreatePlaylistModalStandalone === 'function') {
                            openCreatePlaylistModalStandalone();
                        } else {
                            showToolToast('Đang tải danh sách phát...');
                        }
                    }

                    function renderLibraryGridDirect(tab) {
                        const grid = document.getElementById('asLibraryGrid');
                        if (!grid) return;

                        // Chuyên mục Danh sách phát (Playlist Folders & Playlist Detail)
                        if (tab === 'playlist') {
                            renderPlaylistLibraryView();
                            return;
                        }

                        // Các tab thông thường (Đã xem gần đây, Yêu thích)
                        grid.className = 'as-library-grid';
                        const sub = document.getElementById('asLibrarySubheading');
                        if (sub) {
                            sub.textContent = tab === 'recent' ? 'Đã xem gần đây' : 'Yêu thích';
                        }

                        let items = [];
                        if (tab === 'recent') {
                            items = getRecentlyWatched();
                        } else if (tab === 'fav') {
                            items = getDramaFavorites();
                        }

                        const perPage = getLibraryItemsPerPage();
                        const totalItems = items ? items.length : 0;
                        const totalPages = Math.max(1, Math.ceil(totalItems / perPage));
                        if (libraryCurrentPage > totalPages) libraryCurrentPage = totalPages;

                        if (!items || items.length === 0) {
                            let emptyMsg = 'Chưa có phim nào. Hãy xem vài bộ phim ngắn nhé!';
                            if (tab === 'fav') emptyMsg = 'Chưa có phim ngắn yêu thích nào. Nhấn biểu tượng trái tim để lưu lại nhé!';
                            grid.innerHTML = `<div class="as-library-empty">${emptyMsg}</div>`;
                            renderLibraryPagination(0, perPage);
                            return;
                        }

                        const startIdx = (libraryCurrentPage - 1) * perPage;
                        const pageItems = items.slice(startIdx, startIdx + perPage);

                        grid.innerHTML = pageItems.map(d => {
                            const dramaId = String(d.id || '').replace(/'/g, "\\'");
                            const title = (d.title || '').replace(/"/g, '&quot;');
                            const saved = (typeof getSavedProgressForDrama === 'function') ? getSavedProgressForDrama(d.id) : null;
                            const epNo = (saved && saved.epNo) ? saved.epNo : (d.epNo || 1);
                            const curTime = (saved && typeof saved.currentTime === 'number') ? Math.floor(saved.currentTime) : Math.floor(d.currentTime || 0);
                            const durTime = (saved && typeof saved.duration === 'number') ? Math.floor(saved.duration) : Math.floor(d.duration || 0);
                            const hasProgress = curTime > 0;
                            const progressPct = (durTime > 0) ? Math.min(100, Math.max(4, Math.round((curTime / durTime) * 100))) : 0;
                            const timeStr = hasProgress ? formatTimeSeconds(curTime) : '';

                            return `
                <div class="as-library-card" onclick="playDramaFromLibrary('${dramaId}', ${epNo}, ${curTime})" title="Tiếp tục xem: ${title}">
                    <div class="as-search-genre-poster">
                        <img src="${d.cover || ''}" alt="${title}" loading="lazy">
                        <div class="as-library-card-play-overlay">
                            <div class="as-library-play-btn">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                    <polygon points="6 4 20 12 6 20 6 4"/>
                                </svg>
                            </div>
                        </div>
                        ${hasProgress ? `
                        <div class="as-library-progress-bar-wrap">
                            <div class="as-library-progress-bar-fill" style="width: ${progressPct > 0 ? progressPct + '%' : '35%'}"></div>
                        </div>` : ''}
                    </div>
                    <div class="as-library-card-title">${title}</div>
                    <div class="as-library-card-meta">
                        <span>Tập ${epNo} / ${d.totalEpisodes || '?'}</span>
                        ${hasProgress ? `<span class="as-library-time-tag"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display:inline-block; vertical-align:-1px; margin-right:3px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>${timeStr}</span>` : ''}
                    </div>
                </div>`;
                        }).join('');

                        renderLibraryPagination(totalItems, perPage);
                    }

                    // Render danh sách phát dạng Folder chuyên nghiệp (chuẩn APhim / Spotify / Netflix)
                    function renderPlaylistLibraryView() {
                        const grid = document.getElementById('asLibraryGrid');
                        const sub = document.getElementById('asLibrarySubheading');
                        const pagWrap = document.getElementById('asLibPaginationWrap');
                        if (!grid) return;

                        // Nếu đang xem chi tiết một Playlist cụ thể
                        if (window._pnActivePlaylistDetailId) {
                            renderPlaylistDetailInsideLibrary(window._pnActivePlaylistDetailId);
                            return;
                        }

                        if (sub) {
                            sub.innerHTML = `<span>Danh sách phát</span>`;
                        }

                        let playlists = [];
                        if (typeof playlistService !== 'undefined') {
                            playlists = playlistService.getAll() || [];
                        } else {
                            try {
                                playlists = JSON.parse(localStorage.getItem('cinestream_playlists') || '[]');
                            } catch (e) { playlists = []; }
                        }

                        if (!playlists || playlists.length === 0) {
                            grid.className = 'as-library-grid';
                            grid.innerHTML = `
                                <div class="as-playlist-empty-card">
                                    <div class="as-playlist-empty-icon">
                                        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                                        </svg>
                                    </div>
                                    <h4 class="as-playlist-empty-title">Bạn chưa có danh sách phát nào</h4>
                                    <p class="as-playlist-empty-desc">Tạo các danh sách phát riêng để lưu trữ và phân loại các bộ phim ngắn bạn yêu thích theo chủ đề.</p>
                                    <button type="button" class="as-btn-create-playlist" onclick="handleCreatePlaylistStandalone(event)">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                        <span>Tạo danh sách phát mới</span>
                                    </button>
                                </div>`;
                            if (pagWrap) pagWrap.style.display = 'none';
                            return;
                        }

                        grid.className = 'as-playlist-grid';
                        grid.innerHTML = playlists.map(pl => {
                            const count = pl.movies ? pl.movies.length : 0;
                            const firstMovie = (pl.movies && pl.movies.length > 0) ? pl.movies[0] : null;
                            const poster = firstMovie ? (firstMovie.thumb_url || firstMovie.cover || firstMovie.poster || '') : '';
                            return `
                                <div class="as-playlist-card" onclick="openPlaylistDetailView('${String(pl.id).replace(/'/g, "\\'")}')">
                                    <div class="as-playlist-thumb-wrap">
                                        ${poster ? `<img src="${poster}" class="as-playlist-thumb-img" alt="${(pl.name || '').replace(/"/g, '&quot;')}" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"><div style="display:none; font-size:32px; opacity:0.6;">📁</div>` : `<div style="font-size:32px; opacity:0.6;">📁</div>`}
                                        <div class="as-playlist-badge">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                            <span>${count} phim</span>
                                        </div>
                                    </div>
                                    <div class="as-playlist-info">
                                        <h4 class="as-playlist-title" title="${(pl.name || '').replace(/"/g, '&quot;')}">${pl.name || 'Danh sách phát'}</h4>
                                        <p class="as-playlist-desc">${pl.description || pl.desc || 'Danh sách phát cá nhân'}</p>
                                        <div class="as-playlist-actions">
                                            <button class="as-playlist-btn-sub" type="button" onclick="event.stopPropagation(); if(window.openEditPlaylistModal) window.openEditPlaylistModal('${pl.id}')" title="Đổi tên / mô tả">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                                                <span>Sửa</span>
                                            </button>
                                            <button class="as-playlist-btn-sub as-playlist-btn-del" type="button" onclick="event.stopPropagation(); if(window.openDeletePlaylistModal) window.openDeletePlaylistModal('${pl.id}')" title="Xóa danh sách">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                <span>Xóa</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }).join('');

                        if (pagWrap) pagWrap.style.display = 'none';
                    }

                    function openPlaylistDetailView(plId) {
                        window._pnActivePlaylistDetailId = plId;
                        renderPlaylistDetailInsideLibrary(plId);
                    }

                    function closePlaylistDetailView() {
                        window._pnActivePlaylistDetailId = null;
                        renderPlaylistLibraryView();
                    }

                    function renderPlaylistDetailInsideLibrary(plId) {
                        const grid = document.getElementById('asLibraryGrid');
                        const sub = document.getElementById('asLibrarySubheading');
                        const pagWrap = document.getElementById('asLibPaginationWrap');
                        if (!grid) return;

                        let pl = null;
                        if (typeof playlistService !== 'undefined') pl = playlistService.getById(plId);
                        if (!pl) {
                            try {
                                const list = JSON.parse(localStorage.getItem('cinestream_playlists') || '[]');
                                pl = list.find(p => p.id === plId);
                            } catch(e) {}
                        }

                        if (!pl) {
                            window._pnActivePlaylistDetailId = null;
                            renderPlaylistLibraryView();
                            return;
                        }

                        const movies = pl.movies || [];

                        if (sub) {
                            sub.innerHTML = `
                                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                                    <button type="button" onclick="closePlaylistDetailView()" style="background:rgba(255,255,255,0.08); border:none; color:var(--as-ink); padding:6px 12px; border-radius:8px; cursor:pointer; font-weight:700; font-size:13px; display:inline-flex; align-items:center; gap:6px;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                        <span>Quay lại</span>
                                    </button>
                                    <span style="opacity:0.35;">/</span>
                                    <span>${(pl.name || 'Danh sách phát')}</span>
                                    <span style="font-size:13px; opacity:0.6; font-weight:500;">(${movies.length} phim)</span>
                                </div>
                            `;
                        }

                        grid.className = 'as-library-grid';

                        if (movies.length === 0) {
                            grid.innerHTML = `
                                <div class="as-playlist-empty-card">
                                    <div class="as-playlist-empty-icon">🎬</div>
                                    <h4 class="as-playlist-empty-title">Chưa có phim ngắn nào trong danh sách</h4>
                                    <p class="as-playlist-empty-desc">Khi xem phim, bạn có thể nhấn nút "Lưu danh sách" trên trang chi tiết để thêm phim vào đây.</p>
                                    <button type="button" class="as-btn-create-playlist" onclick="switchNavView('hub')">
                                        <span>Khám phá phim ngay</span>
                                    </button>
                                </div>
                            `;
                            if (pagWrap) pagWrap.style.display = 'none';
                            return;
                        }

                        grid.innerHTML = movies.map(m => {
                            const dramaId = String(m.slug || m.id || '');
                            const title = (m.name || m.title || 'Phim ngắn').replace(/"/g, '&quot;');
                            const poster = m.thumb_url || m.cover || m.poster || '';
                            const saved = (typeof getSavedProgressForDrama === 'function') ? getSavedProgressForDrama(dramaId) : null;
                            const epNo = (saved && saved.epNo) ? saved.epNo : 1;
                            const curTime = (saved && typeof saved.currentTime === 'number') ? Math.floor(saved.currentTime) : 0;
                            const durTime = (saved && typeof saved.duration === 'number') ? Math.floor(saved.duration) : 0;
                            const hasProgress = curTime > 0;
                            const progressPct = (durTime > 0) ? Math.min(100, Math.max(4, Math.round((curTime / durTime) * 100))) : 0;
                            const timeStr = hasProgress ? formatTimeSeconds(curTime) : '';

                            return `
                                <div class="as-library-card" onclick="playDramaFromLibrary('${dramaId.replace(/'/g, "\\'")}', ${epNo}, ${curTime})" title="Tiếp tục xem: ${title}">
                                    <div class="as-search-genre-poster">
                                        <img src="${poster}" alt="${title}" loading="lazy">
                                        <div class="as-library-card-play-overlay">
                                            <div class="as-library-play-btn">
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                                    <polygon points="6 4 20 12 6 20 6 4"/>
                                                </svg>
                                            </div>
                                        </div>
                                        ${hasProgress ? `
                                        <div class="as-library-progress-bar-wrap">
                                            <div class="as-library-progress-bar-fill" style="width: ${progressPct > 0 ? progressPct + '%' : '35%'}"></div>
                                        </div>` : ''}
                                        <button class="as-pl-remove-movie-btn" title="Xóa khỏi danh sách" onclick="event.stopPropagation(); removeMovieFromCurrentPlaylist('${pl.id}', '${dramaId.replace(/'/g, "\\'")}')">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                        </button>
                                    </div>
                                    <div class="as-library-card-title">${title}</div>
                                    <div class="as-library-card-meta">
                                        <span>Tập ${epNo}</span>
                                        ${hasProgress ? `<span class="as-library-time-tag"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display:inline-block; vertical-align:-1px; margin-right:3px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>${timeStr}</span>` : ''}
                                    </div>
                                </div>
                            `;
                        }).join('');

                        if (pagWrap) pagWrap.style.display = 'none';
                    }

                    function removeMovieFromCurrentPlaylist(plId, movieSlug) {
                        if (typeof playlistService !== 'undefined') {
                            playlistService.removeMovie(plId, movieSlug);
                        } else {
                            try {
                                let list = JSON.parse(localStorage.getItem('cinestream_playlists') || '[]');
                                const p = list.find(x => x.id === plId);
                                if (p && p.movies) {
                                    p.movies = p.movies.filter(m => (m.slug !== movieSlug && m.id !== movieSlug));
                                    localStorage.setItem('cinestream_playlists', JSON.stringify(list));
                                }
                            } catch(e) {}
                        }
                        showToolToast('Đã xóa phim khỏi danh sách phát');
                        renderPlaylistDetailInsideLibrary(plId);
                    }

                    // Tự động lắng nghe sự kiện cập nhật danh sách phát toàn cục
                    window.addEventListener('ap:playlists-updated', () => {
                        if (typeof currentLibraryTab !== 'undefined' && currentLibraryTab === 'playlist') {
                            renderLibraryGridDirect('playlist');
                        }
                        const drama = (typeof currentActiveDrama !== 'undefined' && currentActiveDrama) || (typeof currentDetailDrama !== 'undefined' && currentDetailDrama) || (typeof getActiveDetailDrama === 'function' ? getActiveDetailDrama() : null);
                        if (drama) syncDetailActionButtons(drama);
                    });

                    // Lắng nghe sự thay đổi kích thước màn hình để tự động điều chỉnh số bộ / trang
                    window.addEventListener('resize', () => {
                        const libView = document.getElementById('asLibraryView');
                        if (libView && libView.style.display !== 'none') {
                            renderLibraryGridDirect(currentLibraryTab);
                        }
                    });

                    // Lắng nghe nút quay lại / tiến tới của trình duyệt để chuyển tab theo URL
                    window.addEventListener('popstate', (e) => {
                        const path = window.location.pathname;
                        if (path.includes('/phim-ngan/thu-vien')) {
                            let tab = 'recent';
                            if (path.endsWith('/yeu-thich')) tab = 'fav';
                            else if (path.endsWith('/danh-sach-phat')) tab = 'playlist';
                            switchLibraryTab(tab, null, false);
                        }
                    });

                    // =======================================================
                    // 🔍 TRANG TÌM KIẾM — tìm phim ngắn thật
                    // =======================================================
                    let searchState = { q: '', genre: '', status: '', sort: '' };
                    let searchDebounce = null;

                    function onSearchInput(q) {
                        clearTimeout(searchDebounce);
                        searchDebounce = setTimeout(() => {
                            searchState.q = (q || '').trim();
                            currentSearchPage = 1;
                            renderSearchResults();
                            syncSearchUrl();
                        }, 180);
                    }

                    /* Ghi từ khoá lên URL để F5 hoặc copy link vẫn giữ kết quả */
                    function syncSearchUrl() {
                        try {
                            const url = new URL(window.location.href);
                            if (searchState.q) url.searchParams.set('q', searchState.q);
                            else url.searchParams.delete('q');
                            window.history.replaceState({}, '', url.toString());
                        } catch (e) { }
                    }

                    /* Khi user gõ tìm kiếm ở HEADER khi đang ở /phim-ngan thì trình duyệt
                       chuyển sang /phim-ngan/tim-kiem?q=... -> đọc từ khoá và chạy tìm luôn */
                    (function initSearchFromHeader() {
                        const apply = () => {
                            let q = '';
                            try {
                                q = new URLSearchParams(window.location.search || '').get('q') || '';
                            } catch (e) { }
                            q = q.trim();
                            if (!q) return;
                            const inp = document.getElementById('asSearchInput');
                            if (inp) inp.value = q;
                            searchState.q = q;
                            if (typeof renderSearchResults === 'function') renderSearchResults();
                            const results = document.getElementById('asSearchResults');
                            if (results) results.style.display = 'grid';
                        };
                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', apply);
                        } else {
                            apply();
                        }
                    })();

                    // Đóng mọi filter menu đang mở
                    function closeAllFilterMenus() {
                        document.querySelectorAll('.as-filter-menu.open').forEach(m => m.classList.remove('open'));
                        document.querySelectorAll('.as-filter-pill.open').forEach(b => b.classList.remove('open'));
                    }

                    // Mở/đóng menu của 1 filter pill
                    function toggleFilterMenu(btn) {
                        const type = btn.dataset.filter;
                        if (!type) return;
                        const menu = document.getElementById('asFilterMenu' + type.charAt(0).toUpperCase() + type.slice(1));
                        if (!menu) return;
                        const willOpen = !menu.classList.contains('open');
                        closeAllFilterMenus();
                        if (willOpen) {
                            menu.classList.add('open');
                            btn.classList.add('open');
                        }
                    }

                    // Danh sách thể loại chuẩn Ảnh 1
                    const SEARCH_GENRE_PRESETS = [
                        'Tất cả thể loại',
                        'Tổng tài & Hào môn',
                        'Báo thù & Vả mặt',
                        'Nghịch tập & Vươn lên',
                        'Trọng sinh',
                        'Xuyên không',
                        'Ngọt sủng',
                        'Ngược tâm',
                        'Cưới trước yêu sau',
                        'Gia đình & Tình thân',
                        'Cổ trang & Cung đấu',
                        'Huyền huyễn & Tiên hiệp',
                        'Người sói & Siêu nhiên',
                        'Mafia & Xã hội đen',
                        'Danh tính bí ẩn',
                        'Thanh xuân & Học đường',
                        'Nữ cường',
                        'Chiến thần & Đô thị',
                        'Kinh dị & Bí ẩn',
                        'Hài hước & Nhẹ nhàng'
                    ];

                    // Dựng option cho các filter menu (gọi 1 lần khi vào trang)
                    function buildFilterMenus() {
                        const genreBody = document.getElementById('asFilterGenreBody');
                        if (genreBody) {
                            const combined = [...new Set([...SEARCH_GENRE_PRESETS, ...(SEARCH_GENRES || [])])];
                            genreBody.innerHTML = combined.map(g => {
                                const isAll = (g === 'Tất cả thể loại' || g === 'Tất cả');
                                const label = isAll ? 'Tất cả thể loại' : g;
                                const val = isAll ? '' : g;
                                return `<button type="button" class="as-filter-genre-pill" data-genre="${encodeURIComponent(val)}" onclick="selectGenrePill('${String(val).replace(/'/g, "\\'")}', this)">${label}</button>`;
                            }).join('');
                        }
                        const statusMenu = document.getElementById('asFilterMenuStatus');
                        if (statusMenu) {
                            statusMenu.innerHTML = ['Tất cả', 'Hoàn thành'].map(s => `
                    <button class="as-filter-opt" onclick="setSearchFilter('status', ${s === 'Tất cả' ? "''" : `'${s}'`}, this)">
                        <span>${s}</span>
                        <span class="as-filter-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                    </button>`).join('');
                        }
                        const sortMenu = document.getElementById('asFilterMenuSort');
                        if (sortMenu) {
                            sortMenu.innerHTML = [
                                { v: '', label: 'Mặc định' },
                                { v: 'views', label: 'Lượt xem' },
                                { v: 'likes', label: 'Lượt thích' },
                                { v: 'episodes', label: 'Số tập' }
                            ].map(o => `
                    <button class="as-filter-opt" onclick="setSearchFilter('sort', '${o.v}', this)">
                        <span>${o.label}</span>
                        <span class="as-filter-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                    </button>`).join('');
                        }
                        markFilterActive();
                    }

                    // Chọn thể loại dạng viên thuốc (Ảnh 1)
                    function selectGenrePill(genreName, btn) {
                        searchState.genre = genreName || '';
                        currentSearchPage = 1;
                        markFilterActive();
                        renderSearchResults();
                    }

                    // Đánh dấu option đang chọn
                    function markFilterActive() {
                        // Genre cloud pills
                        const genreBody = document.getElementById('asFilterGenreBody');
                        if (genreBody) {
                            const cur = (searchState.genre || '').trim().toLowerCase();
                            genreBody.querySelectorAll('.as-filter-genre-pill').forEach(pill => {
                                const gVal = decodeURIComponent(pill.dataset.genre || '').trim().toLowerCase();
                                const isMatch = (!cur && !gVal) || (cur && gVal === cur);
                                pill.classList.toggle('active', !!isMatch);
                            });
                        }

                        // Status & Sort menus
                        ['status', 'sort'].forEach(type => {
                            const menu = document.getElementById('asFilterMenu' + type.charAt(0).toUpperCase() + type.slice(1));
                            if (!menu) return;
                            menu.querySelectorAll('.as-filter-opt').forEach(opt => {
                                const label = (opt.querySelector('span') || {}).textContent || '';
                                opt.classList.toggle('active', !!(searchState[type] && label === searchState[type]));
                            });
                        });

                        // Filter pills trên thanh tìm kiếm
                        ['genre', 'status', 'sort'].forEach(type => {
                            const pill = document.querySelector(`.as-filter-pill[data-filter="${type}"]`);
                            if (pill) {
                                const base = type === 'genre' ? 'Thể loại' : (type === 'status' ? 'Tình trạng' : 'Sắp xếp');
                                const cur = searchState[type];
                                const label = cur ? (cur.length > 14 ? cur.slice(0, 14) + '…' : cur) : base;
                                const svg = pill.querySelector('svg');
                                pill.innerHTML = `${label} `;
                                if (svg) pill.appendChild(svg);
                                pill.classList.toggle('active', !!cur);
                            }
                        });
                    }

                    function setSearchFilter(type, value, optBtn) {
                        searchState[type] = value || '';
                        currentSearchPage = 1;
                        markFilterActive();
                        closeAllFilterMenus();
                        renderSearchResults();
                    }

                    // Nút "Lượt xem" / "Lượt thích": sắp xếp nhanh
                    function sortSearchBy(key) {
                        searchState.sort = (searchState.sort === key) ? '' : key;
                        currentSearchPage = 1;
                        markFilterActive();
                        renderSearchResults();
                    }

                    function isSearchActive() {
                        return !!(searchState.q || searchState.genre || searchState.status || searchState.sort);
                    }

                    let currentSearchPage = 1;
                    const SEARCH_PAGE_SIZE = 18;
                    let lastFilteredSearchResults = [];

                    function renderSearchResults() {
                        const results = document.getElementById('asSearchResults');
                        const status = document.getElementById('asSearchStatus');
                        const statusText = document.getElementById('asSearchStatusText');
                        const hint = document.getElementById('asSearchHint');
                        const pagWrap = document.getElementById('asSearchPaginationWrap');
                        if (!results) return;

                        // Lọc theo từ khóa + thể loại + tình trạng (hỗ trợ cả tiếng Việt có dấu & không dấu)
                        function stripVnTones(str) {
                            return String(str || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().trim();
                        }

                        const q = (searchState.q || '').toLowerCase().trim();
                        const qClean = stripVnTones(searchState.q);
                        const filterGenre = (searchState.genre || '').toLowerCase().trim();
                        const filterGenreClean = stripVnTones(searchState.genre);

                        let items = (typeof SEARCH_POOL !== 'undefined' && Array.isArray(SEARCH_POOL)) ? [...SEARCH_POOL] : [];

                        if (qClean || filterGenreClean || searchState.status) {
                            items = items.filter(d => {
                                if (filterGenreClean) {
                                    const dGenre = stripVnTones(d.genre);
                                    const dTitle = stripVnTones(d.title);
                                    let match = dGenre.includes(filterGenreClean) || dTitle.includes(filterGenreClean);
                                    if (!match) {
                                        const tokens = filterGenreClean.split(/&|,|\s+/).map(t => t.trim()).filter(t => t.length > 2);
                                        match = tokens.some(t => dGenre.includes(t) || dTitle.includes(t));
                                    }
                                    if (!match) return false;
                                }
                                if (searchState.status === 'Hoàn thành' && String(d.totalEpisodes) === '0') return false;
                                if (qClean) {
                                    const titleClean = stripVnTones(d.title);
                                    const genreClean = stripVnTones(d.genre);
                                    return titleClean.includes(qClean) || genreClean.includes(qClean);
                                }
                                return true;
                            });
                        }

                        // Sắp xếp
                        if (searchState.sort === 'views') items.sort((a, b) => (b.stats?.views || 0) - (a.stats?.views || 0));
                        else if (searchState.sort === 'likes') items.sort((a, b) => (b.stats?.likes || 0) - (a.stats?.likes || 0));
                        else if (searchState.sort === 'episodes') items.sort((a, b) => (b.totalEpisodes || 0) - (a.totalEpisodes || 0));
                        else {
                            // Mặc định: Phim có Vietsub / Lồng tiếng được xếp ưu tiên lên đầu
                            items.sort((a, b) => {
                                const aSub = (a.hasSub || a.isDubbed) ? 1 : 0;
                                const bSub = (b.hasSub || b.isDubbed) ? 1 : 0;
                                return bSub - aSub;
                            });
                        }

                        lastFilteredSearchResults = items;

                        // Trạng thái thông báo
                        if (isSearchActive()) {
                            if (status) {
                                status.style.display = 'flex';
                                const kw = searchState.q ? ` cho "${searchState.q}"` : (searchState.genre ? ` thể loại "${searchState.genre}"` : '');
                                if (statusText) statusText.textContent = `${items.length} phim ngắn${kw}`;
                            }
                            if (hint) hint.textContent = `Hiển thị danh sách kết quả phù hợp (${items.length} phim)`;
                        } else {
                            if (status) status.style.display = 'none';
                            if (hint) hint.textContent = 'Tất cả phim ngắn đặc sắc — Khám phá & thưởng thức';
                        }

                        // Phân trang
                        const totalPages = Math.max(1, Math.ceil(items.length / SEARCH_PAGE_SIZE));
                        if (currentSearchPage > totalPages) currentSearchPage = 1;
                        if (currentSearchPage < 1) currentSearchPage = 1;

                        const startIdx = (currentSearchPage - 1) * SEARCH_PAGE_SIZE;
                        const pageItems = items.slice(startIdx, startIdx + SEARCH_PAGE_SIZE);

                        if (items.length === 0) {
                            results.innerHTML = '<div class="as-search-empty"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="margin-bottom:12px;opacity:0.6;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><p style="font-size:15px;font-weight:600;margin-bottom:4px;">Không tìm thấy phim ngắn nào phù hợp.</p><p style="font-size:13px;opacity:0.75;">Thử thay đổi từ khóa hoặc bộ lọc thể loại khác nhé!</p></div>';
                            if (pagWrap) pagWrap.style.display = 'none';
                            return;
                        }

                        results.innerHTML = pageItems.map(d => {
                            const titleEsc = (d.title || '').replace(/"/g, '&quot;');
                            const dramaIdEsc = String(d.id || '').replace(/'/g, "\\'");
                            const coverUrl = d.cover || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop';
                            const epCount = d.totalEpisodes ? (d.totalEpisodes + ' tập') : '';
                            const viewsCount = (d.stats && d.stats.views) ? (d.stats.views >= 1000 ? (d.stats.views / 1000).toFixed(1) + 'k' : d.stats.views) : '';
                            const genreBadge = d.genre ? d.genre.split(/[,/&]/)[0].trim() : '';

                            return `
                                <div class="as-search-result-item" onclick="openDramaDetail('${dramaIdEsc}')" title="${titleEsc}">
                                    <div class="as-search-result-poster">
                                        <img src="${coverUrl}" alt="${titleEsc}" loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop';">
                                        <div class="as-search-result-play-overlay">
                                            <div class="as-search-play-btn">
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                                    <polygon points="6 4 20 12 6 20 6 4"/>
                                                </svg>
                                            </div>
                                        </div>
                                        ${epCount ? `<span class="as-search-ep-badge">${epCount}</span>` : ''}
                                    </div>
                                    <div class="as-search-result-name">${d.title || ''}</div>
                                    <div class="as-search-result-meta">
                                        ${genreBadge ? `<span class="as-search-meta-genre">${genreBadge}</span>` : ''}
                                        ${viewsCount ? `
                                            <span class="as-search-meta-views">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display:inline-block; vertical-align:-1px; margin-right:2px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>${viewsCount}
                                            </span>
                                        ` : ''}
                                    </div>
                                </div>
                            `;
                        }).join('');

                        // Cập nhật giao diện phân trang
                        if (pagWrap) {
                            if (totalPages > 1) {
                                pagWrap.style.display = 'flex';
                                const prevBtn = document.getElementById('asSearchPrevBtn');
                                const nextBtn = document.getElementById('asSearchNextBtn');
                                const pageInp = document.getElementById('asSearchPageInput');
                                const totalSpan = document.getElementById('asSearchTotalPages');
                                if (prevBtn) prevBtn.disabled = (currentSearchPage <= 1);
                                if (nextBtn) nextBtn.disabled = (currentSearchPage >= totalPages);
                                if (pageInp) {
                                    pageInp.value = currentSearchPage;
                                    pageInp.max = totalPages;
                                }
                                if (totalSpan) totalSpan.textContent = totalPages;
                            } else {
                                pagWrap.style.display = 'none';
                            }
                        }
                    }

                    function changeSearchPage(delta) {
                        const totalPages = Math.max(1, Math.ceil((lastFilteredSearchResults.length || 0) / SEARCH_PAGE_SIZE));
                        const target = currentSearchPage + delta;
                        if (target >= 1 && target <= totalPages) {
                            currentSearchPage = target;
                            renderSearchResults();
                            const results = document.getElementById('asSearchResults');
                            if (results) results.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    }

                    function jumpToSearchPage(val) {
                        const totalPages = Math.max(1, Math.ceil((lastFilteredSearchResults.length || 0) / SEARCH_PAGE_SIZE));
                        let num = parseInt(val, 10);
                        if (isNaN(num)) num = 1;
                        if (num < 1) num = 1;
                        if (num > totalPages) num = totalPages;
                        currentSearchPage = num;
                        renderSearchResults();
                        const results = document.getElementById('asSearchResults');
                        if (results) results.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }

                    function clearSearch() {
                        searchState = { q: '', genre: '', status: '', sort: '' };
                        currentSearchPage = 1;
                        const inp = document.getElementById('asSearchInput');
                        if (inp) inp.value = '';
                        markFilterActive();
                        renderSearchResults();
                    }

                    // Bấm thẻ thể loại => mở trang THÔNG TIN phim (như user yêu cầu: bấm để xem thông tin)
                    function onGenreItemClick(genreName, dramaId) {
                        if (dramaId) {
                            // Mở luôn chi tiết + danh sách tập của phim đầu tiên trong nhóm này
                            if (typeof openDramaDetail === 'function') openDramaDetail(dramaId);
                            else showPhimNganView('search');
                            return;
                        }
                        // Không xác định được phim cụ thể thì lọc theo tên nhóm như trước
                        searchState.genre = (searchState.genre === genreName) ? '' : genreName;
                        markFilterActive();
                        renderSearchResults();
                        const grid = document.getElementById('asSearchGenreGrid');
                        if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }

                    // Đóng filter menu khi click ra ngoài
                    document.addEventListener('click', (e) => {
                        if (!e.target.closest || !e.target.closest('.as-filter-wrap')) closeAllFilterMenus();
                    });
                    document.addEventListener('DOMContentLoaded', buildFilterMenus);

                    // =======================================================
                    // 🎬 REELS — Chuyển mượt sang trang Đề xuất /phim-ngan/de-xuat
                    // =======================================================
                    let reelsLock = false;

                    function openReels() {
                        // Đảm bảo đóng modal Reels cũ nếu có để không bị kẹt overlay đen
                        const feed = document.getElementById('asReelsFeed');
                        if (feed) feed.classList.remove('active');
                        const feedVideo = document.getElementById('asReelsVideo');
                        if (feedVideo) {
                            try { feedVideo.pause(); feedVideo.src = ''; } catch (e) { }
                        }
                        document.body.style.overflow = '';

                        // Lấy thông tin phim hiện tại đang xem/ở trang chi tiết
                        let dramaToPlay = currentActiveDrama || currentDetailDrama || null;
                        if (!dramaToPlay && typeof PN_DETAIL_CACHE !== 'undefined') {
                            const m = window.location.pathname.match(/\/thong-tin\/([^\/?#]+)/);
                            if (m && m[1]) {
                                dramaToPlay = PN_DETAIL_CACHE.get(m[1]);
                            }
                        }
                        if (!dramaToPlay && typeof initDrama !== 'undefined' && initDrama) {
                            dramaToPlay = initDrama;
                        }

                        let epToPlay = 1;
                        if (typeof currentDetailEpNo !== 'undefined' && currentDetailEpNo > 0) {
                            epToPlay = currentDetailEpNo;
                        } else if (typeof currentActiveEpIdx !== 'undefined' && currentActiveEpIdx >= 0) {
                            epToPlay = currentActiveEpIdx + 1;
                        }

                        if (dramaToPlay) {
                            recDrama = dramaToPlay;
                            recEpisode = epToPlay;
                            if (dramaToPlay.id) {
                                recDramaDetailCache.set(String(dramaToPlay.id), dramaToPlay);
                            }
                            const pool = getRecommendPool();
                            const existingIdx = pool.findIndex(item => String(item.id) === String(dramaToPlay.id));
                            if (existingIdx > 0) {
                                pool.splice(existingIdx, 1);
                                pool.unshift(dramaToPlay);
                            } else if (existingIdx === -1) {
                                pool.unshift(dramaToPlay);
                            }
                        }

                        // Cập nhật URL trình duyệt sang trang /phim-ngan/de-xuat
                        try {
                            if (window.location.pathname !== '/phim-ngan/de-xuat') {
                                window.history.pushState({ view: 'recommend', dramaId: dramaToPlay ? dramaToPlay.id : '' }, '', '/phim-ngan/de-xuat');
                            }
                        } catch (e) { }

                        // Chuyển sang view Đề xuất
                        if (typeof showPhimNganView === 'function') {
                            showPhimNganView('recommend');
                        } else if (typeof handlePhimNganTabClick === 'function') {
                            handlePhimNganTabClick(null, 'recommend');
                        }
                    }

                    function closeReels() {
                        const feed = document.getElementById('asReelsFeed');
                        const video = document.getElementById('asReelsVideo');
                        if (video) { video.pause(); video.src = ''; }
                        if (feed) feed.classList.remove('active');
                        document.body.style.overflow = '';
                        reelsLock = false;
                        // Quay lại phát tập đang xem trong trình phát lớn
                        if (currentActiveDrama && typeof currentActiveDrama.episodes !== 'undefined' &&
                            currentActiveDrama.episodes[currentActiveEpIdx]) {
                            playEpisodeByIndex(currentActiveEpIdx);
                        }
                    }

                    function loadReelsEpisode(idx) {
                        if (!currentActiveDrama || !currentActiveDrama.episodes) return;
                        const eps = currentActiveDrama.episodes;
                        if (idx < 0 || idx >= eps.length) return;
                        currentActiveEpIdx = idx;
                        const ep = eps[idx];
                        const total = eps.length;
                        const video = document.getElementById('asReelsVideo');
                        const label = document.getElementById('asReelsEpLabel');
                        const title = document.getElementById('asReelsTitle');
                        const progress = document.getElementById('asReelsProgressFill');
                        if (label) label.textContent = `Tập ${ep.no || (idx + 1)} · xem trước`;
                        if (title) title.textContent = currentActiveDrama.title || '';
                        if (progress) progress.style.width = ((idx + 1) / total * 100) + '%';
                        if (video && ep.videoUrl) {
                            video.src = ep.videoUrl;
                            video.load();
                            const p = video.play();
                            if (p && p.catch) p.catch(() => { });
                        }
                    }

                    // Lướt lên → tập trước, lướt xuống → tập sau
                    function reelsStep(direction) {
                        if (reelsLock || !currentActiveDrama) return;
                        const next = currentActiveEpIdx + direction;
                        const total = (currentActiveDrama.episodes || []).length;
                        if (next < 0 || next >= total) return;
                        reelsLock = true;
                        loadReelsEpisode(next);
                        setTimeout(() => { reelsLock = false; }, 600);
                    }

                    // Bắt sự kiện lướt/phiím cho Reels
                    (function initReelsGestures() {
                        const feed = document.getElementById('asReelsFeed');
                        if (!feed) return;
                        let touchStartY = null;
                        feed.addEventListener('wheel', (e) => {
                            if (Math.abs(e.deltaY) < 8) return;
                            e.preventDefault();
                            reelsStep(e.deltaY > 0 ? 1 : -1);
                        }, { passive: false });
                        feed.addEventListener('touchstart', (e) => {
                            touchStartY = e.touches[0].clientY;
                        }, { passive: true });
                        feed.addEventListener('touchend', (e) => {
                            if (touchStartY === null) return;
                            const delta = touchStartY - (e.changedTouches[0] ? e.changedTouches[0].clientY : touchStartY);
                            if (Math.abs(delta) > 40) reelsStep(delta > 0 ? 1 : -1);
                            touchStartY = null;
                        }, { passive: true });
                        document.addEventListener('keydown', (e) => {
                            const feedEl = document.getElementById('asReelsFeed');
                            if (!feedEl || !feedEl.classList.contains('active')) return;
                            if (e.key === 'ArrowDown' || e.key === 'PageDown') { e.preventDefault(); reelsStep(1); }
                            else if (e.key === 'ArrowUp' || e.key === 'PageUp') { e.preventDefault(); reelsStep(-1); }
                            else if (e.key === 'Escape') closeReels();
                        });
                    })();

                    // Mở đúng view khi vào bằng link /phim-ngan#asSearchView hoặc #asLibraryView hoặc URL trực tiếp
                    document.addEventListener('DOMContentLoaded', () => {
                        const hash = (window.location.hash || '');
                        const path = (window.location.pathname || '');

                        /* AN TOÀN (lớp 2): URL là trang xem (/phim-ngan/xem/:id) mà rạp chiếu
                           chưa mở — do trình duyệt dùng HTML cũ còn cache — thì bật ngay.
                           Không có lớp này, người dùng sẽ thấy trang chủ/A-Z/footer thay vì
                           trình phát và phải tự F5 mới đúng. */
                        if (path.includes('/xem/') || path.includes('/phim/')) {
                            const modal = document.getElementById('asTheaterModal');
                            if (modal && !modal.classList.contains('active')) {
                                if (typeof dismissMiniPlayerForNewWatch === 'function') dismissMiniPlayerForNewWatch();
                                if (typeof hideAllPhimNganViews === 'function') hideAllPhimNganViews();
                                modal.style.removeProperty('display');
                                modal.style.removeProperty('pointer-events');
                                modal.classList.add('active');
                                document.body.style.overflow = 'hidden';
                                if (typeof currentActiveDrama !== 'undefined' && currentActiveDrama) {
                                    const epMatch = (window.location.search || '').match(/[?&]ep=(\d+)/);
                                    const epNo = epMatch ? Math.max(1, parseInt(epMatch[1], 10) || 1) : 1;
                                    if (typeof startPlayingFromDetail === 'function') startPlayingFromDetail(epNo);
                                }
                            }
                        }

                        if (hash === '#asSearchView' || path.endsWith('/tim-kiem')) {
                            showPhimNganView('search');
                        } else if (hash === '#asLibraryView' || path.endsWith('/thu-vien')) {
                            showPhimNganView('library');
                        } else if (hash === '#asRecommendView' || path.endsWith('/de-xuat') || (typeof pnView !== 'undefined' && pnView === 'recommend')) {
                            showPhimNganView('recommend');
                        }
                    });

                    // Xử lý nút Back/Forward của trình duyệt để đồng bộ view, URL và trạng thái rạp chiếu
                    window.addEventListener('popstate', (e) => {
                        const path = window.location.pathname || '';
                        const modal = document.getElementById('asTheaterModal');
                        const detailView = document.getElementById('asDramaDetailView');
                        const mainHub = document.getElementById('asMainHub');

                        if (path.includes('/xem/') || path.includes('/phim/')) {
                            // Vào trang xem phim: tắt mini player và kích hoạt rạp chiếu
                            if (typeof dismissMiniPlayerForNewWatch === 'function') dismissMiniPlayerForNewWatch();
                            const m = path.match(/\/(?:xem|phim)\/([^\/?#]+)/);
                            const did = (e.state && e.state.dramaId) || (m ? m[1] : (currentActiveDrama ? currentActiveDrama.id : ''));
                            const urlParams = new URLSearchParams(window.location.search || '');
                            const epNo = parseInt(urlParams.get('ep') || '1', 10);
                            const seekTime = parseFloat(urlParams.get('t') || '0');
                            if (did) {
                                if (currentActiveDrama && currentActiveDrama.id === did) {
                                    startPlayingFromDetail(epNo, seekTime);
                                } else if (typeof openDramaPlayer === 'function') {
                                    openDramaPlayer(did, epNo, seekTime);
                                }
                            }
                            return;
                        } else {
                            // Thoát khỏi rạp chiếu nếu đang mở
                            if (modal && modal.classList.contains('active')) {
                                const video = document.getElementById('asVideoEl');
                                if (currentActiveDrama && video && !video.paused) {
                                    startMiniPlayer();
                                } else {
                                    stopCinemaPlayback({ keepMini: false });
                                }
                            } else if (!miniPlayerActive) {
                                stopCinemaPlayback({ keepMini: false });
                            }
                            const recVideo = document.getElementById('asRecVideoElement');
                            if (recVideo) { try { recVideo.pause(); recVideo.muted = true; } catch (e) { } }
                            if (typeof recSubPoller !== 'undefined' && recSubPoller) {
                                clearInterval(recSubPoller);
                                recSubPoller = null;
                            }
                            if (typeof window._asReelsAutoplayCleanup === 'function') {
                                try { window._asReelsAutoplayCleanup(); } catch (e) { }
                                window._asReelsAutoplayCleanup = null;
                            }

                            if (typeof closeMobileCinemaSheet === 'function') closeMobileCinemaSheet();
                            if (typeof closeToolPop === 'function') closeToolPop();
                            if (typeof cleanupTheaterFs === 'function') cleanupTheaterFs();

                            if (modal) {
                                modal.classList.remove('active', 'mobile-fs', 'cinema-fs');
                                modal.style.setProperty('display', 'none', 'important');
                                modal.style.setProperty('visibility', 'hidden', 'important');
                                modal.style.setProperty('pointer-events', 'none', 'important');
                                modal.style.setProperty('z-index', '-1', 'important');
                            }
                            const mBackdrop = document.getElementById('asMobileSheetBackdrop');
                            if (mBackdrop) {
                                mBackdrop.classList.remove('active');
                                mBackdrop.style.pointerEvents = 'none';
                                mBackdrop.style.display = 'none';
                            }
                            const rBackdrop = document.getElementById('asRecSheetBackdrop');
                            if (rBackdrop) {
                                rBackdrop.classList.remove('active');
                                rBackdrop.style.pointerEvents = 'none';
                                rBackdrop.style.display = 'none';
                            }

                            document.body.classList.remove('as-cinema-open', 'theater-mode-active', 'page-player-mode', 'as-theater-fullscreen-active');
                            document.documentElement.classList.remove('as-cinema-open', 'theater-mode-active');
                            document.body.style.overflow = '';
                            document.body.style.height = '';
                            document.body.style.touchAction = '';
                            document.documentElement.style.overflow = '';
                            document.documentElement.style.height = '';

                            if (path.includes('/thong-tin/')) {
                                document.body.classList.remove('page-recommend-mode');
                                document.body.classList.add('page-detail-mode');
                                const dramaMatch = path.match(/\/thong-tin\/([^\/?#]+)/);
                                const did = (e.state && e.state.dramaId) || (dramaMatch ? dramaMatch[1] : (currentActiveDrama ? currentActiveDrama.id : ''));
                                if (did) {
                                    switchToDetailView(did, { isPopState: true });
                                    if (currentActiveDrama && currentActiveDrama.id === did) {
                                        if (typeof renderDramaDetailView === 'function') {
                                            renderDramaDetailView(currentActiveDrama, currentActiveEpIdx + 1);
                                        }
                                    } else if (typeof openDramaDetail === 'function') {
                                        openDramaDetail(did, 1, { isPopState: true });
                                    }
                                } else {
                                    if (detailView) {
                                        detailView.style.removeProperty('display');
                                        detailView.style.setProperty('display', 'block', 'important');
                                    }
                                }
                            } else if (path.includes('/xem/')) {
                                const epMatch = (window.location.search || '').match(/ep=(\d+)/);
                                const ep = epMatch ? parseInt(epMatch[1], 10) : 1;
                                const dramaMatch = path.match(/\/xem\/([^\/?#]+)/);
                                const did = (e.state && e.state.dramaId) || (dramaMatch ? dramaMatch[1] : '');
                                if (did) {
                                    openDramaPlayer(did, ep);
                                } else {
                                    showPhimNganView('home');
                                }
                            } else if (path.includes('/de-xuat')) {
                                showPhimNganView('recommend');
                            } else if (path.includes('/tim-kiem')) {
                                showPhimNganView('search');
                            } else if (path.includes('/thu-vien')) {
                                showPhimNganView('library');
                            } else {
                                showPhimNganView('home');
                            }
                        }
                    });

                    // =======================================================
                    // ⭐ TRANG ĐỀ XUẤT — REELS SHORT DRAMA PLAYER (Chuẩn TikTok / Reels)
                    // =======================================================
                    let recDrama = null;
                    let recEpisode = 1;
                    let recPool = [];
                    let recSoundMuted = false;
                    let isReelsSliding = false;
                    let lastWheelTime = 0;
                    const recDramaDetailCache = new Map();

                    function getRecommendPool() {
                        if (recPool.length > 0) return recPool;
                        const seen = new Set();
                        const combined = [];
                        const all = [
                            ...(INITIAL_REC_DRAMA ? [INITIAL_REC_DRAMA] : []),
                            ...(typeof PRIMARY_HERO !== 'undefined' && PRIMARY_HERO ? [PRIMARY_HERO] : []),
                            ...(typeof ALL_RECOMMEND_DRAMAS !== 'undefined' ? ALL_RECOMMEND_DRAMAS : []),
                            ...(HERO_ITEMS || []),
                            ...(TRENDING_DRAMAS || []),
                            ...(SUGGEST_DRAMAS || [])
                        ];
                        all.forEach(d => {
                            if (d && d.id && !seen.has(String(d.id))) {
                                seen.add(String(d.id));
                                combined.push(d);
                            }
                        });
                        recPool = combined;
                        return recPool;
                    }

                    // Khởi tạo Reels khi vào trang
                    function initRecommendReels() {
                        const pool = getRecommendPool();
                        if (!recDrama) {
                            recDrama = INITIAL_REC_DRAMA || pool[0] || null;
                            recEpisode = 1;
                        }
                        renderRecommend();
                        initReelsListeners();
                    }

                    function renderRecommend(direction = null) {
                        const pool = getRecommendPool();
                        if (!recDrama && pool.length > 0) recDrama = pool[0];
                        const d = recDrama;
                        if (!d) return;

                        const frameEl = document.getElementById('asRecVideoFrame');
                        const posterEl = document.getElementById('asRecVideoPoster');
                        const videoEl = document.getElementById('asRecVideoElement');
                        const titleEl = document.getElementById('asRecTitle');
                        const genresEl = document.getElementById('asRecGenres');
                        const descEl = document.getElementById('asRecDesc');
                        const epCountEl = document.getElementById('asRecEpCount');
                        const counterEl = document.getElementById('asRecCounter');
                        const noteEl = document.getElementById('asRecNote');
                        const playLabel = document.getElementById('asRecPlayLabel');
                        const epNums = document.getElementById('asRecEpNums');
                        const nextList = document.getElementById('asRecNextList');
                        const moreBtn = document.querySelector('.as-rec-more');
                        const subCn = document.getElementById('asRecSubCn');
                        const subVi = document.getElementById('asRecSubVi');

                        // Slide Animation Reels NỘI BỘ (Chỉ video/ảnh trượt bên trong khung, khung ngoài & cột xung quanh đứng yên 100%)
                        if (direction && frameEl) {
                            frameEl.classList.remove('reels-slide-next', 'reels-slide-prev');
                            /* Restart animation khong can doc layout (khong bi bao forced reflow) */
                            try { frameEl.getAnimations().forEach(a => a.cancel()); } catch (e) { }
                            frameEl.classList.add(direction > 0 ? 'reels-slide-next' : 'reels-slide-prev');
                            setTimeout(() => {
                                frameEl.classList.remove('reels-slide-next', 'reels-slide-prev');
                            }, 350);
                        }

                        const total = d.totalEpisodes || (d.episodes ? d.episodes.length : 0) || 1;
                        const currentIdx = pool.findIndex(item => String(item.id) === String(d.id));
                        const displayIdx = currentIdx >= 0 ? (currentIdx + 1) : 1;
                        const totalCount = pool.length > 0 ? pool.length : 1;

                        // Cập nhật thông tin cột trái
                        if (titleEl) titleEl.textContent = d.title || 'Phim ngắn';
                        if (genresEl) genresEl.textContent = d.genre || 'Phim ngắn kịch tính';
                        if (descEl) descEl.textContent = d.intro || '';
                        if (epCountEl) epCountEl.textContent = total + ' tập';
                        const counterText = String(displayIdx).padStart(2, '0') + ' / ' + String(totalCount).padStart(2, '0');
                        if (counterEl) counterEl.textContent = counterText;
                        // Đồng bộ counter trong nhóm nổi trên video (mobile)
                        document.querySelectorAll('.as-rec-topbar-right .as-rec-counter').forEach(el => {
                            el.textContent = counterText;
                        });
                        if (noteEl) noteEl.innerHTML = `<span class="as-rec-dot">●</span> Tập ${recEpisode} · xem trước`;
                        if (playLabel) playLabel.textContent = recEpisode === 1 ? 'Xem từ tập 1' : ('Xem tiếp tập ' + recEpisode);
                        if (moreBtn) moreBtn.style.display = d.intro ? '' : 'none';

                        // Triệt tiêu 100% các dòng phụ đề fake ngẫu nhiên
                        if (subCn) {
                            subCn.textContent = '';
                            subCn.style.display = 'none';
                        }
                        if (subVi) {
                            subVi.textContent = '';
                            subVi.style.display = 'none';
                        }
                        recCues = [];
                        if (descEl) descEl.style.webkitLineClamp = '3';

                        // Poster
                        const fallbackPoster = 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop';
                        if (posterEl) {
                            posterEl.classList.remove('hidden');
                            posterEl.src = d.cover || fallbackPoster;
                        }

                        // Dãy số tập 1..7 + "..."
                        if (epNums) {
                            epNums.innerHTML = '';
                            const maxBtn = Math.min(7, total);
                            for (let i = 1; i <= maxBtn; i++) {
                                const b = document.createElement('button');
                                b.className = 'as-rec-ep-num' + (i === recEpisode ? ' active' : '');
                                b.textContent = String(i);
                                b.onclick = () => pickRecEpisode(i);
                                epNums.appendChild(b);
                            }
                            if (total > 7) {
                                const more = document.createElement('button');
                                more.className = 'as-rec-ep-more';
                                more.textContent = '•••';
                                more.onclick = () => openRecPlay();
                                epNums.appendChild(more);
                            }
                        }

                        // Danh sách 4 phim "Tiếp theo"
                        if (nextList) {
                            const upcoming = [];
                            for (let i = 1; i <= 4; i++) {
                                const nextIndex = (currentIdx + i) % pool.length;
                                if (pool[nextIndex]) upcoming.push(pool[nextIndex]);
                            }
                            nextList.innerHTML = upcoming.map(dd => `
                    <div class="as-rec-next-item" onclick="switchRecDrama('${String(dd.id).replace(/'/g, "\\'")}')">
                        <img src="${dd.cover || fallbackPoster}" alt="${dd.title || ''}" loading="lazy" onerror="this.onerror=null; this.src='${fallbackPoster}';">
                        <div class="as-rec-next-item-title">${dd.title || ''}</div>
                    </div>`).join('');
                        }

                        // Tự động load và phát video thật của phim
                        loadAndPlayReelsVideo(d, recEpisode);
                    }

                    // Lấy video tập phim và phát trực tiếp
                    async function loadAndPlayReelsVideo(drama, epNo = 1) {
                        const recView = document.getElementById('asRecommendView');
                        if (!recView || recView.style.display === 'none') {
                            // Tab Đề xuất không mở -> tuyệt đối không nạp và không phát video Reels!
                            return;
                        }
                        const videoEl = document.getElementById('asRecVideoElement');
                        const posterEl = document.getElementById('asRecVideoPoster');
                        const spinner = document.getElementById('asRecSpinner');
                        if (!videoEl || !drama) return;

                        if (spinner) spinner.classList.add('active');

                        // Đảm bảo hiển thị poster phim ngay khi bắt đầu tải tập mới
                        if (posterEl && drama.cover) {
                            posterEl.src = drama.cover;
                            posterEl.classList.remove('hidden');
                        }

                        try {
                            let detail = recDramaDetailCache.get(String(drama.id));
                            if (!detail) {
                                if (drama.episodes && drama.episodes.length > 0) {
                                    detail = drama;
                                    recDramaDetailCache.set(String(drama.id), detail);
                                } else if (typeof PN_DETAIL_CACHE !== 'undefined' && PN_DETAIL_CACHE.get(String(drama.id))) {
                                    detail = PN_DETAIL_CACHE.get(String(drama.id));
                                    recDramaDetailCache.set(String(drama.id), detail);
                                } else {
                                    const res = await fetch(`/phim-ngan/detail/${encodeURIComponent(drama.id)}`);
                                    const json = await res.json();
                                    if (json && json.success && json.data) {
                                        detail = json.data;
                                        recDramaDetailCache.set(String(drama.id), detail);
                                    }
                                }
                            }

                            if (detail) {
                                if (detail.cover && !drama.cover) {
                                    drama.cover = detail.cover;
                                    if (posterEl) posterEl.src = detail.cover;
                                }
                                if (detail.episodes && (!drama.episodes || drama.episodes.length === 0)) {
                                    drama.episodes = detail.episodes;
                                }
                                if (detail.totalEpisodes && !drama.totalEpisodes) {
                                    drama.totalEpisodes = detail.totalEpisodes;
                                }
                                // Đồng bộ lại metadata chi tiết chính xác nhất sau khi nạp detail
                                if (recDrama && String(recDrama.id) === String(detail.id)) {
                                    const titleEl = document.getElementById('asRecTitle');
                                    const genresEl = document.getElementById('asRecGenres');
                                    const descEl = document.getElementById('asRecDesc');
                                    const epCountEl = document.getElementById('asRecEpCount');
                                    if (titleEl && detail.title) titleEl.textContent = detail.title;
                                    if (genresEl && detail.genre) genresEl.textContent = detail.genre;
                                    if (descEl && detail.intro) descEl.textContent = detail.intro;
                                    if (epCountEl && detail.totalEpisodes) epCountEl.textContent = detail.totalEpisodes + ' tập';
                                }
                            }

                            let streamUrl = '';
                            if (detail && detail.episodes && detail.episodes.length > 0) {
                                const targetEp = detail.episodes[epNo - 1] || detail.episodes[0];
                                if (targetEp && (targetEp.streamUrl || targetEp.url)) {
                                    const raw = (targetEp.streamUrl || targetEp.url).trim();
                                    if (raw.includes('cdn.vietshort.com')) {
                                        streamUrl = `/phim-ngan/stream?sid=${encodeURIComponent(drama.id)}&vid=${encodeURIComponent(targetEp.id || epNo)}&rescue=1`;
                                    } else if (raw.includes('.m3u8') && raw.startsWith('http') && !raw.includes('/phim-ngan/proxy-hls')) {
                                        streamUrl = `/phim-ngan/proxy-hls?url=${encodeURIComponent(raw)}`;
                                    } else {
                                        streamUrl = raw;
                                    }
                                } else if (targetEp && targetEp.id) {
                                    streamUrl = `/phim-ngan/stream?sid=${encodeURIComponent(drama.id)}&vid=${encodeURIComponent(targetEp.id)}`;
                                }
                            }

                            if (!streamUrl) {
                                streamUrl = `/phim-ngan/stream?sid=${encodeURIComponent(drama.id)}&vid=1`;
                            }

                            // Tránh ngắt quãng và lỗi AbortError nếu video đang phát/tải đúng tập này
                            const loadedKey = `${drama.id}_${epNo}_${streamUrl}`;
                            if (videoEl.getAttribute('data-loaded-key') === loadedKey && (videoEl.src || videoEl._hlsInstance)) {
                                if (videoEl.paused) attemptReelsAutoplay(videoEl);
                                return;
                            }
                            videoEl.setAttribute('data-loaded-key', loadedKey);

                            if (videoEl._hlsInstance) {
                                try { videoEl._hlsInstance.destroy(); } catch (e) { }
                                videoEl._hlsInstance = null;
                            }

                            // Ẩn poster và spinner khi video load — nghe nhiều sự kiện + timeout bảo hiểm
                            const onReady = () => {
                                if (spinner) spinner.classList.remove('active');
                                if (posterEl) posterEl.classList.add('hidden');
                            };
                            ['playing', 'loadeddata', 'canplay', 'canplaythrough', 'timeupdate', 'error'].forEach(ev => {
                                videoEl.addEventListener(ev, onReady, { once: true });
                            });
                            clearTimeout(videoEl._spinnerSafety);
                            videoEl._spinnerSafety = setTimeout(onReady, 6000);

                            if (streamUrl && streamUrl.includes('.m3u8') && typeof Hls !== 'undefined' && Hls.isSupported()) {
                                const hls = new Hls({ enableWorker: true, lowLatencyMode: false });
                                hls.loadSource(streamUrl);
                                hls.attachMedia(videoEl);
                                hls.on(Hls.Events.MANIFEST_PARSED, function () {
                                    videoEl.muted = recSoundMuted;
                                    attemptReelsAutoplay(videoEl);
                                });
                                videoEl._hlsInstance = hls;
                            } else {
                                videoEl.src = streamUrl;
                                videoEl.muted = recSoundMuted;
                                videoEl.load();
                                attemptReelsAutoplay(videoEl);
                            }

                            loadRecSubtitles(drama.id, epNo);
                        } catch (err) {
                            console.warn('[Reels] Load video error:', err);
                            if (spinner) spinner.classList.remove('active');
                        }
                    }

                    // Tự động phát xử lý chính sách Autoplay của trình duyệt mượt mà, không bao giờ crash console
                    function attemptReelsAutoplay(videoEl) {
                        if (!videoEl) return;
                        const recView = document.getElementById('asRecommendView');
                        if (!recView || recView.style.display === 'none' || document.body.classList.contains('as-cinema-open') || miniPlayerActive) {
                            try { videoEl.pause(); videoEl.muted = true; } catch (e) { }
                            return;
                        }
                        videoEl.muted = recSoundMuted;

                        const playPromise = videoEl.play();
                        if (playPromise !== undefined && typeof playPromise.catch === 'function') {
                            playPromise.catch((err) => {
                                if (err && err.name === 'AbortError') {
                                    // Thao tác play bị hủy do chuyển video hoặc đổi tập mới => an toàn bỏ qua
                                    return;
                                }
                                // Trình duyệt chặn âm thanh tự phát => muted và phát tiếp
                                videoEl.muted = true;
                                recSoundMuted = true;
                                updateRecSoundIcon();
                                const p2 = videoEl.play();
                                if (p2 && typeof p2.catch === 'function') {
                                    p2.catch((e2) => {
                                        if (e2 && e2.name === 'AbortError') return;
                                        // Hiện nút Play ở giữa nếu cả muted autoplay cũng bị chặn
                                        const centerPlay = document.getElementById('asRecCenterPlay');
                                        const centerPlaySvg = document.getElementById('asRecCenterPlaySvg');
                                        if (centerPlay && centerPlaySvg) {
                                            centerPlaySvg.innerHTML = '<polygon points="7 4 20 12 7 20 7 4"/>';
                                            centerPlay.classList.add('show');
                                        }
                                    });
                                }

                                // Tương tác đầu tiên trên màn hình (chạm / click) sẽ mở tiếng và tiếp tục phát
                                const unlockSound = () => {
                                    document.removeEventListener('click', unlockSound);
                                    document.removeEventListener('touchstart', unlockSound);
                                    document.removeEventListener('keydown', unlockSound);
                                    window._asReelsAutoplayCleanup = null;
                                    const recView = document.getElementById('asRecommendView');
                                    if (!recView || recView.style.display === 'none') return;
                                    if (!videoEl || !videoEl.src || videoEl.paused) return;
                                    videoEl.muted = false;
                                    recSoundMuted = false;
                                    updateRecSoundIcon();
                                    const p3 = videoEl.play();
                                    if (p3 && typeof p3.catch === 'function') p3.catch(() => { });
                                };
                                window._asReelsAutoplayCleanup = () => {
                                    document.removeEventListener('click', unlockSound);
                                    document.removeEventListener('touchstart', unlockSound);
                                    document.removeEventListener('keydown', unlockSound);
                                };
                                document.addEventListener('click', unlockSound, { once: true });
                                document.addEventListener('touchstart', unlockSound, { once: true });
                            });
                        }
                        updateRecSoundIcon();
                    }

                    // Quản lý và đồng bộ phụ đề tiếng Việt chuẩn thời gian thực cho trang Đề xuất
                    let recCues = [];
                    let recSubTarget = null;
                    let recSubPoller = null;

                    async function loadRecSubtitles(dramaId, epNo = 1) {
                        const subVi = document.getElementById('asRecSubVi');
                        const subCn = document.getElementById('asRecSubCn');
                        const subWrap = document.getElementById('asRecSubtitles');
                        if (subCn) {
                            subCn.textContent = '';
                            subCn.style.display = 'none';
                        }
                        if (subVi) {
                            subVi.textContent = '';
                            subVi.style.display = 'none';
                            if (typeof applyRecSavedSubtitleStyle === 'function') {
                                applyRecSavedSubtitleStyle();
                            }
                        }
                        recCues = [];
                        if (recSubPoller) {
                            clearInterval(recSubPoller);
                            recSubPoller = null;
                        }
                        recSubTarget = { dramaId: String(dramaId), epNo: Number(epNo) };

                        // Kiểm tra nếu phim đã lồng tiếng hoặc có sẵn sub cứng: KHÔNG hiện overlay phụ đề đè lên
                        const detail = recDramaDetailCache.get(String(dramaId)) || (recDrama && String(recDrama.id) === String(dramaId) ? recDrama : null);
                        if (detail && (detail.isDubbed || (detail.title && (detail.title.includes('Lồng tiếng') || detail.title.includes('Thuyết minh'))))) {
                            return;
                        }

                        const applyVtt = (vttText, isEmbedded) => {
                            if (isEmbedded) {
                                recCues = [];
                                if (subVi) {
                                    subVi.textContent = '';
                                    subVi.style.display = 'none';
                                }
                                return;
                            }
                            try {
                                if (typeof parseWebVTT === 'function') {
                                    recCues = parseWebVTT(vttText).filter(c => !c.text.includes('✨ Phim đã có sẵn Vietsub'));
                                }
                            } catch (e) {
                                console.warn('[RecSub] parseWebVTT error:', e);
                            }
                        };

                        try {
                            const res = await fetch(`/phim-ngan/api/subtitle?dramaId=${encodeURIComponent(dramaId)}&ep=${epNo}`);
                            const data = await res.json();
                            if (data && data.success) {
                                if (data.isEmbedded || data.isDubbed) {
                                    recCues = [];
                                    if (subVi) {
                                        subVi.textContent = '';
                                        subVi.style.display = 'none';
                                    }
                                    return;
                                }
                                if (data.vtt) {
                                    applyVtt(data.vtt, false);
                                    return;
                                }
                            }
                        } catch (err) {
                            console.warn('[RecSub] Fetch error:', err);
                        }

                        // Polling ngầm nếu server đang tạo phụ đề cho tập này
                        let attempts = 0;
                        recSubPoller = setInterval(async () => {
                            attempts++;
                            const recView = document.getElementById('asRecommendView');
                            if (!recView || recView.style.display === 'none') {
                                clearInterval(recSubPoller);
                                recSubPoller = null;
                                return;
                            }
                            if (!recSubTarget || recSubTarget.dramaId !== String(dramaId) || recSubTarget.epNo !== Number(epNo)) {
                                clearInterval(recSubPoller);
                                recSubPoller = null;
                                return;
                            }
                            try {
                                const pRes = await fetch(`/phim-ngan/api/subtitle?dramaId=${encodeURIComponent(dramaId)}&ep=${epNo}`);
                                const pData = await pRes.json();
                                if (pData && pData.success) {
                                    clearInterval(recSubPoller);
                                    recSubPoller = null;
                                    if (!pData.isEmbedded && !pData.isDubbed && pData.vtt) {
                                        applyVtt(pData.vtt, false);
                                    }
                                    return;
                                }
                            } catch (e) { }

                            if (attempts >= 15) {
                                clearInterval(recSubPoller);
                                recSubPoller = null;
                            }
                        }, 2000);
                    }

                    // Đồng bộ font chữ, màu sắc, viền chữ phụ đề đã lưu từ trang xem (/phim-ngan/xem) sang Đề xuất (/phim-ngan/de-xuat)
                    // và loại bỏ hoàn toàn ô bọc/nền đen bao quanh phụ đề theo yêu cầu
                    function applyRecSavedSubtitleStyle() {
                        const subVi = document.getElementById('asRecSubVi');
                        if (!subVi) return;

                        let savedCc = null;
                        try {
                            const raw = localStorage.getItem('asPlayerSettings.v1');
                            if (raw) {
                                const data = JSON.parse(raw);
                                if (data && data.cc) savedCc = data.cc;
                            }
                        } catch (e) { }

                        const cfg = savedCc || (typeof ccCfg !== 'undefined' ? ccCfg : {
                            size: 18, color: '#ffffff', outline: 2, outlineColor: '#000000'
                        });

                        const fontSize = (cfg && typeof cfg.size === 'number' && cfg.size > 0) ? cfg.size : 18;
                        const color = (cfg && cfg.color) ? cfg.color : '#ffffff';
                        const outlineW = (cfg && typeof cfg.outline === 'number') ? cfg.outline : 2;
                        const outlineColor = (cfg && cfg.outlineColor) ? cfg.outlineColor : '#000000';

                        // Áp dụng font chữ chuẩn rạp chiếu phim (không có bất kỳ ô bọc nền nào)
                        subVi.style.setProperty('font-family', '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif', 'important');
                        subVi.style.setProperty('font-size', `clamp(${Math.max(14, fontSize - 2)}px, 2.4vh, ${Math.max(18, fontSize + 2)}px)`, 'important');
                        subVi.style.setProperty('font-weight', '700', 'important');
                        subVi.style.setProperty('color', color, 'important');
                        subVi.style.setProperty('background', 'transparent', 'important');
                        subVi.style.setProperty('border', 'none', 'important');
                        subVi.style.setProperty('border-radius', '0', 'important');
                        subVi.style.setProperty('box-shadow', 'none', 'important');
                        subVi.style.setProperty('backdrop-filter', 'none', 'important');
                        subVi.style.setProperty('-webkit-backdrop-filter', 'none', 'important');
                        subVi.style.setProperty('padding', '0', 'important');
                        subVi.style.setProperty('line-height', '1.38', 'important');

                        if (outlineW <= 0) {
                            subVi.style.setProperty('-webkit-text-stroke', '0px transparent', 'important');
                            subVi.style.setProperty('text-shadow', '0 1px 2px rgba(0,0,0,0.95), 0 2px 5px rgba(0,0,0,0.9), 0 0 8px rgba(0,0,0,0.7)', 'important');
                        } else {
                            subVi.style.setProperty('-webkit-text-stroke', `${outlineW}px ${outlineColor}`, 'important');
                            subVi.style.setProperty('paint-order', 'stroke fill', 'important');
                            if (outlineW === 1) {
                                subVi.style.setProperty('text-shadow', `0 1px 2px ${outlineColor}, 0 -1px 2px ${outlineColor}, 1px 0 2px ${outlineColor}, -1px 0 2px ${outlineColor}`, 'important');
                            } else if (outlineW === 2) {
                                subVi.style.setProperty('text-shadow', `0 1px 3px ${outlineColor}, 0 -1px 3px ${outlineColor}, 1px 0 3px ${outlineColor}, -1px 0 3px ${outlineColor}, 0 2px 6px rgba(0,0,0,0.95)`, 'important');
                            } else {
                                subVi.style.setProperty('text-shadow', `0 2px 4px ${outlineColor}, 0 -2px 4px ${outlineColor}, 2px 0 4px ${outlineColor}, -2px 0 4px ${outlineColor}, 0 3px 10px rgba(0,0,0,0.95)`, 'important');
                            }
                        }
                    }

                    window.addEventListener('storage', function (e) {
                        if (e.key === 'asPlayerSettings.v1') {
                            applyRecSavedSubtitleStyle();
                        }
                    });

                    function syncRecSubtitleCue(currentTime) {
                        const subWrap = document.getElementById('asRecSubtitles');
                        const subVi = document.getElementById('asRecSubVi');
                        if (!subVi || !subWrap) return;
                        if (subWrap.style.display === 'none') return;

                        if (!recCues || recCues.length === 0) {
                            subVi.textContent = '';
                            subVi.style.display = 'none';
                            return;
                        }
                        const matched = recCues.find(c => currentTime >= c.start && currentTime <= c.end);
                        if (matched && matched.text) {
                            const clean = matched.text.replace(/<[^>]*>/g, '').trim();
                            if (subVi.textContent !== clean) {
                                subVi.textContent = clean;
                                applyRecSavedSubtitleStyle();
                            }
                            subVi.style.display = clean ? 'inline-block' : 'none';
                        } else {
                            subVi.textContent = '';
                            subVi.style.display = 'none';
                        }
                    }

                    // Bật / tắt âm thanh Reels
                    function toggleRecSound() {
                        const videoEl = document.getElementById('asRecVideoElement');
                        if (!videoEl) return;
                        recSoundMuted = !recSoundMuted;
                        videoEl.muted = recSoundMuted;
                        updateRecSoundIcon();
                        showToolToast(recSoundMuted ? 'Đã tắt tiếng' : 'Đã bật tiếng');
                    }

                    /* ===== Menu Cài đặt riêng cho trang Đề xuất (/phim-ngan/de-xuat) ===== */
                    function openRecSettings(e) {
                        if (e) { e.preventDefault(); e.stopPropagation(); }
                        const pop = document.getElementById('asRecSettingsPop');
                        if (!pop) return;
                        // Đang mở thì bấm lại là đóng
                        if (pop.classList.contains('open')) {
                            closeRecSettings();
                            return;
                        }
                        closeToolPop();
                        // Đồng bộ trạng thái hiện tại lên menu trước khi mở
                        syncRecSettingsSwitches();
                        pop.classList.add('open');
                    }

                    function closeRecSettings() {
                        const pop = document.getElementById('asRecSettingsPop');
                        if (pop) pop.classList.remove('open');
                    }

                    function syncRecSettingsSwitches() {
                        const videoEl = document.getElementById('asRecVideoElement');
                        const soundSw = document.getElementById('asRecSetSoundSwitch');
                        const ccSw = document.getElementById('asRecSetCcSwitch');
                        const dubSw = document.getElementById('asRecSetDubSwitch');
                        const autoNextSw = document.getElementById('asRecAutoNextSwitch');
                        const favLabel = document.getElementById('asRecMenuFavLabel');
                        const favBtn = document.querySelector('.as-rec-actions .as-rec-action[data-rec-action="fav"]');
                        if (soundSw) soundSw.classList.toggle('on', !!(videoEl && !videoEl.muted));
                        const subWrap = document.getElementById('asRecSubtitles');
                        const ccOn = subWrap ? subWrap.style.display !== 'none' : true;
                        if (ccSw) ccSw.classList.toggle('on', ccOn);
                        if (autoNextSw) autoNextSw.classList.toggle('on', recAutoNextEnabled);
                        if (favLabel && favBtn) {
                            const isFav = favBtn.classList.contains('on') || favBtn.classList.contains('active');
                            favLabel.textContent = isFav ? 'Bỏ thích phim này' : 'Thích phim này';
                        }
                    }

                    function toggleRecSoundFromSettings(btn) {
                        toggleRecSound();
                        setTimeout(syncRecSettingsSwitches, 0);
                    }

                    function toggleRecSubtitleFromSettings(btn) {
                        const subWrap = document.getElementById('asRecSubtitles');
                        if (!subWrap) return;
                        const isHidden = subWrap.style.display === 'none';
                        subWrap.style.display = isHidden ? '' : 'none';
                        if (btn) btn.classList.toggle('on', isHidden);
                        showToolToast(isHidden ? 'Đã bật phụ đề' : 'Đã tắt phụ đề');
                    }

                    function toggleRecDubFromSettings(btn) {
                        if (btn) btn.classList.toggle('on');
                        const isOn = btn && btn.classList.contains('on');
                        showToolToast(isOn ? 'Đã bật thuyết minh AI' : 'Đã tắt thuyết minh AI');
                    }

                    let recAutoNextEnabled = true;
                    function toggleRecAutoNext(btn) {
                        recAutoNextEnabled = !recAutoNextEnabled;
                        if (btn) btn.classList.toggle('on', recAutoNextEnabled);
                        showToolToast(recAutoNextEnabled ? 'Tự chuyển tập: Bật' : 'Tự chuyển tập: Tắt');
                    }

                    function pickRecSpeed(btn) {
                        const videoEl = document.getElementById('asRecVideoElement');
                        if (!videoEl || !btn) return;
                        const spd = parseFloat(btn.dataset.speed || '1');
                        videoEl.playbackRate = spd;
                        document.querySelectorAll('#asRecSpeedSeg .as-tool-seg-btn').forEach(b => b.classList.remove('on'));
                        btn.classList.add('on');
                        showToolToast('Tốc độ phát ' + btn.textContent.trim());
                    }

                    /* Thích phim ngay trong menu cài đặt, đồng bộ với nút Thích bên ngoài */
                    function recToggleFavFromSettings() {
                        const btn = document.querySelector('.as-rec-actions .as-rec-action[data-rec-action="fav"]');
                        if (btn && typeof toggleRecFav === 'function') toggleRecFav(btn);
                        setTimeout(syncRecSettingsSwitches, 0);
                    }

                    function recToggleSaveFromSettings() {
                        const btn = document.querySelector('.as-rec-actions .as-rec-action[data-rec-action="save"]');
                        if (btn && typeof toggleRecSave === 'function') toggleRecSave(btn);
                    }

                    function retranslateRecEpisode() {
                        showToolToast('Đang làm mới phụ đề tiếng Việt...');
                        if (recDrama) {
                            loadRecSubtitles(recDrama.id, recEpisode || 1);
                        }
                        setTimeout(() => {
                            showToolToast('Phụ đề đã được làm mới bản dịch chuẩn nhất!');
                        }, 800);
                    }

                    /* Dự phòng: gắn trực tiếp listener cho cột nút tương tác của trang Đề xuất.
                       Mỗi nút KHÔNG dùng onclick inline nữa để tránh chạy 2 lần
                       (trước đây bị bấm 1 cái mà hàm chạy 2 lần: Thích bật rồi tắt ngay,
                       Cài đặt mở rồi đóng ngay → tưởng như không bấm được). */
                    (function bindRecActions() {
                        const ACTIONS = {
                            fav: (ev, btn) => toggleRecFav(btn),
                            save: (ev, btn) => toggleRecSave(btn),
                            comment: () => openRecCommentDrawer(),
                            episodes: () => openRecEpisodeDrawer(),
                            share: (ev) => openRecShare(ev),
                            fs: () => toggleRecFullscreen(),
                            settings: (ev) => openRecSettings(ev)
                        };

                        const wire = () => {
                            document.querySelectorAll('.as-rec-actions .as-rec-action[data-rec-action]').forEach(btn => {
                                if (btn.dataset.recWired) return;
                                btn.dataset.recWired = '1';
                                const act = ACTIONS[btn.dataset.recAction];
                                if (!act) return;
                                btn.addEventListener('click', function (ev) {
                                    ev.preventDefault();
                                    ev.stopPropagation();
                                    try { act(ev, btn); } catch (err) { console.error(err); }
                                });
                            });
                        };

                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', () => {
                                wire();
                                if (typeof applyRecSavedSubtitleStyle === 'function') applyRecSavedSubtitleStyle();
                            });
                        } else {
                            wire();
                            if (typeof applyRecSavedSubtitleStyle === 'function') applyRecSavedSubtitleStyle();
                        }
                    })();

                    /* Mở / Đóng ngăn kéo chọn tập (Bottom Sheet) trên Mobile cho trang Đề xuất */
                    function openRecEpisodeDrawer() {
                        const drawer = document.getElementById('asRecSheetDrawer');
                        const backdrop = document.getElementById('asRecSheetBackdrop');
                        const body = document.getElementById('asRecSheetBody');
                        const heading = drawer ? drawer.querySelector('.as-rec-sheet-heading') : null;
                        if (!drawer || !backdrop || !recDrama) return;

