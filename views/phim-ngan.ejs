                                svg.setAttribute('stroke', isPl ? 'var(--as-lime, #a3e635)' : 'currentColor');
                            }
                        }
                        if (cinemaSaveBtn) {
                            cinemaSaveBtn.classList.toggle('active', isPl);
                            const svg = cinemaSaveBtn.querySelector('svg');
                            if (svg) {
                                svg.setAttribute('fill', isPl ? 'var(--as-lime, #a3e635)' : 'none');
                                svg.setAttribute('stroke', isPl ? 'var(--as-lime, #a3e635)' : 'currentColor');
                            }
                        }
                        if (mobSaveBtn) {
                            mobSaveBtn.classList.toggle('active', isPl);
                            const svg = mobSaveBtn.querySelector('svg');
                            if (svg) {
                                svg.setAttribute('fill', isPl ? 'var(--as-lime, #a3e635)' : 'none');
                                svg.setAttribute('stroke', isPl ? 'var(--as-lime, #a3e635)' : 'currentColor');
