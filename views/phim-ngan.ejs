                                                                                    stroke="#a3e635" stroke-width="2.4"
                                                                                    stroke-linecap="round"
                                                                                    stroke-linejoin="round">
                                                                                    <path
                                                                                        d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                                                    <circle cx="12" cy="12" r="3.2" />
                                                                                </svg></span>
                                                                            <%= d.stats ? d.stats.views : (20 + idx) %>
                                                                        </span>
                                                                        <span><span class="as-stat-ico"
                                                                                style="background:rgba(244,114,182,0.2);"><svg
                                                                                    width="9" height="9"
                                                                                    viewBox="0 0 24 24" fill="none"
                                                                                    stroke="#f472b6" stroke-width="2.4"
                                                                                    stroke-linecap="round"
                                                                                    stroke-linejoin="round">
                                                                                    <path
                                                                                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                                                                </svg></span>
                                                                            <%= d.stats ? d.stats.likes : 1 %>
                                                                        </span>
                                                                        <span><span class="as-stat-ico"
                                                                                style="background:rgba(250,204,21,0.2);"><svg
                                                                                    width="9" height="9"
                                                                                    viewBox="0 0 24 24" fill="none"
                                                                                    stroke="#facc15" stroke-width="2"
                                                                                    stroke-linecap="round"
                                                                                    stroke-linejoin="round">
                                                                                    <polygon
                                                                                        points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                                                                </svg></span>
                                                                            <%= d.stats ? d.stats.stars : 0 %>
                                                                        </span>
                                                                    </div>
                                                        </div>
                                                    </div>

                                                    <!-- Tiêu đề và thể loại phim nằm ngay dưới khung poster -->
                                                    <div class="as-top10-card-body">
                                                        <div class="as-top10-title">
                                                            <%= d.title %>
                                                        </div>
                                                        <div class="as-top10-genre">
                                                            <%= d.genre %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                    </section>
                                    <% } %>

                                        <!-- =======================================================
             4. "HÔM NAY MUỐN XEM GÌ?" (SCREENSHOT 3)
             ======================================================= -->
                                        <section class="as-genre-explore-section">
                                            <a class="as-section-head-link"
                                                onclick="document.getElementById('asLeaderboard').scrollIntoView({behavior:'smooth'})">
                                                <span>Hôm nay muốn xem gì?</span>
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2.5">
