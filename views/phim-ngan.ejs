            /* Canh lề đồng bộ với dự án chính (.app-container: 1540px + padding 24/16/12)
           Lưu ý: CSS global (movie-cards-v2.css) đã set body { padding-top: 64px } cho
           header fixed nên container chỉ cần thêm 24px => tổng 88px như trang chủ dự án chính */
            .as-container {
                max-width: 1540px;
                width: 100%;
                margin: 0 auto;
                box-sizing: border-box;
                padding: 24px 12px 140px;
            }

