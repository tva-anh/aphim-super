                    const ALLSHORTS_KEY_B64 = "223QON86QMVdNyCOZumR4ZLNUmiltER1x4ioU6qCPUs=";
                    let allshortsCryptoKey = null;

                    async function getAllshortsCryptoKey() {
                        if (allshortsCryptoKey) return allshortsCryptoKey;
                        const raw = Uint8Array.from(atob(ALLSHORTS_KEY_B64), c => c.charCodeAt(0));
                        allshortsCryptoKey = await crypto.subtle.importKey("raw", raw, "AES-GCM", false, ["decrypt"]);
                        return allshortsCryptoKey;
                    }

                    async function decryptAllshortsPayload(b64) {
                        const raw = Uint8Array.from(atob(b64.trim()), c => c.charCodeAt(0));
                        const iv = raw.subarray(0, 12);
                        const ciphertext = raw.subarray(12);
                        const key = await getAllshortsCryptoKey();
                        const decrypted = await crypto.subtle.decrypt({ name: "AES-GCM", iv }, key, ciphertext);
                        return JSON.parse(new TextDecoder().decode(decrypted));
                    }

                    async function tryFetchAllshortsStream(provider, dramaId, epNo) {
                        try {
                            // ✅ Sửa: Gọi qua backend proxy thay vì trực tiếp allshorts.net (tránh CORS + 403)
                            const url = `/phim-ngan/api/get-stream?dramaId=${dramaId}&ep=${epNo}`;
                            const res = await fetch(url);
                            if (res.ok) {
                                const json = await res.json();
                                if (json.success && json.streamUrl) return json.streamUrl;
                            }
                        } catch (e) {
                            console.warn('[Stream Fetch] Error:', e.message);
                        }
                        return null;
                    }

                    // 🚀 Client-side Narto Direct Extractor: giải mã payload JWT narto để kết nối trực tiếp CDN, giảm 1 trạm trung gian
                    function extractDirectMediaUrlClient(url) {
                        if (!url || typeof url !== 'string') return url;
                        if (url.includes('narto-drama.com/e/')) {
                            try {
                                const tokenMatch = url.match(/\/e\/[ms]\/([A-Za-z0-9_-]+)/);
                                if (tokenMatch && tokenMatch[1]) {
                                    const b64 = tokenMatch[1].replace(/-/g, '+').replace(/_/g, '/');
                                    const rawPayload = decodeURIComponent(escape(atob(b64)));
                                    const data = JSON.parse(rawPayload);
                                    if (data && data.src && data.src.startsWith('http')) {
                                        return data.src;
                                    }
                                }
                            } catch (e) { }
                        }
                        return url;
                    }

                    // 🚀 Factory khởi tạo HLS.js siêu tối ưu cho Mobile (progressive buffer, prefetch frag 1, lowLatencyMode false)
                    function createOptimizedHls(customOpts = {}) {
                        return new Hls(Object.assign({
                            enableWorker: true,
                            lowLatencyMode: false, // ⚡ VOD PHẢI LÀ FALSE: Tránh stall / rebuffer trên mạng 4G/5G
                            startFragPrefetch: true, // ⚡ Tải trước phân đoạn video đầu tiên ngay khi manifest đang parse
                            progressive: true, // ⚡ Bơm dữ liệu vào SourceBuffer tức thì khi tải từng chunk, không chờ full 3MB TS
                            testBandwidth: false, // ⚡ Bỏ qua test băng thông ban đầu, phát ngay với initial level
                            maxBufferLength: 15, // ⚡ Tối ưu RAM cho mobile (15s đệm phía trước)
                            maxMaxBufferLength: 30,
                            maxBufferSize: 20 * 1024 * 1024, // 20MB buffer trần
                            maxBufferHole: 0.8, // ⚡ Bỏ qua khe hở timestamp nhỏ, không bị khựng video
                            backBufferLength: 10, // ⚡ Giải phóng bộ nhớ video phía sau để mobile không bị tràn RAM
                            nudgeOffset: 0.1,
                            nudgeMaxRetry: 5,
                            manifestLoadingTimeOut: 10000,
                            fragLoadingTimeOut: 15000
                        }, customOpts));
                    }

                    function playEpisodeByIndex(index, seekTime = 0) {
                        if (!currentActiveDrama || !currentActiveDrama.episodes || !currentActiveDrama.episodes[index]) return;

                        currentActiveEpIdx = index;
                        const ep = currentActiveDrama.episodes[index];
                        const epNo = ep.no || (index + 1);
                        const totalEps = currentActiveDrama.episodes.length;

                        // 🔍 Tự động khôi phục mốc thời gian đã lưu nếu seekTime chưa được truyền
                        if (seekTime <= 0 && typeof getSavedProgressForDrama === 'function') {
                            const saved = getSavedProgressForDrama(currentActiveDrama.id);
                            if (saved && saved.epNo === epNo && saved.currentTime > 0) {
                                seekTime = saved.currentTime;
                            }
                        }

                        const videoEl = document.getElementById('asVideoEl');
                        const spinner = document.getElementById('asVideoSpinner');
                        const counterEl = document.getElementById('asSidebarEpCounter');
                        const playIcon = document.getElementById('asPlayIconSvg');
                        const pauseIcon = document.getElementById('asPauseIconSvg');
                        const centerPlayBtn = document.getElementById('asCenterPlayBtn');

                        // Luôn bật âm thanh khi user mở tập xem
                        if (videoEl) {
                            videoEl.muted = false;
                            if (typeof videoEl.volume === 'number' && videoEl.volume <= 0.05) videoEl.volume = 1;
                            if (typeof updateVolumeIcon === 'function') updateVolumeIcon();
                            if (typeof syncVolumeSlider === 'function') syncVolumeSlider();
                        }

                        if (counterEl) counterEl.textContent = `Tập ${epNo} / ${totalEps}`;
                        syncMobileDramaInfo(currentActiveDrama.title, epNo, totalEps);

                        // Cập nhật URL sang dạng /xem/<id>?ep=N để load lại trang vẫn tự phát đúng tập CHỈ KHI RẠP CHIẾU ĐANG MỞ
                        const modal = document.getElementById('asTheaterModal');
                        if (!miniPlayerActive && modal && modal.classList.contains('active')) {
                            try {
                                document.title = `Xem Phim ${currentActiveDrama.title} Tập ${epNo} Full HD Vietsub | APhim Phim Ngắn`;
                                window.history.replaceState({}, '', `/phim-ngan/xem/${currentActiveDrama.id}?ep=${epNo}`);
                            } catch (e) { }
                        }

                        // Đang ở khung nhỏ: cập nhật tên phim + số tập trên khung nhỏ
                        if (miniPlayerActive) updateMiniInfo();

                        // Highlight buttons in sidebar & detail
                        document.querySelectorAll('.as-sidebar-ep-btn').forEach(b => {
                            b.classList.toggle('active', parseInt(b.dataset.ep, 10) === epNo);
                        });
                        document.querySelectorAll('.as-detail-ep-btn').forEach(b => {
                            b.classList.toggle('active', parseInt(b.dataset.ep, 10) === epNo);
                        });

                        // Update status text on detail view
                        const statusLabel = document.getElementById('asDetailStatusLabel');
                        if (statusLabel) statusLabel.textContent = `Đang xem: tập ${epNo}.`;
                        const playHeroLabel = document.getElementById('asPlayHeroLabel');
                        if (playHeroLabel) playHeroLabel.textContent = `Xem từ tập ${epNo}`;
                        if (window.innerWidth <= 991) { closeMobileCinemaSheet(); }

                        // ⚡ Kỹ thuật nạp thông minh: Tự bóc tách link direct CDN (bỏ qua proxy nếu CDN đã hỗ trợ CORS)
                        let streamUrl = '';
                        if (ep && (ep.streamUrl || ep.url)) {
                            let raw = (ep.streamUrl || ep.url).trim();
                            raw = extractDirectMediaUrlClient(raw);

                            if (raw.includes('cdn.vietshort.com')) {
                                streamUrl = `/phim-ngan/stream?sid=${encodeURIComponent(currentActiveDrama.id)}&vid=${encodeURIComponent(ep ? ep.id : epNo)}&rescue=1`;
                            } else if (raw.includes('vip.ffzy-play') || raw.includes('tiktokcdn.com') || raw.includes('cloudfront.net') || raw.includes('allshorts.net')) {
                                // ⚡ Phát trực tiếp siêu tốc từ CDN gốc không qua Node proxy
                                streamUrl = raw;
                            } else if ((raw.includes('.m3u8') || raw.includes('/e/m/')) && raw.startsWith('http') && !raw.includes('/phim-ngan/proxy-hls')) {
                                streamUrl = `/phim-ngan/proxy-hls?url=${encodeURIComponent(raw)}`;
                            } else {
                                streamUrl = raw;
                            }
                        } else {
                            streamUrl = `/phim-ngan/stream?sid=${encodeURIComponent(currentActiveDrama.id)}&vid=${encodeURIComponent(ep ? ep.id : (index + 1))}`;
                        }

                        // Tự động nâng cấp sang luồng 1080p Full HD trực tiếp từ ByteDance CDN nếu khác với luồng hiện tại
                        if (currentActiveDrama && !String(currentActiveDrama.id).startsWith('narto_') && (currentActiveDrama.source === 'hongguo' || currentActiveDrama.provider === 'hongguo' || String(currentActiveDrama.id).startsWith('76'))) {
                            tryFetchAllshortsStream(currentActiveDrama.provider || 'hongguo', currentActiveDrama.id, epNo).then(hdUrl => {
                                if (!hdUrl) return;
                                const cleanCurrent = streamUrl.replace('/phim-ngan/proxy-hls?url=', '');
                                const isSameStream = (cleanCurrent === hdUrl) || (decodeURIComponent(cleanCurrent) === hdUrl);
                                if (isSameStream) return; // ✅ Đã là luồng chuẩn, không hủy player đang nạp

                                if (currentActiveEpIdx === index && videoEl && !hasStartedPlaying) {
                                    console.log('[APhim Cinema] ⚡ Nâng cấp sang luồng 1080p Full HD ByteDance:', hdUrl);
                                    if (videoEl._hlsInstance) {
                                        try { videoEl._hlsInstance.destroy(); } catch (e) { }
                                        videoEl._hlsInstance = null;
                                    }
                                    if (hdUrl.includes('.m3u8') && typeof Hls !== 'undefined' && Hls.isSupported()) {
                                        const hls = createOptimizedHls();
                                        hls.loadSource(hdUrl);
                                        hls.attachMedia(videoEl);
                                        hls.on(Hls.Events.MANIFEST_PARSED, function () {
                                            attemptAutoplay(videoEl, spinner);
                                            performSeekOnce();
                                        });
                                        videoEl._hlsInstance = hls;
                                    } else {
                                        videoEl.src = hdUrl;
                                        videoEl.load();
                                        attemptAutoplay(videoEl, spinner);
                                    }
                                }
                            }).catch(() => { });
                        }

                        // Đảm bảo video nằm đúng trong khung chiếu
                        const videoStage = document.getElementById('asVideoStage');
                        const videoBox = videoStage && videoStage.querySelector('.as-cinema-video-box');
                        if (videoEl && videoBox && videoEl.parentElement !== videoBox) {
                            videoBox.appendChild(videoEl);
                            const overlay = document.getElementById('asSubOverlay');
                            if (overlay) videoBox.appendChild(overlay);
                        }

                        if (videoEl) {
                            if (spinner) spinner.classList.add('active');

                            // Thiết lập logic tua mốc thời gian đã lưu (seekTime)
                            videoEl._seekTargetTime = seekTime > 0 ? seekTime : 0;
                            videoEl._seekPerformed = false;
                            const performSeekOnce = () => {
                                if (videoEl._seekTargetTime > 0 && !videoEl._seekPerformed) {
                                    try {
                                        if (videoEl.duration && videoEl._seekTargetTime >= Math.max(0, videoEl.duration - 1)) {
                                            return;
                                        }
                                        videoEl.currentTime = videoEl._seekTargetTime;
                                        videoEl._seekPerformed = true;
                                        console.log(`[APhim Cinema] ⏩ Đã khôi phục mốc xem tập ${epNo}: ${videoEl._seekTargetTime}s`);
                                        if (typeof showToolToast === 'function') {
                                            showToolToast(`Đang tiếp tục xem từ ${formatTimeSeconds(videoEl._seekTargetTime)}`);
                                        }
                                    } catch (err) { }
                                }
                            };
                            ['loadedmetadata', 'canplay', 'playing'].forEach(evName => {
                                videoEl.addEventListener(evName, performSeekOnce, { passive: true });
                            });

                            // Dọn dẹp phiên Hls cũ và timer giải cứu cũ
                            if (videoEl._hlsInstance) {
                                try { videoEl._hlsInstance.destroy(); } catch (e) { }
                                videoEl._hlsInstance = null;
                            }
                            if (videoEl._rescueTimer) {
                                clearTimeout(videoEl._rescueTimer);
                                videoEl._rescueTimer = null;
                            }

                            // 🛡️ BẢO HIỂM GIẢI CỨU 8S: Tự động kích hoạt luồng cứu cánh nếu stream ngoài bị lỗi hoặc nghẽn
                            let hasStartedPlaying = false;
                            const triggerRescue = () => {
                                const m = document.getElementById('asTheaterModal');
                                const isTheaterActive = m && m.classList.contains('active');
                                if (!isTheaterActive && !miniPlayerActive) {
                                    return;
                                }
                                if (hasStartedPlaying) return;
                                hasStartedPlaying = true;
                                const rescueUrl = `/phim-ngan/stream?sid=${encodeURIComponent(currentActiveDrama.id)}&vid=${encodeURIComponent(ep ? ep.id : epNo)}&rescue=1`;
                                console.warn('[APhim Cinema] ⚡ Kích hoạt luồng cứu cánh siêu tốc:', rescueUrl);
                                if (videoEl._hlsInstance) {
                                    try { videoEl._hlsInstance.destroy(); } catch (e) { }
                                    videoEl._hlsInstance = null;
                                }
                                if (typeof Hls !== 'undefined' && Hls.isSupported()) {
                                    const rescueHls = createOptimizedHls();
                                    rescueHls.loadSource(rescueUrl);
                                    rescueHls.attachMedia(videoEl);
                                    rescueHls.on(Hls.Events.MANIFEST_PARSED, function () {
                                        attemptAutoplay(videoEl, spinner);
                                        performSeekOnce();
                                    });
                                    rescueHls.on(Hls.Events.ERROR, function (ev, errData) {
                                        if (errData && errData.fatal) {
                                            videoEl.src = rescueUrl;
                                            videoEl.load();
                                            attemptAutoplay(videoEl, spinner);
                                        }
                                    });
                                    videoEl._hlsInstance = rescueHls;
                                } else {
                                    videoEl.src = rescueUrl;
                                    videoEl.preload = 'auto';
                                    videoEl.load();
                                    attemptAutoplay(videoEl, spinner);
                                }
                            };

                            videoEl._rescueTimer = setTimeout(() => {
                                if (!hasStartedPlaying && videoEl.readyState < 2 && videoEl.paused) {
                                    triggerRescue();
                                }
                            }, 8000);

                            const isHls = streamUrl && streamUrl.includes('.m3u8');
                            if (isHls && typeof Hls !== 'undefined' && Hls.isSupported()) {
                                const hls = createOptimizedHls();
                                hls.loadSource(streamUrl);
                                hls.attachMedia(videoEl);
                                hls.on(Hls.Events.MANIFEST_PARSED, function () {
                                    attemptAutoplay(videoEl, spinner);
                                    performSeekOnce();
                                });
                                hls.on(Hls.Events.FRAG_LOADED, function () {
                                    hasStartedPlaying = true;
                                    if (videoEl._rescueTimer) clearTimeout(videoEl._rescueTimer);
                                    performSeekOnce();
                                });
                                hls.on(Hls.Events.ERROR, function (event, data) {
                                    if (data.fatal) {
                                        if (!streamUrl.includes('/phim-ngan/proxy-hls')) {
                                            console.warn('[APhim Cinema] Fallback direct HLS error sang proxy-hls:', streamUrl);
                                            const proxyUrl = `/phim-ngan/proxy-hls?url=${encodeURIComponent(streamUrl)}`;
                                            hls.loadSource(proxyUrl);
                                            return;
                                        }
                                        triggerRescue();
                                    }
                                });
                                videoEl._hlsInstance = hls;
                            } else {
                                // 🚀 Luồng trực tiếp MP4 hoặc Safari iOS native HLS (Khởi động tức thì < 100ms)
                                videoEl.src = streamUrl;
                                videoEl.preload = 'auto';
                                videoEl.load();
                                attemptAutoplay(videoEl, spinner);
                            }

                            // ⚡ Tải trước (Prefetch) metadata & DNS tập kế tiếp để chuyển tập 0ms
                            const nextEpIdx = index + 1;
                            if (currentActiveDrama.episodes && currentActiveDrama.episodes[nextEpIdx]) {
                                const nextEp = currentActiveDrama.episodes[nextEpIdx];
                                let nextRaw = (nextEp.streamUrl || nextEp.url || '').trim();
                                if (nextRaw) {
                                    nextRaw = extractDirectMediaUrlClient(nextRaw);
                                    try {
                                        const preLink = document.createElement('link');
                                        preLink.rel = 'prefetch';
                                        preLink.href = nextRaw;
                                        document.head.appendChild(preLink);
                                    } catch (e) { }
                                }
                            }

                            if (playIcon) playIcon.style.display = 'none';
                            if (pauseIcon) pauseIcon.style.display = 'block';
                            if (centerPlayBtn) centerPlayBtn.classList.remove('show');

                            videoEl.onerror = () => {
                                const m = document.getElementById('asTheaterModal');
                                const isTheaterActive = m && m.classList.contains('active');
                                if (!isTheaterActive && !miniPlayerActive) return;
                                if (!videoEl.src || videoEl.src === window.location.href || videoEl.src.endsWith('/')) return;
                                console.warn('[APhim Cinema] Video element error:', videoEl.src);
                                triggerRescue();
                            };

                            // Ẩn vòng quay khi video sẵn sàng/phát (Thuần Event-driven, không dùng polling setInterval gây forced reflow)
                            const hideSpinner = () => {
                                if (spinner && spinner.classList.contains('active')) spinner.classList.remove('active');
                            };
                            ['playing', 'canplay', 'canplaythrough', 'loadeddata', 'timeupdate'].forEach(ev => {
                                videoEl.addEventListener(ev, hideSpinner, { passive: true });
                            });
                            clearTimeout(videoEl._spinnerSafety);
                            videoEl._spinnerSafety = setTimeout(hideSpinner, 3500);

                            videoEl.onplaying = () => {
                                hasStartedPlaying = true;
                                if (videoEl._rescueTimer) clearTimeout(videoEl._rescueTimer);
                                hideSpinner();
                                if (playIcon) playIcon.style.display = 'none';
                                if (pauseIcon) pauseIcon.style.display = 'block';
                                if (centerPlayBtn) centerPlayBtn.classList.remove('show');
                                performSeekOnce();
                                if (typeof scheduleMobileCinemaActionsAutoHide === 'function') {
                                    scheduleMobileCinemaActionsAutoHide(2200);
                                }
                            };

                            videoEl.onpause = () => {
                                if (playIcon) playIcon.style.display = 'block';
                                if (pauseIcon) pauseIcon.style.display = 'none';
                                if (centerPlayBtn) centerPlayBtn.classList.add('show');
                                if (typeof showMobileCinemaActions === 'function') {
                                    showMobileCinemaActions(0);
                                }
                                if (videoEl.currentTime > 0) {
                                    saveContinueState(currentActiveDrama, epNo, videoEl.currentTime, videoEl.duration, true);
                                }
                            };

                            videoEl.onended = () => {
                                if (currentActiveEpIdx < currentActiveDrama.episodes.length - 1) {
                                    navigateDramaEpisode(1);
                                }
                            };

                            // Real-time Subtitle & Seekbar (Tối ưu hóa: Cache DOM nodes, không query lặp lại mỗi frame)
                            const curLabel = document.getElementById('asCurrentTimeLabel');
                            const durLabel = document.getElementById('asDurationLabel');
                            const seekbar = document.getElementById('asSeekbar');
                            const subOverlay = document.getElementById('asSubOverlay');

                            videoEl.ontimeupdate = () => {
                                const cur = videoEl.currentTime;
                                const dur = videoEl.duration || 0;

                                // ⚡ Tự động lưu tiến trình xem định kỳ mỗi 3.5 giây
                                const now = Date.now();
                                if (!videoEl._lastSaveTime || (now - videoEl._lastSaveTime > 3500)) {
                                    videoEl._lastSaveTime = now;
                                    if (cur > 0) {
                                        saveContinueState(currentActiveDrama, epNo, cur, dur);
                                    }
                                }

                                if (curLabel) curLabel.textContent = formatTimeSeconds(cur);
                                if (durLabel && dur) durLabel.textContent = formatTimeSeconds(dur);
                                if (seekbar && dur) {
                                    const pct = Math.min(100, Math.max(0, (cur / dur) * 100));
                                    seekbar.value = pct;
                                    seekbar.style.background = `linear-gradient(to right, #ffffff ${pct}%, #4e515a ${pct}%)`;
                                }

                                if (!subtitlesEnabled || currentCues.length === 0) {
                                    if (subOverlay && subOverlay.textContent !== '') {
                                        subOverlay.textContent = '';
                                        subOverlay.style.display = 'none';
                                    }
                                    return;
                                }
                                const matchedCue = currentCues.find(c => cur >= c.start && cur <= c.end);
                                if (subOverlay) {
                                    if (matchedCue && matchedCue.text) {
                                        const cleanText = matchedCue.text.replace(/<[^>]*>/g, '').trim();
                                        if (subOverlay.textContent !== cleanText) {
                                            subOverlay.textContent = cleanText;
                                            subOverlay.style.display = cleanText ? 'block' : 'none';
                                        }
                                    } else if (subOverlay.textContent !== '') {
                                        subOverlay.textContent = '';
                                        subOverlay.style.display = 'none';
                                    }
                                }
                            };
                        }

                        // Load subtitle
                        loadEpisodeSubtitles(currentActiveDrama.id, epNo);

                        // Trigger on-demand focus for this ep
                        fetch(`/phim-ngan/api/focus?dramaId=${encodeURIComponent(currentActiveDrama.id)}&ep=${epNo}`).catch(() => { });
                        setTimeout(() => { updateReadyEpisodesBadge(currentActiveDrama.id); }, 1500);

                        // Save continue
                        saveContinueState(currentActiveDrama, epNo, seekTime > 0 ? seekTime : 0);
                    }

                    // =======================================================
                    // 8. SUBTITLE ENGINE
                    // =======================================================
                    currentCues = [];
                    let subtitlesEnabled = true;

                    function parseWebVTT(vttText) {
                        if (!vttText) return [];
                        const lines = vttText.split(/\r?\n/);
                        const cues = [];
                        let currentCue = null;
                        const timeRegex = /((?:\d{2}:)?\d{2}:\d{2}[.,]\d{3})\s*-->\s*((?:\d{2}:)?\d{2}:\d{2}[.,]\d{3})/;

                        function parseSeconds(tStr) {
                            if (!tStr) return 0;
                            const parts = tStr.trim().replace(',', '.').split(':');
                            if (parts.length === 3) {
                                return parseFloat(parts[0]) * 3600 + parseFloat(parts[1]) * 60 + parseFloat(parts[2]);
                            }
                            return parseFloat(parts[0]) * 60 + parseFloat(parts[1]);
                        }

                        for (let i = 0; i < lines.length; i++) {
                            const line = lines[i].trim();
                            const match = line.match(timeRegex);
                            if (match) {
                                currentCue = {
                                    start: parseSeconds(match[1]),
                                    end: parseSeconds(match[2]),
                                    text: ''
                                };
                                cues.push(currentCue);
                            } else if (currentCue && line && !line.match(/^\d+$/) && !line.startsWith('WEBVTT') && !line.startsWith('NOTE')) {
                                currentCue.text = currentCue.text ? (currentCue.text + '\n' + line) : line;
                            }
                        }
                        return cues;
                    }

                    let subNoticeTimeout = null;

                    function dismissSubNotice() {
                        const notice = document.getElementById('asSubNotice');
                        if (notice) notice.style.display = 'none';
                        if (subNoticeTimeout) clearTimeout(subNoticeTimeout);
                    }

                    function applySubtitleData(vttText, epNo, isEmbedded = false) {
                        const subOverlay = document.getElementById('asSubOverlay');
                        const ccBtn = document.getElementById('asCcBtn');
                        const notice = document.getElementById('asSubNotice');
                        const noticeText = document.getElementById('asSubNoticeText');

                        if (isEmbedded) {
                            currentCues = [];
                            if (subOverlay) {
                                subOverlay.textContent = '';
                                subOverlay.style.display = 'none';
                            }
                        } else {
                            currentCues = parseWebVTT(vttText);
                        }
                        if (ccBtn) ccBtn.classList.add('active');

                        // Cập nhật ngay phụ đề tại thời điểm hiện tại của video (kể cả khi video đang pause)
                        if (!isEmbedded && currentCues.length > 0 && subOverlay) {
                            const videoEl = document.getElementById('asCinemaVideo');
                            if (videoEl && typeof videoEl.currentTime === 'number') {
                                const cur = videoEl.currentTime;
                                const matchedCue = currentCues.find(c => cur >= c.start && cur <= c.end);
                                if (matchedCue && matchedCue.text) {
                                    const cleanText = matchedCue.text.replace(/<[^>]*>/g, '').trim();
                                    subOverlay.textContent = cleanText;
                                    subOverlay.style.display = cleanText ? 'block' : 'none';
                                }
                            }
                        }

                        // Mark button as has-sub
                        document.querySelectorAll(`.as-modal-ep-btn[data-ep="${epNo}"]`).forEach(b => {
                            b.classList.add('has-sub');
                            b.title = `Tập ${epNo}: Đã có Vietsub`;
                        });

                        if (notice && noticeText) {
                            noticeText.innerHTML = isEmbedded ? `✨ Phim đã tích hợp sẵn Vietsub 1080p` : `✨ Phụ đề Tiếng Việt đã sẵn sàng`;
                            notice.style.display = 'flex';
                            subNoticeTimeout = setTimeout(dismissSubNotice, 1500);
                        }
                    }

                    async function loadEpisodeSubtitles(dramaId, epNo) {
                        const subOverlay = document.getElementById('asSubOverlay');
                        const notice = document.getElementById('asSubNotice');
                        const noticeText = document.getElementById('asSubNoticeText');

                        if (subOverlay) subOverlay.textContent = '';
                        currentCues = [];
                        dismissSubNotice();

                        if (activeSubPoller) {
                            clearInterval(activeSubPoller);
                            activeSubPoller = null;
                        }
                        activeSubTarget = { dramaId, epNo };

                        if (notice && noticeText) {
                            noticeText.innerHTML = `✨ Đang đồng bộ phụ đề Tiếng Việt cho Tập ${epNo}...`;
                            notice.style.display = 'flex';
                        }

                        try {
                            const res = await fetch(`/phim-ngan/api/subtitle?dramaId=${encodeURIComponent(dramaId)}&ep=${epNo}`);
                            const data = await res.json();
                            if (data.success && data.vtt) {
                                applySubtitleData(data.vtt, epNo, Boolean(data.isEmbedded));
                                return;
                            }
                        } catch (err) { }

                        let attempts = 0;
                        activeSubPoller = setInterval(async () => {
                            attempts++;
                            const modal = document.getElementById('asTheaterModal');
                            if (!modal || !modal.classList.contains('active')) {
                                clearInterval(activeSubPoller);
                                activeSubPoller = null;
                                return;
                            }
                            if (!activeSubTarget || activeSubTarget.dramaId !== dramaId || activeSubTarget.epNo !== epNo) {
                                clearInterval(activeSubPoller);
                                activeSubPoller = null;
                                return;
                            }

                            try {
                                const pRes = await fetch(`/phim-ngan/api/subtitle?dramaId=${encodeURIComponent(dramaId)}&ep=${epNo}`);
                                const pData = await pRes.json();
                                if (pData.success && pData.vtt) {
                                    clearInterval(activeSubPoller);
                                    activeSubPoller = null;
                                    applySubtitleData(pData.vtt, epNo, Boolean(pData.isEmbedded));
                                    updateReadyEpisodesBadge(dramaId);
                                    return;
                                }
                            } catch (e) { }

                            if (attempts >= 18) {
                                clearInterval(activeSubPoller);
                                activeSubPoller = null;
                                if (notice && noticeText) {
                                    noticeText.innerHTML = `✨ Đang chuẩn bị phụ đề cho tập này...`;
                                    subNoticeTimeout = setTimeout(dismissSubNotice, 2500);
                                }
                            }
                        }, 1800);
                    }

                    function toggleSubtitles() {
                        subtitlesEnabled = !subtitlesEnabled;
                        const ccBtn = document.getElementById('asCcBtn');
                        const subOverlay = document.getElementById('asSubOverlay');
                        if (ccBtn) ccBtn.classList.toggle('active', subtitlesEnabled);
                        if (!subtitlesEnabled && subOverlay) {
                            subOverlay.textContent = '';
                        }
                    }

                    function navigateDramaEpisode(dir) {
                        if (!currentActiveDrama || !currentActiveDrama.episodes) return;
                        const nextIdx = currentActiveEpIdx + dir;
                        if (nextIdx >= 0 && nextIdx < currentActiveDrama.episodes.length) {
                            playEpisodeByIndex(nextIdx);
                        }
                    }

                    function closeDramaPlayer() {
                        backFromCinemaToDetail(true);
                    }

                    // Mở trực tiếp Rạp chiếu phim (Cinema Player /phim-ngan/xem/...)
                    async function openDramaPlayer(dramaId, epNo = 1, seekTime = 0) {
                        forceExitFullscreen();

                        // 🔍 Tự động tra cứu tiến trình xem phim đã lưu (cả tập phim & mốc giây xem)
                        if (seekTime <= 0 && typeof getSavedProgressForDrama === 'function') {
                            const saved = getSavedProgressForDrama(dramaId);
                            if (saved) {
                                if (epNo === 1 && saved.epNo > 1) epNo = saved.epNo;
                                if (saved.epNo === epNo && saved.currentTime > 0) {
                                    seekTime = saved.currentTime;
                                }
                            }
                        }

                        const cached = PN_DETAIL_CACHE.get(dramaId);
                        if (cached) {
                            currentActiveDrama = cached;
                            currentDetailDrama = cached;
                            startPlayingFromDetail(epNo, seekTime);
                            return;
                        }
                        try {
                            const res = await fetch(`/phim-ngan/detail/${encodeURIComponent(dramaId)}`);
                            const json = await res.json();
                            if (json.success && json.data) {
                                PN_DETAIL_CACHE.set(dramaId, json.data);
                                currentActiveDrama = json.data;   // Cập nhật trước khi phát
                                currentDetailDrama = json.data;
                                startPlayingFromDetail(epNo, seekTime);
                                return;
                            }
                        } catch (e) { }
                        window.location.href = `/phim-ngan/xem/${dramaId}?ep=${epNo}${seekTime > 0 ? `&t=${seekTime}` : ''}`;
                    }

                    // Mở rộng hoặc thu gọn danh sách Phim mới hôm nay để cân bằng với ô bộ lọc bên phải
                    function toggleReleasesList() {
                        const extras = document.querySelectorAll('.as-release-row-extra');
                        const textSpan = document.getElementById('asToggleReleasesText');
                        const iconSvg = document.getElementById('asToggleReleasesIcon');
                        if (!extras.length) return;

                        const isExpanded = extras[0].style.display === 'flex';
                        if (isExpanded) {
                            extras.forEach(el => el.style.display = 'none');
                            if (textSpan) textSpan.textContent = `Xem thêm ${extras.length} phim mới`;
                            if (iconSvg) iconSvg.style.transform = 'rotate(0deg)';
                            const section = document.querySelector('.as-two-col-left');
                            if (section) section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        } else {
                            extras.forEach(el => el.style.display = 'flex');
                            if (textSpan) textSpan.textContent = 'Thu gọn';
                            if (iconSvg) iconSvg.style.transform = 'rotate(180deg)';
                        }
                    }



                </script>
