                        const toggleBtn = document.getElementById('asSidebarToggleBtn');
                        const restoreBtn = document.getElementById('asSidebarRestoreBtn');
                        if (!modal) return;
                        const isHidden = modal.classList.toggle('sidebar-hidden');
                        if (toggleBtn) toggleBtn.classList.toggle('active', !isHidden);
