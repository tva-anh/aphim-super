               noi dung 222 tap va khong keo duoc het) */
            @media (max-width: 1023px) {

                .as-rec-sheet-drawer {
                    max-height: calc(100vh - 84px) !important;
                }

                .as-rec-sheet-body {
                    max-height: calc(100vh - 262px) !important;
                    overflow-y: auto !important;
                    padding-bottom: 44px !important;
                    -webkit-overflow-scrolling: touch;
                }

                .as-rec-sheet.active .as-rec-sheet-body {
                    touch-action: pan-y;
                }

            }

            @media (min-width: 992px) {
                .as-hero-section {
                    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
                    gap: 48px;
                    padding: 28px 0 54px 0;
                }
            }

            /* =======================================================
           ✨ ÁNH XẠ XANH LÁ MỀM MẠI SÁT CẠNH TRÊN (KHÔNG VIỀN, KHÔNG GẠCH NGANG)
           Áp dụng cho tất cả các trang trên nền màu đen (Dark Mode):
           - Trang chủ: .as-hero-section
           - Trang thông tin chi tiết: .as-detail-view (/phim-ngan/thong-tin)
           - Trang đề xuất: .as-recommend-view (/phim-ngan/de-xuat)
           - Trang tìm kiếm: .as-search-view (/phim-ngan/tim-kiem)
           - Trang thư viện: .as-library-view (/phim-ngan/thu-vien)
           🚫 TUYỆT ĐỐI TRỪ TRANG PHIM / RẠP CHIẾU RA (GIỮ NỀN ĐEN TUYỀN 100%)
           ======================================================= */
            /* 1. Trang chủ */
            html:not(.light-mode) .as-hero-section::before {
                content: "" !important;
                display: block !important;
                position: absolute !important;
                top: -160px !important;
                left: 50% !important;
                width: 100vw !important;
                height: 580px !important;
                transform: translateX(-50%) !important;
                pointer-events: none !important;
                z-index: 0 !important;
                background:
                    /* Ánh xạ xanh lá sát mép cạnh trên hắt từ đỉnh xuống */
                    radial-gradient(ellipse 90% 70% at 50% 0%, rgba(163, 230, 53, 0.16) 0%, rgba(163, 230, 53, 0.06) 42%, rgba(163, 230, 53, 0) 100%),
                    /* Quầng sáng xanh lá nhẹ phía sau cụm poster bên phải */
                    radial-gradient(circle 460px at 80% 30%, rgba(163, 230, 53, 0.09) 0%, rgba(163, 230, 53, 0) 70%) !important;
                /* Mask tan dần về 0 để triệt tiêu 100% mọi vệt cắt / viền ngang */
                mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%) !important;
                -webkit-mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%) !important;
            }

            /* 2. Trang thông tin chi tiết (/phim-ngan/thong-tin/:dramaId) */
            html:not(.light-mode) .as-detail-view::before {
                content: "" !important;
                display: block !important;
                position: absolute !important;
                top: -100px !important;
                left: 50% !important;
                width: 100vw !important;
                height: 600px !important;
                transform: translateX(-50%) !important;
                pointer-events: none !important;
                z-index: 0 !important;
                background:
                    /* Ánh xạ xanh lá sát mép cạnh trên hắt từ đỉnh xuống */
                    radial-gradient(ellipse 90% 70% at 50% 0%, rgba(163, 230, 53, 0.16) 0%, rgba(163, 230, 53, 0.06) 42%, rgba(163, 230, 53, 0) 100%),
                    /* Quầng sáng xanh lá nhẹ lan tỏa dịu nhẹ phía trên poster và tiêu đề */
                    radial-gradient(circle 460px at 75% 25%, rgba(163, 230, 53, 0.08) 0%, rgba(163, 230, 53, 0) 70%) !important;
                /* Mask tan dần về 0 để triệt tiêu 100% mọi vệt cắt / viền ngang */
                mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 100%) !important;
                -webkit-mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 100%) !important;
            }

            .as-detail-view>* {
                position: relative;
                z-index: 1;
            }

            /* 3. Trang đề xuất (/phim-ngan/de-xuat) */
            html:not(.light-mode) .as-recommend-view::before {
                content: "" !important;
                display: block !important;
                position: absolute !important;
                top: 0 !important;
                left: 50% !important;
                width: 100vw !important;
                height: 520px !important;
                transform: translateX(-50%) !important;
                pointer-events: none !important;
                z-index: 0 !important;
                background:
                    radial-gradient(ellipse 90% 70% at 50% 0%, rgba(163, 230, 53, 0.16) 0%, rgba(163, 230, 53, 0.06) 42%, rgba(163, 230, 53, 0) 100%),
                    radial-gradient(circle 460px at 80% 30%, rgba(163, 230, 53, 0.08) 0%, rgba(163, 230, 53, 0) 70%) !important;
                mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%) !important;
                -webkit-mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%) !important;
            }

            .as-recommend-view .as-rec-layout {
                position: relative;
                z-index: 1;
            }

            /* 4. Trang tìm kiếm & Trang thư viện */
            html:not(.light-mode) .as-search-view::before,
            html:not(.light-mode) .as-library-view::before {
                content: "" !important;
                display: block !important;
                position: absolute !important;
                top: 0 !important;
                left: 50% !important;
                width: 100vw !important;
                height: 520px !important;
                transform: translateX(-50%) !important;
                pointer-events: none !important;
                z-index: 0 !important;
                background:
                    radial-gradient(ellipse 90% 70% at 50% 0%, rgba(163, 230, 53, 0.16) 0%, rgba(163, 230, 53, 0.06) 42%, rgba(163, 230, 53, 0) 100%),
                    radial-gradient(circle 460px at 80% 30%, rgba(163, 230, 53, 0.08) 0%, rgba(163, 230, 53, 0) 70%) !important;
                mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%) !important;
                -webkit-mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%) !important;
            }

            .as-search-view .as-view-inner,
            .as-library-view .as-view-inner {
                position: relative;
                z-index: 1;
            }

            /* 🚫 TUYỆT ĐỐI TRỪ TRANG PHIM / RẠP CHIẾU RA (GIỮ NỀN ĐEN TUYỀN CHO VIDEO STAGE) */
            body.as-cinema-open .as-detail-view::before,
            body.as-cinema-open .as-hero-section::before,
            body.as-cinema-open .as-recommend-view::before,
            body.as-cinema-open .as-search-view::before,
            body.as-cinema-open .as-library-view::before,
            body:has(#asTheaterModal.active) .as-detail-view::before,
            body:has(#asTheaterModal.active) .as-hero-section::before,
            body:has(#asTheaterModal.active) .as-recommend-view::before,
            body:has(#asTheaterModal.active) .as-search-view::before,
            body:has(#asTheaterModal.active) .as-library-view::before,
            body.page-player-mode::before,
            body.page-player-mode .as-detail-view::before,
            body.page-player-mode .as-hero-section::before,
            body.page-player-mode .as-recommend-view::before,
            body.page-player-mode .as-search-view::before,
            body.page-player-mode .as-library-view::before,
            .as-cinema-modal::before,
            .as-cinema-modal::after,
            .as-cinema-video-stage::before,
            .as-cinema-video-stage::after {
                display: none !important;
                content: none !important;
                opacity: 0 !important;
            }

            /* Nhãn "Nổi bật" — ánh xanh lime hài hòa với nền */
            .as-hero-section .as-tag-spotlight {
                box-shadow: 0 2px 10px rgba(163, 230, 53, 0.3) !important;
            }

            .as-hero-left {
                display: flex;
                flex-direction: column;
                justify-content: center;
                min-width: 0;
                /* position:relative la dieu kien de z-index:5 phat huy tac dung.
               Truoc day thieu position nen z-index bi bo qua, cột thong tin
               co the bi lop anh sang (::before cua .as-hero-section) che len. */
                position: relative;
                z-index: 5;
            }

            .as-tag-spotlight {
                display: inline-flex;
                align-items: center;
                align-self: flex-start;
                background: var(--as-lime);
                color: #000;
                font-size: 0.88rem;
                font-weight: 800;
                padding: 5px 16px;
                border-radius: 999px;
                margin-bottom: 18px;
                letter-spacing: 0.3px;
            }

            .as-hero-title {
                font-size: 1.85rem;
                font-weight: 800;
                line-height: 1.25;
                color: var(--as-ink);
                margin-bottom: 16px;
                letter-spacing: -0.4px;
                height: 2.5em;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                text-overflow: ellipsis;
                transition: opacity 0.2s ease;
            }

            @media (min-width: 768px) {
                .as-hero-title {
                    font-size: 2.25rem;
                    line-height: 1.22;
                    height: 2.45em;
                    margin-bottom: 18px;
                }
            }

            .as-hero-meta {
                color: var(--as-ink-soft);
                font-size: 1.15rem;
                font-weight: 600;
                margin-bottom: 28px;
                display: flex;
                align-items: center;
                gap: 10px;
                flex-wrap: wrap;
                height: 28px;
                line-height: 28px;
            }

            .as-hero-actions {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 34px;
                flex-wrap: wrap;
            }

            .as-btn-info {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                background: var(--as-scrim);
                color: var(--as-ink);
                font-weight: 700;
                font-size: 1.05rem;
                height: 52px;
                padding: 0 28px;
                border-radius: 999px;
                border: 1.5px solid var(--as-scrim-strong);
                cursor: pointer;
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                white-space: nowrap;
            }

            .as-btn-info:hover {
                background: var(--as-scrim-strong);
                border-color: var(--as-scrim-strong);
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
            }

            .as-btn-info svg {
                width: 20px;
                height: 20px;
                stroke-width: 2.2;
            }

            .as-btn-play {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                background: var(--as-lime);
                color: #000000;
                font-weight: 800;
                font-size: 1.08rem;
                height: 52px;
                padding: 0 32px;
                border-radius: 999px;
                border: none;
                cursor: pointer;
                box-shadow: 0 6px 22px rgba(163, 230, 53, 0.4);
                transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
                white-space: nowrap;
            }

            .as-btn-play:hover {
                background: var(--as-lime-hover);
                transform: translateY(-2px) scale(1.02);
                box-shadow: 0 10px 30px rgba(163, 230, 53, 0.55);
            }

            .as-btn-play svg {
                width: 20px;
                height: 20px;
            }

            .as-btn-add {
                width: 52px;
                height: 52px;
                border-radius: 50%;
                background: var(--as-scrim);
                border: 1.5px solid var(--as-scrim-strong);
                color: var(--as-ink);
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                flex-shrink: 0;
            }

            .as-btn-add:hover {
                background: var(--as-scrim-strong);
                border-color: var(--as-scrim-strong);
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
            }

            .as-btn-add svg {
                width: 22px;
                height: 22px;
                stroke-width: 2.5;
            }

            @media (max-width: 767px) {
                .as-btn-info {
                    height: 44px;
                    padding: 0 20px;
                    font-size: 0.95rem;
                }

                .as-btn-play {
                    height: 44px;
                    padding: 0 24px;
                    font-size: 0.98rem;
                }

                .as-btn-add {
                    width: 44px;
                    height: 44px;
                }
            }

            /* Thumbnails selector row + Counter: Bổ sung padding-top an toàn chống cắt viền trên */
            .as-hero-thumbs-row {
                display: flex;
                align-items: center;
                gap: 12px;
                overflow-x: auto;
                scrollbar-width: none;
                padding: 10px 6px 14px 6px;
                margin-top: 0;
            }

            .as-hero-thumbs-row::-webkit-scrollbar {
                display: none;
            }

            .as-thumb-item {
                width: 70px;
                height: 96px;
                border-radius: 12px;
                overflow: hidden;
                position: relative;
                cursor: pointer;
                border: 2.5px solid transparent;
                flex-shrink: 0;
                transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
                background: #1e2330;
                will-change: transform;
            }

            .as-thumb-item:hover {
                transform: translateY(-2px);
                border-color: rgba(163, 230, 53, 0.6);
            }

            .as-thumb-item:active {
                transform: scale(0.94) !important;
            }

            .as-thumb-item.active {
                border-color: var(--as-lime) !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 14px rgba(163, 230, 53, 0.35), 0 4px 12px rgba(0, 0, 0, 0.7) !important;
            }

            .as-thumb-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .as-slide-counter {
                margin-left: 14px;
                font-size: 0.95rem;
                font-weight: 700;
                color: var(--as-ink-soft);
                white-space: nowrap;
            }

            /* 3D Layered Cards Showcase (Right Column) */
            /* =======================================================
           👆 HERO CÓ THỂ LƯỚT (vuốt tay / kéo chuột)
           ======================================================= */
            .as-hero-section {
                cursor: grab;
                touch-action: pan-y;
                /* cho phép vuốt ngang, giữ cuộn dọc */
                -webkit-user-select: none;
                user-select: none;
            }

            .as-hero-section.as-hero-dragging {
                cursor: grabbing;
            }

            /* Ảnh trong hero không bị trình duyệt kéo thả */
            .as-hero-section img {
                -webkit-user-drag: none;
                user-drag: none;
                pointer-events: none;
            }

            /* Nhưng nút bấm vẫn phải bấm được bình thường */
            .as-hero-section button,
            .as-hero-section a,
            .as-hero-section .as-thumb-item,
            .as-hero-section .as-stack-card,
            .as-hero-section .as-continue-peek-card {
                pointer-events: auto;
            }

            .as-hero-3d-wrap {
                position: relative;
                width: 100%;
                height: 470px;
                display: flex;
                align-items: center;
                justify-content: center;
                perspective: 1000px;
                min-width: 0;
            }

            @media (min-width: 768px) {
                .as-hero-3d-wrap {
                    height: 540px;
                    justify-content: flex-end;
                    padding-right: 0;
                }
            }

            .as-stack-card {
                position: absolute;
                width: 300px;
                height: 440px;
                border-radius: 18px;
                overflow: hidden;
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85);
                transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.45s ease, filter 0.45s ease;
                cursor: pointer;
                background: #181c24;
            }

            @media (min-width: 768px) {
                .as-stack-card {
                    width: 330px;
                    height: 500px;
                }
            }

            .as-stack-card img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .as-stack-card.pos-0 {
                z-index: 3;
                transform: translateX(0) scale(1);
                opacity: 1;
                filter: brightness(1);
                border: 1px solid rgba(255, 255, 255, 0.15);
            }

            .as-stack-card.pos-1 {
                z-index: 2;
                transform: translateX(-70px) scale(0.92);
                opacity: 0.75;
                filter: brightness(0.65);
            }

            .as-stack-card.pos-2 {
                z-index: 1;
                transform: translateX(-138px) scale(0.85);
                opacity: 0.45;
                filter: brightness(0.4);
            }

            /* =======================================================
           POPOVER BỘ CÔNG CỤ (gọn như ảnh mẫu)
           ======================================================= */
            .as-tool-pop {
                position: fixed;
                top: 90px;
                left: 24px;
                z-index: 10001;
                width: min(420px, calc(100% - 48px));
                background: #20232a !important;
                backdrop-filter: blur(30px) saturate(160%) !important;
                -webkit-backdrop-filter: blur(30px) saturate(160%) !important;
                border: 1px solid rgba(255, 255, 255, 0.1) !important;
                border-radius: 26px !important;
                box-shadow: 0 24px 70px rgba(0, 0, 0, 0.88) !important;
                padding: 22px 24px;
                display: none;
                flex-direction: column;
                gap: 15px;
                max-height: calc(100vh - 120px);
                overflow-y: auto;
                overscroll-behavior: contain;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: thin;
                scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
                animation: asToolPopIn 0.1s cubic-bezier(0, 0, 0.2, 1);
                will-change: transform, opacity;
            }

            .as-tool-pop.open {
                display: flex;
            }

            /* Menu Cài đặt của trang Đề xuất: canh theo cột nút bên phải,
           bám sát cạnh video thay vì né về góc trái như trong rạp chiếu */
            .as-tool-pop.as-rec-settings-pop {
                top: 96px;
                left: auto;
                right: 24px;
                width: 320px;
                z-index: 10001;
                line-height: normal;
            }

            @media (max-width: 1023px) {

                .as-tool-pop.as-rec-settings-pop,
                #asRecSettingsPop {
                    top: auto !important;
                    bottom: 0 !important;
                    left: 0 !important;
                    right: 0 !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    min-width: 100% !important;
                    margin: 0 !important;
                    box-sizing: border-box !important;
                    max-height: 85vh !important;
                    overflow-y: auto !important;
                    padding: 22px 20px calc(24px + env(safe-area-inset-bottom, 0px)) 20px !important;
                    gap: 0 !important;
                    border-radius: 26px 26px 0 0 !important;
                    border: 1px solid rgba(255, 255, 255, 0.12) !important;
                    border-left: none !important;
                    border-right: none !important;
                    border-bottom: none !important;
                    background: #20232a !important;
                    backdrop-filter: blur(28px) saturate(160%) !important;
                    -webkit-backdrop-filter: blur(28px) saturate(160%) !important;
                    box-shadow: 0 -24px 70px rgba(0, 0, 0, 0.88) !important;
                    z-index: 10001 !important;
                }
            }

            .as-tool-pop::-webkit-scrollbar {
                width: 6px;
            }

            .as-tool-pop::-webkit-scrollbar-track {
                background: transparent;
            }

            .as-tool-pop::-webkit-scrollbar-thumb {
                background: rgba(255, 255, 255, 0.28);
                border-radius: 999px;
            }

            .as-tool-pop::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 255, 255, 0.45);
            }

            @keyframes asToolPopIn {
                from {
                    opacity: 0;
                    transform: translateY(-4px) scale(0.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .as-tool-pop.as-pop-center {
                left: 50%;
                transform: translateX(-50%);
                width: min(300px, calc(100% - 48px));
                padding: 14px 18px;
            }

            .as-tool-pop.as-pop-center.as-pop-modal {
                top: 50%;
                transform: translate(-50%, -50%);
                width: min(520px, calc(100% - 48px));
                padding: 20px;
                animation-name: asToolPopInModal;
            }

            @keyframes asToolPopInModal {
                from {
                    opacity: 0;
                    transform: translate(-50%, -46%) scale(0.97);
                }

                to {
                    opacity: 1;
                    transform: translate(-50%, -50%) scale(1);
                }
            }

            .as-tool-pop.as-pop-volume {
                width: min(320px, calc(100% - 24px));
                padding: 14px 18px;
            }

            .as-tool-pop.as-pop-volume .as-tool-slider {
                height: 5px;
            }

            .as-tool-pop.as-pop-volume .as-tool-slider::-webkit-slider-thumb {
                width: 18px;
                height: 18px;
            }

            .as-tool-pop-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
            }

            .as-tool-head-left {
                display: flex;
                align-items: center;
                gap: 8px;
                min-width: 0;
            }

            .as-tool-pop-title {
                font-size: 0.96rem;
                font-weight: 800;
                color: #ffffff;
                margin: 0;
            }

            .as-tool-pop-close {
                background: none;
                border: none;
                color: #cbd5e1;
                cursor: pointer;
                width: 28px;
                height: 28px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                transition: background 0.15s ease, color 0.15s ease;
                padding: 0;
                flex-shrink: 0;
            }

            .as-tool-pop-close:hover {
                background: rgba(255, 255, 255, 0.12);
                color: #fff;
            }

            .as-tool-back {
                background: none;
                border: none;
                color: #cbd5e1;
                cursor: pointer;
                width: 26px;
                height: 26px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                transition: background 0.15s ease;
                padding: 0;
                flex-shrink: 0;
            }

            .as-tool-back:hover {
                background: rgba(255, 255, 255, 0.12);
            }

            .as-tool-sub {
                font-size: 0.76rem;
                color: #94a3b8;
                line-height: 1.5;
                margin: 0;
            }

            .as-tool-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                min-height: 28px;
            }

            .as-tool-label {
                font-size: 0.86rem;
