                border: 1px solid rgba(15, 23, 42, 0.1) !important;
                box-shadow: 0 18px 46px -8px rgba(15, 23, 42, 0.18), 0 4px 16px -2px rgba(15, 23, 42, 0.06), inset 0 1px 1px 0 rgba(255, 255, 255, 1) !important;
            }

