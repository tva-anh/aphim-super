                    function scheduleMobileCinemaActionsAutoHide(delay = 2500) {
                        if (window.innerWidth > 991) return;
                        if (mobileActionsHideTimer) {
                            clearTimeout(mobileActionsHideTimer);
                            mobileActionsHideTimer = null;
