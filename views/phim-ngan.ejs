                    function shareCurrentDrama(evt) {
                        if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
                        const drama = getActiveDetailDrama();
                        const title = (drama && drama.title) || document.title || 'APhim Phim Ngắn';
                        const url = window.location.href;

                        const shareBtn = document.getElementById('asDetailShareBtn');
                        if (shareBtn) {
                            shareBtn.style.transform = 'scale(1.15)';
                            setTimeout(() => { shareBtn.style.transform = ''; }, 250);
                        }

                        // Sao chép clipboard
                        function fallbackCopy(text) {
                            try {
                                const ta = document.createElement('textarea');
                                ta.value = text;
                                ta.style.position = 'fixed';
                                ta.style.opacity = '0';
                                document.body.appendChild(ta);
                                ta.select();
                                document.execCommand('copy');
                                document.body.removeChild(ta);
                                showToolToast('Đã sao chép liên kết phim vào clipboard!');
                            } catch (e) {
                                showToolToast('Không thể sao chép liên kết!');
                            }
                        }

                        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
                            navigator.clipboard.writeText(url).then(() => {
                                showToolToast('Đã sao chép liên kết phim vào clipboard!');
                            }).catch(() => {
                                fallbackCopy(url);
                            });
                        } else {
                            fallbackCopy(url);
                        }

                        // Mở native share trên thiết bị di động
                        const isMobileDevice = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                        if (isMobileDevice && navigator.share) {
                            navigator.share({
                                title: title,
                                text: (drama && drama.intro) || 'Xem phim ngắn đỉnh cao trên APhim!',
                                url: url
                            }).catch(() => { });
                        }
                    }

                    // Đánh giá sao, Quick Tags & Gửi nhận xét trực quan
                    function rateStar(star) {
                        selectedStarScore = star;
                        document.querySelectorAll('#asStarsPicker .as-star-btn').forEach(btn => {
                            const val = parseInt(btn.dataset.star, 10);
                            btn.classList.toggle('active', val <= star);
                        });
                        const hintEl = document.getElementById('asStarHint');
                        const hints = [
                            '👎 1 sao - Cốt truyện chưa hợp gu',
                            '😐 2 sao - Bình thường, chưa nhiều điểm nhấn',
                            '👌 3 sao - Tạm ổn, giải trí xem lúc rảnh!',
                            '✨ 4 sao - Phim rất hay, kịch bản & diễn xuất tốt!',
                            '🌟 5 sao - Cực phẩm kịch tính, xem cuốn từ đầu đến cuối!'
                        ];
                        if (hintEl) hintEl.textContent = hints[star - 1] || 'Chạm vào sao để đánh giá';
                    }

                    function appendQuickTag(tagText) {
                        const input = document.getElementById('asReviewInput');
                        if (!input) return;
                        if (!input.value.includes(tagText.trim())) {
                            input.value = (input.value.trim() ? input.value.trim() + ' ' : '') + tagText;
                        }
                        input.focus();
                        updateCharCount();
                    }

                    function updateCharCount() {
                        const input = document.getElementById('asReviewInput');
                        const counter = document.getElementById('asCharCount');
                        if (!input || !counter) return;
                        const len = input.value.length;
                        const isValid = len >= 10;
                        counter.classList.toggle('valid', isValid);
                        counter.textContent = `${len}/500 ký tự • ${!isValid ? `cần thêm ít nhất ${10 - len} ký tự` : 'đủ điều kiện gửi'}`;
                    }

                    function submitDramaReview() {
                        const input = document.getElementById('asReviewInput');
                        if (!input) return;
                        const val = input.value.trim();
                        if (val.length < 10) {
                            if (typeof showToolToast === 'function') {
                                showToolToast('Vui lòng nhập tối thiểu 10 ký tự cảm nhận!');
