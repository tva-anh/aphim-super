            .as-video-pane {
                flex: 0 0 100%;
                height: 60vh;
                background: #000;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            @media (min-width: 768px) {
                .as-video-pane {
                    flex: 0 0 490px;
                    height: 100%;
                }
            }

            .as-video-el {
                width: 100%;
                height: 100%;
                object-fit: contain;
                background: #000;
            }

            /* Suppress browser native track cue so only custom overlay renders cleanly */
            .as-video-el::cue,
            video::cue {
                display: none !important;
                opacity: 0 !important;
                visibility: hidden !important;
            }

            /* VIETNAMESE SUBTITLE OVERLAY (HIỂN THỊ RÕ RÀNG, ĐẸP MẮT CHUẨN HÌNH 1) */
            .as-sub-overlay {
                position: absolute;
                bottom: 22%;
                left: 50%;
                transform: translateX(-50%);
                width: 90%;
                max-width: 540px;
                text-align: center;
                color: #ffffff;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                font-size: clamp(15px, 2.3vh, 18px);
                font-weight: 600;
                line-height: 1.35;
                letter-spacing: 0.25px;
                text-shadow:
                    0 1px 2px rgba(0, 0, 0, 0.95),
                    0 2px 5px rgba(0, 0, 0, 0.85),
                    0 0 8px rgba(0, 0, 0, 0.6);
                pointer-events: none;
                z-index: 15;
                transition: opacity 0.15s ease;
                white-space: pre-wrap;
                word-break: break-word;
                user-select: none;
            }

            @media (min-width: 768px) {
                .as-sub-overlay {
                    font-size: clamp(16px, 2.2vh, 19px);
                    bottom: 22%;
                }
            }

            .as-cc-btn {
                position: absolute;
                top: 14px;
                right: 14px;
                background: rgba(0, 0, 0, 0.75);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #9ca3af;
                font-size: 0.75rem;
                font-weight: 800;
                padding: 5px 11px;
                border-radius: 6px;
                cursor: pointer;
                z-index: 15;
                transition: all 0.2s ease;
                display: none;
            }

            .as-cc-btn.active {
                background: var(--as-lime);
                color: #000;
                border-color: var(--as-lime);
                box-shadow: 0 0 12px rgba(163, 230, 53, 0.5);
            }

            .as-sub-notice {
                position: absolute;
                top: 16px;
                left: 50%;
                transform: translateX(-50%);
                background: rgba(18, 20, 29, 0.92);
                border: 1px solid rgba(163, 230, 53, 0.45);
                border-radius: 999px;
                padding: 8px 18px;
                font-size: 0.78rem;
                font-weight: 600;
                color: #e2e8f0;
                display: none;
                align-items: center;
                gap: 10px;
                max-width: calc(100% - 32px);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                z-index: 10;
                animation: asNoticeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .as-sub-notice.show {
                display: inline-flex;
            }

            .as-sub-notice button {
                background: rgba(255, 255, 255, 0.1);
                border: none;
                color: #cbd5e1;
                cursor: pointer;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 0.7rem;
                line-height: 1;
                padding: 0;
                flex-shrink: 0;
                transition: background 0.15s ease;
            }

            .as-sub-notice button:hover {
                background: rgba(255, 255, 255, 0.22);
                color: #ffffff;
            }

            @keyframes asNoticeIn {
                from {
                    opacity: 0;
                    transform: translateX(-50%) translateY(-6px);
                }

                to {
                    opacity: 1;
                    transform: translateX(-50%) translateY(0);
                }
            }

            /* Loại bỏ hoàn toàn vòng quay sau nền chiếu theo yêu cầu */
            #asVideoSpinner,
            .as-video-spinner,
            .as-video-spinner.active {
                display: none !important;
                visibility: hidden !important;
                opacity: 0 !important;
                pointer-events: none !important;
                width: 0 !important;
                height: 0 !important;
            }

            /* Thông báo đồng bộ phụ đề: tắt theo yêu cầu (ẩn ở mọi trạng thái) */
            #asSubNotice {
                display: none !important;
            }

            @keyframes asSpinnerSpin {
                from {
                    transform: rotate(0deg);
                }

                to {
                    transform: rotate(360deg);
                }
            }

            .as-info-pane {
                flex: 1;
                display: flex;
                flex-direction: column;
                height: 40vh;
                background: #0f1219;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
                overflow: hidden;
            }

            @media (min-width: 768px) {
                .as-info-pane {
                    height: 100%;
                    border-top: none;
                    border-left: 1px solid rgba(255, 255, 255, 0.08);
                }
            }

            .as-modal-header {
                padding: 18px 22px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 12px;
            }

            .as-modal-title {
                font-size: 1.15rem;
                font-weight: 800;
                color: #fff;
                line-height: 1.3;
                margin-bottom: 4px;
            }

            .as-modal-meta {
                font-size: 0.8rem;
                color: var(--as-muted);
            }

            .as-btn-modal-close {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.12);
                color: #fff;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: all 0.2s ease;
            }

            .as-btn-modal-close:hover {
                background: #ef4444;
                transform: rotate(90deg);
            }

            .as-episodes-scroller {
                flex: 1;
                padding: 16px 22px;
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: var(--as-lime) transparent;
            }

            .as-modal-ep-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
                gap: 8px;
                margin-top: 10px;
            }

            .as-modal-ep-btn {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.08);
                color: #cbd5e1;
                font-size: 0.82rem;
                font-weight: 600;
                padding: 10px 4px;
                border-radius: 8px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: all 0.2s ease;
                position: relative;
            }

            /* 🔴 Mặc định: Chấm đỏ góc phải nhận diện tập CHƯA DỊCH TỚI */
            .as-modal-ep-btn::after {
                content: '';
                position: absolute;
                top: 6px;
                right: 6px;
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #ef4444;
                box-shadow: 0 0 6px rgba(239, 68, 68, 0.85);
                transition: all 0.25s ease;
            }

            /* =� � C� D�CH: Ch�m chuy�n sang m�u xanh l� Vietsub */
            .as-modal-ep-btn.has-sub::after {
                background: var(--as-lime, #a3e635);
                box-shadow: 0 0 7px var(--as-lime, #a3e635);
            }

            .as-modal-ep-btn:hover {
                background: rgba(255, 255, 255, 0.14);
                color: #fff;
            }

            .as-modal-ep-btn.active {
                background: var(--as-lime);
                color: #000;
                font-weight: 800;
                border-color: var(--as-lime);
            }

            .as-modal-ep-btn.active::after {
                border: 1px solid rgba(0, 0, 0, 0.8);
            }

            /* =======================================================
           🌟 MÀN HÌNH THÔNG TIN PHIM NGẮN (SCREENSHOT 1 & 2)
           (max-width/padding/margin dùng chung rule .as-detail-view ở đầu file)
           ======================================================= */
            .as-detail-view {
                color: var(--as-ink);
                animation: asFadeIn 0.3s ease;
            }

            .as-detail-back-wrap {
                margin-bottom: 24px;
            }

            #asDetailBackBtn {
                background: var(--as-scrim, rgba(255, 255, 255, 0.08));
                border: 1px solid var(--as-scrim-strong, rgba(255, 255, 255, 0.16));
                color: var(--as-ink, #ffffff);
                padding: 8px 18px;
                border-radius: 99px;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-weight: 600;
                font-size: 0.88rem;
                font-family: inherit;
                transition: all 0.22s ease;
                text-decoration: none;
                -webkit-tap-highlight-color: transparent;
            }

            #asDetailBackBtn:hover {
                background: rgba(255, 255, 255, 0.15);
                border-color: rgba(255, 255, 255, 0.28);
                transform: translateX(-3px);
            }

            #asDetailBackBtn .as-back-icon-box {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: transform 0.2s ease;
            }

            #asDetailBackBtn:hover .as-back-icon-box {
                transform: translateX(-2px);
            }

            .as-detail-hero {
                display: flex;
                gap: 40px;
                align-items: flex-start;
                margin-bottom: 48px;
            }

            .as-detail-poster-wrap {
                flex-shrink: 0;
                width: 250px;
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.08);
                background: #11141c;
            }

            /* Chế độ Sáng / Nền Kem: Triệt tiêu bóng đen nặng nề, dùng bóng ấm tinh tế và viền kem hài hòa */
            html.light-mode .as-detail-poster-wrap {
                background: #faf7f2 !important;
                border: 1px solid #e7decb !important;
                box-shadow: 0 10px 24px rgba(78, 64, 45, 0.12), 0 2px 6px rgba(78, 64, 45, 0.05) !important;
            }

            .as-detail-poster {
                width: 100%;
                height: 100%;
                aspect-ratio: 2 / 3;
                object-fit: cover;
                object-position: center top;
                display: block;
                transform: scale(1.025); /* Tự động ẩn vệt mép xám ở đáy ảnh nguồn ra ngoài bo góc */
            }

            html.light-mode .as-top10-poster-wrap {
                background: #faf7f2 !important;
                border: 1px solid #e7decb !important;
                box-shadow: 0 8px 20px rgba(78, 64, 45, 0.12) !important;
            }

            html.light-mode .as-shelf-poster-wrap {
                background: #faf7f2 !important;
                border: 1px solid #e7decb !important;
                box-shadow: 0 6px 16px rgba(78, 64, 45, 0.1) !important;
            }

            html.light-mode .as-search-genre-poster,
            html.light-mode .as-library-card .as-search-genre-poster {
                background: #faf7f2 !important;
                border: 1px solid #e7decb !important;
                box-shadow: 0 6px 16px rgba(78, 64, 45, 0.1) !important;
            }

            .as-detail-mobile-gradient {
                display: none;
            }

            .as-detail-info {
                flex: 1;
                min-width: 0;
            }

            .as-detail-title {
                font-size: 2.3rem;
                font-weight: 800;
                line-height: 1.25;
                color: var(--as-ink);
                margin: 0 0 16px;
                letter-spacing: -0.02em;
            }

            .as-detail-genres {
                font-size: 0.95rem;
                color: var(--as-ink-soft);
                margin-bottom: 12px;
                font-weight: 500;
                line-height: 1.5;
            }

            .as-detail-meta {
                font-size: 0.88rem;
                color: var(--as-ink-muted);
                margin-bottom: 20px;
            }

            .as-detail-synopsis {
                font-size: 0.95rem;
                line-height: 1.65;
                color: var(--as-ink-muted);
