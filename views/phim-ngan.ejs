                    function toggleDetailBookmark(evt) {
                        if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
                        const drama = getActiveDetailDrama();
                        if (!drama || !drama.id) {
                            showToolToast('Không thể xác định thông tin phim');
                            return;
                        }
                        const dramaId = String(drama.id);
                        let favs = typeof getDramaFavorites === 'function' ? getDramaFavorites() : [];
                        const idx = favs.findIndex(f => f && String(f.id) === dramaId);
                        let isAdded = false;

                        if (idx === -1) {
                            favs.unshift({
                                id: dramaId,
                                title: drama.title || '',
                                cover: drama.cover || '',
                                epNo: drama.epNo || (typeof currentDetailEpNo !== 'undefined' ? currentDetailEpNo : 1),
                                totalEpisodes: drama.totalEpisodes || (drama.episodes ? drama.episodes.length : 60),
                                timestamp: Date.now()
                            });
                            isAdded = true;
                        } else {
                            favs.splice(idx, 1);
                            isAdded = false;
                        }

                        try { localStorage.setItem('aphim_pn_favorites', JSON.stringify(favs)); } catch (e) { }
                        if (window._pnMongoLibrary) window._pnMongoLibrary.favorites = favs;

                        const btn = document.getElementById('asDetailFavBtn');
                        if (btn) {
                            btn.classList.toggle('active', isAdded);
                            const svg = btn.querySelector('svg');
                            if (svg) {
                                svg.setAttribute('fill', isAdded ? '#ef4444' : 'none');
                                svg.setAttribute('stroke', isAdded ? '#ef4444' : 'currentColor');
                            }
                        }

                        // Đồng bộ nút rạp chiếu nếu có
                        const cinemaFavBtn = document.getElementById('asFavBtn');
                        if (cinemaFavBtn) {
                            cinemaFavBtn.classList.toggle('active', isAdded);
                            const cSvg = cinemaFavBtn.querySelector('svg');
                            if (cSvg) cSvg.setAttribute('fill', isAdded ? 'var(--as-lime)' : 'none');
                        }

                        showToolToast(isAdded ? 'Đã thêm vào danh sách yêu thích' : 'Đã bỏ yêu thích');

                        // Lưu backend nếu đăng nhập
                        try {
                            const token = localStorage.getItem('cinestream_token');
                            const headers = { 'Content-Type': 'application/json' };
                            if (token) headers['Authorization'] = 'Bearer ' + token;
                            fetch('/phim-ngan/api/favorite-toggle', {
                                method: 'POST',
                                headers: headers,
                                body: JSON.stringify({
                                    id: dramaId,
                                    title: drama.title || '',
                                    cover: drama.cover || '',
                                    epNo: drama.epNo || (typeof currentDetailEpNo !== 'undefined' ? currentDetailEpNo : 1),
                                    totalEpisodes: drama.totalEpisodes || (drama.episodes ? drama.episodes.length : 60)
                                })
                            }).catch(() => { });
                        } catch (e) { }

                        if (typeof currentLibraryTab !== 'undefined' && currentLibraryTab === 'fav' && typeof renderLibraryGridDirect === 'function') {
                            renderLibraryGridDirect('fav');
                        }
                    }

