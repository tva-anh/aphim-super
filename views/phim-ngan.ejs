                    function updateRecSoundIcon() {
                        const mutedIco = document.getElementById('asRecSoundMutedIco');
                        const activeIco = document.getElementById('asRecSoundActiveIco');
                        if (!mutedIco || !activeIco) return;
                        if (recSoundMuted) {
                            mutedIco.style.display = 'block';
                            activeIco.style.display = 'none';
                        } else {
                            mutedIco.style.display = 'none';
                            activeIco.style.display = 'block';
                        }
                    }

                    // Bấm video để Play / Pause
                    function toggleRecPlayPause(ev) {
                        if (ev && ev.target) {
                            if (ev.target.closest('button') || ev.target.closest('a') ||
                                ev.target.closest('.as-rec-actions') || ev.target.closest('.as-rec-info') ||
                                ev.target.closest('.as-rec-progress') || ev.target.closest('.as-rec-topbar-right-wrap') ||
                                ev.target.closest('.as-tool-pop') || ev.target.closest('#asRecSheetDrawer')) {
                                return;
                            }
                        }
                        const videoEl = document.getElementById('asRecVideoElement');
                        const centerPlay = document.getElementById('asRecCenterPlay');
                        const centerPlaySvg = document.getElementById('asRecCenterPlaySvg');
                        if (!videoEl) return;

                        if (videoEl.paused) {
                            const p = videoEl.play();
                            if (p && typeof p.catch === 'function') p.catch(() => { });
                            if (centerPlay && centerPlaySvg) {
                                centerPlaySvg.innerHTML = '<polygon points="7 4 20 12 7 20 7 4"/>';
                                centerPlay.classList.add('show');
                                setTimeout(() => centerPlay.classList.remove('show'), 350);
                            }
                        } else {
                            videoEl.pause();
                            if (centerPlay && centerPlaySvg) {
                                centerPlaySvg.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
                                centerPlay.classList.add('show');
                                setTimeout(() => centerPlay.classList.remove('show'), 350);
                            }
                        }
                    }

                    // Tua video khi bấm thanh tiến trình
                    function seekRecVideo(e) {
                        const videoEl = document.getElementById('asRecVideoElement');
                        const bar = document.getElementById('asRecProgress');
                        if (!videoEl || !bar || !videoEl.duration) return;
                        const rect = bar.getBoundingClientRect();
                        const pos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                        videoEl.currentTime = pos * videoEl.duration;
                    }

                    // Cập nhật thanh tiến trình theo thời gian video
                    document.addEventListener('DOMContentLoaded', () => {
                        const v = document.getElementById('asRecVideoElement');
                        const fill = document.getElementById('asRecProgressFill');
                        if (v && fill) {
                            v.addEventListener('timeupdate', () => {
                                if (v.duration) {
                                    fill.style.width = ((v.currentTime / v.duration) * 100) + '%';
                                }
                                syncRecSubtitleCue(v.currentTime);
                            });
                        }
                    });

                    // 📱 Lướt sang phim kế tiếp / phim trước chuẩn Reels (Gesture & Mouse Wheel)
                    function reelsStepDrama(delta) {
                        if (isReelsSliding) return;
                        const pool = getRecommendPool();
                        if (!pool.length) return;

                        isReelsSliding = true;
                        let idx = pool.findIndex(d => String(d.id) === String(recDrama?.id));
                        if (idx === -1) idx = 0;
                        idx = (idx + delta + pool.length) % pool.length;

                        closeRecSettings();
                        recDrama = pool[idx];
                        recEpisode = 1;
                        renderRecommend(delta);

                        setTimeout(() => {
                            isReelsSliding = false;
                        }, 420);
                    }

                    function switchRecDrama(dramaId) {
                        const pool = getRecommendPool();
                        const found = pool.find(d => String(d.id) === String(dramaId));
                        if (found) {
                            closeRecSettings();
                            recDrama = found;
                            recEpisode = 1;
                            renderRecommend(1);
                        }
                    }

                    function pickRecEpisode(n) {
                        const total = recDrama ? (recDrama.totalEpisodes || (recDrama.episodes ? recDrama.episodes.length : 0) || 100) : 100;
                        recEpisode = Math.max(1, Math.min(n, total));
                        const noteEl = document.getElementById('asRecNote');
                        if (noteEl) noteEl.innerHTML = `<span class="as-rec-dot">●</span> Tập ${recEpisode} · xem trước`;
                        document.querySelectorAll('.as-rec-ep-num').forEach(b => {
                            b.classList.toggle('active', b.textContent === String(recEpisode));
                        });
                        const playLabel = document.getElementById('asRecPlayLabel');
                        if (playLabel) playLabel.textContent = recEpisode === 1 ? 'Xem từ tập 1' : ('Xem tiếp tập ' + recEpisode);
                        loadAndPlayReelsVideo(recDrama, recEpisode);
                    }

                    function recStepEpisode(delta) {
                        pickRecEpisode(recEpisode + delta);
                    }

                    async function openRecPlay() {
                        if (!recDrama) return;
                        closeRecSettings();
                        forceExitFullscreen();
                        const ep = Math.min(recEpisode || 1, recDrama.totalEpisodes || 99);
                        const recVideo = document.getElementById('asRecVideoElement');
                        if (recVideo) recVideo.pause();

                        // Mở trực tiếp Rạp chiếu phim (Cinema Player /phim-ngan/xem/...)
                        const cached = PN_DETAIL_CACHE.get(recDrama.id);
                        if (cached) {
                            currentActiveDrama = cached;
                            currentDetailDrama = cached;
                            startPlayingFromDetail(ep);
                            return;
                        }

                        try {
                            const res = await fetch(`/phim-ngan/detail/${encodeURIComponent(recDrama.id)}`);
                            const json = await res.json();
                            if (json.success && json.data) {
                                PN_DETAIL_CACHE.set(recDrama.id, json.data);
                                currentActiveDrama = json.data;
                                currentDetailDrama = json.data;
                                startPlayingFromDetail(ep);
                                return;
                            }
                        } catch (err) {
                            console.error(err);
                        }

                        // Fallback điều hướng sang route /phim-ngan/xem/:id?ep=...
                        window.location.href = `/phim-ngan/xem/${recDrama.id}?ep=${ep}`;
                    }

                    function openRecDetailModal() {
                        if (!recDrama) return;
                        closeRecSettings();
                        forceExitFullscreen();
                        openDramaDetail(recDrama.id);
                    }

                    function toggleRecFullscreen(ev) {
                        if (ev) {
                            if (typeof ev.preventDefault === 'function') ev.preventDefault();
                            if (typeof ev.stopPropagation === 'function') ev.stopPropagation();
                        }
                        const recView = document.getElementById('asRecommendView');
                        if (!recView) return;

                        const fsEl = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement;
                        const isCustomFs = recView.classList.contains('rec-mobile-fs');

                        if (fsEl || isCustomFs) {
                            // Thoát toàn màn hình
                            recView.classList.remove('rec-mobile-fs');
                            const exit = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;
                            if (fsEl && exit) {
                                try {
                                    const p = exit.call(document);
                                    if (p && typeof p.catch === 'function') p.catch(() => { });
                                } catch (e) { }
                            }
                            return;
                        }

                        // Đóng mọi sheet/popover đang mở (kiểm tra an toàn trước khi gọi)
                        if (typeof closeRecSettings === 'function') closeRecSettings();
                        if (typeof closeRecCommentDrawer === 'function') closeRecCommentDrawer();
                        if (typeof closeRecEpisodeDrawer === 'function') closeRecEpisodeDrawer();

                        // Luôn thêm class rec-mobile-fs để mở full màn hình ngay lập tức (hoạt động 100% trên cả Desktop và Mobile)
                        recView.classList.add('rec-mobile-fs');

                        // Thử gọi native requestFullscreen nếu thiết bị hỗ trợ
                        const req = recView.requestFullscreen || recView.webkitRequestFullscreen || recView.mozRequestFullScreen || recView.msRequestFullscreen;
                        if (req) {
                            try {
                                const p = req.call(recView);
                                if (p && typeof p.catch === 'function') {
                                    p.catch(() => { });
                                }
                            } catch (e) { }
                        }
                    }

                    function toggleRecFav(btn) {
                        const target = recDrama || (HERO_ITEMS && HERO_ITEMS[activeHeroIdx]);
                        if (!target) return;
                        toggleDramaFavorite(target, btn);
                    }

                    function toggleRecDesc(btn) {
                        const desc = document.getElementById('asRecDesc');
                        if (!desc) return;
                        const expanded = desc.style.webkitLineClamp === '99' || desc.style.webkitLineClamp === 'unset';
                        desc.style.webkitLineClamp = expanded ? '3' : '99';
                        btn.textContent = expanded ? 'xem thêm' : 'thu gọn';
                    }

                    // Bắt sự kiện lướt chuột (wheel), cảm ứng (swipe), kéo (drag)
                    let reelsListenersAttached = false;
                    function initReelsListeners() {
                        if (reelsListenersAttached) return;
                        reelsListenersAttached = true;

                        const recView = document.getElementById('asRecommendView');
                        const frame = document.getElementById('asRecVideoFrame');
                        if (!recView || !frame) return;

                        if (typeof applyRecSavedSubtitleStyle === 'function') {
                            applyRecSavedSubtitleStyle();
                        }

                        // 1. Cuộn chuột (Wheel) trên trang đề xuất — Chỉ bắt sự kiện khi ĐANG Ở VIEW ĐỀ XUẤT
                        window.addEventListener('wheel', (e) => {
                            const recViewEl = document.getElementById('asRecommendView');
                            if (!recViewEl) return;
                            const isRecVisible = document.body.classList.contains('page-recommend-mode') || 
                                (recViewEl.style.display !== 'none' && recViewEl.style.display !== '' && recViewEl.offsetParent !== null);
                            if (!isRecVisible) return;
                            if (e.target.closest('#asRecEpNums') || e.target.closest('#asRecNextList') || e.target.closest('#asRecSheetDrawer')) return;
                            e.preventDefault();
                            const now = Date.now();
                            if (now - lastWheelTime < 400 || isReelsSliding) return;
                            if (Math.abs(e.deltaY) > 20) {
                                lastWheelTime = now;
                                reelsStepDrama(e.deltaY > 0 ? 1 : -1);
                            }
                        }, { passive: false });

                        // 2. Vuốt cảm ứng (Touch swipe) mượt mà trên Mobile
                        let touchY = 0;
                        let touchX = 0;
                        let touchStartTime = 0;

                        const isInteractiveTouch = (el) => {
                            return !!(el && el.closest && (
                                el.closest('.as-rec-actions') ||
                                el.closest('.as-rec-btns') ||
                                el.closest('.as-tool-pop') ||
                                el.closest('#asRecSheetDrawer') ||
                                el.closest('#asDramaDetailModal') ||
                                el.closest('.as-rec-sound-btn') ||
                                el.closest('.as-rec-topbar-right-wrap') ||
                                el.closest('.as-rec-topbar-right') ||
                                el.closest('.as-rec-progress') ||
                                el.closest('.as-rec-fs-exit') ||
                                el.closest('button') ||
                                el.closest('a')
                            ));
                        };

                        recView.addEventListener('touchmove', (e) => {
                            const recViewEl = document.getElementById('asRecommendView');
                            if (!recViewEl || recViewEl.style.display === 'none') return;
                            if (isInteractiveTouch(e.target)) return;
                            if (e.cancelable) e.preventDefault();
                        }, { passive: false });

                        recView.addEventListener('touchstart', (e) => {
                            if (isInteractiveTouch(e.target)) {
                                touchStartTime = 0;
                                return;
                            }
                            if (e.touches && e.touches.length === 1) {
                                touchY = e.touches[0].clientY;
                                touchX = e.touches[0].clientX;
                                touchStartTime = Date.now();
                            }
                        }, { passive: true });

                        recView.addEventListener('touchend', (e) => {
                            if (isInteractiveTouch(e.target) || touchStartTime === 0) {
                                touchStartTime = 0;
                                return;
                            }
                            if (isReelsSliding || !e.changedTouches || !e.changedTouches[0]) return;
                            const dY = touchY - e.changedTouches[0].clientY;
                            const dX = touchX - e.changedTouches[0].clientX;
                            const dt = Date.now() - touchStartTime;
                            touchStartTime = 0;
                            if ((Math.abs(dY) > 35 || (Math.abs(dY) > 20 && dt < 400)) && Math.abs(dY) > Math.abs(dX) * 1.1) {
                                reelsStepDrama(dY > 0 ? 1 : -1);
                            }
                        }, { passive: true });

                        // 3. Kéo chuột (Mouse drag lên / xuống trên desktop)
                        let dragStartY = null;
                        frame.addEventListener('mousedown', (e) => {
                            if (e.button !== 0 || isInteractiveTouch(e.target)) return;
                            dragStartY = e.clientY;
                        });
                        frame.addEventListener('mouseup', (e) => {
                            if (dragStartY === null || isReelsSliding || isInteractiveTouch(e.target)) {
                                dragStartY = null;
                                return;
                            }
                            const dY = dragStartY - e.clientY;
                            dragStartY = null;
                            if (Math.abs(dY) > 50) {
                                reelsStepDrama(dY > 0 ? 1 : -1);
                            }
                        });
                    }

                    // Hotkeys đổi phim / dừng video
                    document.addEventListener('keydown', (e) => {
                        const recView = document.getElementById('asRecommendView');
                        if (!recView || recView.style.display === 'none') return;
                        if (['input', 'textarea'].includes((document.activeElement?.tagName || '').toLowerCase())) return;

                        if (e.key === 'ArrowDown' || e.key === 'PageDown') {
                            e.preventDefault();
                            reelsStepDrama(1);
                        } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
                            e.preventDefault();
                            reelsStepDrama(-1);
                        } else if (e.code === 'Space') {
                            e.preventDefault();
                            toggleRecPlayPause();
                        } else if (e.key === 'm' || e.key === 'M') {
                            e.preventDefault();
                            toggleRecSound();
                        } else if (e.key === 'f' || e.key === 'F') {
                            e.preventDefault();
                            toggleRecFullscreen();
                        }
                    });

                    let activeHeroIdx = 0;
                    let heroAutoTimer = null;

                    let currentActiveDrama = null;
                    let currentActiveEpIdx = 0;

                    // On DOM Load
                    document.addEventListener('DOMContentLoaded', () => {
                        // Triệt tiêu toàn bộ banner quảng cáo trên trang phim ngắn
                        document.querySelectorAll('.aphim-catfish-wrapper, #aphimCatfishBanner, [class*="catfish"]').forEach(el => el.remove());

                        initHeroSlider();
                        loadContinueWatchingState();
            
            <% if (typeof initialDrama !== 'undefined' && initialDrama && (typeof pnView === 'undefined' || pnView !== 'recommend')) { %>
                const initDrama = <%- JSON.stringify(initialDrama) %>;
                const initEp = <%= typeof initialEpisode !== 'undefined' ? initialEpisode : 1 %>;
                const initViewMode = <%- typeof viewMode !== 'undefined' ? JSON.stringify(viewMode) : '"player"' %>;
                            currentDetailDrama = initDrama;
                            currentActiveDrama = initDrama;
                            const mainHub = document.getElementById('asMainHub');
                            const detailView = document.getElementById('asDramaDetailView');
                            if (mainHub) mainHub.style.display = 'none';

                            // Chỉ tự động mở rạp chiếu khi viewMode là 'player' (đường dẫn /phim-ngan/xem/:id)
                            // Khi URL là trang thông tin/chi tiết (/phim-ngan/thong-tin/:id) hoặc người dùng đã thoát khỏi rạp chiếu,
                            // tải lại trang (F5) PHẢI ĐỨNG NGUYÊN trên trang chi tiết, KHÔNG ĐƯỢC ép mở rạp chiếu về /phim-ngan/xem
                            if (initViewMode === 'player') {
                                if (detailView) detailView.style.setProperty('display', 'none', 'important');
                                if (typeof dismissMiniPlayerForNewWatch === 'function') dismissMiniPlayerForNewWatch();
                                startPlayingFromDetail(initEp);
                                if (typeof syncDetailActionButtons === 'function') syncDetailActionButtons(initDrama);
                            } else {
                                renderDramaDetailView(initDrama, initEp);
                                // ĐẢM BẢO DỪNG MỌI VIDEO & ÂM THANH NỀN TRÊN TRANG CHI TIẾT
                                if (typeof stopCinemaPlayback === 'function') stopCinemaPlayback({ keepMini: false });
                                document.querySelectorAll('video').forEach(v => {
                                    try {
                                        v.pause();
                                        v.muted = true;
                                        if (v._hlsInstance) {
                                            try { v._hlsInstance.stopLoad(); v._hlsInstance.detachMedia(); v._hlsInstance.destroy(); } catch (e) { }
                                            v._hlsInstance = null;
                                        }
                                        v.removeAttribute('src');
                                        v.src = '';
                                        v.load();
                                    } catch (e) { }
                                });
                                const modal = document.getElementById('asTheaterModal');
                                if (modal) {
                                    modal.classList.remove('active', 'mobile-fs', 'cinema-fs');
                                    modal.style.setProperty('display', 'none', 'important');
                                    modal.style.setProperty('visibility', 'hidden', 'important');
                                    modal.style.setProperty('pointer-events', 'none', 'important');
                                    modal.style.setProperty('z-index', '-1', 'important');
                                }
                                document.body.classList.remove('as-cinema-open', 'theater-mode-active', 'page-player-mode', 'as-theater-fullscreen-active', 'page-recommend-mode');
                                document.body.classList.add('page-detail-mode');
                                if (detailView) {
                                    detailView.style.removeProperty('display');
                                    detailView.style.setProperty('display', 'block', 'important');
                                }
                                updateDetailBackButton();
                                updateReadyEpisodesBadge(initDrama.id);
                            }
            <% } %>
                        // Fallback an toàn: Chỉ fetch và hiển thị nếu URL là /thong-tin/:id hoặc /xem/:id mà initialDrama chưa có từ SSR
                        const curInitPath = window.location.pathname || '';
                        if (curInitPath.includes('/thong-tin/')) {
                            const matchId = curInitPath.match(/\/thong-tin\/([^\/?#]+)/);
                            if (matchId && matchId[1]) {
                                const did = matchId[1];
                                if (!currentDetailDrama || String(currentDetailDrama.id) !== did) {
                                    switchToDetailView(did, { isPopState: true });
                                    openDramaDetail(did, 1, { isPopState: true });
                                }
                            }
                        } else if (curInitPath.includes('/xem/') || curInitPath.includes('/phim/')) {
                            const matchId = curInitPath.match(/\/(?:xem|phim)\/([^\/?#]+)/);
                            if (matchId && matchId[1]) {
                                const did = matchId[1];
                                const searchParams = new URLSearchParams(window.location.search || '');
                                const epNo = parseInt(searchParams.get('ep'), 10) || 1;
                                if (!currentActiveDrama || String(currentActiveDrama.id) !== did) {
                                    openDramaPlayer(did, epNo, { isPopState: true });
                                }
                            }
                        }
        });

                    // 1. HERO SLIDER LOGIC
                    let heroJustSwiped = false;   // chống mở nhầm player sau khi vuốt/kéo

                    function initHeroSlider() {
                        if (!HERO_ITEMS || HERO_ITEMS.length <= 1) return;
                        startHeroAutoPlay();
                        initHeroSwipe();
                    }

                    /* =======================================================
                       👆 LƯỚT HERO: vuốt tay (mobile) + kéo chuột (desktop)
                       Kéo sang trái -> phim kế tiếp; kéo sang phải -> phim trước.
                       Kéo quá 50px thì đổi slide, và coi như KHÔNG phải bấm
                       nên sẽ không mở nhầm trình phát.
                       ======================================================= */
                    function initHeroSwipe() {
                        const hero = document.getElementById('asHeroSection');
                        if (!hero) return;

                        let startX = 0, startY = 0, dragging = false, moved = false;

                        const onStart = (x, y) => {
                            startX = x;
                            startY = y;
                            dragging = true;
                            moved = false;
                            hero.classList.add('as-hero-dragging');
                        };

                        const onMove = (x, y) => {
                            if (!dragging) return;
                            const dx = x - startX;
                            const dy = y - startY;
                            // Chỉ coi là "lướt" khi kéo ngang rõ ràng (hơn dọc)
                            if (!moved && Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) {
                                moved = true;
                            }
                        };

                        const onEnd = (x, y) => {
                            if (!dragging) return;
                            dragging = false;
                            hero.classList.remove('as-hero-dragging');
                            const dx = x - startX;
                            const dy = typeof y === 'number' ? (y - startY) : 0;
                            // Chỉ đổi slide khi đúng là LƯỚT NGANG (moved) và kéo đủ 50px
                            if (!moved) return;
                            if (Math.abs(dx) < 50) return;
                            // Nếu dọc nhiều hơn ngang thì bỏ qua (người dùng đang cuộn trang)
                            if (Math.abs(dy) > Math.abs(dx)) return;
                            heroJustSwiped = true;
                            // Kéo sang trái (dx âm) -> sang phim sau
                            const dir = dx < 0 ? 1 : -1;
                            const next = (activeHeroIdx + dir + HERO_ITEMS.length) % HERO_ITEMS.length;
                            selectHeroSlide(next);
                            // Tránh cờ bị kẹt nếu không có click phát sinh
                            setTimeout(() => { heroJustSwiped = false; }, 350);
                        };

                        // ---- Cảm ứng (mobile / máy tính bảng) ----
                        hero.addEventListener('touchstart', (e) => {
                            const t = e.touches[0];
                            if (t) onStart(t.clientX, t.clientY);
                        }, { passive: true });
                        hero.addEventListener('touchmove', (e) => {
                            const t = e.touches[0];
                            if (t) onMove(t.clientX, t.clientY);
                        }, { passive: true });
                        hero.addEventListener('touchend', (e) => {
                            const t = e.changedTouches && e.changedTouches[0];
                            if (t) onEnd(t.clientX, t.clientY);
                        }, { passive: true });
                        hero.addEventListener('touchcancel', () => {
                            dragging = false;
                            moved = false;
                            hero.classList.remove('as-hero-dragging');
                        }, { passive: true });

                        // ---- Chuột (desktop) ----
                        hero.addEventListener('mousedown', (e) => {
                            // Không cản nút/chức năng bên trong
                            if (e.button !== 0) return;
                            onStart(e.clientX, e.clientY);
                        });
                        hero.addEventListener('mousemove', (e) => onMove(e.clientX, e.clientY));
                        hero.addEventListener('mouseup', (e) => onEnd(e.clientX, e.clientY));
                        // Thả chuột ngoài khung hero cũng phải xử lý
                        hero.addEventListener('mouseleave', (e) => {
                            if (dragging) onEnd(e.clientX, e.clientY);
                        });

                        // Chặn hành vi kéo ảnh mặc định của trình duyệt
                        hero.addEventListener('dragstart', (e) => e.preventDefault());
                    }

                    function startHeroAutoPlay() {
                        clearInterval(heroAutoTimer);
                        const recView = document.getElementById('asRecommendView');
                        if (recView && recView.style.display !== 'none') return;
                        heroAutoTimer = setInterval(() => {
                            const recViewNow = document.getElementById('asRecommendView');
                            if (recViewNow && recViewNow.style.display !== 'none') return;
                            const nextIdx = (activeHeroIdx + 1) % HERO_ITEMS.length;
                            selectHeroSlide(nextIdx);
                        }, 6000);
                    }

                    function selectHeroSlide(index) {
                        if (index < 0 || index >= HERO_ITEMS.length) return;
                        activeHeroIdx = index;
                        const item = HERO_ITEMS[index];

                        // Update Titles & Subtitles
                        const titleEl = document.getElementById('asHeroTitle');
                        const metaEl = document.getElementById('asHeroMeta');
                        const counterEl = document.getElementById('asSlideCounter');

                        if (titleEl) {
                            titleEl.style.opacity = '0.4';
                            titleEl.textContent = item.title;
                            setTimeout(() => {
                                titleEl.style.opacity = '1';
                            }, 80);
                        }
                        if (metaEl) {
                            metaEl.innerHTML = `<span>${item.genre || 'Ngọt sủng, Cưới trước yêu sau'}</span><span>·</span><span>${item.totalEpisodes} tập</span>`;
                        }
                        if (counterEl) {
                            counterEl.textContent = `${String(index + 1).padStart(2, '0')} / ${String(HERO_ITEMS.length).padStart(2, '0')}`;
                        }

                        // Update Mobile Cover Backdrop
                        const mobileCover = document.getElementById('asHeroMobileCover');
                        if (mobileCover && item.cover) {
                            mobileCover.style.opacity = '0.6';
                            mobileCover.src = item.cover;
                            setTimeout(() => {
                                mobileCover.style.opacity = '1';
                            }, 100);
                        }

                        // Update Thumbnails Active Class
                        document.querySelectorAll('.as-thumb-item').forEach((el, i) => {
                            el.classList.toggle('active', i === index);
                        });

                        // Update 3D Stack Cards Position
                        update3DStackCards(index);
                        startHeroAutoPlay();
                    }

                    function update3DStackCards(centerIndex) {
                        const wrap = document.getElementById('as3DStackWrap');
                        if (!wrap) return;

                        const stackIndices = [
                            centerIndex,
                            (centerIndex + 1) % HERO_ITEMS.length,
                            (centerIndex + 2) % HERO_ITEMS.length
                        ];

                        wrap.innerHTML = stackIndices.map((idx, pos) => {
                            const drama = HERO_ITEMS[idx];
                            return `
                    <div class="as-stack-card pos-${pos}" onclick="playCurrentHero()">
                        <img src="${drama.cover}" alt="${drama.title}">
                    </div>
                `;
                        }).join('');
                    }

                    function playCurrentHero() {
                        // Vừa vuốt/kéo xong thì coi như KHÔNG phải bấm mở phim
                        if (heroJustSwiped) {
                            heroJustSwiped = false;
                            return;
                        }
                        if (HERO_ITEMS[activeHeroIdx]) {
                            openDramaPlayer(HERO_ITEMS[activeHeroIdx].id, 1);
                        }
                    }

                    function openHeroDetails() {
                        if (HERO_ITEMS && HERO_ITEMS[activeHeroIdx] && HERO_ITEMS[activeHeroIdx].id) {
                            openDramaDetail(HERO_ITEMS[activeHeroIdx].id);
                        }
                    }

                    function toggleHeroBookmark() {
                        if (!HERO_ITEMS[activeHeroIdx]) return;
                        alert(`Đã lưu "${HERO_ITEMS[activeHeroIdx].title}" vào thư viện của bạn!`);
                    }

                    // 2. CONTINUE WATCHING STATE (LOCALSTORAGE CHO KHÁCH & MONGODB CHO USER ĐÃ ĐĂNG NHẬP)
                    let _lastMongoHistorySyncTime = 0;
                    let _pendingMongoHistoryTimeout = null;

                    function saveContinueState(drama, epNo, currentTime = 0, duration = 0, immediateSync = false) {
                        try {
                            if (!drama || !drama.id) return;
                            let list = [];
                            try {
                                list = JSON.parse(localStorage.getItem('aphim_pn_continue_list') || '[]');
                                if (!Array.isArray(list)) list = [];
                            } catch (e) {
                                list = [];
                            }

                            const total = drama.totalEpisodes || (drama.episodes ? drama.episodes.length : 60);
                            const videoEl = document.getElementById('asVideoEl');
                            const curSec = Math.floor(currentTime > 0 ? currentTime : (videoEl && !isNaN(videoEl.currentTime) ? videoEl.currentTime : 0));
                            const durSec = Math.floor(duration > 0 ? duration : (videoEl && !isNaN(videoEl.duration) ? videoEl.duration : 0));

                            const current = {
                                id: String(drama.id),
                                title: drama.title || '',
                                cover: drama.cover || '',
                                totalEpisodes: total,
                                epNo: epNo || 1,
                                currentTime: curSec,
                                duration: durSec,
                                timestamp: Date.now()
                            };

                            list = list.filter(item => item && String(item.id) !== String(drama.id));
                            list.unshift(current);
                            if (list.length > 50) list = list.slice(0, 50);

                            // Luôn cập nhật localStorage (đáp ứng trọn vẹn cho khách xem không đăng nhập)
                            localStorage.setItem('aphim_pn_continue_list', JSON.stringify(list));
                            localStorage.setItem('aphim_pn_continue', JSON.stringify(current));
                            loadContinueWatchingState();

                            // 🌟 NẾU USER ĐÃ ĐĂNG NHẬP: LƯU LỊCH SỬ XEM PHIM VÀO MONGODB
                            syncWatchHistoryToMongo(current, immediateSync);
                        } catch (e) { }
                    }

                    function syncWatchHistoryToMongo(current, immediate = false) {
                        try {
                            const token = localStorage.getItem('cinestream_token');
                            const headers = { 'Content-Type': 'application/json' };
                            if (token) headers['Authorization'] = 'Bearer ' + token;

                            const doSync = () => {
                                _lastMongoHistorySyncTime = Date.now();
                                fetch('/phim-ngan/api/history', {
                                    method: 'POST',
                                    headers: headers,
                                    body: JSON.stringify({
                                        id: current.id,
                                        title: current.title,
                                        cover: current.cover,
                                        epNo: current.epNo,
                                        totalEpisodes: current.totalEpisodes,
                                        currentTime: current.currentTime || 0,
                                        duration: current.duration || 0
                                    })
                                }).then(r => r.json()).then(res => {
                                    if (res && res.loggedIn && res.success) {
                                        // Cập nhật bộ nhớ đệm MongoDB trong phiên nếu đang duyệt
                                        if (window._pnMongoLibrary && Array.isArray(window._pnMongoLibrary.history)) {
                                            window._pnMongoLibrary.history = window._pnMongoLibrary.history.filter(h => h && String(h.id) !== String(current.id));
                                            window._pnMongoLibrary.history.unshift(current);
                                        }
                                    }
                                }).catch(() => { });
                            };

                            if (immediate || (Date.now() - _lastMongoHistorySyncTime > 4000)) {
                                if (_pendingMongoHistoryTimeout) {
                                    clearTimeout(_pendingMongoHistoryTimeout);
                                    _pendingMongoHistoryTimeout = null;
                                }
                                doSync();
                            } else if (!_pendingMongoHistoryTimeout) {
                                _pendingMongoHistoryTimeout = setTimeout(() => {
                                    _pendingMongoHistoryTimeout = null;
                                    doSync();
                                }, 4000);
                            }
                        } catch (e) { }
                    }

                    // Helper tra cứu tiến trình đã xem của một phim (Tập bao nhiêu, giây thứ mấy)
                    function getSavedProgressForDrama(dramaId) {
                        if (!dramaId) return null;
                        const sId = String(dramaId);
                        const history = getRecentlyWatched() || [];
                        const match = history.find(h => h && String(h.id) === sId);
                        if (match) {
                            return {
                                epNo: parseInt(match.epNo, 10) || 1,
                                currentTime: parseFloat(match.currentTime) || 0,
                                duration: parseFloat(match.duration) || 0
                            };
                        }
                        try {
                            const single = JSON.parse(localStorage.getItem('aphim_pn_continue') || '{}');
                            if (single && String(single.id) === sId) {
                                return {
                                    epNo: parseInt(single.epNo, 10) || 1,
                                    currentTime: parseFloat(single.currentTime) || 0,
                                    duration: parseFloat(single.duration) || 0
                                };
                            }
                        } catch (e) { }
                        return null;
                    }

                    // Mở rạp xem phim từ Thư viện: Khôi phục chính xác Tập và Mốc thời gian đang xem dở
                    function playDramaFromLibrary(dramaId, fallbackEp = 1, fallbackTime = 0) {
                        if (!dramaId) return;
                        const progress = getSavedProgressForDrama(dramaId);
                        const epNo = (progress && progress.epNo) ? progress.epNo : (fallbackEp || 1);
                        const seekTime = (progress && typeof progress.currentTime === 'number') ? progress.currentTime : (fallbackTime || 0);

                        console.log(`[APhim Library] 🎬 Mở xem phim ${dramaId} từ thư viện: Tập ${epNo}, mốc ${seekTime}s`);
                        openDramaPlayer(dramaId, epNo, seekTime);
                    }

                    function loadContinueWatchingState() {
                        try {
                            let list = [];
                            try {
                                list = JSON.parse(localStorage.getItem('aphim_pn_continue_list') || '[]');
                                if (!Array.isArray(list)) list = [];
                            } catch (e) {
                                list = [];
                            }

                            if (list.length === 0) {
                                const raw = localStorage.getItem('aphim_pn_continue');
                                if (raw) {
                                    try { list.push(JSON.parse(raw)); } catch (e) { }
                                }
                            }

                            if (list.length === 0) return;

                            // Cập nhật các card xem tiếp theo thứ tự
                            list.slice(0, 4).forEach((state, idx) => {
                                const coverEl = document.getElementById(`asContinueCover_${idx}`);
                                const titleEl = document.getElementById(`asContinueTitle_${idx}`);
                                const epLabelEl = document.getElementById(`asContinueEpLabel_${idx}`);
                                const fillEl = document.getElementById(`asProgressBarFill_${idx}`);
                                const nextLabelEl = document.getElementById(`asContinueNextLabel_${idx}`);
                                const remLabelEl = document.getElementById(`asContinueRemainingLabel_${idx}`);
                                const cardEl = document.getElementById(`asContinueCard_${idx}`);

                                if (coverEl && state.cover) coverEl.src = state.cover;
                                if (titleEl && state.title) {
                                    titleEl.textContent = state.title;
                                    titleEl.title = state.title;
                                }
                                if (epLabelEl && state.epNo && state.totalEpisodes) {
                                    epLabelEl.textContent = `Tập ${state.epNo} / ${state.totalEpisodes}`;
                                }
                                if (nextLabelEl && state.epNo) {
                                    const timeTag = (state.currentTime > 0) ? ` • ${formatTimeSeconds(state.currentTime)}` : '';
                                    nextLabelEl.textContent = `Tiếp tục tập ${state.epNo}${timeTag}`;
                                }
                                if (remLabelEl && state.epNo && state.totalEpisodes) {
                                    const remaining = Math.max(0, state.totalEpisodes - state.epNo);
                                    remLabelEl.textContent = `Còn ${remaining} tập`;
                                }
                                if (fillEl && state.epNo && state.totalEpisodes) {
                                    const pct = Math.min(100, Math.max(5, Math.round((state.epNo / state.totalEpisodes) * 100)));
                                    fillEl.style.width = `${pct}%`;
                                }
                                if (cardEl && state.id) {
                                    cardEl.onclick = () => openDramaPlayer(state.id, state.epNo || 1, state.currentTime || 0);
                                }
                            });
                        } catch (e) { }
                    }

                    function handleContinueClick() {
                        try {
                            const raw = localStorage.getItem('aphim_pn_continue');
                            if (raw) {
                                const state = JSON.parse(raw);
                                openDramaPlayer(state.id, state.epNo || 1, state.currentTime || 0);
                                return;
                            }
                        } catch (e) { }
                        // Mở phim đầu tiên trong danh sách 4 thẻ xem tiếp
                        const firstCard = document.querySelector('#asContinueCardsGrid .as-continue-card');
                        if (firstCard && firstCard.dataset.dramaId) {
                            const ep = parseInt(firstCard.dataset.ep || '1', 10);
                            openDramaPlayer(firstCard.dataset.dramaId, ep);
                            return;
                        }
                        if (HERO_ITEMS && HERO_ITEMS[0]) {
                            openDramaPlayer(HERO_ITEMS[0].id, 1);
                        }
                    }

                    // 3. CAROUSEL HORIZONTAL SCROLL
                    function scrollCarousel(elementId, distance) {
                        const el = document.getElementById(elementId);
                        if (el) {
                            el.scrollBy({ left: distance, behavior: 'smooth' });
                        }
                    }

                    function scrollToShelf(targetId) {
                        const el = document.getElementById(targetId);
                        if (el) {
                            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }

                    // 4. LEADERBOARD FILTERS
                    async function filterLeaderboard(catId, btnEl) {
                        document.querySelectorAll('.as-lb-pill').forEach(b => b.classList.remove('active'));
                        if (btnEl) btnEl.classList.add('active');

                        const carousel = document.getElementById('asLbCarousel');
                        if (carousel) carousel.innerHTML = '<div style="padding:20px; color:#9ca3af;">Đang tải dữ liệu bảng xếp hạng...</div>';

                        try {
                            const res = await fetch(`/phim-ngan/list?category=${encodeURIComponent(catId)}`);
                            const json = await res.json();
                            if (json.success && json.items) {
                                carousel.innerHTML = json.items.map((d, i) => `
                        <div class="as-lb-card" onclick="openDramaDetail('${d.id}')">
                            <div class="as-lb-rank as-rank-${i + 1}">
                                ${i === 0 ? '<span class="as-rank-icon">👑</span>' : ''}
                                <span>${i + 1}</span>
                            </div>
                            <img src="${d.cover}" alt="${d.title}" loading="lazy">
                            <div class="as-card-bottom-stats">
                                <span>${d.stats ? d.stats.views : (25 - i)} <span class="as-stat-ico" style="background:rgba(163,230,53,0.22);"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#a3e635" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3.2"/></svg></span></span>
                                <span>${d.stats ? d.stats.likes : 1} <span class="as-stat-ico" style="background:rgba(244,114,182,0.2);"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#f472b6" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span></span>
                                <span>${d.stats ? d.stats.stars : 0} <span class="as-stat-ico" style="background:rgba(250,204,21,0.2);"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span></span>
                            </div>
                        </div>
                    `).join('');
