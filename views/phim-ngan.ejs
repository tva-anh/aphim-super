                    // =======================================================
                    // ⚡ TUA NHANH 5S (DOUBLE-TAP CẠNH TRÁI / PHẢI) & HIỆU ỨNG RIPPLE
                    // =======================================================
                    let lastCinemaTapTime = 0;
                    let lastCinemaTapSide = null;
                    let cinemaSingleTapTimeout = null;
                    let seekRippleTimer = null;

                    function showSeekRipple(side, text = '5s') {
                        const rippleId = (side === 'right') ? 'asSeekRippleRight' : 'asSeekRippleLeft';
                        const rippleEl = document.getElementById(rippleId);
                        if (!rippleEl) return;

                        rippleEl.classList.remove('active');
                        void rippleEl.offsetWidth; // Buộc reflow để kích hoạt lại animation ngay lập tức
                        rippleEl.classList.add('active');

                        const textEl = rippleEl.querySelector('.as-seek-text');
                        if (textEl && text) textEl.textContent = text;

                        if (seekRippleTimer) clearTimeout(seekRippleTimer);
                        seekRippleTimer = setTimeout(() => {
                            const l = document.getElementById('asSeekRippleLeft');
                            const r = document.getElementById('asSeekRippleRight');
                            if (l) l.classList.remove('active');
                            if (r) r.classList.remove('active');
                            seekRippleTimer = null;
                        }, 600);
                    }

                    function handleCinemaVideoClick(event) {
                        if (event) {
                            const target = event.target;
                            if (target && (target.closest('.as-mobile-cinema-actions') ||
                                target.closest('.as-cinema-bottom-bar-wrap') ||
                                target.closest('.as-cinema-topbar') ||
                                target.closest('.as-video-center-play-btn') ||
                                target.closest('.as-tool-pop') ||
                                target.closest('.as-mobile-cinema-sheet') ||
                                target.closest('.as-sub-notice') ||
                                target.closest('button'))) {
                                return;
                            }
                        }

                        // 💻 Trên Desktop: Click màn hình để phát / dừng video như bình thường
                        if (window.innerWidth > 991) {
                            toggleCinemaPlay();
                            return;
                        }

                        // 📱 Trên Mobile:
                        if (event) {
                            event.preventDefault();
                            event.stopPropagation();
                        }

                        // Xác định tọa độ chạm xem nằm ở nửa bên trái hay nửa bên phải video
                        const box = document.querySelector('.as-cinema-video-box') || document.getElementById('asVideoStage');
                        const rect = box ? box.getBoundingClientRect() : { left: 0, width: window.innerWidth };
                        let clickX = (event && typeof event.clientX === 'number' && event.clientX > 0) ? event.clientX : 0;
                        if (!clickX && event && event.changedTouches && event.changedTouches.length) {
                            clickX = event.changedTouches[0].clientX;
                        }
                        if (!clickX) clickX = window.innerWidth / 2;

                        const relativeX = clickX - rect.left;
                        const isRightSide = relativeX > (rect.width / 2);
                        const side = isRightSide ? 'right' : 'left';

                        const now = Date.now();
                        const timeDiff = now - lastCinemaTapTime;

                        // ⚡ KIỂM TRA DOUBLE TAP: Chạm 2 lần liên tiếp (< 360ms) vào cùng một cạnh
                        if (timeDiff < 360 && lastCinemaTapSide === side) {
                            // Hủy thao tác chạm đơn (không ẩn/hiện menu khi đang tua)
                            if (cinemaSingleTapTimeout) {
                                clearTimeout(cinemaSingleTapTimeout);
                                cinemaSingleTapTimeout = null;
                            }
                            lastCinemaTapTime = now;
                            lastCinemaTapSide = side;

                            if (side === 'right') {
                                skipCinemaTime(5);
                                showSeekRipple('right', '+5s');
                            } else {
                                skipCinemaTime(-5);
                                showSeekRipple('left', '-5s');
                            }
                            return;
                        }

                        // Ghi nhận lần chạm đầu tiên
                        lastCinemaTapTime = now;
                        lastCinemaTapSide = side;

                        // Đợi 260ms: nếu người dùng không chạm lần 2 -> thực hiện Single Tap bật/tắt menu icon bên phải
                        if (cinemaSingleTapTimeout) clearTimeout(cinemaSingleTapTimeout);
                        cinemaSingleTapTimeout = setTimeout(() => {
                            cinemaSingleTapTimeout = null;
                            lastCinemaTapTime = 0;
                            lastCinemaTapSide = null;
                            toggleMobileCinemaActions();
                        }, 260);
                    }

                    function toggleCinemaPlay() {
                        const videoEl = document.getElementById('asVideoEl');
                        const playIcon = document.getElementById('asPlayIconSvg');
                        const pauseIcon = document.getElementById('asPauseIconSvg');
                        const centerPlayBtn = document.getElementById('asCenterPlayBtn');
                        if (!videoEl) return;
                        if (videoEl.paused) {
                            videoEl.play().catch(() => { });
                            if (playIcon) playIcon.style.display = 'none';
                            if (pauseIcon) pauseIcon.style.display = 'block';
                            if (centerPlayBtn) centerPlayBtn.classList.remove('show');
                            scheduleMobileCinemaActionsAutoHide(2200);
                        } else {
                            videoEl.pause();
                            if (playIcon) playIcon.style.display = 'block';
                            if (pauseIcon) pauseIcon.style.display = 'none';
