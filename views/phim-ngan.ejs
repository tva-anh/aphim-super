                    /* Nhấn Esc cũng đóng popover/drawer và thoát toàn màn hình */
                    document.addEventListener('keydown', function (ev) {
                        if (ev.key === 'Escape') {
                            closeRecSettings();
                            closeRecEpisodeDrawer();
