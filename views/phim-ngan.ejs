                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="#ffffff">
                                                            <polygon points="7 4 20 12 7 20 7 4" />
                                                        </svg>
                                                    </div>
                                                </div>
                                                <!-- Nội dung chi tiết bên phải -->
                                                <div class="as-continue-info">
                                                    <div class="as-continue-title" id="asContinueTitle_<%= idx %>"
                                                        title="<%= item.title %>">
                                                        <%= item.title %>
                                                    </div>
                                                    <div class="as-continue-sub" id="asContinueEpLabel_<%= idx %>">Tập
                                                        <%= item.currentEp %> / <%= item.totalEps %>
                                                    </div>
                                                    <!-- Thanh tiến trình nằm ngang mỏng -->
                                                    <div class="as-progress-bar-wrap">
                                                        <div class="as-progress-bar-fill"
                                                            id="asProgressBarFill_<%= idx %>"
                                                            style="width: <%= item.percent %>%;"></div>
                                                    </div>
                                                    <!-- Hàng footer: Tiếp tục tập X --- Còn Y tập -->
                                                    <div class="as-continue-footer">
                                                        <span class="as-continue-left-text"
                                                            id="asContinueNextLabel_<%= idx %>">Tiếp tục tập <%=
                                                                item.currentEp %></span>
                                                        <span class="as-continue-right-text"
                                                            id="asContinueRemainingLabel_<%= idx %>">Còn <%= remain %>
                                                                tập</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }); %>
                                </div>
                            </section>

                            <!-- =======================================================
             3. TOP 10 PHIM ĐANG HOT NHẤT (SCREENSHOT 1)
             Giant outline number to the left, poster overlapping right!
             ======================================================= -->
                            <% const topTenList=(typeof top10Dramas !=='undefined' && top10Dramas && top10Dramas.length>
                                0) ? top10Dramas : (trendingDramas ? trendingDramas.slice(0, 10) : []); %>
