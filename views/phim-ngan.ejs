                                            stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                            <polyline points="7 10 12 15 17 10" />
                                            <line x1="12" y1="15" x2="12" y2="3" />
                                        </svg>
                                    </span>
                                </div>
                            </div>

                            <!-- Báo lỗi (Chevron Arrow) -->
                            <div class="as-set-row as-set-clickable"
                                onclick="closeRecSettings(); reportCurrentDrama();">
                                <span class="as-set-row-title">Báo lỗi</span>
                                <div class="as-set-row-right">
                                    <span class="as-set-row-arrow as-set-row-end-slot">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <polyline points="9 18 15 12 9 6" />
                                        </svg>
                                    </span>
                                </div>
                            </div>

                            <!-- Hai nút điều khiển đáy: Toàn màn hình & Đóng trình phát -->
                            <div class="as-set-footer-actions">
                                <button class="as-set-footer-btn" onclick="closeRecSettings(); toggleRecFullscreen();">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path
                                            d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
                                    </svg>
                                    <span>Toàn màn hình</span>
                                </button>
                                <button class="as-set-footer-btn" onclick="closeRecSettings();">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.4" stroke-linecap="round">
                                        <line x1="18" y1="6" x2="6" y2="18" />
                                        <line x1="6" y1="6" x2="18" y2="18" />
                                    </svg>
                                    <span>Đóng trình phát</span>
                                </button>
                            </div>
                        </div>

                        <!-- 4. RIGHT: Counter, phím tắt & danh sách Tiếp theo (Ảnh 1) -->
                        <div class="as-rec-side">
                            <div class="as-rec-counter-row">
                                <button class="as-rec-nav-btn prev" onclick="reelsStepDrama(-1)" title="Phim trước (↑)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.5">
                                        <polyline points="18 15 12 9 6 15" />
                                    </svg>
                                </button>
                                <button class="as-rec-nav-btn next active-white" onclick="reelsStepDrama(1)"
                                    title="Phim sau (↓)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.5">
                                        <polyline points="6 9 12 15 18 9" />
                                    </svg>
                                </button>
                                <span class="as-rec-counter" id="asRecCounter">04 / 498</span>
                            </div>

                            <div class="as-rec-hotkeys">
                                <span><kbd>↑</kbd><kbd>↓</kbd> đổi phim</span>
                                <span><kbd>Space</kbd> dừng</span>
                            </div>

                            <div class="as-rec-next">
                                <div class="as-rec-next-title">Tiếp theo</div>
                                <div class="as-rec-next-list" id="asRecNextList"></div>
                            </div>
                        </div>
                    </div>

                    <!-- 🟢 Bottom Sheet Drawer Chọn Tập trên Mobile cho Đề Xuất -->
                    <div class="as-rec-sheet-backdrop" id="asRecSheetBackdrop" onclick="closeRecEpisodeDrawer()"></div>
                    <div class="as-rec-sheet-drawer" id="asRecSheetDrawer">
                        <div class="as-rec-sheet-pull-bar"></div>
                        <div class="as-rec-sheet-header">
                            <span class="as-rec-sheet-heading">Danh sách tập (<span
                                    id="asRecSheetCount">0</span>)</span>
                            <button type="button" class="as-rec-sheet-close" onclick="closeRecEpisodeDrawer()"
                                title="Đóng">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.4" stroke-linecap="round">
                                    <line x1="18" y1="6" x2="6" y2="18" />
                                    <line x1="6" y1="6" x2="18" y2="18" />
                                </svg>
                            </button>
                        </div>
                        <div class="as-rec-sheet-body" id="asRecSheetBody"></div>
                    </div>
                </section>

                <!-- =======================================================
         🔍 TRANG TÌM KIẾM /phim-ngan/tim-kiem (CHUẨN 100% ẢNH 1)
         ======================================================= -->
                <section class="as-search-view" id="asSearchView"
                    style="<%= (typeof pnView !== 'undefined' && pnView === 'search') ? 'display:block;' : 'display:none;' %>">
                    <div class="as-view-inner">
                        <h2 class="as-view-title">Tìm kiếm</h2>

                        <div class="as-search-box">
                            <input type="text" id="asSearchInput" placeholder="Tìm phim, thể loại..."
                                oninput="onSearchInput(this.value)">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8" />
                                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                            </svg>
                        </div>

                        <div class="as-search-filters">
                            <div class="as-filter-wrap">
                                <button class="as-filter-pill" onclick="toggleFilterMenu(this)" data-filter="genre">Thể
                                    loại
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9" />
                                    </svg>
                                </button>
                                <div class="as-filter-menu as-filter-menu-genre" id="asFilterMenuGenre">
                                    <div class="as-filter-genre-head">
                                        <span class="as-filter-genre-head-title">Thể loại</span>
                                        <button type="button" class="as-filter-genre-close"
                                            onclick="closeAllFilterMenus(); event.stopPropagation();"
                                            aria-label="Đóng danh mục">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                                                <line x1="18" y1="6" x2="6" y2="18" />
                                                <line x1="6" y1="6" x2="18" y2="18" />
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="as-filter-genre-body" id="asFilterGenreBody"></div>
                                </div>
                            </div>
                            <div class="as-filter-wrap">
                                <button class="as-filter-pill" onclick="toggleFilterMenu(this)"
                                    data-filter="status">Tình trạng
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9" />
                                    </svg>
                                </button>
                                <div class="as-filter-menu" id="asFilterMenuStatus"></div>
                            </div>
                            <button class="as-filter-pill" onclick="sortSearchBy('views')">Lượt xem
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="17 11 12 6 7 11" />
                                    <polyline points="17 18 12 13 7 18" />
                                </svg>
                            </button>
                            <button class="as-filter-pill" onclick="sortSearchBy('likes')">Lượt thích
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="17 11 12 6 7 11" />
                                    <polyline points="17 18 12 13 7 18" />
                                </svg>
                            </button>
                            <div class="as-filter-wrap">
                                <button class="as-filter-pill" onclick="toggleFilterMenu(this)" data-filter="sort">Sắp
                                    xếp
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9" />
                                    </svg>
                                </button>
                                <div class="as-filter-menu" id="asFilterMenuSort"></div>
                            </div>
                        </div>

                        <% 
                            // Pool phim để tìm kiếm: gộp tất cả nguồn, loại trùng
                            const SEARCH_POOL_MAP = new Map();
                            [...(heroDramas || []), ...(latestDramas || []), ...(trendingDramas || []), ...(popularDramas || []), ...(top10Dramas || [])].forEach(d => {
                                if (d && d.id) SEARCH_POOL_MAP.set(String(d.id), d);
                            });
                            (shelves || []).forEach(s => (s.items || []).forEach(d => {
                                if (d && d.id) SEARCH_POOL_MAP.set(String(d.id), d);
                            }));
                            const SEARCH_POOL_ITEMS = [...SEARCH_POOL_MAP.values()].map(d => ({
                                id: String(d.id),
                                title: d.title || '',
                                cover: d.cover || '',
                                genre: d.genre || '',
                                totalEpisodes: d.totalEpisodes || 0,
                                hasSub: Boolean(d.hasSub || d.hasEmbeddedSub || d.source === 'narto' || d.source === 'vietshort'),
                                isDubbed: Boolean(d.isDubbed),
                                stats: d.stats || { views: 0, likes: 0, stars: 0 }
                            }));
                            const SEARCH_GENRE_TITLES = [...new Set((shelves || []).map(s => s.title).filter(Boolean))];
                            %>

                            <!-- Thanh trạng thái tìm kiếm -->
                            <div class="as-search-status" id="asSearchStatus" style="display:none;">
                                <span id="asSearchStatusText"></span>
                                <button class="as-search-clear" onclick="clearSearch()">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.6" stroke-linecap="round">
                                        <line x1="5" y1="5" x2="19" y2="19" />
                                        <line x1="19" y1="5" x2="5" y2="19" />
                                    </svg>
                                    Xóa
                                </button>
                            </div>

                            <p class="as-search-hint" id="asSearchHint">Tất cả phim ngắn đặc sắc — Khám phá &amp; thưởng thức</p>

                            <!-- Grid hiển thị phim ngắn chuẩn (6 cột Desktop, 3 cột Mobile, chuẩn Netflix / APhim) -->
                            <div class="as-search-results" id="asSearchResults">
                                <% 
                                const initialSearchPage = SEARCH_POOL_ITEMS.slice(0, 18);
                                initialSearchPage.forEach(d => {
                                    const titleEsc = (d.title || '').replace(/"/g, '&quot;');
                                    const dramaIdEsc = String(d.id || '').replace(/'/g, "\\'");
                                    const coverUrl = d.cover || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop';
                                    const epCount = d.totalEpisodes ? (d.totalEpisodes + ' tập') : '';
                                    const viewsCount = (d.stats && d.stats.views) ? (d.stats.views >= 1000 ? (d.stats.views / 1000).toFixed(1) + 'k' : d.stats.views) : '';
                                    const genreBadge = d.genre ? d.genre.split(/[,/&]/)[0].trim() : '';
                                %>
                                    <div class="as-search-result-item" onclick="openDramaDetail('<%= dramaIdEsc %>')" title="<%= titleEsc %>">
                                        <div class="as-search-result-poster">
                                            <img src="<%= coverUrl %>" alt="<%= titleEsc %>" loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop';">
                                            <div class="as-search-result-play-overlay">
                                                <div class="as-search-play-btn">
                                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                                        <polygon points="6 4 20 12 6 20 6 4"/>
                                                    </svg>
                                                </div>
                                            </div>
                                            <% if (epCount) { %><span class="as-search-ep-badge"><%= epCount %></span><% } %>
                                        </div>
                                        <div class="as-search-result-name"><%= d.title %></div>
                                        <div class="as-search-result-meta">
                                            <% if (genreBadge) { %><span class="as-search-meta-genre"><%= genreBadge %></span><% } %>
                                            <% if (viewsCount) { %>
                                                <span class="as-search-meta-views">
                                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display:inline-block; vertical-align:-1px; margin-right:2px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg><%= viewsCount %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>

                            <!-- Bộ phân chia trang cho Tìm kiếm & Khám phá phim ngắn -->
                            <% const initialTotalSearchPages = Math.max(1, Math.ceil(SEARCH_POOL_ITEMS.length / 18)); %>
                            <div id="asSearchPaginationWrap" class="as-lib-pagination-wrap" style="<%= (SEARCH_POOL_ITEMS.length > 18) ? 'display: flex;' : 'display: none;' %> margin-top: 36px;">
                                <button id="asSearchPrevBtn" type="button" onclick="changeSearchPage(-1)" class="as-lib-page-btn" aria-label="Trang trước" disabled>
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3.75 12m0 0l6.75-6.75M3.75 12h16.5" />
                                    </svg>
                                </button>

                                <div class="as-lib-page-pill">
                                    <span class="as-lib-page-label">Trang</span>
                                    <input type="number" id="asSearchPageInput" min="1" value="1" max="<%= initialTotalSearchPages %>" onchange="jumpToSearchPage(this.value)" class="as-lib-page-input">
                                    <span class="as-lib-page-slash">/</span>
                                    <span id="asSearchTotalPages" class="as-lib-total-pages"><%= initialTotalSearchPages %></span>
                                </div>

                                <button id="asSearchNextBtn" type="button" onclick="changeSearchPage(1)" class="as-lib-page-btn" aria-label="Trang sau" <%= (initialTotalSearchPages <= 1) ? 'disabled' : '' %>>
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L20.25 12m0 0l-6.75 6.75M20.25 12H3.75" />
                                    </svg>
                                </button>
                            </div>
                    </div>
                </section>

                <!-- =======================================================
         📚 TRANG THƯ VIỆN (ảnh 3)
         ======================================================= -->
                <section class="as-library-view" id="asLibraryView"
                    style="<%= (typeof pnView !== 'undefined' && pnView === 'library') ? 'display:block;' : 'display:none;' %>">
                    <div class="as-view-inner">
                        <div class="as-library-head">
                            <h2 class="as-view-title">Thư viện</h2>
                            <button class="as-library-add" onclick="handleCreatePlaylistStandalone(event)"
                                title="Tạo danh sách phát mới">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.4" stroke-linecap="round">
                                    <line x1="12" y1="5" x2="12" y2="19" />
                                    <line x1="5" y1="12" x2="19" y2="12" />
                                </svg>
                            </button>
                        </div>

                        <div class="as-library-tabs" id="asLibraryTabs">
                            <button class="as-library-tab <%= (typeof initialLibraryTab === 'undefined' || initialLibraryTab === 'recent') ? 'active' : '' %>" data-tab="recent" onclick="switchLibraryTab('recent', this, true)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10" />
                                    <polyline points="12 7 12 12 15.5 13.5" />
                                </svg>
                                <span>Đã xem gần đây</span>
                            </button>
                            <button class="as-library-tab <%= (typeof initialLibraryTab !== 'undefined' && initialLibraryTab === 'fav') ? 'active' : '' %>" data-tab="fav" onclick="switchLibraryTab('fav', this, true)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path
                                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                </svg>
                                <span>Yêu thích</span>
                            </button>
                            <button class="as-library-tab <%= (typeof initialLibraryTab !== 'undefined' && initialLibraryTab === 'playlist') ? 'active' : '' %>" data-tab="playlist" onclick="switchLibraryTab('playlist', this, true)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                                </svg>
                                <span>Danh sách phát</span>
                            </button>
                        </div>

                        <h3 class="as-library-subheading" id="asLibrarySubheading"><%= (typeof initialLibraryTab !== 'undefined' && initialLibraryTab === 'fav') ? 'Yêu thích' : ((typeof initialLibraryTab !== 'undefined' && initialLibraryTab === 'playlist') ? 'Danh sách phát' : 'Đã xem gần đây') %></h3>
                        <div class="as-library-grid" id="asLibraryGrid"></div>

                        <!-- Bộ chuyển trang chuẩn ảnh 5 (Exact Screenshot 5) -->
                        <div id="asLibPaginationWrap" class="as-lib-pagination-wrap" style="display: none;">
                            <button id="asLibPrevBtn" type="button" onclick="changeLibraryPage(-1)" class="as-lib-page-btn" aria-label="Trang trước">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3.75 12m0 0l6.75-6.75M3.75 12h16.5" />
                                </svg>
                            </button>

                            <div class="as-lib-page-pill">
                                <span class="as-lib-page-label">Trang</span>
                                <input type="number" id="asLibPageInput" min="1" value="1" onchange="jumpToLibraryPage(this.value)" class="as-lib-page-input">
                                <span class="as-lib-page-slash">/</span>
                                <span id="asLibTotalPages" class="as-lib-total-pages">1</span>
                            </div>

                            <button id="asLibNextBtn" type="button" onclick="changeLibraryPage(1)" class="as-lib-page-btn" aria-label="Trang sau">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L20.25 12m0 0l-6.75 6.75M20.25 12H3.75" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </section>

                <!-- =======================================================
         🌟 TRANG THÔNG TIN CHI TIẾT PHIM NGẮN (SCREENSHOT 1 & 2)
         ======================================================= -->
                <!-- Trang /phim-ngan/thong-tin/:id: hiện sẵn trang chi tiết ngay từ server
            (không đợi JS) để không nháy màn hình trống/trang chủ khi tải trang -->
                <div id="asDramaDetailView" class="as-detail-view"
                    style="<%= (typeof viewMode !== 'undefined' && viewMode === 'detail') ? 'display:block;' : 'display:none;' %>">
                    <!-- Nút quay lại trang chủ / trang trước (Trên mobile thu gọn icon sát mép trái, chạm để mở rộng) -->
                    <div class="as-detail-back-wrap" id="asDetailBackWrap">
                        <button type="button" id="asDetailBackBtn" onclick="handleDetailBackClick(event)"
                            aria-label="Quay lại">
                            <span class="as-back-icon-box">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="15 18 9 12 15 6" />
                                </svg>
                            </span>
                            <span id="asDetailBackText">Quay lại Trang chủ</span>
                        </button>
                    </div>

                    <!-- Hero Section (Screenshot 1) -->
                    <div class="as-detail-hero">
                        <div class="as-detail-poster-wrap">
                            <img id="asDetailPoster" class="as-detail-poster"
                                src="<%= (typeof initialDrama !== 'undefined' && initialDrama && initialDrama.cover) ? initialDrama.cover : '' %>"
                                alt="<%= (typeof initialDrama !== 'undefined' && initialDrama && initialDrama.title) ? initialDrama.title : 'Poster Phim Ngắn' %>"
                                loading="eager">
                            <div class="as-detail-mobile-gradient"></div>
                        </div>
                        <div class="as-detail-info">
                            <h1 id="asDetailTitle" class="as-detail-title"><%= (typeof initialDrama !== 'undefined' && initialDrama && initialDrama.title) ? initialDrama.title : 'Tên Phim' %></h1>
                            <div id="asDetailGenres" class="as-detail-genres"><%= (typeof initialDrama !== 'undefined' && initialDrama && initialDrama.genre) ? initialDrama.genre : 'Thể loại phim' %></div>
                            <div id="asDetailMeta" class="as-detail-meta"><%= (typeof initialDrama !== 'undefined' && initialDrama) ? (((initialDrama.episodes ? initialDrama.episodes.length : (initialDrama.totalEpisodes || 0))) + ' tập • Hoàn thành • ' + (initialDrama.play_count || '1.2K') + ' lượt xem') : '0 tập • Hoàn thành • 0 lượt xem' %></div>
                            <div id="asDetailSynopsis" class="as-detail-synopsis"><%= (typeof initialDrama !== 'undefined' && initialDrama && initialDrama.intro) ? initialDrama.intro : 'Tóm tắt nội dung phim...' %></div>
                            <button type="button" class="as-detail-more-toggle" id="asDetailSynopsisToggle"
                                onclick="toggleDetailSynopsis()">xem thêm</button>

                            <div class="as-detail-actions">
                                <button class="as-btn-play-hero" id="asBtnPlayHero"
                                    onclick="startPlayingFromDetail(currentDetailEpNo)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="7" width="20" height="15" rx="3" />
                                        <polyline points="17 2 12 7 7 2" />
                                    </svg>
                                    <span id="asPlayHeroLabel">Xem từ tập 1</span>
                                </button>
                                <button class="as-btn-choose-ep" onclick="scrollToDetailEpisodes()">
                                    <span>Danh sách tập</span>
                                </button>
