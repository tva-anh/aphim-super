                                                        <!-- =======================================================
             9. KINH DỊ & BÍ ẨN (mục cuối cùng - ảnh mẫu)
             ======================================================= -->
                                                        <% 
                                                            const _allDramas = [...(trendingDramas || []), ...(latestDramas || []), ...((typeof shelves !== 'undefined' && shelves) ? shelves.flatMap(s => s.items || []) : [])];
                                                            const _seen = new Set();
                                                            const _pool = _allDramas.filter(d => d && d.id && !_seen.has(d.id) && _seen.add(d.id));
                                                            let horrorDramas = _pool.filter(d => {
                                                                const g = (d.genre || '') + ' ' + (d.labels || []).join(' ');
                                                                return /Kinh dị|Kinh di|Bí ẩn|Bi an|Kinh hoàng|Kinh hoang/i.test(g);
                                                            });
                                                            if (horrorDramas.length < 6) {
                                                                horrorDramas = horrorDramas.concat(_pool.filter(d => !horrorDramas.includes(d)).slice(0, 12 - horrorDramas.length));
                                                            }
                                                            horrorDramas = horrorDramas.slice(0, 12);
                                                        %>
                                                                <% if (horrorDramas.length> 0) { %>
                                                                    <section class="as-shelf-section"
                                                                        id="shelf_section_kinh-di">
                                                                        <div class="as-shelf-header">
