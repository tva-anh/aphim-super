                </main>

                <!-- =======================================================
         ⭐ TRANG ĐỀ XUẤT /phim-ngan/de-xuat (CHUẨN 100% ẢNH 1)
         ======================================================= -->
                <section class="as-recommend-view" id="asRecommendView"
                    style="<%= (typeof pnView !== 'undefined' && pnView === 'recommend') ? 'display:flex;' : 'display:none;' %>">
                    <div class="as-rec-layout">
                        <!-- 1. LEFT: Thông tin phim + chọn tập (chuẩn 100% Ảnh 1) -->
                        <div class="as-rec-info">
                            <div class="as-rec-badges">
                                <span class="as-rec-badge" id="asRecEpCount"
                                    onclick="if(window.innerWidth<=1023)openRecEpisodeDrawer()" style="cursor:pointer;">
                                    <%= (typeof recDrama !=='undefined' && recDrama && recDrama.totalEpisodes) ?
                                        recDrama.totalEpisodes + ' tập' : '68 tập' %>
                                </span>
                                <span class="as-rec-badge full">Full</span>
                            </div>
                            <h1 class="as-rec-title" id="asRecTitle">
                                <%= (typeof recDrama !=='undefined' && recDrama && recDrama.title) ? recDrama.title
                                    : 'Đêm Kinh Thành Cám Dỗ Ôn Trĩ' %>
                            </h1>
                            <p class="as-rec-genres" id="asRecGenres">
                                <%= (typeof recDrama !=='undefined' && recDrama && recDrama.genre) ? recDrama.genre
                                    : 'Ngọt sủng · Gia đình & Tình thân · Danh tính bí ẩn' %>
                            </p>
                            <p class="as-rec-desc" id="asRecDesc">
                                <%= (typeof recDrama !=='undefined' && recDrama && recDrama.intro) ? recDrama.intro
                                    : 'Ôn Trĩ, nữ phóng viên của đài truyền hình Bắc Kinh, trong lúc say rượu đã đến buổi xem mắt do bạn thân sắp xếp rồi tình cờ có quan hệ với một người đàn ông lạ mặt, để rồi khi tỉnh dậy lại chẳng biết...'
                                    %>
                            </p>
                            <button class="as-rec-more" onclick="toggleRecDesc(this)">xem thêm</button>

                            <div class="as-rec-btns">
                                <button class="as-rec-play-btn" id="asRecPlayBtn" onclick="openRecPlay()">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                        <path
                                            d="M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2v3h16V5H4zm6 5v6l5-3-5-3z" />
                                    </svg>
                                    <span id="asRecPlayLabel">Xem từ tập 1</span>
                                </button>
                                <button class="as-rec-detail-btn" onclick="openRecDetailModal()">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10" />
                                        <line x1="12" y1="16" x2="12" y2="12" />
                                        <line x1="12" y1="8" x2="12.01" y2="8" />
                                    </svg>
                                    Chi tiết
                                </button>
                            </div>

                            <div class="as-rec-eps-label">Chọn tập</div>
                            <div class="as-rec-ep-nums" id="asRecEpNums"></div>
                        </div>

                        <!-- 2. CENTER: Khung video dọc chuẩn Reels (Cố định, lướt êm ái) -->
                        <div class="as-rec-stage" id="asRecStage">
                            <div class="as-rec-video-frame" id="asRecVideoFrame" onclick="toggleRecPlayPause(event)">
                                <img class="as-rec-video-poster" id="asRecVideoPoster"
                                    src="<%= (typeof recDrama !== 'undefined' && recDrama && recDrama.cover) ? recDrama.cover : 'https://p6-novel.byteimg.com/novel-pic/5315b66c9f3286f3110a09b2ca75fa77~tplv-noop.image' %>"
                                    alt="Poster phim"
                                    onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop';">
                                <video class="as-rec-video-element" id="asRecVideoElement" playsinline loop
                                    preload="auto"></video>
                                <div class="as-rec-spinner" id="asRecSpinner">
                                    <div class="as-spinner-ring"></div>
                                </div>

                                <!-- 🎛️ Cụm điều khiển trên đỉnh (Trái: Badge tập · Phải: Loa + Bộ chuyển tập) -->
                                <div class="as-rec-note" id="asRecNote"><span class="as-rec-dot"></span> Tập 1 · xem
                                    trước</div>

                                <div class="as-rec-topbar-right-wrap" id="asRecTopbarWrap">
                                    <!-- 🔊 Nút bật/tắt âm thanh -->
                                    <button type="button" class="as-rec-sound-btn" id="asRecSoundBtn"
                                        onclick="event.stopPropagation(); toggleRecSound();" title="Bật/Tắt âm thanh">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                            stroke-linejoin="round" id="asRecSoundMutedIco">
                                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                                            <line x1="23" y1="9" x2="17" y2="15" />
                                            <line x1="17" y1="9" x2="23" y2="15" />
                                        </svg>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                            stroke-linejoin="round" id="asRecSoundActiveIco" style="display:none;">
                                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                                            <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                                            <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
                                        </svg>
                                    </button>

                                    <!-- 🎛️ Nhóm điều khiển TẬP nổi trên video -->
                                    <div class="as-rec-topbar-right" id="asRecTopbarRight">
                                        <button type="button" class="as-rec-topnav-btn"
                                            onclick="event.stopPropagation(); reelsStepDrama(-1);" title="Tập trước (↑)"
                                            aria-label="Tập trước">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2.6" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="18 15 12 9 6 15" />
                                            </svg>
                                        </button>
                                        <button type="button" class="as-rec-topnav-btn"
                                            onclick="event.stopPropagation(); reelsStepDrama(1);" title="Tập sau (↓)"
                                            aria-label="Tập sau">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2.6" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9" />
                                            </svg>
                                        </button>
                                        <span class="as-rec-counter">04 / 498</span>
                                    </div>
                                </div>

                                <!-- 🎬 Phụ đề song ngữ hiển thị trên Video chuẩn Ảnh 1 -->
                                <div class="as-rec-subtitles" id="asRecSubtitles">
                                    <div class="as-rec-sub-cn" id="asRecSubCn">我都把我哥</div>
                                    <div class="as-rec-sub-vi" id="asRecSubVi">Ôn Trĩ, tớ hiến cả anh trai tớ cho cậu
                                        rồi đấy.</div>
                                </div>

                                <!-- Thanh tiến trình phát -->
                                <div class="as-rec-progress" id="asRecProgress"
                                    onclick="event.stopPropagation(); seekRecVideo(event);">
                                    <div class="as-rec-progress-fill" id="asRecProgressFill"></div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. ACTIONS: Cột nút dọc (Thích, Lưu, Bình luận, Tập, Chia sẻ, Cài đặt, Màn hình) sao chép chuẩn 100% từ /phim-ngan/xem -->
