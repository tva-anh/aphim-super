                                        <svg class="as-continue-head-arrow" width="14" height="14" viewBox="0 0 24 24"
                                            fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <polyline points="9 18 15 12 9 6" />
                                        </svg>
                                    </a>
                                </div>

                                <!-- Hàng 4 Card Xem Tiếp chuẩn 100% Ảnh 1 & Ảnh 2 -->
                                <div class="as-continue-cards-grid" id="asContinueCardsGrid">
                                    <% 
                                        // Danh sách 4 phim tiếp tục xem lấy động từ danh sách phim thịnh hành
                                        const sampleContinues = (typeof trendingDramas !== 'undefined' && trendingDramas && trendingDramas.length >= 4) ? [
                                            { id: trendingDramas[0].id, title: trendingDramas[0].title, cover: trendingDramas[0].cover, currentEp: 3, totalEps: trendingDramas[0].totalEpisodes || 72, percent: 18 },
                                            { id: trendingDramas[1].id, title: trendingDramas[1].title, cover: trendingDramas[1].cover, currentEp: 1, totalEps: trendingDramas[1].totalEpisodes || 60, percent: 22 },
                                            { id: trendingDramas[2].id, title: trendingDramas[2].title, cover: trendingDramas[2].cover, currentEp: 2, totalEps: trendingDramas[2].totalEpisodes || 80, percent: 32 },
                                            { id: trendingDramas[3].id, title: trendingDramas[3].title, cover: trendingDramas[3].cover, currentEp: 1, totalEps: trendingDramas[3].totalEpisodes || 101, percent: 12 }
                                        ] : [];
                                    %>

                                        <% sampleContinues.forEach((item, idx)=> {
                                            const remain = Math.max(0, item.totalEps - item.currentEp);
                                            %>
                                            <div class="as-continue-card" id="asContinueCard_<%= idx %>"
                                                data-card-idx="<%= idx %>" data-drama-id="<%= item.id %>"
                                                data-ep="<%= item.currentEp %>"
                                                onclick="openDramaPlayer('<%= item.id %>', <%= item.currentEp %>)">
                                                <!-- Poster Thumbnail đứng với icon Play ở giữa -->
                                                <div class="as-continue-poster">
                                                    <img id="asContinueCover_<%= idx %>" src="<%= item.cover %>"
                                                        alt="<%= item.title %>" loading="lazy">
