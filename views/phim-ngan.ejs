                    }

                    // Mở rộng / Thu gọn tóm tắt phim trong sidebar (/phim-ngan/xem)
                    function toggleSidebarDesc() {
                        const desc = document.getElementById('asSidebarDesc');
                        const link = document.getElementById('asSidebarMoreLink') || document.querySelector('.as-sidebar-more-link');
                        if (!desc) return;
                        const isExp = desc.classList.toggle('expanded');
                        if (link) link.textContent = isExp ? 'thu gọn' : 'xem thêm';
                    }

                    // =======================================================
                    // 🎞 MINI PLAYER: phim tiếp tục phát ở góc dưới khi thoát
                    // =======================================================
                    let miniPlayerActive = false;
                    let miniProgressTimer = null;
                    let miniPlayerDraggedJustNow = false;
                    const MINI_STORAGE_KEY = 'aphim_pn_mini_state';
                    const MINI_POS_STORAGE_KEY = 'aphim_pn_mini_pos';

                    function saveMiniPlayerPosition(left, top) {
                        try {
                            const payload = {
                                left: Math.round(left),
                                top: Math.round(top),
                                vw: window.innerWidth,
                                vh: window.innerHeight
                            };
                            localStorage.setItem(MINI_POS_STORAGE_KEY, JSON.stringify(payload));
                        } catch (e) { }
                    }

                    function resetMiniPlayerDefaultPosition() {
                        const mini = document.getElementById('asMiniPlayer');
                        if (!mini) return;
                        mini.style.removeProperty('left');
                        mini.style.removeProperty('top');
                        mini.style.removeProperty('right');
                        mini.style.removeProperty('bottom');
                        if (window.innerWidth <= 1023) {
                            mini.style.setProperty('bottom', 'calc(92px + env(safe-area-inset-bottom, 0px))', 'important');
                            mini.style.setProperty('right', '14px', 'important');
                        } else {
                            mini.style.setProperty('bottom', '32px', 'important');
                            mini.style.setProperty('right', '28px', 'important');
                        }
                    }

                    function applySavedMiniPlayerPosition() {
                        const mini = document.getElementById('asMiniPlayer');
                        if (!mini) return;
                        try {
                            const raw = localStorage.getItem(MINI_POS_STORAGE_KEY);
                            if (raw) {
                                const pos = JSON.parse(raw);
                                if (pos && typeof pos.left === 'number' && typeof pos.top === 'number') {
                                    const curW = mini.offsetWidth || (window.innerWidth <= 768 ? 320 : 360);
                                    const curH = mini.offsetHeight || 96;
                                    const snapMargin = (window.innerWidth <= 768) ? 12 : 18;
                                    const headerSafe = 68;
                                    const dockHeight = (window.innerWidth <= 1023) ? 96 : 32;
                                    const maxSafeY = Math.max(headerSafe, window.innerHeight - dockHeight - curH);

                                    const left = Math.max(snapMargin, Math.min(pos.left, window.innerWidth - curW - snapMargin));
                                    const top = Math.max(headerSafe, Math.min(pos.top, maxSafeY));

                                    mini.style.setProperty('left', left + 'px', 'important');
                                    mini.style.setProperty('top', top + 'px', 'important');
                                    mini.style.setProperty('right', 'auto', 'important');
                                    mini.style.setProperty('bottom', 'auto', 'important');
                                    return;
                                }
                            }
                        } catch (e) { }
                        resetMiniPlayerDefaultPosition();
                    }

                    function initMiniPlayerDrag() {
                        const dragSize = { w: 0, h: 0 };
                        const mini = document.getElementById('asMiniPlayer');
                        if (!mini || mini._dragInitialized) return;
                        mini._dragInitialized = true;

                        let startX = 0, startY = 0;
                        let origX = 0, origY = 0;
                        let currX = 0, currY = 0;
                        let isDragging = false;
                        let activePointerId = null;
                        let rafId = null;

                        const updatePosition = () => {
                            if (!isDragging || !mini) return;
                            mini.style.setProperty('left', currX + 'px', 'important');
                            mini.style.setProperty('top', currY + 'px', 'important');
                            mini.style.setProperty('right', 'auto', 'important');
                            mini.style.setProperty('bottom', 'auto', 'important');
                            rafId = null;
                        };

                        const onPointerMove = (moveEvt) => {
                            if (moveEvt.pointerId !== activePointerId) return;
                            const dx = moveEvt.clientX - startX;
                            const dy = moveEvt.clientY - startY;

                            if (!isDragging) {
                                if (Math.hypot(dx, dy) > 5) {
                                    isDragging = true;
                                    miniPlayerDraggedJustNow = true;
                                    mini.classList.remove('as-mini-snapping');
                                    mini.classList.add('as-mini-dragging');
                                }
                            }

                            if (isDragging) {
                                if (moveEvt.cancelable) moveEvt.preventDefault();
                                const curW = dragSize.w || (window.innerWidth <= 768 ? 320 : 360);
                                const curH = dragSize.h || 96;
                                const minX = 4;
                                const maxX = Math.max(4, window.innerWidth - curW - 4);
                                const minY = 64;
                                const dockHeight = (window.innerWidth <= 1023) ? 96 : 32;
                                const maxY = Math.max(minY, window.innerHeight - dockHeight - curH);

                                currX = Math.max(minX, Math.min(origX + dx, maxX));
                                currY = Math.max(minY, Math.min(origY + dy, maxY));

                                if (!rafId) {
                                    rafId = requestAnimationFrame(updatePosition);
                                }
                            }
                        };

                        const onPointerUp = (upEvt) => {
                            if (upEvt.pointerId !== activePointerId) return;
                            window.removeEventListener('pointermove', onPointerMove);
                            window.removeEventListener('pointerup', onPointerUp);
                            window.removeEventListener('pointercancel', onPointerUp);

                            if (rafId) {
                                cancelAnimationFrame(rafId);
                                rafId = null;
                            }

                            try {
                                mini.releasePointerCapture(activePointerId);
                            } catch (err) { }

                            if (isDragging) {
                                mini.classList.remove('as-mini-dragging');

                                // 🧲 MAGNETIC SNAP TO EDGE (Tự động hít mép trái hoặc phải siêu mượt chuẩn iOS/TikTok)
                                const curW = dragSize.w || (window.innerWidth <= 768 ? 320 : 360);
                                const curH = dragSize.h || 96;
                                const snapMargin = (window.innerWidth <= 768) ? 12 : 18;
                                const headerSafe = 68;
                                const dockHeight = (window.innerWidth <= 1023) ? 96 : 32;
                                const maxSafeY = Math.max(headerSafe, window.innerHeight - dockHeight - curH);

                                // Hít về mép gần nhất
                                const centerX = currX + curW / 2;
                                const snapX = (centerX < window.innerWidth / 2) ? snapMargin : (window.innerWidth - curW - snapMargin);
                                const snapY = Math.max(headerSafe, Math.min(currY, maxSafeY));

                                mini.classList.add('as-mini-snapping');
                                mini.style.setProperty('left', snapX + 'px', 'important');
                                mini.style.setProperty('top', snapY + 'px', 'important');
                                mini.style.setProperty('right', 'auto', 'important');
                                mini.style.setProperty('bottom', 'auto', 'important');

                                saveMiniPlayerPosition(snapX, snapY);

                                setTimeout(() => {
                                    mini.classList.remove('as-mini-snapping');
                                }, 380);

                                miniPlayerDraggedJustNow = true;
                                setTimeout(() => {
                                    miniPlayerDraggedJustNow = false;
                                }, 350);
                            } else {
                                miniPlayerDraggedJustNow = false;
                                // Nếu người dùng chỉ click/chạm vào Mini Player mà không kéo -> Mở rộng rạp chiếu ngay!
                                if (upEvt && upEvt.target && !upEvt.target.closest('button, .as-mini-btn, .as-mini-close, .as-miniplayer-bar, input')) {
                                    expandMiniPlayer();
                                }
                            }
                            isDragging = false;
                            activePointerId = null;
                        };

                        mini.addEventListener('pointerdown', (e) => {
                            // Bỏ qua nếu chạm vào các nút điều khiển bên trong
                            if (e.target.closest('button, .as-mini-btn, .as-mini-close, .as-miniplayer-bar, input')) {
                                return;
                            }
                            // Chỉ xử lý chuột trái hoặc ngón tay cảm ứng mobile
                            if (e.pointerType === 'mouse' && e.button !== 0) return;

                            const rect = mini.getBoundingClientRect();
                            startX = e.clientX;
                            startY = e.clientY;
                            origX = rect.left;
                            origY = rect.top;
                            currX = origX;
                            currY = origY;
                            isDragging = false;
                            activePointerId = e.pointerId;

                            try {
                                mini.setPointerCapture(activePointerId);
                            } catch (err) { }

                            dragSize.w = mini.offsetWidth || (window.innerWidth <= 768 ? 320 : 360);
                            dragSize.h = mini.offsetHeight || 96;
                            window.addEventListener('pointermove', onPointerMove, { passive: false });
                            window.addEventListener('pointerup', onPointerUp);
                            window.addEventListener('pointercancel', onPointerUp);
                        });
                    }

                    window.addEventListener('resize', () => {
                        const mini = document.getElementById('asMiniPlayer');
                        if (mini && mini.classList.contains('active') && mini.style.left) {
                            applySavedMiniPlayerPosition();
                        }
                    });

                    document.addEventListener('DOMContentLoaded', () => {
                        initMiniPlayerDrag();
                        const mini = document.getElementById('asMiniPlayer');
                        if (mini && mini.classList.contains('active')) {
                            applySavedMiniPlayerPosition();
                        }
                    });

                    function saveMiniPlayerState(forceActive = null) {
                        if (!currentActiveDrama || !currentActiveDrama.episodes) return;
                        const video = document.getElementById('asVideoEl');
                        const isActive = forceActive !== null ? forceActive : miniPlayerActive;
                        if (!isActive) {
                            try { localStorage.removeItem(MINI_STORAGE_KEY); } catch (e) { }
                            return;
                        }
                        const state = {
                            active: true,
                            drama: {
                                id: currentActiveDrama.id,
                                title: currentActiveDrama.title,
                                cover: currentActiveDrama.cover,
                                episodes: currentActiveDrama.episodes,
                                totalEpisodes: currentActiveDrama.totalEpisodes || currentActiveDrama.episodes.length
                            },
                            epIdx: currentActiveEpIdx,
                            currentTime: video ? (video.currentTime || 0) : 0,
                            paused: video ? video.paused : false,
                            updatedAt: Date.now()
                        };
                        try {
                            localStorage.setItem(MINI_STORAGE_KEY, JSON.stringify(state));
                        } catch (e) { }
                    }

                    function clearMiniPlayerState() {
                        try { localStorage.removeItem(MINI_STORAGE_KEY); } catch (e) { }
                    }

                    function getSavedMiniPlayerState() {
                        try {
                            const raw = localStorage.getItem(MINI_STORAGE_KEY);
                            if (!raw) return null;
                            const data = JSON.parse(raw);
                            if (data && data.active && data.drama && data.drama.id && Array.isArray(data.drama.episodes) && data.drama.episodes.length > 0) {
                                return data;
                            }
                        } catch (e) { }
                        return null;
                    }

                    function dismissMiniPlayerForNewWatch() {
                        const mini = document.getElementById('asMiniPlayer');
                        if (mini) mini.classList.remove('active');
                        miniPlayerActive = false;
                        if (miniProgressTimer) { clearInterval(miniProgressTimer); miniProgressTimer = null; }
                        clearMiniPlayerState();

                        // Đưa video element về lại stage chính của rạp chiếu
                        const video = document.getElementById('asVideoEl');
                        const stage = document.getElementById('asVideoStage');
                        const vBox = stage && stage.querySelector('.as-cinema-video-box');
                        if (vBox && video && video.parentElement !== vBox) {
                            vBox.appendChild(video);
                            const overlay = document.getElementById('asSubOverlay');
                            if (overlay) vBox.appendChild(overlay);
                        }
                    }

                    function restoreMiniPlayerIfSaved() {
                        // Nếu đang ở trang xem (/phim-ngan/xem/...) thì tự động ẩn mini player để nhường chỗ rạp chiếu
                        const isWatchPage = window.location.pathname.includes('/xem/');
                        if (isWatchPage) {
                            dismissMiniPlayerForNewWatch();
                            return;
                        }

                        const saved = getSavedMiniPlayerState();
                        if (!saved) return;

                        const mini = document.getElementById('asMiniPlayer');
                        const video = document.getElementById('asVideoEl');
                        const box = document.getElementById('asMiniVideoBox');
                        if (!mini || !video || !box) return;

                        currentActiveDrama = saved.drama;
                        currentActiveEpIdx = Math.max(0, Math.min(saved.epIdx || 0, saved.drama.episodes.length - 1));

                        // Đưa video + overlay vào khung mini player
                        box.insertBefore(video, box.firstChild);
                        const overlay = document.getElementById('asSubOverlay');
                        if (overlay) {
                            overlay.style.left = '0';
                            overlay.style.right = '0';
                            overlay.style.width = '100%';
                            overlay.style.maxWidth = 'none';
                            overlay.style.transform = 'none';
                            overlay.style.bottom = '6px';
                            box.appendChild(overlay);
                        }

                        updateMiniInfo();
                        mini.classList.add('active');
                        miniPlayerActive = true;
                        initMiniPlayerDrag();
                        applySavedMiniPlayerPosition();

                        const ep = currentActiveDrama.episodes[currentActiveEpIdx];
                        if (!ep) return;
                        const epNo = ep.no || (currentActiveEpIdx + 1);
                        let streamUrl = '';
                        if (ep && ep.url && ep.url.startsWith('http')) {
                            streamUrl = ep.url;
                        } else if (ep && ep.streamUrl && ep.streamUrl.startsWith('http') && !ep.streamUrl.includes('allshorts.net/hgdec')) {
                            streamUrl = ep.streamUrl;
                        } else {
                            streamUrl = `/phim-ngan/stream?sid=${encodeURIComponent(currentActiveDrama.id)}&vid=${encodeURIComponent(ep.id)}`;
                        }

                        // Gán lại stream url và khôi phục currentTime
                        if (video._hlsInstance) {
                            try { video._hlsInstance.destroy(); } catch (e) { }
                            video._hlsInstance = null;
                        }
                        if (streamUrl && streamUrl.includes('.m3u8') && typeof Hls !== 'undefined' && Hls.isSupported()) {
                            const hls = new Hls({ enableWorker: true, lowLatencyMode: false });
                            hls.loadSource(streamUrl);
                            hls.attachMedia(video);
                            video._hlsInstance = hls;
                            const targetTime = saved.currentTime || 0;
                            hls.on(Hls.Events.MANIFEST_PARSED, () => {
                                if (targetTime > 0) video.currentTime = targetTime;
                                updateMiniProgress();
                            });
                        } else if (!video.src || !video.src.includes(encodeURIComponent(ep.id))) {
                            video.src = streamUrl;
                            const targetTime = saved.currentTime || 0;
                            const onMeta = () => {
                                if (targetTime > 0) video.currentTime = targetTime;
                                updateMiniProgress();
                                video.removeEventListener('loadedmetadata', onMeta);
                            };
                            video.addEventListener('loadedmetadata', onMeta);
                            video.load();
                        } else if (saved.currentTime > 0) {
                            video.currentTime = saved.currentTime;
                        }

                        // Luôn luôn ở trạng thái tạm dừng khi phục hồi từ storage để không bao giờ tự phát âm thanh ngầm
                        video.pause();

                        syncMiniPlayIcon();

                        if (miniProgressTimer) clearInterval(miniProgressTimer);
                        miniProgressTimer = setInterval(() => {
                            updateMiniProgress();
                            saveMiniPlayerState(true);
                        }, 1000);
                    }

                    function startMiniPlayer() {
                        const mini = document.getElementById('asMiniPlayer');
                        const video = document.getElementById('asVideoEl');
                        const box = document.getElementById('asMiniVideoBox');
                        const modal = document.getElementById('asTheaterModal');
                        if (!mini || !video || !box || !currentActiveDrama) return;

                        // 1. Chuyển video element và overlay phụ đề vào khung nhỏ Mini Player
                        box.insertBefore(video, box.firstChild);
                        const overlay = document.getElementById('asSubOverlay');
                        if (overlay) {
                            overlay.style.left = '0';
                            overlay.style.right = '0';
                            overlay.style.width = '100%';
                            overlay.style.maxWidth = 'none';
                            overlay.style.transform = 'none';
                            overlay.style.bottom = '6px';
                            box.appendChild(overlay);
                        }

                        updateMiniInfo();
                        cleanupTheaterFs();
                        if (typeof closeToolPop === 'function') closeToolPop();
                        if (typeof closeMobileCinemaSheet === 'function') closeMobileCinemaSheet();

                        // 2. Ẩn modal rạp chiếu lớn
                        if (modal) {
                            modal.classList.remove('active', 'mobile-fs', 'cinema-fs');
                            modal.style.setProperty('display', 'none', 'important');
                            modal.style.setProperty('visibility', 'hidden', 'important');
                            modal.style.setProperty('pointer-events', 'none', 'important');
                            modal.style.setProperty('z-index', '-1', 'important');
                        }
                        document.body.classList.remove('as-cinema-open', 'theater-mode-active', 'page-player-mode', 'as-theater-fullscreen-active', 'page-recommend-mode');
                        document.documentElement.classList.remove('as-cinema-open', 'theater-mode-active');
                        document.body.style.overflow = '';
                        document.body.style.height = '';
                        document.body.style.touchAction = '';
                        document.body.style.position = '';
                        document.documentElement.style.overflow = '';
                        document.documentElement.style.height = '';

                        // 3. Đảm bảo dừng và tắt âm thanh triệt để mọi video nền (Reels, Đề xuất)
                        const recVideo = document.getElementById('asRecVideoElement');
                        if (recVideo) { try { recVideo.pause(); recVideo.muted = true; } catch (e) { } }
                        const reelsVideo = document.getElementById('asReelsVideo');
                        if (reelsVideo) { try { reelsVideo.pause(); reelsVideo.muted = true; } catch (e) { } }
                        if (typeof recSubPoller !== 'undefined' && recSubPoller) { try { clearInterval(recSubPoller); } catch (e) { } recSubPoller = null; }
                        if (typeof window._asReelsAutoplayCleanup === 'function') { try { window._asReelsAutoplayCleanup(); } catch (e) { } window._asReelsAutoplayCleanup = null; }

                        // 4. Kích hoạt Mini Player UI
                        mini.classList.add('active');
                        miniPlayerActive = true;
                        initMiniPlayerDrag();
                        applySavedMiniPlayerPosition();

                        // 5. Hiển thị view phù hợp bên dưới mà KHÔNG dừng mini player và cập nhật URL
                        try {
                            if (cinemaOriginView === 'search' || (cinemaOriginPath && cinemaOriginPath.includes('/tim-kiem'))) {
                                showPhimNganView('search');
                                window.history.replaceState({ view: 'search' }, '', cinemaOriginPath || '/phim-ngan/tim-kiem');
                            } else if (cinemaOriginView === 'library' || (cinemaOriginPath && cinemaOriginPath.includes('/thu-vien'))) {
                                showPhimNganView('library');
                                window.history.replaceState({ view: 'library' }, '', cinemaOriginPath || '/phim-ngan/thu-vien');
                            } else if (cinemaOriginView === 'home' && (!cinemaOriginPath || cinemaOriginPath === '/phim-ngan')) {
                                showPhimNganView('home');
                                window.history.replaceState({ view: 'home' }, '', '/phim-ngan');
                            } else if (currentActiveDrama && currentActiveDrama.id) {
                                switchToDetailView(currentActiveDrama.id, { keepMini: true });
                                currentDetailDrama = currentActiveDrama;
                                if (typeof renderDramaDetailView === 'function') {
                                    renderDramaDetailView(currentActiveDrama, currentActiveEpIdx + 1);
                                }
                                window.history.replaceState({ view: 'detail', dramaId: currentActiveDrama.id }, '', `/phim-ngan/thong-tin/${currentActiveDrama.id}`);
                            } else {
                                showPhimNganView('home');
                                window.history.replaceState({ view: 'home' }, '', '/phim-ngan');
                            }
                        } catch (e) { }

                        // 6. Lưu trạng thái mini player vào storage
                        saveMiniPlayerState(true);

                        if (miniProgressTimer) clearInterval(miniProgressTimer);
                        miniProgressTimer = setInterval(() => {
                            updateMiniProgress();
                            saveMiniPlayerState(true);
                        }, 1000);
                        updateMiniProgress();
                        syncMiniPlayIcon();
                    }

                    function expandMiniPlayer() {
                        if (miniPlayerDraggedJustNow) return;
                        const mini = document.getElementById('asMiniPlayer');
                        const video = document.getElementById('asVideoEl');
                        const stage = document.getElementById('asVideoStage');
                        const modal = document.getElementById('asTheaterModal');
                        if (!currentActiveDrama) {
                            const saved = getSavedMiniPlayerState();
                            if (saved && saved.drama) {
                                currentActiveDrama = saved.drama;
                                currentActiveEpIdx = saved.epIdx || 0;
                            }
                        }
                        if (!video || !stage || !modal || !currentActiveDrama) return;

                        // Đưa video + phụ đề về khung chiếu lớn (không nạp lại, phát liên tục)
                        const vBox = stage.querySelector('.as-cinema-video-box');
                        if (vBox) {
                            vBox.appendChild(video);
                            const overlay = document.getElementById('asSubOverlay');
                            if (overlay) vBox.appendChild(overlay);
                        }
                        if (mini) mini.classList.remove('active');
                        if (modal) {
                            modal.classList.add('active');
                            modal.classList.remove('sidebar-hidden');
                            modal.style.removeProperty('display');
                            modal.style.removeProperty('visibility');
                            modal.style.removeProperty('pointer-events');
                            modal.style.removeProperty('z-index');
                            modal.style.setProperty('display', 'flex', 'important');
                            modal.style.setProperty('visibility', 'visible', 'important');
                            modal.style.setProperty('pointer-events', 'auto', 'important');
                            modal.style.setProperty('z-index', '100000', 'important');
                        }
                        hideAllPhimNganViews();
                        document.body.classList.add('as-cinema-open', 'theater-mode-active', 'page-player-mode');
                        document.body.classList.remove('page-detail-mode', 'page-recommend-mode');
                        document.body.style.overflow = 'hidden';
                        miniPlayerActive = false;
                        if (miniProgressTimer) { clearInterval(miniProgressTimer); miniProgressTimer = null; }
                        applyCcStyle();

                        // Khôi phục Ambient Background & Sidebar
                        const ambientBg = document.getElementById('asAmbientBg');
                        if (ambientBg && currentActiveDrama.cover) {
                            ambientBg.style.backgroundImage = `url('${currentActiveDrama.cover}')`;
                        }
                        const sidebarTitle = document.getElementById('asSidebarTitle');
                        const sidebarDesc = document.getElementById('asSidebarDesc');
                        if (sidebarTitle) sidebarTitle.textContent = currentActiveDrama.title;
                        if (sidebarDesc) sidebarDesc.textContent = currentActiveDrama.intro || '';
                        const counterEl = document.getElementById('asSidebarEpCounter');
                        const eps = currentActiveDrama.episodes || [];
                        const ep = eps[currentActiveEpIdx];
                        const epNo = ep ? (ep.no || currentActiveEpIdx + 1) : currentActiveEpIdx + 1;
                        if (counterEl) counterEl.textContent = `Tập ${epNo} / ${eps.length || 1}`;

                        // Đảm bảo video tiếp tục phát mượt mà
                        try {
                            if (video.paused) {
                                const p = video.play();
                                if (p && typeof p.catch === 'function') p.catch(() => {});
                            }
                        } catch (e) { }

                        // Khôi phục URL xem khi mở rộng lại mini player
                        try {
                            window.history.pushState({ view: 'player', dramaId: currentActiveDrama.id, ep: epNo }, '', `/phim-ngan/xem/${currentActiveDrama.id}?ep=${epNo}`);
                        } catch (e) { }
                    }

                    let _isClosingMiniPlayer = false;
                    function closeMiniPlayer(options = {}) {
                        if (_isClosingMiniPlayer) return;
                        _isClosingMiniPlayer = true;
                        try {
                        const mini = document.getElementById('asMiniPlayer');
                        const video = document.getElementById('asVideoEl');
                        const stage = document.getElementById('asVideoStage');
                        const modal = document.getElementById('asTheaterModal');

                        // 0. Dọn dẹp triệt để timer polling phụ đề và badge
                        if (readyBadgeInterval) {
                            clearInterval(readyBadgeInterval);
                            readyBadgeInterval = null;
                        }
                        if (activeSubPoller) {
                            clearInterval(activeSubPoller);
                            activeSubPoller = null;
                        }
                        if (typeof window._asAutoplayCleanup === 'function') {
                            try { window._asAutoplayCleanup(); } catch (e) { }
                            window._asAutoplayCleanup = null;
                        }

                        // 1. Dừng triệt để video chính, gỡ sạch listener để KHÔNG kích hoạt cứu cánh tự phát ngầm
                        if (video) {
                            video.onerror = null;
                            video.onplaying = null;
                            video.ontimeupdate = null;
                            video.onended = null;
                            video.onpause = null;
                            if (video._rescueTimer) {
                                clearTimeout(video._rescueTimer);
                                video._rescueTimer = null;
                            }
                            if (video._spinnerSafety) {
                                clearTimeout(video._spinnerSafety);
                                video._spinnerSafety = null;
                            }
                            if (video._spinnerGuard) {
                                clearInterval(video._spinnerGuard);
                                video._spinnerGuard = null;
                            }
                            try { video.pause(); video.muted = true; } catch (e) { }
                            if (video._hlsInstance) {
                                try {
                                    video._hlsInstance.stopLoad();
                                    video._hlsInstance.detachMedia();
                                    video._hlsInstance.destroy();
                                } catch (e) { }
                                video._hlsInstance = null;
                            }
                            try {
                                video.removeAttribute('src');
                                video.src = '';
                                video.load();
                            } catch (e) { }
                        }

                        // 2. Dừng tất cả các video trên trang để tránh âm thanh phát ngầm
                        document.querySelectorAll('video').forEach(v => {
                            try {
                                v.pause();
                                v.muted = true;
                                if (v._hlsInstance && v !== video) {
                                    try {
                                        v._hlsInstance.stopLoad();
                                        v._hlsInstance.detachMedia();
                                        v._hlsInstance.destroy();
                                    } catch (e) { }
                                    v._hlsInstance = null;
                                }
                            } catch (e) { }
                        });

                        // 3. Đưa video element và phụ đề về lại stage chính của rạp chiếu
                        const vBox = stage && stage.querySelector('.as-cinema-video-box');
                        if (vBox && video) vBox.appendChild(video);
                        const overlay = document.getElementById('asSubOverlay');
                        if (vBox && overlay) vBox.appendChild(overlay);
                        const subOverlay = document.getElementById('asSubOverlay');
                        if (subOverlay) subOverlay.textContent = '';
                        currentCues = [];
                        cleanupTheaterFs();
                        if (mini) mini.classList.remove('active');
                        if (modal) {
                            modal.classList.remove('active', 'mobile-fs', 'cinema-fs');
                            modal.style.removeProperty('display');
                            modal.style.setProperty('display', 'none', 'important');
                            modal.style.pointerEvents = 'none';
                        }
                        document.body.style.overflow = '';
                        miniPlayerActive = false;
                        if (miniProgressTimer) { clearInterval(miniProgressTimer); miniProgressTimer = null; }

                        // 4. Cập nhật lại URL nếu trình duyệt đang ở dạng /xem/... và khôi phục view hiển thị chuẩn xác
                        try {
                            if (window.location.pathname.includes('/xem/')) {
                                if (currentActiveDrama && currentActiveDrama.id) {
                                    window.history.replaceState({ view: 'detail', dramaId: currentActiveDrama.id }, '', `/phim-ngan/thong-tin/${currentActiveDrama.id}`);
                                    switchToDetailView(currentActiveDrama.id, { isPopState: true });
                                    if (typeof renderDramaDetailView === 'function') {
                                        renderDramaDetailView(currentActiveDrama, currentActiveEpIdx + 1);
                                    }
                                } else {
                                    window.history.replaceState({ view: 'home' }, '', '/phim-ngan');
                                    if (!_isShowingPhimNganView) showPhimNganView('home');
                                }
                            } else if (options && options.restoreView === true) {
                                if (!_isShowingPhimNganView) {
                                    restorePhimNganView();
                                }
                            }
                        } catch (e) { }

                        // Xóa state khỏi storage khi user chủ động đóng
                        clearMiniPlayerState();
                    } finally {
                        _isClosingMiniPlayer = false;
                    }
                }

                    function updateMiniInfo() {
                        const titleEl = document.getElementById('asMiniTitle');
                        const subEl = document.getElementById('asMiniSub');
                        if (!currentActiveDrama) return;
                        if (titleEl) titleEl.textContent = currentActiveDrama.title || 'Đang phát';
                        const eps = currentActiveDrama.episodes || [];
                        const ep = eps[currentActiveEpIdx];
                        const epNo = ep ? (ep.no || currentActiveEpIdx + 1) : currentActiveEpIdx + 1;
                        if (subEl) subEl.textContent = `Tập ${epNo} / ${eps.length || 1}`;
                    }

                    function updateMiniProgress() {
                        const video = document.getElementById('asVideoEl');
                        const fill = document.getElementById('asMiniBarFill');
                        if (!video) return;
                        const pct = video.duration ? (video.currentTime / video.duration) * 100 : 0;
                        if (fill) fill.style.width = pct + '%';
                    }

                    function seekMiniBar(e) {
                        if (e && e.stopPropagation) e.stopPropagation();
                        const bar = document.getElementById('asMiniBar');
                        const video = document.getElementById('asVideoEl');
                        if (!bar || !video || !video.duration) return;
                        const rect = bar.getBoundingClientRect();
                        const clickX = e.clientX - rect.left;
                        const pct = Math.max(0, Math.min(1, clickX / rect.width));
                        video.currentTime = pct * video.duration;
                        updateMiniProgress();
                        saveMiniPlayerState(true);
                    }

                    function miniSeek(delta) {
                        const video = document.getElementById('asVideoEl');
                        if (!video || !video.duration) return;
                        video.currentTime = Math.max(0, Math.min(video.duration, video.currentTime + delta));
                        updateMiniProgress();
                        saveMiniPlayerState(true);
                    }

                    function toggleMiniPlay() {
                        const video = document.getElementById('asVideoEl');
                        if (!video) return;
                        if (video.paused) {
                            video.play().catch(() => { });
                        } else {
                            video.pause();
                        }
                        syncMiniPlayIcon();
                        saveMiniPlayerState(true);
                    }

                    function syncMiniPlayIcon() {
                        const video = document.getElementById('asVideoEl');
                        const btn = document.getElementById('asMiniPlayBtn');
                        if (!video || !btn) return;
                        if (video.paused) {
                            btn.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="7 4 20 12 7 20 7 4"/></svg>`;
                            btn.title = 'Phát';
                        } else {
                            btn.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>`;
                            btn.title = 'Tạm dừng';
                        }
                    }

                    // =======================================================
                    // 🌫 AMBIENT: lấy chính frame video đang phát làm mờ 2 bên
                    // =======================================================
                    // Nền ambient 2 bên khung chiếu: CHỈ dùng ảnh bìa phim làm sáng/mờ.
                    // (Theo yêu cầu: nền sau khung chiếu chỉ là ảnh phim, không chụp frame video đang chạy)
                    let ambientCaptureTimer = null;

                    function captureAmbientFrame() {
                        // Đã tắt: giữ nguyên ảnh bìa (drama.cover) đang hiển thị làm nền
                        return;
                    }

                    function startAmbientCapture() {
                        // Đã tắt: không chạy chu kỳ chụp frame video
                    }

                    function stopAmbientCapture() {
                        if (ambientCaptureTimer) {
                            clearInterval(ambientCaptureTimer);
                            ambientCaptureTimer = null;
                        }
                    }

                    // =======================================================
                    // 🧰 POPOVER BỘ CÔNG CỤ
                    // =======================================================
                    const TOOL_POP_ANCHOR = {
                        asPopPlaylist: 'asSaveBtn',
                        asPopCc: 'asCcBtn',
                        asPopDub: 'asDubBtn',
                        asPopShare: 'asShareBtn',
                        asPopVolume: 'asVolumeBtn',
                        asPopSettings: 'asSettingsBtn'
                    };

                    const DEFAULT_POP_WIDTH = {
                        asPopVolume: 320,
                        asPopCc: 420,
                        asPopDub: 420,
                        asPopShare: 360,
                        asPopSettings: 340,
                        asPopPlaylist: 420
                    };

                    function hoistToolPops() {
                        const modal = document.getElementById('asTheaterModal');
                        if (!modal) return;
                        document.querySelectorAll('.as-tool-pop, .as-tool-toast').forEach(el => {
                            if (el.parentElement !== modal) modal.appendChild(el);
                            if (!el._eventsHooked) {
                                el._eventsHooked = true;
                                // ⚡ Ngăn mọi click, chạm, kéo bên trong popover bị nổi bọt ra ngoài, đảm bảo trượt/chạm không bị đóng nhầm
                                ['click', 'mousedown', 'pointerdown', 'touchstart'].forEach(evt => {
                                    el.addEventListener(evt, (e) => e.stopPropagation());
                                });
                            }
                        });
                    }
                    document.addEventListener('DOMContentLoaded', hoistToolPops);

                    let lastToolPopTrigger = null;

                    function openToolPop(id, event) {
                        if (event && typeof event.stopPropagation === 'function') {
                            event.stopPropagation();
                        }
                        if (event) {
                            lastToolPopTrigger = event.currentTarget || (event.target && event.target.closest ? event.target.closest('button, .as-top-icon-btn, .as-mobile-action-btn, [data-pop-anchor]') : null);
                        } else {
                            lastToolPopTrigger = null;
                        }
                        const el = document.getElementById(id);
                        if (!el) return;
                        const wasOpen = el.classList.contains('open');
                        closeToolPop();
                        if (wasOpen) return;

                        // ⚡ Định vị trước khi mở để triệt tiêu độ trễ và không giật vị trí
                        anchorToolPop(el, id, lastToolPopTrigger);
                        el.classList.add('open');
                        anchorToolPop(el, id, lastToolPopTrigger);

                        if (id === 'asPopCc') {
                            syncCcSwitches();
                            syncCcControls();
                            applyCcStyle();
                        }
                        if (id === 'asPopDub') syncDubSwitches();
                        if (id === 'asPopVolume') syncVolumeSlider();
                    }

                    function closeToolPop() {
                        document.querySelectorAll('.as-tool-pop.open').forEach(p => p.classList.remove('open'));
                    }

                    function anchorToolPop(el, id, triggerBtn = null) {
                        if (!el) return;
                        const isMobile = window.innerWidth <= 1023;

                        // 🟢 XỬ LÝ ĐẶC BIỆT CHO MOBILE (/phim-ngan/xem): Dock sát đáy, tràn đầy 2 bên 100vw
                        if (isMobile) {
                            el.style.left = '0px';
                            el.style.right = '0px';
                            el.style.top = 'auto';
                            el.style.bottom = '0px';
                            el.style.width = '100vw';
                            el.style.maxWidth = '100vw';
                            el.style.minWidth = '100vw';
                            el.style.margin = '0';
                            el.style.transform = 'none';
                            return;
                        }

                        // Giới hạn trong PHẠM VI KHUNG CHIẾU (stage), không tràn ra sidebar
                        const stage = document.getElementById('asVideoStage');
                        const stageRect = (stage && typeof stage.getBoundingClientRect === 'function')
                            ? stage.getBoundingClientRect()
                            : { left: 0, top: 0, right: window.innerWidth || 0, bottom: window.innerHeight || 0, width: window.innerWidth || 0, height: window.innerHeight || 0 };
                        const pad = 12;

                        // Không cho menu rộng hơn khung chiếu
                        const maxPopW = Math.max(240, stageRect.width - pad * 2);
                        el.style.maxWidth = maxPopW + 'px';

                        // ---- Modal "Thêm vào danh sách phát": căn giữa TRONG khung chiếu ----
                        if (el.classList.contains('as-pop-modal')) {
                            const w = el.offsetWidth || DEFAULT_POP_WIDTH[id] || 420;
                            const h = el.offsetHeight || 240;
                            el.style.transform = 'none';
                            el.style.animation = 'none';
                            el.style.left = Math.round(Math.max(stageRect.left + pad, stageRect.left + (stageRect.width - w) / 2)) + 'px';
                            el.style.top = Math.round(Math.max(stageRect.top + pad, stageRect.top + (stageRect.height - h) / 2)) + 'px';
                            el.style.maxHeight = Math.max(180, stageRect.height - pad * 2) + 'px';
                            return;
                        }

                        // Tìm nút kích hoạt chính xác
                        let btn = triggerBtn || lastToolPopTrigger;
                        if (!btn || !btn.getBoundingClientRect) {
                            const mobMap = {
                                asPopPlaylist: 'asMobileSaveBtn',
                                asPopShare: 'asMobileShareBtn',
                                asPopSettings: 'asMobileSettingsBtn'
                            };
                            if (isMobile && mobMap[id]) {
                                btn = document.getElementById(mobMap[id]);
                            }
                            if (!btn) {
                                const btnId = TOOL_POP_ANCHOR[id];
                                btn = btnId ? document.getElementById(btnId) : null;
                            }
                        }
                        if (!btn || typeof btn.getBoundingClientRect !== 'function') return;

                        const r = btn.getBoundingClientRect();
                        const popW = Math.min(el.offsetWidth || DEFAULT_POP_WIDTH[id] || 320, maxPopW);
                        const popH = el.offsetHeight || 280;

                        // Desktop / Căn thông thường:
                        el.style.right = 'auto';
                        el.style.bottom = 'auto';
                        const gap = 12;
                        let left = r.left + (r.width / 2) - (popW / 2);
                        const minLeft = stageRect.left + pad;
                        const maxLeft = Math.max(minLeft, stageRect.right - popW - pad);
                        if (left > maxLeft) left = maxLeft;
                        if (left < minLeft) left = minLeft;

                        const top = r.bottom + gap;
                        el.style.left = Math.round(left) + 'px';
                        el.style.top = Math.round(top) + 'px';
                        const stageBottom = Math.min(window.innerHeight || 0, stageRect.bottom);
                        const maxH = Math.max(180, stageBottom - top - pad);
                        el.style.maxHeight = maxH + 'px';
                    }

                    window.addEventListener('resize', () => {
                        const open = document.querySelector('.as-tool-pop.open');
                        if (open) anchorToolPop(open, open.id);
                    });

                    function showToolToast(message) {
                        if (!message) return;
                        let toast = document.getElementById('asFavToast');
                        if (!toast) {
                            toast = document.createElement('div');
                            toast.className = 'as-tool-toast';
                            toast.id = 'asFavToast';
                            document.body.appendChild(toast);
                        } else if (toast.parentElement !== document.body) {
                            document.body.appendChild(toast);
                        }
                        toast.textContent = message;
                        toast.style.display = 'block';
                        clearTimeout(toast._timer);
                        toast._timer = setTimeout(() => { toast.style.display = 'none'; }, 2600);
                    }

                    // Đóng popover khi bấm ra ngoài / nhấn Escape
                    document.addEventListener('click', (e) => {
                        const pop = e.target.closest ? e.target.closest('.as-tool-pop') : null;
                        const btn = e.target.closest ? e.target.closest('.as-top-icon-btn, .as-btn-cinema-back') : null;
                        if (!pop && !btn) closeToolPop();
                    });
                    document.addEventListener('keydown', (e) => {
                        if (e.key === 'Escape') closeToolPop();

                        const modal = document.getElementById('asTheaterModal');
                        const isCinemaOpen = modal && (modal.classList.contains('active') || modal.style.display !== 'none');
                        if (!isCinemaOpen) return;

                        // Bỏ qua nếu đang gõ chữ vào input / textarea
                        const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
                        if (e.target.matches('input, textarea') || activeTag === 'input' || activeTag === 'textarea') {
                            return;
                        }

                        // 💻 PHÍM MŨI TÊN TRÊN DESKTOP: QUA PHẢI +5s, QUA TRÁI -5s
                        if (e.key === 'ArrowRight') {
                            e.preventDefault();
                            skipCinemaTime(5);
                            if (typeof showSeekRipple === 'function') showSeekRipple('right', '+5s');
                        } else if (e.key === 'ArrowLeft') {
                            e.preventDefault();
                            skipCinemaTime(-5);
                            if (typeof showSeekRipple === 'function') showSeekRipple('left', '-5s');
                        } else if (e.key === ' ' || e.code === 'Space' || e.key === 'k' || e.key === 'K') {
                            e.preventDefault();
                            toggleCinemaPlay();
                        } else if (e.key === 'f' || e.key === 'F') {
                            e.preventDefault();
                            toggleCinemaFullscreen();
                        } else if (e.key === 'ArrowUp') {
                            e.preventDefault();
                            const v = document.getElementById('asVideoEl');
                            if (v) {
                                v.volume = Math.min(1, Math.round((v.volume + 0.1) * 10) / 10);
                                v.muted = false;
                                if (typeof updateVolumeIcon === 'function') updateVolumeIcon();
                                if (typeof syncVolumeSlider === 'function') syncVolumeSlider();
                            }
                        } else if (e.key === 'ArrowDown') {
                            e.preventDefault();
                            const v = document.getElementById('asVideoEl');
                            if (v) {
                                v.volume = Math.max(0, Math.round((v.volume - 0.1) * 10) / 10);
                                if (v.volume === 0) v.muted = true;
                                if (typeof updateVolumeIcon === 'function') updateVolumeIcon();
                                if (typeof syncVolumeSlider === 'function') syncVolumeSlider();
                            }
                        } else if (e.key === 'm' || e.key === 'M') {
                            e.preventDefault();
                            const v = document.getElementById('asVideoEl');
                            if (v) {
                                v.muted = !v.muted;
                                if (typeof updateVolumeIcon === 'function') updateVolumeIcon();
                            }
                        }
                    });

                    function toggleCinemaFavFromMenu(btn) {
                        toggleCinemaFav();
                    }

                    function toggleCinemaFav(evt) {
                        if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
                        const drama = currentActiveDrama || (typeof currentDetailDrama !== 'undefined' ? currentDetailDrama : null);
                        if (drama && typeof toggleDramaFavorite === 'function') {
                            const btn = document.getElementById('asFavBtn');
                            toggleDramaFavorite(drama, btn);
                            const favs = typeof getDramaFavorites === 'function' ? getDramaFavorites() : [];
                            const isFav = favs.some(f => f && String(f.id) === String(drama.id));

                            const mobBtn = document.getElementById('asMobileFavBtn');
                            if (mobBtn) {
                                mobBtn.classList.toggle('active', isFav);
                                const mobSvg = mobBtn.querySelector('svg');
                                if (mobSvg) {
                                    mobSvg.setAttribute('fill', isFav ? '#ef4444' : 'none');
                                    mobSvg.setAttribute('stroke', isFav ? '#ef4444' : 'currentColor');
                                }
                                const mobLabel = document.getElementById('asMobileFavLabel');
                                if (mobLabel) mobLabel.textContent = isFav ? 'Đã thích' : 'Thích';
                            }
                            const menuLabel = document.getElementById('asMenuFavLabel');
                            if (menuLabel) menuLabel.textContent = isFav ? 'Bỏ thích phim này' : 'Thích phim này';

                            // Đồng bộ lại nút trên trang chi tiết nếu có
                            const detailFavBtn = document.getElementById('asDetailFavBtn');
                            if (detailFavBtn) {
                                detailFavBtn.classList.toggle('active', isFav);
                                const dSvg = detailFavBtn.querySelector('svg');
                                if (dSvg) {
                                    dSvg.setAttribute('fill', isFav ? '#ef4444' : 'none');
                                    dSvg.setAttribute('stroke', isFav ? '#ef4444' : 'currentColor');
                                }
                            }
                            return;
                        }
                    }

                    function toggleCinemaSavePlaylist(evt) {
                        if (evt && typeof evt.stopPropagation === 'function') evt.stopPropagation();
                        if (typeof closeToolPop === 'function') closeToolPop();

                        let drama = currentActiveDrama || (typeof currentDetailDrama !== 'undefined' ? currentDetailDrama : null);
                        if (!drama || !drama.id) {
                            if (typeof getActiveDetailDrama === 'function') {
                                drama = getActiveDetailDrama();
                            }
                        }

                        if (!drama || !drama.id) {
                            showToolToast('Không thể xác định thông tin phim');
                            return;
                        }

                        const epCount = drama.totalEpisodes || (drama.episodes ? drama.episodes.length : null);
                        const movieObj = {
                            slug: String(drama.id),
                            id: String(drama.id),
                            name: drama.title || 'Phim ngắn',
                            title: drama.title || 'Phim ngắn',
                            thumb_url: drama.cover || '',
                            poster: drama.cover || '',
                            cover: drama.cover || '',
                            year: epCount ? `${epCount} Tập` : 'Phim ngắn',
                            isDrama: true
                        };

                        if (typeof window.openPlaylistModal === 'function') {
                            window.openPlaylistModal(movieObj);
                            return;
                        }

                        if (typeof window.openCreatePlaylistModalStandalone === 'function') {
                            window.openCreatePlaylistModalStandalone();
                            return;
                        }

                        showToolToast('Đang mở danh sách phát...');
                    }

                    function createNewPlaylist() {
                        toggleCinemaSavePlaylist();
                    }

                    function shareTo(platform) {
                        const url = window.location.href;
                        const title = (currentActiveDrama && currentActiveDrama.title) || 'APhim';
                        const map = {
                            facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
                            twitter: `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
                            telegram: `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`
                        };
                        const target = map[platform];
                        if (target) {
                            window.open(target, '_blank', 'noopener');
                        } else {
                            copyDramaLink();
                        }
                    }

                    function copyDramaLink() {
                        const url = window.location.href;
                        const done = () => showToolToast('Đã sao chép liên kết phim');
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(url).then(done).catch(() => fallbackCopy(url, done));
                        } else {
                            fallbackCopy(url, done);
                        }
                    }

                    function fallbackCopy(text, done) {
                        try {
                            const ta = document.createElement('textarea');
                            ta.value = text;
                            ta.style.position = 'fixed';
                            ta.style.opacity = '0';
                            document.body.appendChild(ta);
                            ta.select();
                            document.execCommand('copy');
                            document.body.removeChild(ta);
                            done();
                        } catch (e) {
                            showToolToast('Không sao chép được, hãy copy thủ công');
                        }
                    }

                    function reportCurrentDrama() {
                        closeToolPop();
                        showToolToast('Đã gửi báo cáo lỗi cho bộ phận quản trị');
                    }

                    function downloadCurrentEpisode() {
                        closeToolPop();
                        const video = document.getElementById('asVideoEl');
                        if (video && video.src) {
                            window.open(video.src, '_blank', 'noopener');
                        } else {
                            showToolToast('Chưa có tập nào để tải');
                        }
                    }

                    function retranslateCurrentEpisode() {
                        const notice = document.getElementById('asSubNotice');
                        const noticeText = document.getElementById('asSubNoticeText');
                        const spinner = document.getElementById('asVideoSpinner');
                        if (spinner) spinner.classList.add('active');
                        if (noticeText) noticeText.textContent = '✨ Đang dịch lại phụ đề Tiếng Việt...';
                        if (notice) notice.classList.add('show');
                        if (typeof playEpisodeByIndex === 'function' && typeof currentActiveEpIdx === 'number') {
                            playEpisodeByIndex(currentActiveEpIdx);
                        }
                        setTimeout(() => {
                            if (spinner) spinner.classList.remove('active');
                            if (noticeText) noticeText.textContent = '✨ Phụ đề Tiếng Việt đã sẵn sàng!';
                            setTimeout(() => { if (notice) notice.classList.remove('show'); }, 1500);
                        }, 1500);
                    }

                    // ---- Âm lượng ----
                    function updateVolumeIcon() {
                        const videoEl = document.getElementById('asVideoEl');
                        const btn = document.getElementById('asVolumeBtn');
                        if (!btn) return;
                        if (videoEl && videoEl.muted) {
                            btn.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="1" y1="1" x2="23" y2="23"/><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/></svg>`;
                            btn.title = 'Bật âm lượng';
                        } else {
                            btn.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>`;
                            btn.title = 'Tắt âm thanh';
                        }
                    }

                    function toggleCinemaMute() {
                        const videoEl = document.getElementById('asVideoEl');
                        if (!videoEl) return;
                        videoEl.muted = !videoEl.muted;
                        updateVolumeIcon();
                        syncVolumeSlider();
                        saveAsSettings();
                    }

                    function syncVolumeSlider() {
                        const video = document.getElementById('asVideoEl');
                        const slider = document.getElementById('asVolSlider');
                        const val = document.getElementById('asVolVal');
                        const v = video ? Math.round(video.volume * 100) : 100;
                        if (slider) slider.value = v;
                        if (val) val.textContent = v + '%';
                        updateVolumeIcon();
                    }

                    function onVolumeSliderChange(el) {
                        const v = parseInt(el.value, 10);
                        const video = document.getElementById('asVideoEl');
                        const val = document.getElementById('asVolVal');
                        if (val) val.textContent = v + '%';
                        if (video) {
                            video.volume = v / 100;
                            video.muted = (v === 0);
                        }
                        updateVolumeIcon();
                        saveAsSettings();
                    }

                    // ---- Tốc độ phát ----
                    function pickSpeed(btn) {
                        document.querySelectorAll('#asSpeedSeg .as-tool-seg-btn').forEach(b => b.classList.remove('on'));
                        btn.classList.add('on');
                        const speed = parseFloat(btn.dataset.speed);
                        const video = document.getElementById('asVideoEl');
                        if (video) video.playbackRate = speed;
                        const speedBtn = document.getElementById('asSpeedBtn');
                        if (speedBtn) speedBtn.textContent = `${speed}x`;
                        cinemaCurrentSpeedIdx = Math.max(0, PLAYBACK_SPEEDS.indexOf(speed));
                        saveAsSettings();
                    }

                    // ---- Cấu hình phụ đề ----
                    var ccCfg = {
                        size: 18, color: '#ffffff',
                        outline: 2, outlineColor: '#000000',
                        bg: '0,0,0', bgOpacity: 0, marginX: 15, marginY: 3,
                        pushBottom: 10
                    };

                    function applyCcStyle() {
                        const overlay = document.getElementById('asSubOverlay');
                        const preview = document.getElementById('asCcPreview');
                        const isMini = miniPlayerActive;
                        const alpha = (typeof ccCfg.bgOpacity === 'number' ? ccCfg.bgOpacity : 0) / 100;
                        const bg = alpha > 0 ? `rgba(${ccCfg.bg},${alpha})` : 'transparent';
                        const color = ccCfg.color || '#ffffff';
                        const outlineW = typeof ccCfg.outline === 'number' ? ccCfg.outline : 2;
                        const outlineColor = ccCfg.outlineColor || '#000000';
                        const fontSize = typeof ccCfg.size === 'number' ? ccCfg.size : 18;

                        [overlay, preview].forEach(el => {
                            if (!el) return;
                            const sizePx = (isMini && el === overlay ? Math.max(8, Math.round(fontSize * 0.55)) : fontSize) + 'px';
                            el.style.setProperty('font-size', sizePx, 'important');
                            el.style.setProperty('color', color, 'important');
                            el.style.setProperty('background', bg, 'important');

                            if (outlineW <= 0) {
                                el.style.webkitTextStroke = '0px transparent';
                                el.style.textShadow = 'none';
                            } else {
                                el.style.webkitTextStroke = `${outlineW}px ${outlineColor}`;
                                el.style.paintOrder = 'stroke fill';
                                if (outlineW === 1) {
                                    el.style.textShadow = `0 1px 2px ${outlineColor}, 0 -1px 2px ${outlineColor}, 1px 0 2px ${outlineColor}, -1px 0 2px ${outlineColor}`;
                                } else if (outlineW === 2) {
                                    el.style.textShadow = `0 1px 3px ${outlineColor}, 0 -1px 3px ${outlineColor}, 1px 0 3px ${outlineColor}, -1px 0 3px ${outlineColor}, 0 2px 5px rgba(0,0,0,0.85)`;
                                } else {
                                    el.style.textShadow = `0 2px 4px ${outlineColor}, 0 -2px 4px ${outlineColor}, 2px 0 4px ${outlineColor}, -2px 0 4px ${outlineColor}, 0 3px 8px rgba(0,0,0,0.95)`;
                                }
                            }

                            if (el === overlay) {
                                if (isMini) {
                                    el.style.left = '0';
                                    el.style.right = '0';
                                    el.style.width = '100%';
                                    el.style.maxWidth = 'none';
                                    el.style.transform = 'none';
                                    el.style.bottom = '6px';
                                } else {
                                    el.style.setProperty('left', ccCfg.marginX + '%', 'important');
                                    el.style.setProperty('right', ccCfg.marginX + '%', 'important');
                                    el.style.setProperty('width', 'auto', 'important');
                                    el.style.setProperty('max-width', 'none', 'important');
                                    el.style.setProperty('transform', 'none', 'important');
                                    el.style.setProperty('bottom', `calc(${ccCfg.pushBottom}% + ${ccCfg.marginY}%)`, 'important');
                                }
                            }
                        });
                    }

                    function syncCcControls() {
                        const setInput = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
                        const setText = (id, t) => { const el = document.getElementById(id); if (el) el.textContent = t; };
                        setInput('asCcSize', ccCfg.size);
                        setText('asCcSizeVal', ccCfg.size + 'px');
                        setInput('asCcBgOpacity', ccCfg.bgOpacity);
                        setText('asCcBgOpacityVal', ccCfg.bgOpacity + '%');
                        setInput('asCcMarginX', ccCfg.marginX);
                        setText('asCcMarginXVal', (ccCfg.marginX / 10).toFixed(1) + '%');
                        setInput('asCcMarginY', ccCfg.marginY);
                        setText('asCcMarginYVal', (ccCfg.marginY / 10).toFixed(1) + '%');
                        setInput('asCcPush', ccCfg.pushBottom);
                        setText('asCcPushVal', ccCfg.pushBottom + '%');
                        const pickSwatch = (containerId, target) => {
                            document.querySelectorAll(containerId + ' .as-tool-swatch').forEach(b => {
                                b.classList.toggle('on', b.dataset.color === target);
                            });
                        };
                        pickSwatch('#asCcColors', ccCfg.color);
                        pickSwatch('#asCcOutlineColors', ccCfg.outlineColor);
                        pickSwatch('#asCcBgColors', ccCfg.bg);
                        document.querySelectorAll('#asCcOutline .as-tool-seg-btn').forEach(b => {
                            b.classList.toggle('on', parseInt(b.dataset.w, 10) === ccCfg.outline);
                        });
                    }

                    function syncCcSwitches() {
                        document.querySelectorAll('#asCcSwitch, #asSetCcSwitch').forEach(s => s.classList.toggle('on', subtitlesEnabled));
                    }

                    function setCcEnabled(on) {
                        subtitlesEnabled = on;
                        document.querySelectorAll('#asCcSwitch, #asSetCcSwitch').forEach(s => s.classList.toggle('on', on));
                        const ccBtn = document.getElementById('asCcBtn');
                        if (ccBtn) ccBtn.classList.toggle('active', on);
                        const bCc = document.getElementById('asBottomCcBtn');
                        if (bCc) bCc.classList.toggle('active', !!on);
                        const subOverlay = document.getElementById('asSubOverlay');
                        if (!on && subOverlay) subOverlay.textContent = '';
                        saveAsSettings();
                    }

                    function toggleCcEnabled(btn) {
                        setCcEnabled(!subtitlesEnabled);
                    }

                    function onCcSizeChange(el) {
                        ccCfg.size = parseInt(el.value, 10);
                        const val = document.getElementById('asCcSizeVal');
                        if (val) val.textContent = ccCfg.size + 'px';
                        applyCcStyle();
                        saveAsSettings();
                    }

                    function pickCcColor(btn) {
                        document.querySelectorAll('#asCcColors .as-tool-swatch').forEach(b => b.classList.remove('on'));
                        btn.classList.add('on');
                        ccCfg.color = btn.dataset.color;
                        applyCcStyle();
                        saveAsSettings();
                    }

                    function pickCcOutline(btn) {
                        document.querySelectorAll('#asCcOutline .as-tool-seg-btn').forEach(b => b.classList.remove('on'));
                        btn.classList.add('on');
                        ccCfg.outline = parseInt(btn.dataset.w, 10);
                        applyCcStyle();
                        saveAsSettings();
                    }

                    function pickCcOutlineColor(btn) {
                        document.querySelectorAll('#asCcOutlineColors .as-tool-swatch').forEach(b => b.classList.remove('on'));
                        btn.classList.add('on');
                        ccCfg.outlineColor = btn.dataset.color;
                        applyCcStyle();
                        saveAsSettings();
                    }

                    function pickCcBg(btn) {
                        document.querySelectorAll('#asCcBgColors .as-tool-swatch').forEach(b => b.classList.remove('on'));
                        btn.classList.add('on');
                        ccCfg.bg = btn.dataset.color;
                        if (ccCfg.bgOpacity === 0) {
                            ccCfg.bgOpacity = 60;
                            const opSlider = document.getElementById('asCcBgOpacity');
                            if (opSlider) opSlider.value = 60;
                            const opVal = document.getElementById('asCcBgOpacityVal');
                            if (opVal) opVal.textContent = '60%';
                        }
                        applyCcStyle();
                        saveAsSettings();
                    }

                    function onCcBgOpacityChange(el) {
                        ccCfg.bgOpacity = parseInt(el.value, 10);
                        const val = document.getElementById('asCcBgOpacityVal');
                        if (val) val.textContent = ccCfg.bgOpacity + '%';
                        applyCcStyle();
                        saveAsSettings();
                    }

                    function onCcMarginChange(el) {
                        ccCfg.marginX = parseInt(el.value, 10) / 10;
                        const val = document.getElementById('asCcMarginXVal');
                        if (val) val.textContent = ccCfg.marginX.toFixed(1) + '%';
                        applyCcStyle();
                        saveAsSettings();
                    }

                    function onCcMarginYChange(el) {
                        ccCfg.marginY = parseInt(el.value, 10) / 10;
                        const val = document.getElementById('asCcMarginYVal');
                        if (val) val.textContent = ccCfg.marginY.toFixed(1) + '%';
                        applyCcStyle();
                        saveAsSettings();
                    }

                    function onCcPushChange(el) {
                        ccCfg.pushBottom = parseInt(el.value, 10);
                        const val = document.getElementById('asCcPushVal');
                        if (val) val.textContent = ccCfg.pushBottom + '%';
                        applyCcStyle();
                        saveAsSettings();
                    }

                    function resetCcDefaults() {
                        ccCfg.size = 18;
                        ccCfg.color = '#ffffff';
                        ccCfg.outline = 2;
                        ccCfg.outlineColor = '#000000';
                        ccCfg.bg = '0,0,0';
                        ccCfg.bgOpacity = 0;
                        ccCfg.marginX = 15;
                        ccCfg.marginY = 3;
                        ccCfg.pushBottom = 10;
                        syncCcControls();
                        applyCcStyle();
                        saveAsSettings();
                        showToolToast('Đã đặt lại cấu hình phụ đề');
                    }

                    // ---- Thuyết minh ----
                    function syncDubSwitches() {
                        const on = dubState === 'dub';
                        document.querySelectorAll('#asDubSwitch, #asSetDubSwitch').forEach(s => s.classList.toggle('on', on));
                        const dubBtn = document.getElementById('asDubBtn');
                        if (dubBtn) dubBtn.classList.toggle('active', on);
                        const bDub = document.getElementById('asBottomDubBtn');
                        if (bDub) bDub.classList.toggle('active', !!on);
                    }

                    function setDubEnabled(on) {
                        dubState = on ? 'dub' : 'origin';
                        document.querySelectorAll('#asDubSwitch, #asSetDubSwitch').forEach(s => s.classList.toggle('on', on));
                        const dubBtn = document.getElementById('asDubBtn');
                        if (dubBtn) dubBtn.classList.toggle('active', on);
                        saveAsSettings();
                    }

                    function toggleDubEnabled(btn) {
                        const on = dubState !== 'dub';
                        setDubEnabled(on);
                        showToolToast(on ? 'Đã bật Thuyết minh' : 'Đang phát Âm thanh gốc + Vietsub');
                    }

                    function pickDubVoice(btn) {
                        document.querySelectorAll('#asDubVoices .as-tool-seg-btn').forEach(b => b.classList.remove('on'));
                        btn.classList.add('on');
                        dubVoice = btn.textContent.trim();
                        saveAsSettings();
                        showToolToast('Giọng đọc: ' + dubVoice);
                    }

                    function onDubVolumeChange(el) {
                        const v = parseInt(el.value, 10);
                        const val = document.getElementById('asDubVolVal');
                        if (val) val.textContent = v + '%';
                        saveAsSettings();
                    }

                    // ---- Tự chuyển tập ----
                    function toggleAutoNext(btn) {
                        btn.classList.toggle('on');
                        saveAsSettings();
                    }

                    // =======================================================
                    // 💾 LƯU CẤU HÌNH (localStorage) — load lại trang vẫn còn
                    // =======================================================
                    const AS_SAVE_KEY = 'asPlayerSettings.v1';

                    function saveAsSettings() {
                        try {
                            const video = document.getElementById('asVideoEl');
                            const autoNext = document.getElementById('asAutoNextSwitch');
                            const dubVol = document.getElementById('asDubVol');
                            const dubVoiceBtn = document.querySelector('#asDubVoices .as-tool-seg-btn.on');
                            const speedBtn = document.querySelector('#asSpeedSeg .as-tool-seg-btn.on');
                            const data = {
                                cc: {
                                    size: ccCfg.size, color: ccCfg.color,
                                    outline: ccCfg.outline, outlineColor: ccCfg.outlineColor,
                                    bg: ccCfg.bg, bgOpacity: ccCfg.bgOpacity,
                                    marginX: ccCfg.marginX, marginY: ccCfg.marginY,
                                    pushBottom: ccCfg.pushBottom
                                },
                                ccEnabled: (typeof subtitlesEnabled !== 'undefined') ? subtitlesEnabled : true,
                                dubEnabled: dubState === 'dub',
                                dubVoice: dubVoiceBtn ? dubVoiceBtn.textContent.trim() : dubVoice,
                                dubVolume: dubVol ? parseInt(dubVol.value, 10) : 50,
                                volume: video ? video.volume : 1,
                                muted: video ? video.muted : false,
                                speed: speedBtn ? parseFloat(speedBtn.dataset.speed) : 1,
                                autoNext: autoNext ? autoNext.classList.contains('on') : true
                            };
                            localStorage.setItem(AS_SAVE_KEY, JSON.stringify(data));
                            if (typeof applyRecSavedSubtitleStyle === 'function') {
                                applyRecSavedSubtitleStyle();
                            }
                        } catch (e) { }
                    }

                    function loadAsSettings() {
                        try {
                            const raw = localStorage.getItem(AS_SAVE_KEY);
                            if (!raw) return null;
                            const data = JSON.parse(raw);
                            return (data && typeof data === 'object') ? data : null;
                        } catch (e) { return null; }
                    }

                    function applySavedSettings() {
                        const saved = loadAsSettings();
                        if (saved) {
                            if (saved.cc) {
                                ['size', 'color', 'outline', 'outlineColor', 'bg', 'bgOpacity', 'marginX', 'marginY', 'pushBottom'].forEach(k => {
                                    if (saved.cc[k] !== undefined && saved.cc[k] !== null) ccCfg[k] = saved.cc[k];
                                });
                                syncCcControls();
                            }
                            if (typeof saved.ccEnabled === 'boolean') setCcEnabled(saved.ccEnabled);
                            if (typeof saved.dubEnabled === 'boolean') setDubEnabled(saved.dubEnabled);
                            if (saved.dubVoice) {
                                dubVoice = saved.dubVoice;
                                document.querySelectorAll('#asDubVoices .as-tool-seg-btn').forEach(b => {
                                    b.classList.toggle('on', b.textContent.trim() === dubVoice);
                                });
                            }
                            if (saved.dubVolume !== undefined && saved.dubVolume !== null) {
                                const dv = document.getElementById('asDubVol');
                                const dvl = document.getElementById('asDubVolVal');
                                if (dv) dv.value = saved.dubVolume;
                                if (dvl) dvl.textContent = saved.dubVolume + '%';
                            }
                            if (typeof saved.autoNext === 'boolean') {
                                const an = document.getElementById('asAutoNextSwitch');
                                if (an) an.classList.toggle('on', saved.autoNext);
                            }
                            if (saved.speed) {
                                const speed = parseFloat(saved.speed);
                                const idx = PLAYBACK_SPEEDS.indexOf(speed);
                                if (idx >= 0) cinemaCurrentSpeedIdx = idx;
                                document.querySelectorAll('#asSpeedSeg .as-tool-seg-btn').forEach(b => {
                                    b.classList.toggle('on', parseFloat(b.dataset.speed) === speed);
                                });
                                const video = document.getElementById('asVideoEl');
                                if (video) video.playbackRate = speed;
                                const speedBtn = document.getElementById('asSpeedBtn');
                                if (speedBtn) speedBtn.textContent = speed + 'x';
                            }
                            if (saved.volume !== undefined && saved.volume !== null) {
                                const video = document.getElementById('asVideoEl');
                                if (video) {
                                    const v = parseFloat(saved.volume);
                                    video.volume = (isNaN(v) || v <= 0.05) ? 1 : Math.max(0.1, Math.min(1, v));
                                    video.muted = false; // Người dùng yêu cầu: luôn bật âm thanh khi user vào xem
                                }
                            }
                        }
                        const modal = document.getElementById('asTheaterModal');
                        const videoEl = document.getElementById('asVideoEl');
                        if (videoEl) {
                            if ((modal && modal.classList.contains('active')) || miniPlayerActive) {
                                videoEl.muted = false;
                                if (typeof videoEl.volume === 'number' && videoEl.volume <= 0.05) videoEl.volume = 1;
                            } else {
                                videoEl.muted = true;
                            }
                            videoEl.addEventListener('volumechange', updateVolumeIcon);
                        }
                        updateVolumeIcon();
                        syncVolumeSlider();
                        applyCcStyle();
                    }
                    document.addEventListener('DOMContentLoaded', applySavedSettings);

                    // ---- Chính sách autoplay của trình duyệt ----
                    function attemptAutoplay(videoEl, spinner) {
                        if (!videoEl) return;
                        const modal = document.getElementById('asTheaterModal');
                        const isTheaterActive = modal && modal.classList.contains('active');
                        if (!isTheaterActive && !miniPlayerActive) {
                            // Cả rạp chiếu lẫn mini player đều không mở -> tuyệt đối không play()
                            try { videoEl.pause(); videoEl.muted = true; } catch (e) { }
                            return;
                        }
                        // Người dùng yêu cầu: luôn bật âm thanh khi user vào xem
                        videoEl.muted = false;
                        if (typeof videoEl.volume === 'number' && videoEl.volume <= 0.05) videoEl.volume = 1;
                        if (typeof updateVolumeIcon === 'function') updateVolumeIcon();
                        if (typeof syncVolumeSlider === 'function') syncVolumeSlider();

                        const showPausedUI = () => {
                            if (spinner) spinner.classList.remove('active');
                            const playIcon = document.getElementById('asPlayIconSvg');
                            const pauseIcon = document.getElementById('asPauseIconSvg');
                            const centerPlayBtn = document.getElementById('asCenterPlayBtn');
                            if (playIcon) playIcon.style.display = 'block';
                            if (pauseIcon) pauseIcon.style.display = 'none';
                            if (centerPlayBtn) centerPlayBtn.classList.add('show');
                        };

                        const p = videoEl.play();
                        if (!p || typeof p.catch !== 'function') return;
                        p.catch(() => {
                            // Bị chặn autoplay có tiếng => thử phát tạm tắt tiếng để tránh khựng video
                            videoEl.muted = true;
                            if (typeof updateVolumeIcon === 'function') updateVolumeIcon();
                            const p2 = videoEl.play();
                            if (p2 && typeof p2.catch === 'function') p2.catch(showPausedUI);

                            // Ngay ở tương tác đầu tiên: bật lại tiếng và tiếp tục phát
                            const restoreSound = () => {
                                document.removeEventListener('click', restoreSound);
                                document.removeEventListener('touchstart', restoreSound);
                                document.removeEventListener('keydown', restoreSound);
                                window._asAutoplayCleanup = null;
                                const modal = document.getElementById('asTheaterModal');
                                if (!modal || !modal.classList.contains('active')) return;
                                if (!videoEl || !videoEl.src || videoEl.src === window.location.href || videoEl.paused) return;
                                videoEl.muted = false;
                                if (typeof videoEl.volume === 'number' && videoEl.volume <= 0.05) videoEl.volume = 1;
                                if (typeof updateVolumeIcon === 'function') updateVolumeIcon();
                                if (typeof syncVolumeSlider === 'function') syncVolumeSlider();
                                const p3 = videoEl.play();
                                if (p3 && p3.catch) p3.catch(() => { });
                            };
                            window._asAutoplayCleanup = () => {
                                document.removeEventListener('click', restoreSound);
                                document.removeEventListener('touchstart', restoreSound);
                                document.removeEventListener('keydown', restoreSound);
                            };
                            document.addEventListener('click', restoreSound, { once: true });
                            document.addEventListener('touchstart', restoreSound, { once: true });
                            document.addEventListener('keydown', restoreSound, { once: true });
                        });
                    }

                    // ---- Toàn màn hình ----
                    let _fsSyncTimer = null;
                    function syncFullscreenClass() {
                        const modal = document.getElementById('asTheaterModal');
                        if (!modal) return;
                        const fsEl = document.fullscreenElement || document.webkitFullscreenElement;
                        const isFs = !!(fsEl && (fsEl === modal || modal.contains(fsEl)));
                        modal.classList.toggle('cinema-fs', isFs);
                        if (isFs) {
                            hoistToolPops();
                            if (!_fsSyncTimer) {
                                // Polling dự phòng: một số trình duyệt không bắn fullscreenchange kịp
                                _fsSyncTimer = setInterval(() => {
                                    const curFs = document.fullscreenElement || document.webkitFullscreenElement;
                                    if (!curFs) {
                                        clearInterval(_fsSyncTimer);
                                        _fsSyncTimer = null;
                                        modal.classList.remove('cinema-fs');
                                    }
                                }, 400);
                            }
                        } else {
                            if (_fsSyncTimer) {
                                clearInterval(_fsSyncTimer);
                                _fsSyncTimer = null;
                            }
                        }
                    }
                    document.addEventListener('fullscreenchange', syncFullscreenClass);
                    document.addEventListener('webkitfullscreenchange', syncFullscreenClass);

                    /* =======================================================
                       🛟 CỨU LỖI "FULLSCREEN MA": khi vào fullscreen rồi rời trang
                       (bấm poster, mở rạp chiếu, quay lại...) trình duyệt có thể KHÔNG
                       tự thoát. Khi đó lớp fullscreen bám lại che toàn trang: mọi thứ
                       bị mờ và KHÔNG BẤM ĐƯỢC GÌ.
                       => Kiểm định kỳ: phần tử đang fullscreen mà bị ẩn/Gỡ khỏi DOM thì
                          thoát fullscreen ngay để trả quyền điều khiển về cho trang.
                       ======================================================= */
                    function isFullscreenElementAlive() {
                        const el = document.fullscreenElement || document.webkitFullscreenElement;
                        if (!el) return true;
                        // Bị gỡ khỏi DOM
                        if (!el.isConnected) return false;
                        // Bị ẩn (display:none ở chính nó hoặc bất kỳ cha nào)
                        let node = el;
                        while (node && node.nodeType === 1) {
                            let hidden = false;
                            try { hidden = node.style && node.style.display === 'none'; } catch (e) { }
                            if (hidden) return false;
                            node = node.parentElement;
                        }
                        return true;
                    }

                    function fullscreenWatchdog() {
                        const fs = document.fullscreenElement || document.webkitFullscreenElement;
                        if (fs && !isFullscreenElementAlive()) {
                            syncFullscreenClass();
                            const exit = document.exitFullscreen || document.webkitExitFullscreen;
                            if (exit) {
                                (exit.call(document) || Promise.resolve()).catch(() => { });
                            }
                            syncFullscreenClass();
                        }
                    }
                    setInterval(fullscreenWatchdog, 600);
                    // Chỉ chạy khi quay lại tab (tránh tốn pin khi ẩn)
                    document.addEventListener('visibilitychange', fullscreenWatchdog);

                    // Rời trang Đề xuất hoặc mở rạp chiếu thì buộc thoát fullscreen trước
                    function forceExitFullscreen() {
                        const fs = document.fullscreenElement || document.webkitFullscreenElement;
                        if (!fs) return;
                        const exit = document.exitFullscreen || document.webkitExitFullscreen;
                        if (exit) (exit.call(document) || Promise.resolve()).catch(() => { });
                        syncFullscreenClass();
                    }

                    /* =======================================================
                       📱 HEADER THEO CUỘN TRANG (mobile)
                       Trang phim ngắn không nạp sticky-nav.js của site nên phải tự gắn
                       class 'scrolled' cho header:
                         • đầu trang (chưa cuộn) -> header trong suốt, poster hiện ra phía sau
                         • cuộn xuống (>50px)    -> header có nền đặc như trang thường
                       ======================================================= */
                    (function bindHeaderScrollState() {
                        let ticking = false;
                        const header = () => document.getElementById('sofa-header') || document.querySelector('header');

                        /* Helper an toàn: trình duyệt nào cũng có setProperty/removeProperty,
                           nhưng vẫn phòng khi style object bị thay bằng object thường. */
                        const setInline = (h, prop, val) => {
                            if (!h || !h.style) return;
                            if (typeof h.style.setProperty === 'function') h.style.setProperty(prop, val, 'important');
                            else h.style[prop] = val;
                        };
                        const clearInline = (h, prop) => {
                            if (!h || !h.style) return;
                            if (typeof h.style.removeProperty === 'function') h.style.removeProperty(prop);
                            else if (typeof h.style.setProperty === 'function') h.style.setProperty(prop, '');
                            else delete h.style[prop];
                        };

                        /* Ép header trong suốt ở đầu trang bằng INLINE style.
                           Cần thiết vì một số file CSS (mobile-viewport-fix.css) set
                           'background: #13151b !important' cho cả trạng thái chưa cuộn,
                           đủ sức thắng rule CSS thường của trang này. */
                        const forceTransparent = (h) => {
                            if (!h) return;
                            setInline(h, 'background', 'transparent');
                            setInline(h, 'background-color', 'transparent');
                            setInline(h, 'background-image', 'none');
                            setInline(h, 'border', 'none');
                            setInline(h, 'border-bottom', 'none');
                            setInline(h, 'box-shadow', 'none');
                            setInline(h, 'backdrop-filter', 'none');
                            setInline(h, '-webkit-backdrop-filter', 'none');
                        };

                        const releaseTransparent = (h) => {
                            if (!h) return;
                            ['background', 'background-color', 'background-image', 'border', 'border-bottom',
                                'box-shadow', 'backdrop-filter', '-webkit-backdrop-filter'].forEach(p => clearInline(h, p));
                        };

                        const sync = () => {
                            const h = header();
                            if (!h) { ticking = false; return; }
                            const top = window.pageYOffset || 0;
                            const isLight = document.documentElement.classList.contains('light-mode');

                            // Luôn dọn sạch inline styles cũ của theme trước để không bị dính màu nền kem
                            releaseTransparent(h);

                            if (top > 50) {
                                if (isLight) {
                                    setInline(h, 'background', 'rgba(250, 247, 242, 0.98)');
                                    setInline(h, 'background-color', '#faf7f2');
                                    setInline(h, 'border-bottom', '1px solid #e7e0d3');
                                    setInline(h, 'box-shadow', '0 4px 20px rgba(78, 64, 45, 0.08)');
                                    setInline(h, 'backdrop-filter', 'blur(12px)');
                                    setInline(h, '-webkit-backdrop-filter', 'blur(12px)');
                                } else {
                                    // Chế độ tối khi cuộn: dọn sạch inline styles để CSS dark header (#11141a) tự xử lý
                                    releaseTransparent(h);
                                }
                                h.classList.add('scrolled');
                                h.classList.add('sofa-header-scrolled');
                            } else {
                                // 🌟 Ở ĐẦU TRANG (top <= 50): Header LUÔN trong suốt hoàn toàn ở cả Dark Mode lẫn Light Mode
                                // để poster phim ở /phim-ngan và /phim-ngan/thong-tin tràn sát mép trên header như ban đầu!
                                const isLibraryOrSearch = document.body.classList.contains('page-library-mode') ||
                                    document.body.classList.contains('page-search-mode') ||
                                    (document.getElementById('asLibraryView') && document.getElementById('asLibraryView').style.display !== 'none') ||
                                    (document.getElementById('asSearchView') && document.getElementById('asSearchView').style.display !== 'none');

                                if (isLibraryOrSearch) {
                                    if (isLight) {
                                        setInline(h, 'background', 'rgba(250, 247, 242, 0.98)');
                                        setInline(h, 'background-color', '#faf7f2');
                                        setInline(h, 'border-bottom', '1px solid #e7e0d3');
                                        setInline(h, 'box-shadow', '0 4px 20px rgba(78, 64, 45, 0.08)');
                                    } else {
                                        releaseTransparent(h);
                                    }
                                } else {
                                    forceTransparent(h);
                                }
                                h.classList.remove('scrolled');
                                h.classList.remove('sofa-header-scrolled');
                            }
                            ticking = false;
                        };
                        const onScroll = () => {
                            if (ticking) return;
                            ticking = true;
                            if (window.requestAnimationFrame) window.requestAnimationFrame(sync);
                            else setTimeout(sync, 60);
                        };
                        window.addEventListener('scroll', onScroll, { passive: true });
                        window.addEventListener('resize', onScroll, { passive: true });
                        window.addEventListener('pageshow', sync);

                        // 🌟 Theo dõi thay đổi class 'light-mode' trên thẻ <html> bằng MutationObserver để phản ứng TỨC THÌ
                        try {
                            const observer = new MutationObserver((mutations) => {
                                for (const m of mutations) {
                                    if (m.attributeName === 'class') {
                                        sync();
                                        break;
                                    }
                                }
                            });
                            observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
                        } catch (e) { }

                        // Lắng nghe các event đổi theme từ floating-dock hoặc localStorage
                        window.addEventListener('aphim:theme-change', sync);
                        window.addEventListener('themeChanged', sync);
                        window.addEventListener('storage', (e) => {
                            if (e.key === 'aphim_theme' || e.key === 'cinestream_theme') sync();
                        });

                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', sync);
                        } else {
                            sync();
                        }
                    })();

                    /* Gọi mỗi khi đóng rạp chiếu: nếu rạp chiếu đang giữ fullscreen thì
                       thoát ngay, tránh lớp fullscreen kẹt lại che toàn trang (mất click) */
                    function cleanupTheaterFs() {
                        const fs = document.fullscreenElement || document.webkitFullscreenElement;
                        if (!fs) { syncFullscreenClass(); return; }
                        const modal = document.getElementById('asTheaterModal');
                        if (fs === modal || (modal && modal.contains(fs))) {
                            forceExitFullscreen();
                        } else {
                            syncFullscreenClass();
                        }
                    }

                    // Gắn sự kiện video: có frame mới hoặc tua thì chụp lại nền
                    document.addEventListener('DOMContentLoaded', () => {
                        const videoEl = document.getElementById('asVideoEl');
                        if (!videoEl) return;

                        // Ẩn vòng quay ở MỌI đường dẫn: canplay/playing/loadeddata/timeupdate
                        const hideSpinnerAny = () => {
                            const sp = document.getElementById('asVideoSpinner');
                            if (sp) sp.classList.remove('active');
                        };
                        ['canplay', 'canplaythrough', 'playing', 'loadeddata', 'error', 'timeupdate'].forEach(ev => {
                            videoEl.addEventListener(ev, hideSpinnerAny);
                        });
                    });

                    // An toàn cuối (top-level, không phụ thuộc DOMContentLoaded):
                    // nếu video đã có khung hình hoặc đang phát mà spinner vẫn bật thì ẩn ngay
                    setInterval(() => {
                        const v = document.getElementById('asVideoEl');
                        const sp = document.getElementById('asVideoSpinner');
                        if (!v || !sp) return;
                        const hasFrame = v.readyState >= 1 || !v.paused || v.currentTime > 0;
                        if (hasFrame && sp.classList.contains('active')) {
                            sp.classList.remove('active');
                        }
                    }, 500);

