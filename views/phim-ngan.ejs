                    // =======================================================
                    // 7. PLAY EPISODE & SYNC (ALL SCREENS)
                    // =======================================================
                    activeSubPoller = null;
                    let activeSubTarget = null;
                    readyBadgeInterval = null;

                    let _readyBadgeTimer = null;
                    function updateReadyEpisodesBadge(dramaId) {
                        if (!dramaId) return;
                        if (_readyBadgeTimer) clearTimeout(_readyBadgeTimer);
                        _readyBadgeTimer = setTimeout(async () => {
                            try {
                                const res = await fetch(`/phim-ngan/api/ready-subs?dramaId=${encodeURIComponent(dramaId)}`);
                                const data = await res.json();
                                if (data.success && Array.isArray(data.readyEpisodes)) {
                                    const readySet = new Set(data.readyEpisodes);
                                    const totalEps = (currentActiveDrama && (currentActiveDrama.totalEpisodes || (currentActiveDrama.episodes && currentActiveDrama.episodes.length))) || 50;

                                    // ⚡ Batch DOM update trong requestAnimationFrame để triệt tiêu Forced Reflow
                                    requestAnimationFrame(() => {
                                        document.querySelectorAll('.as-modal-ep-btn, .as-detail-ep-btn, .as-sidebar-ep-btn').forEach(btn => {
                                            const epNo = parseInt(btn.dataset.ep, 10);
                                            if (readySet.has(epNo)) {
                                                btn.classList.add('has-sub');
                                                btn.title = `Tập ${epNo}: Đã có Vietsub`;
                                            } else {
                                                btn.classList.remove('has-sub');
                                                btn.title = `Tập ${epNo}: Chưa dịch tới (Bấm xem để tự động dịch)`;
                                            }
                                        });

                                        const pickerLabel = document.getElementById('asModalEpPickerLabel');
                                        const progressBar = document.getElementById('asModalSubProgressBar');
                                        const readyCount = data.totalReady || readySet.size;

                                        if (pickerLabel) {
                                            pickerLabel.innerHTML = `Tổng ${totalEps} tập • <span style="color:var(--as-lime); font-weight:700;">${readyCount}/${totalEps} Vietsub</span>`;
                                        }
                                        if (progressBar) {
                                            const pct = Math.min(100, Math.round((readyCount / totalEps) * 100));
                                            progressBar.style.width = `${pct}%`;
                                        }

                                        const subCount = document.getElementById('asSidebarSubCount');
                                        const subTotal = document.getElementById('asSidebarSubTotal');
                                        if (subCount) subCount.textContent = readyCount;
                                        if (subTotal) subTotal.textContent = totalEps;

                                        if (readyCount >= totalEps && readyBadgeInterval) {
                                            clearInterval(readyBadgeInterval);
                                            readyBadgeInterval = null;
                                        }
                                    });
                                }
                            } catch (e) { }
                        }, 200);
                    }

                    function loadAndPlayDrama(drama, epNo = 1, seekTime = 0) {
                        currentActiveDrama = drama;
                        if (typeof syncDetailActionButtons === 'function') {
                            syncDetailActionButtons(drama);
                        }

                        const ambientBg = document.getElementById('asAmbientBg');
                        if (ambientBg && drama.cover) {
                            ambientBg.style.backgroundImage = `url('${drama.cover}')`;
                        }

                        // Render Sidebar Episodes & Tabs (Hình 3)
                        renderSidebarEpisodeChunks(drama.episodes || [], epNo);

                        const targetEpIdx = Math.max(0, epNo - 1);
                        playEpisodeByIndex(targetEpIdx, seekTime);

                        // On-demand fetch
                        fetch(`/phim-ngan/api/focus?dramaId=${encodeURIComponent(drama.id)}&ep=${epNo}`).catch(() => { });
                        updateReadyEpisodesBadge(drama.id);

                        if (readyBadgeInterval) clearInterval(readyBadgeInterval);
                        readyBadgeInterval = setInterval(() => {
                            const modal = document.getElementById('asTheaterModal');
                            if (!modal || !modal.classList.contains('active')) {
                                clearInterval(readyBadgeInterval);
                                readyBadgeInterval = null;
                                return;
                            }
                            if (currentActiveDrama) updateReadyEpisodesBadge(currentActiveDrama.id);
                        }, 3500);
                    }

                    function renderSidebarEpisodeChunks(episodes, activeEpNo = 1) {
                        const tabsWrap = document.getElementById('asSidebarChunkTabs');
                        const gridWrap = document.getElementById('asSidebarEpGrid');
                        const counterEl = document.getElementById('asSidebarEpCounter');
                        if (!tabsWrap || !gridWrap) return;

                        const totalEps = episodes.length;
                        if (counterEl) counterEl.textContent = `Tập ${activeEpNo} / ${totalEps}`;

                        const CHUNK_SIZE = 30;
                        const chunkCount = Math.ceil(totalEps / CHUNK_SIZE);
                        const activeChunk = Math.floor((activeEpNo - 1) / CHUNK_SIZE);

                        // Render Tabs 1 - 30, 31 - 51...
                        tabsWrap.innerHTML = '';
                        for (let i = 0; i < chunkCount; i++) {
                            const start = i * CHUNK_SIZE + 1;
                            const end = Math.min((i + 1) * CHUNK_SIZE, totalEps);
                            const btn = document.createElement('button');
                            btn.className = `as-sidebar-chunk-tab ${i === activeChunk ? 'active' : ''}`;
                            btn.textContent = `${start} – ${end}`;
                            btn.onclick = () => {
                                document.querySelectorAll('.as-sidebar-chunk-tab').forEach((t, idx) => t.classList.toggle('active', idx === i));
                                renderSidebarChunkGrid(episodes, i, CHUNK_SIZE, activeEpNo);
                            };
                            tabsWrap.appendChild(btn);
                        }

                        renderSidebarChunkGrid(episodes, activeChunk, CHUNK_SIZE, activeEpNo);
                    }

                    function renderSidebarChunkGrid(episodes, chunkIndex, chunkSize, activeEpNo) {
                        const gridWrap = document.getElementById('asSidebarEpGrid');
                        if (!gridWrap) return;
                        gridWrap.innerHTML = '';

                        const startIdx = chunkIndex * chunkSize;
                        const endIdx = Math.min((chunkIndex + 1) * chunkSize, episodes.length);

                        for (let i = startIdx; i < endIdx; i++) {
                            const ep = episodes[i];
                            const epNo = ep.no || (i + 1);
                            const btn = document.createElement('button');
                            btn.className = `as-sidebar-ep-btn as-modal-ep-btn ${epNo === activeEpNo ? 'active' : ''}`;
                            btn.id = `asSidebarBtn_${i}`;
                            btn.dataset.ep = epNo;
                            const badgeHtml = '<span class="as-ep-badge">3s</span>';
                            const checkHtml = '<span class="as-ep-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>';
                            btn.innerHTML = `<span class="as-ep-num">${epNo}</span>${checkHtml}${badgeHtml}`;
                            btn.title = `Tập ${epNo}`;
                            btn.onclick = () => playEpisodeByIndex(i);
                            gridWrap.appendChild(btn);
                        }

                        if (currentActiveDrama) {
                            updateReadyEpisodesBadge(currentActiveDrama.id);
                        }
                    }

                    /* =======================================================
                       [MOBILE CINEMA] Đồng bộ thông tin phim hiển thị góc dưới bên trái
                       ======================================================= */
                    /* =======================================================
                       [MOBILE FS] Toàn màn hình: ẩn toàn bộ icon bên phải + thông tin phim
                       - Dùng Fullscreen API của trình duyệt khi có
                       - Dự phòng "toàn màn trong app" (class mobile-fs) cho iOS Safari
                       ======================================================= */
                    function toggleMobileCinemaFullscreen(ev) {
                        if (ev && typeof ev.stopPropagation === 'function') ev.stopPropagation();
                        const modal = document.getElementById('asTheaterModal');
                        if (!modal) return;

                        const fsEl = document.fullscreenElement || document.webkitFullscreenElement;
                        // Đang ở chế độ toàn màn hình -> thoát và phục hồi lại đầy đủ giao diện công cụ bên phải
                        if (fsEl || modal.classList.contains('mobile-fs') || modal.classList.contains('cinema-fs')) {
                            const exit = document.exitFullscreen || document.webkitExitFullscreen;
                            if (fsEl && exit) (exit.call(document) || Promise.resolve()).catch(() => { });
                            modal.classList.remove('mobile-fs');
                            modal.classList.remove('cinema-fs');
                            return;
                        }

                        // Đóng mọi sheet/popover đang mở để vào full cho sạch
                        if (typeof closeMobileCinemaSheet === 'function') closeMobileCinemaSheet();
                        if (typeof closeToolPop === 'function') closeToolPop();

                        // Luôn thêm class mobile-fs để ẩn các nút và hiện nút ESC góc trái trên ngay lập tức
                        modal.classList.add('mobile-fs');

                        // Thử Fullscreen API thật nếu thiết bị hỗ trợ
                        const req = modal.requestFullscreen || modal.webkitRequestFullscreen;
                        if (req) {
                            try {
                                const p = req.call(modal);
                                if (p && typeof p.catch === 'function') {
                                    p.catch(() => { });
                                }
                            } catch (e) { }
                        }
                    }

                    // Khi toàn màn hình thật bị tắt (nút back, Esc) thì dọn class dự phòng
                    document.addEventListener('fullscreenchange', function () {
                        const fsEl = document.fullscreenElement || document.webkitFullscreenElement;
                        if (!fsEl) {
                            const modal = document.getElementById('asTheaterModal');
                            if (modal) modal.classList.remove('mobile-fs');
                            const recView = document.getElementById('asRecommendView');
                            if (recView) recView.classList.remove('rec-mobile-fs');
                        }
                    });

