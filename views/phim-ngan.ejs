                    function closeRecEpisodeDrawer() {
                        const drawer = document.getElementById('asRecSheetDrawer');
                        const backdrop = document.getElementById('asRecSheetBackdrop');
                        if (drawer) drawer.classList.remove('active');
                        if (backdrop) backdrop.classList.remove('active');

                        /* Khôi phục cuộn trang theo ĐÚNG trạng thái hiện tại.
                           Trước đây chỉ reset khi page-recommend-mode nên khi đang ở trang
                           Chi tiết (hoặc sau khi rời Đề xuất) body giữ overflow:hidden
                           => người dùng không lướt được gì. */
                        const modal = document.getElementById('asTheaterModal');
                        const isRecommendMode = document.body.classList.contains('page-recommend-mode') &&
                            document.getElementById('asRecommendView') &&
                            document.getElementById('asRecommendView').style.display !== 'none';
                        const isTheater = modal && modal.classList.contains('active');
                        document.body.style.overflow = (isRecommendMode || isTheater) ? 'hidden' : '';
                    }

                    function closeRecCommentDrawer() {
                        closeRecEpisodeDrawer();
