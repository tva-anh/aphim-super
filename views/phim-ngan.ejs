            /* Các hàng mục Cài đặt (Chuẩn ảnh 2: Phụ đề, Thuyết minh, Tự chuyển tập, Dịch lại, Tải tập, Báo lỗi) */
            .as-set-row {
                display: flex !important;
                align-items: center !important;
                justify-content: space-between !important;
                padding: 13px 0 !important;
                min-height: 48px !important;
                border: none !important;
                background: transparent !important;
            }

            .as-set-row.as-set-clickable {
                cursor: pointer !important;
                border-radius: 10px !important;
                transition: opacity 0.15s ease !important;
            }

            .as-set-row.as-set-clickable:active {
                opacity: 0.75 !important;
            }

            .as-set-row-title {
                font-size: 1rem !important;
                font-weight: 700 !important;
                color: #ffffff !important;
                letter-spacing: -0.15px !important;
                user-select: none !important;
                cursor: pointer !important;
            }

            .as-set-row-right {
                display: flex !important;
                align-items: center !important;
                gap: 12px !important;
                flex-shrink: 0 !important;
            }

            .as-set-row-end-slot {
                width: 24px !important;
                height: 24px !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                flex-shrink: 0 !important;
                color: #94a3b8 !important;
                margin: 0 !important;
                padding: 0 !important;
                border: none !important;
                background: transparent !important;
                text-align: center !important;
            }

            .as-set-row-arrow,
            .as-set-row-icon {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                color: #94a3b8 !important;
                cursor: pointer !important;
                background: transparent !important;
                border: none !important;
                padding: 0 !important;
                transition: color 0.15s ease !important;
            }

            .as-set-row-arrow:hover,
            .as-set-row-icon:hover,
            .as-set-row-end-slot:hover {
                color: #ffffff !important;
            }

            /* Công tắc Toggle Switch chuẩn ảnh 2 (Xanh lá neon #a3e635 khi bật, Xám #393d47 khi tắt) */
            .as-tool-switch {
                position: relative !important;
                width: 44px !important;
                height: 26px !important;
                border-radius: 999px !important;
                background: #393d47 !important;
                border: none !important;
                cursor: pointer !important;
                flex-shrink: 0 !important;
                transition: background 0.22s ease !important;
                padding: 0 !important;
            }

            .as-tool-switch::after {
                content: '' !important;
                position: absolute !important;
                top: 3px !important;
                left: 3px !important;
                width: 20px !important;
                height: 20px !important;
                border-radius: 50% !important;
                background: #ffffff !important;
                transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1) !important;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.35) !important;
            }

            .as-tool-switch.on {
                background: #a3e635 !important;
            }

            .as-tool-switch.on::after {
                transform: translateX(18px) !important;
            }

            /* Hai nút đáy: Toàn màn hình & Đóng trình phát chuẩn ảnh 2 */
            .as-set-footer-actions {
                display: flex !important;
                align-items: center !important;
                gap: 12px !important;
                margin-top: 18px !important;
                padding-top: 6px !important;
