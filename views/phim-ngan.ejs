                                                            <%= idx + 1 %>
                                                        </div>
                                                        <div class="as-top10-poster-wrap">
                                                            <% if (d.isDubbed || (d.title && (d.title.toLowerCase().includes('lồng tiếng') || d.title.toLowerCase().includes('thuyết minh')))) { %>
                                                                <span class="as-card-badge-full" style="background:#0284c7; color:#fff;">Lồng tiếng</span>
                                                            <% } else if (d.isFlexTv || d.hasEmbeddedSub || (d.labels && d.labels.includes('Vietsub Sẵn')) || String(d.id) === '7688646466708966462') { %>
