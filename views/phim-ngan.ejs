                }
            }

            /* =======================================================
           📱 HEADER THEO CUỘN TRANG (SOFA-HEADER)
           • Ở ĐẦU TRANG (chưa cuộn): header TRONG SUỐT HOÀN TOÀN
           • Khi user KÉO XUỐNG (.scrolled): header hiện nền đặc
           ======================================================= */
            body.page-phim-ngan #sofa-header:not(.scrolled),
            body.page-phim-ngan header#sofa-header:not(.scrolled),
            html.light-mode body.page-phim-ngan #sofa-header:not(.scrolled),
            html.light-mode body.page-phim-ngan header#sofa-header:not(.scrolled) {
                background: transparent !important;
                background-color: transparent !important;
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
                border: none !important;
                border-bottom: none !important;
                box-shadow: none !important;
            }

            html:not(.light-mode) body.page-phim-ngan #sofa-header.scrolled,
            html:not(.light-mode) body.page-phim-ngan header#sofa-header.scrolled {
                background: #11141a !important;
                background-color: #11141a !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
                box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35) !important;
                backdrop-filter: blur(12px) !important;
                -webkit-backdrop-filter: blur(12px) !important;
            }

            html.light-mode body.page-phim-ngan #sofa-header.scrolled,
            html.light-mode body.page-phim-ngan header#sofa-header.scrolled {
                background: rgba(250, 247, 242, 0.98) !important;
                background-color: #faf7f2 !important;
                border-bottom: 1px solid #e7e0d3 !important;
                box-shadow: 0 4px 18px rgba(22, 24, 29, 0.12) !important;
                backdrop-filter: blur(12px) !important;
                -webkit-backdrop-filter: blur(12px) !important;
            }

            /* =======================================================
           🖥️ DESKTOP HERO CLEARANCE & COMPACT SPACING (>= 992px)
           Canh chỉnh Hero vừa vặn: vừa cách thoáng thanh Header,
           vừa đưa lên nhẹ để người dùng nhìn thấy trọn vẹn mục "Xem tiếp"
           ngay trên màn hình đầu tiên (Above the fold) mà không cần cuộn.
           ======================================================= */
            @media (min-width: 992px) {
                body.page-phim-ngan .as-container {
                    padding-top: 48px !important;
                    padding-bottom: 80px !important;
                }

                body.page-phim-ngan .as-hero-section {
                    margin-top: 28px !important;
                    padding: 18px 0 24px 0 !important;
                    min-height: 460px !important;
                    gap: 40px !important;
                    align-items: center !important;
                }

                body.page-phim-ngan .as-hero-left {
                    display: flex !important;
                    flex-direction: column !important;
                    justify-content: center !important;
                    align-items: flex-start !important;
                    margin-top: 0 !important;
                    padding-top: 10px !important;
                }

                body.page-phim-ngan .as-hero-section .as-tag-spotlight {
                    margin-bottom: 12px !important;
                    padding: 4px 14px !important;
                    font-size: 0.82rem !important;
                }

                body.page-phim-ngan .as-hero-title {
                    font-size: 1.65rem !important;
                    margin-bottom: 10px !important;
                    line-height: 1.25 !important;
                    height: auto !important;
                    max-height: 2.6em !important;
                }

                body.page-phim-ngan .as-hero-meta {
                    margin-bottom: 14px !important;
                    font-size: 0.88rem !important;
                }

                body.page-phim-ngan .as-hero-actions {
                    margin-bottom: 18px !important;
                    gap: 12px !important;
                }

                body.page-phim-ngan .as-hero-thumbs-row {
                    margin-top: 0 !important;
                }

                body.page-phim-ngan .as-hero-3d-wrap {
                    display: flex !important;
                    margin-top: 18px !important;
                    height: 450px !important;
                    align-items: center !important;
                    justify-content: flex-end !important;
                }

                body.page-phim-ngan .as-stack-card {
                    top: 10px !important;
                    width: 295px !important;
                    height: 440px !important;
                }

                body.page-phim-ngan .as-stack-card.pos-1 {
                    transform: translateX(-65px) scale(0.92) !important;
                }

                body.page-phim-ngan .as-stack-card.pos-2 {
                    transform: translateX(-128px) scale(0.85) !important;
                }

                /* Mục Xem tiếp: Dời xuống theo đúng yêu cầu người dùng, đẩy Top 10 xuống dưới hẳn */
                body.page-phim-ngan .as-continue-section {
                    margin-top: 54px !important;
                    margin-bottom: 80px !important;
                }

                body.page-phim-ngan .as-top10-section {
                    margin-top: 36px !important;
                }

                body.page-phim-ngan .as-continue-head-row {
                    margin-bottom: 12px !important;
                }

                body.page-phim-ngan .as-continue-head-link {
                    font-size: 1.18rem !important;
                }

                body.page-phim-ngan .as-continue-card {
                    padding: 10px 13px !important;
                }
            }

            /* ===== Reels: lướt lên/xuống đổi tập (xem luôn trong trang) ===== */
            .as-reels-feed {
                display: none !important;
                visibility: hidden !important;
                pointer-events: none !important;
            }

            .as-reels-stage {
                position: relative;
                width: min(430px, 100vw);
                height: min(100vh, 760px);
                background: #000000;
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 30px 90px rgba(0, 0, 0, 0.8);
            }

            .as-reels-stage::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 52px;
                background: linear-gradient(to bottom, #000000 0%, rgba(0, 0, 0, 0.88) 55%, transparent 100%);
                pointer-events: none;
                z-index: 4;
            }

            @media (max-width: 767px) {
                .as-reels-stage {
                    width: 100vw;
                    height: 100vh;
                    border-radius: 0;
                }
            }

            .as-reels-video {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                background: #000000;
                transform: scale(1.08) translateY(-3%);
                transform-origin: center top;
            }

            /* Thông tin tập */
            .as-reels-info {
                position: absolute;
                top: 16px;
                left: 16px;
                right: 16px;
                z-index: 5;
                display: flex;
                flex-direction: column;
                gap: 10px;
                pointer-events: none;
            }

            .as-reels-chip {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                align-self: flex-start;
                background: rgba(0, 0, 0, 0.62);
                border: 1px solid rgba(255, 255, 255, 0.16);
                border-radius: 999px;
                padding: 7px 16px;
                font-size: 0.82rem;
                font-weight: 700;
                color: #f1f5f9;
            }

            .as-reels-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--as-lime);
                box-shadow: 0 0 8px var(--as-lime);
            }

            .as-reels-title {
                font-size: 1.15rem;
                font-weight: 800;
                color: #ffffff;
                line-height: 1.3;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                text-shadow: 0 2px 12px rgba(0, 0, 0, 0.95);
            }

            /* Điều hướng */
            .as-reels-nav {
                position: absolute;
                bottom: 22px;
                left: 16px;
                right: 16px;
                z-index: 5;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
            }

            .as-reels-nav-btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                background: rgba(0, 0, 0, 0.62);
                border: 1px solid rgba(255, 255, 255, 0.18);
                border-radius: 999px;
                padding: 9px 16px;
                font-family: inherit;
                font-size: 0.84rem;
                font-weight: 700;
                color: #ffffff;
                cursor: pointer;
                transition: background 0.15s ease, transform 0.15s ease;
            }

            .as-reels-nav-btn:hover {
                background: rgba(0, 0, 0, 0.85);
                transform: scale(1.04);
            }

            .as-reels-hint {
                font-size: 0.76rem;
                color: rgba(255, 255, 255, 0.65);
                text-align: center;
            }

            /* Thanh tiến trình */
            .as-reels-progress {
                position: absolute;
                left: 16px;
                right: 16px;
                bottom: 66px;
                height: 3px;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.25);
                z-index: 5;
            }

