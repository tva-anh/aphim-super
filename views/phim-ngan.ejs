                color: #ffffff !important;
                font-size: 0.88rem !important;
                font-weight: 700 !important;
                padding: 12px 14px !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 8px !important;
                cursor: pointer !important;
                transition: all 0.18s ease !important;
                white-space: nowrap !important;
            }

            .as-set-footer-btn:hover {
                background: rgba(255, 255, 255, 0.15) !important;
                border-color: rgba(255, 255, 255, 0.18) !important;
                transform: translateY(-1px) !important;
            }

            .as-set-footer-btn:active {
                transform: scale(0.97) !important;
            }

            /* 📱 TRÊN MOBILE: TẤT CẢ MENU POPOVER ĐỀU DOCK SÁT ĐÁY MÀN HÌNH ĐẦY 2 BÊN (100% WIDTH) */
            @media (max-width: 1023px) {

                .as-tool-pop,
                .as-tool-pop.as-settings-sheet-pop,
                .as-tool-pop.as-rec-settings-pop,
                #asPopSettings,
                #asRecSettingsPop,
                #asPopCc,
                #asPopDub,
                #asPopPlaylist,
                #asPopShare,
                #asPopVolume {
                    position: fixed !important;
                    bottom: 0 !important;
                    left: 0 !important;
                    right: 0 !important;
                    top: auto !important;
                    width: 100vw !important;
                    max-width: 100vw !important;
                    min-width: 100vw !important;
                    margin: 0 !important;
                    box-sizing: border-box !important;
                    border-radius: 26px 26px 0 0 !important;
                    border: 1px solid rgba(255, 255, 255, 0.1) !important;
                    border-left: none !important;
                    border-right: none !important;
                    border-bottom: none !important;
                    background: #20232a !important;
                    padding: 22px 20px calc(24px + env(safe-area-inset-bottom, 0px)) 20px !important;
                    box-shadow: 0 -24px 70px rgba(0, 0, 0, 0.92) !important;
                    z-index: 10001 !important;
                    max-height: 85vh !important;
                    overflow-y: auto !important;
                    backdrop-filter: blur(30px) saturate(160%) !important;
                    -webkit-backdrop-filter: blur(30px) saturate(160%) !important;
                }
            }

            /* [CINEMA-Z-OVERLAY] Khi trình phát mở, mọi thứ phía sau phải bị che hoàn toàn
           (đề phòng trường hợp view quên ẩn hoặc header/footer có z-index cao) */
            body:has(.as-cinema-modal.active) #asRecommendView,
            body:has(.as-cinema-modal.active) #asSearchView,
            body:has(.as-cinema-modal.active) #asLibraryView,
            body:has(.as-cinema-modal.active) #asMainHub,
            body:has(.as-cinema-modal.active) #asDramaDetailView {
                visibility: hidden !important;
            }

            /* [CINEMA-Z-OVERLAY-MINI] Mini player & các lớp nổi cũng phải ẩn khi mở rạp chiếu
           (tránh khung phim nhỏ góc dưới lộ ra che hoặc chen ngang trình phát chính) */
            body:has(.as-cinema-modal.active) .as-miniplayer,
            body:has(.as-cinema-modal.active) .as-reels-feed,
            body:has(.as-cinema-modal.active) .as-recs-view,
            body:has(.as-cinema-modal.active) .as-rec-sheet-backdrop,
            body:has(.as-cinema-modal.active) .as-rec-sheet-drawer {
                display: none !important;
            }

            /* =======================================================
           🛡️ DETAIL VIEW MASTER GUARD (BẢO VỆ TUYỆT ĐỐI CHO TRANG THÔNG TIN CHI TIẾT)
           Đảm bảo khi về trang /phim-ngan/thong-tin:
           1. Khôi phục cuộn trang 100%, hủy bỏ hoàn toàn overflow: hidden
           2. Cho phép touch/click đầy đủ (touch-action: auto, pointer-events: auto)
           3. Cưỡng chế ẩn triệt để rạp chiếu (#asTheaterModal), backdrop, và recommend view
           4. Đưa .as-detail-view lên z-index an toàn, tránh bị các lớp phủ che lấp
           ======================================================= */
            body.page-detail-mode,
            html body.page-detail-mode,
            body:has(#asDramaDetailView[style*="display: block"]),
            body:has(#asDramaDetailView[style*="display:block"]),
            body:has(#asDramaDetailView:not([style*="display: none"]):not([style*="display:none"])) {
                overflow-y: auto !important;
                overflow-x: hidden !important;
                height: auto !important;
                min-height: 100vh !important;
                touch-action: auto !important;
                -webkit-overflow-scrolling: touch !important;
                position: static !important;
            }

            html:has(body.page-detail-mode),
            html:has(body:has(#asDramaDetailView[style*="display: block"])),
            html:has(body:has(#asDramaDetailView[style*="display:block"])) {
                overflow-y: auto !important;
                height: auto !important;
            }

            /* Ẩn triệt để rạp chiếu khi không active */
            body.page-detail-mode #asTheaterModal:not(.active),
            body:has(#asDramaDetailView[style*="display: block"]) #asTheaterModal:not(.active),
            body:has(#asDramaDetailView[style*="display:block"]) #asTheaterModal:not(.active) {
                display: none !important;
                visibility: hidden !important;
                pointer-events: none !important;
                z-index: -9999 !important;
            }

            /* Ẩn triệt để recommend view khi đang ở detail */
            body.page-detail-mode #asRecommendView,
            body:has(#asDramaDetailView[style*="display: block"]) #asRecommendView,
            body:has(#asDramaDetailView[style*="display:block"]) #asRecommendView {
                display: none !important;
                visibility: hidden !important;
                pointer-events: none !important;
                z-index: -9999 !important;
            }

            /* Tắt tất cả backdrops có thể kẹt lại */
            body.page-detail-mode .as-mobile-sheet-backdrop,
            body.page-detail-mode .as-rec-sheet-backdrop,
            body:has(#asDramaDetailView[style*="display: block"]) .as-mobile-sheet-backdrop,
            body:has(#asDramaDetailView[style*="display: block"]) .as-rec-sheet-backdrop,
            body:has(#asDramaDetailView[style*="display:block"]) .as-mobile-sheet-backdrop,
            body:has(#asDramaDetailView[style*="display:block"]) .as-rec-sheet-backdrop {
                display: none !important;
                visibility: hidden !important;
                pointer-events: none !important;
                opacity: 0 !important;
                z-index: -9999 !important;
            }

            /* Đảm bảo khung chi tiết nhận tương tác và cuộn mượt mà trên mobile */
            @media (max-width: 1023px) {
                .as-detail-view {
                    position: relative !important;
                    z-index: 20 !important;
                    pointer-events: auto !important;
                    min-height: 100vh !important;
                    height: auto !important;
                }

                .as-detail-view * {
                    pointer-events: auto;
                }
            }

