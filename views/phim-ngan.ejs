                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 999px;
                padding: 10px 22px;
                font-size: 0.86rem;
                font-weight: 700;
                color: #ffffff;
                white-space: nowrap;
                box-shadow: 0 16px 40px rgba(0, 0, 0, 0.65);
                display: none;
                animation: asToolPopInCenter 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            }

            @keyframes asToolPopInCenter {
                from {
                    opacity: 0;
                    transform: translateX(-50%) translateY(-8px);
                }

                to {
                    opacity: 1;
                    transform: translateX(-50%) translateY(0);
                }
            }

            /* =======================================================
           ⛶ TOÀN MÀN HÌNH: video tràn màn hình, icon + thanh
           điều khiển lọt vào trong khung chiếu
           ======================================================= */
            .as-cinema-modal.cinema-fs .as-cinema-video-stage,
            .as-cinema-modal:fullscreen .as-cinema-video-stage {
                height: 100%;
            }

            .as-cinema-modal.cinema-fs .as-cinema-topbar,
            .as-cinema-modal:fullscreen .as-cinema-topbar {
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                background: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0));
                z-index: 40;
            }

            .as-cinema-modal.cinema-fs .as-cinema-bottom-bar-wrap,
            .as-cinema-modal:fullscreen .as-cinema-bottom-bar-wrap {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: auto;
                padding: 16px 0 18px;
                background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
                z-index: 40;
            }

            .as-cinema-modal.cinema-fs .as-cinema-video-box,
            .as-cinema-modal:fullscreen .as-cinema-video-box {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                margin: 0;
                max-width: none;
                border-radius: 0;
                background: #000000;
                border: none;
                box-shadow: none;
            }

            /* 1. KHÔNG LÀM MỜ 2 BÊN NHƯ Ở TRANG /phim-ngan/de-xuat:
           Triệt tiêu hoàn toàn quầng mờ ambient blur 2 bên khi bật toàn màn hình */
            .as-cinema-modal.cinema-fs .as-ambient-bg,
            .as-cinema-modal:fullscreen .as-ambient-bg {
                display: none !important;
                opacity: 0 !important;
                visibility: hidden !important;
                pointer-events: none !important;
            }

            /* 2. MỞ PHIM FULL MÀN CHIẾU TRÀN VIỀN NHƯ Ở TRANG /phim-ngan/de-xuat (ẢNH 1):
           Video phủ tràn 100% toàn bộ khung chiếu với object-fit: cover,
           xóa bỏ gò bó tỉ lệ 9:16 ở giữa màn hình */
            .as-cinema-modal.cinema-fs .as-cinema-video-el,
            .as-cinema-modal:fullscreen .as-cinema-video-el {
                position: absolute !important;
                inset: 0 !important;
                width: 100% !important;
                height: 100% !important;
                max-width: none !important;
                max-height: none !important;
                aspect-ratio: auto !important;
                object-fit: cover !important;
                border-radius: 0 !important;
                background: #000000 !important;
                z-index: 2 !important;
            }

            /* Phụ đề khi toàn màn hình: nổi trên video với z-index cao, vị trí và cỡ chữ được tùy chỉnh trực tiếp qua menu Cấu hình phụ đề */
            .as-cinema-modal.cinema-fs .as-cinema-video-box .as-sub-overlay,
            .as-cinema-modal:fullscreen .as-cinema-video-box .as-sub-overlay {
                z-index: 45 !important;
                pointer-events: none !important;
                position: absolute !important;
            }

            /* Đảm bảo toàn bộ menu/cửa sổ điều chỉnh (Phụ đề, Âm lượng, Thuyết minh, Cài đặt) hiển thị nổi lên trên cùng và thao tác nhạy bén khi bật toàn màn hình */
            .as-cinema-modal.cinema-fs .as-tool-pop,
            .as-cinema-modal:fullscreen .as-tool-pop {
                z-index: 10005 !important;
                pointer-events: auto !important;
            }

            /* Khi ở chế độ toàn màn hình: Ẩn sidebar để video chiếm 100% diện tích màn hình */
            .as-cinema-modal.cinema-fs .as-cinema-sidebar,
            .as-cinema-modal:fullscreen .as-cinema-sidebar {
                display: none !important;
            }

            .as-cinema-modal.cinema-fs .as-cinema-video-stage,
            .as-cinema-modal:fullscreen .as-cinema-video-stage {
                width: 100% !important;
                max-width: 100% !important;
                flex: 1 1 100% !important;
                height: 100% !important;
            }

            /* =======================================================
           🎞 MINI PLAYER: khung nhỏ góc dưới phải, phim vẫn phát
           khi user thoát về trang /phim-ngan (chuẩn ảnh mẫu)
           ======================================================= */
            .as-miniplayer {
                position: fixed;
                right: 28px;
                bottom: 28px;
                z-index: 10005;
                width: 360px;
                max-width: calc(100vw - 32px);
                display: none;
                padding: 9px 12px 9px 9px;
                background: linear-gradient(135deg, rgba(25, 30, 42, 0.94) 0%, rgba(13, 16, 24, 0.98) 100%) !important;
                backdrop-filter: blur(24px) saturate(180%);
                -webkit-backdrop-filter: blur(24px) saturate(180%);
                border: 1px solid rgba(255, 255, 255, 0.12) !important;
                border-radius: 22px;
                box-shadow: 0 18px 48px -8px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 1px 0 rgba(255, 255, 255, 0.18) !important;
                animation: asMiniIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
                box-sizing: border-box;
                user-select: none;
                -webkit-user-select: none;
                touch-action: none !important;
                cursor: grab;
                transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                will-change: transform, left, top;
            }

            .as-miniplayer:hover {
                border-color: rgba(255, 255, 255, 0.2) !important;
                box-shadow: 0 22px 56px -8px rgba(0, 0, 0, 0.88), 0 0 0 1px rgba(255, 255, 255, 0.08), inset 0 1px 1px 0 rgba(255, 255, 255, 0.22) !important;
            }

            .as-miniplayer.as-mini-dragging {
                cursor: grabbing !important;
                user-select: none !important;
                -webkit-user-select: none !important;
                transition: none !important;
                transform: scale(1.035) !important;
                box-shadow: 0 28px 70px -4px rgba(0, 0, 0, 0.95), 0 0 0 2px var(--as-lime, #a3e635), inset 0 1px 1px 0 rgba(255, 255, 255, 0.35) !important;
                will-change: transform, left, top;
            }

            .as-miniplayer.as-mini-snapping {
                transition: left 0.36s cubic-bezier(0.19, 1, 0.22, 1), top 0.36s cubic-bezier(0.19, 1, 0.22, 1), transform 0.36s cubic-bezier(0.19, 1, 0.22, 1) !important;
                will-change: transform, left, top;
            }

            /* ── Hiệu ứng chuyển view mượt mà giữa các trang ── */
            .as-view-active-enter {
                animation: asViewFadeScale 0.26s cubic-bezier(0.16, 1, 0.3, 1) both !important;
            }

            @keyframes asViewFadeScale {
                from {
                    opacity: 0;
                    transform: translateY(8px) scale(0.995);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            /* ── Micro-Interaction nảy nhẹ cho Bottom Navigation ── */
            #bottom-nav-dock.bn-phim-ngan-mode .bn-tab,
            #bottom-nav-dock.bn-phim-ngan-mode .bn-tab-center {
                transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease !important;
            }

            #bottom-nav-dock.bn-phim-ngan-mode .bn-tab:active {
                transform: scale(0.88) translateY(-1px) !important;
            }

            #bottom-nav-dock.bn-phim-ngan-mode .bn-tab-center:active .bn-center-circle {
                transform: scale(0.88) !important;
            }

            #bottom-nav-dock.bn-phim-ngan-mode .bn-tab.active .bn-tab-icon {
                animation: bnTabPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
            }

            @keyframes bnTabPop {
                0% {
                    transform: scale(0.82);
                }

                50% {
                    transform: scale(1.16);
                }

                100% {
                    transform: scale(1);
                }
            }

