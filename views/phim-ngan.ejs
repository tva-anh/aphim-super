                    function renderDetailEpisodeChunks(episodes, activeEpNo = 1) {
                        const chunkTabsWrap = document.getElementById('asDetailChunkTabs');
                        const gridWrap = document.getElementById('asDetailEpGrid');
                        if (!chunkTabsWrap || !gridWrap) return;

                        const CHUNK_SIZE = 30;
                        const totalEps = episodes.length;
                        const chunkCount = Math.ceil(totalEps / CHUNK_SIZE);
                        currentDetailActiveChunk = Math.floor((activeEpNo - 1) / CHUNK_SIZE);

                        // Render Chunk Tabs: "Tập 1 – 30", "Tập 31 – 51"...
                        chunkTabsWrap.innerHTML = '';
                        for (let i = 0; i < chunkCount; i++) {
                            const start = i * CHUNK_SIZE + 1;
                            const end = Math.min((i + 1) * CHUNK_SIZE, totalEps);
                            const btn = document.createElement('button');
                            btn.className = `as-chunk-tab ${i === currentDetailActiveChunk ? 'active' : ''}`;
                            btn.textContent = `Tập ${start} – ${end}`;
                            btn.onclick = () => {
                                currentDetailActiveChunk = i;
                                document.querySelectorAll('.as-chunk-tab').forEach((t, idx) => t.classList.toggle('active', idx === i));
                                renderDetailChunkGrid(episodes, i, CHUNK_SIZE, activeEpNo);
                            };
                            chunkTabsWrap.appendChild(btn);
                        }

                        renderDetailChunkGrid(episodes, currentDetailActiveChunk, CHUNK_SIZE, activeEpNo);
                    }

                    function renderDetailChunkGrid(episodes, chunkIndex, chunkSize, activeEpNo) {
                        const gridWrap = document.getElementById('asDetailEpGrid');
                        if (!gridWrap) return;
                        gridWrap.innerHTML = '';

                        const startIdx = chunkIndex * chunkSize;
                        const endIdx = Math.min((chunkIndex + 1) * chunkSize, episodes.length);

                        for (let i = startIdx; i < endIdx; i++) {
                            const ep = episodes[i];
                            const epNo = ep.no || (i + 1);
                            const btn = document.createElement('button');
                            btn.className = `as-detail-ep-btn as-modal-ep-btn has-sub ${epNo === activeEpNo ? 'active' : ''}`;
                            btn.dataset.ep = epNo;
                            const badgeHtml = '<span class="as-ep-badge">3s</span>';
                            const checkHtml = '<span class="as-ep-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>';
                            btn.innerHTML = `<span class="as-ep-num">${epNo}</span>${checkHtml}${badgeHtml}`;
                            btn.title = `Tập ${epNo}: Đã có Vietsub`;
                            btn.onclick = () => startPlayingFromDetail(epNo);
                            gridWrap.appendChild(btn);
                        }

                        // Đồng bộ trạng thái phụ đề đỏ/xanh ngay lập tức
                        if (currentDetailDrama) {
                            updateReadyEpisodesBadge(currentDetailDrama.id);
                        }
                    }

                    function scrollToDetailEpisodes() {
                        const wrap = document.getElementById('asDetailEpisodesWrap');
                        if (wrap) wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }

                    function getActiveDetailDrama() {
                        if (typeof currentDetailDrama !== 'undefined' && currentDetailDrama && currentDetailDrama.id) return currentDetailDrama;
                        if (typeof currentActiveDrama !== 'undefined' && currentActiveDrama && currentActiveDrama.id) return currentActiveDrama;
                        // Fallback: parse from URL
                        const m = window.location.pathname.match(/\/(?:thong-tin|xem|phim)\/([^/?#]+)/);
                        if (m && m[1]) {
                            const id = m[1];
                            if (typeof PN_DETAIL_CACHE !== 'undefined' && PN_DETAIL_CACHE.has(id)) {
                                return PN_DETAIL_CACHE.get(id);
                            }
                            const titleEl = document.getElementById('asDetailTitle');
                            const posterEl = document.getElementById('asDetailPoster');
                            return {
                                id: id,
                                title: titleEl ? titleEl.textContent : 'Phim Ngắn',
                                cover: posterEl ? posterEl.src : ''
                            };
                        }
                        return null;
                    }

                    function syncDetailActionButtons(drama) {
                        const target = drama || (typeof currentActiveDrama !== 'undefined' && currentActiveDrama && currentActiveDrama.id ? currentActiveDrama : null) || (typeof currentDetailDrama !== 'undefined' && currentDetailDrama && currentDetailDrama.id ? currentDetailDrama : null) || (typeof getActiveDetailDrama === 'function' ? getActiveDetailDrama() : null);
