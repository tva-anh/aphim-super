                        const starsCount = selectedStarScore || 5;
                        const starStr = '★'.repeat(starsCount) + '☆'.repeat(5 - starsCount);
                        const reviewsList = document.getElementById('asReviewsList');
                        const totalBadge = document.getElementById('asReviewTotalBadge');
                        const countEl = document.getElementById('asRatingCount');

                        if (reviewsList) {
                            const emptyEl = document.getElementById('asReviewsEmpty');
                            if (emptyEl) emptyEl.style.display = 'none';
                            const newCard = document.createElement('div');
                            newCard.className = 'as-review-card';
                            newCard.style.animation = 'asFadeIn 0.35s ease';
                            newCard.innerHTML = `
                    <div class="as-review-avatar" style="background:linear-gradient(135deg, #10b981, #059669);">B</div>
                    <div class="as-review-content">
                        <div class="as-review-top">
                            <div class="as-review-user-wrap">
                                <span class="as-review-username">Bạn</span>
                                <span class="as-review-badge-vip" style="background:linear-gradient(135deg, #3b82f6, #1d4ed8); color:#fff;">Vừa xong</span>
                            </div>
                            <span class="as-review-time">Vài giây trước</span>
                        </div>
                        <div class="as-review-stars">${starStr}</div>
                        <p class="as-review-text">${val.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>
                        <div class="as-review-actions-bar">
