                                                                    fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path
                                                                        d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                                                                </svg>
                                                                <span>Lưu thành danh sách phát</span>
                                                            </button>
