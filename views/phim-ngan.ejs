                        if (navigator.share) {
                            navigator.share({ title: title, url: url }).catch(() => { });
                        } else {
                            if (navigator.clipboard) {
                                navigator.clipboard.writeText(url).then(() => showToolToast('Đã sao chép liên kết chia sẻ!')).catch(() => showToolToast('Đã sao chép liên kết chia sẻ!'));
