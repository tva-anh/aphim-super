                    function switchLbSubfilter(type, btnEl) {
                        document.querySelectorAll('.as-lb-subpill').forEach(b => b.classList.remove('active'));
                        if (btnEl) btnEl.classList.add('active');
                        filterLeaderboard('rank-hot-drama', document.querySelector('.as-lb-pill.active'));
                    }

                    function savePlaylistNotification() {
                        alert('Đã lưu danh sách phát thành công vào tài khoản của bạn!');
                    }

                    // =======================================================
                    // 🌟 5. DRAMA DETAIL VIEW LOGIC (SCREENSHOT 1 & 2)
                    // =======================================================
                    let currentDetailDrama = null;
                    let currentDetailActiveChunk = 0;
                    // Tập đang được chọn trên trang chi tiết (dùng cho nút "Xem tiếp tập N" / "Xem từ tập N")
                    let currentDetailEpNo = 1;
                    let selectedStarScore = 0;
                    let dramaOriginPath = '/phim-ngan';
                    let dramaOriginView = 'home';

                    // =======================================================
                    // ⚡ TĂNG TỐC PHẢN HỒI KHI BẤM VÀO PHIM
                    //  1. Cache thông tin phim đã tải
                    //  2. Tải trước khi user rê chuột / chạm vào thẻ
                    //  3. Chuyển khung chi tiết NGAY, không đợi mạng
                    // =======================================================
                    const PN_DETAIL_CACHE = new Map();

                    function prefetchDramaDetail(dramaId) {
                        if (!dramaId || dramaId === 'undefined' || dramaId === 'null') return;
                        const _id = String(dramaId).trim();
                        if (!_id || _id.toLowerCase() === 'undefined' || _id.toLowerCase() === 'null') return;
                        if (PN_DETAIL_CACHE.has(dramaId)) return;
                        PN_DETAIL_CACHE.set(dramaId, null); // đánh dấu đang tải, tránh gọi lặp
                        fetch(`/phim-ngan/detail/${encodeURIComponent(dramaId)}`)
                            .then(r => r.json())
                            .then(j => {
                                if (j && j.success && j.data) PN_DETAIL_CACHE.set(dramaId, j.data);
                                else PN_DETAIL_CACHE.delete(dramaId);
                            })
                            .catch(() => { /* IM LANG: day chi la toi uu tuong tac */ });
                    }

                    /* Rê chuột / chạm vào thẻ phim là tải trước thông tin (không chặn tương tác) */
                    document.addEventListener('pointerover', function (ev) {
                        const el = ev.target && ev.target.closest
                            ? ev.target.closest('[onclick*="openDramaPlayer"], [onclick*="openDramaDetail"]')
                            : null;
                        if (!el) return;
                        const m = /openDrama(?:Player|Detail)\(['"]([^'"]+)['"]/.exec(el.getAttribute('onclick') || '');
                        if (m) prefetchDramaDetail(m[1]);
                    }, { passive: true });

                    /* Chuyển sang khung chi tiết ngay lập tức (không còn cảnh bười người dùng đợi) */
                    /* Chuyển sang khung chi tiết ngay lập tức (không còn cảnh bắt người dùng đợi) */
                    function switchToDetailView(dramaId, options = {}) {
                        const wantKeepMini = (options && options.keepMini === true) || miniPlayerActive;
                        if (!wantKeepMini) {
                            if (typeof stopCinemaPlayback === 'function') {
                                stopCinemaPlayback({ keepMini: false });
                            }
                            document.querySelectorAll('video').forEach(v => {
                                try {
                                    v.pause();
                                    v.muted = true;
                                    if (v._hlsInstance) {
                                        try { v._hlsInstance.stopLoad(); v._hlsInstance.detachMedia(); v._hlsInstance.destroy(); } catch (e) { }
                                        v._hlsInstance = null;
                                    }
                                    v.removeAttribute('src');
                                    v.src = '';
                                    v.load();
                                } catch (e) { }
                            });
                        } else {
                            // Đang có Mini Player: DỪNG TRIỆT ĐỂ mọi video khác (Reels, Đề xuất nền)
                            const recVideo = document.getElementById('asRecVideoElement');
                            if (recVideo) { try { recVideo.pause(); recVideo.muted = true; } catch (e) { } }
                            const reelsVideo = document.getElementById('asReelsVideo');
                            if (reelsVideo) { try { reelsVideo.pause(); reelsVideo.muted = true; } catch (e) { } }
                        }
                        if (typeof recSubPoller !== 'undefined' && recSubPoller) {
                            try { clearInterval(recSubPoller); } catch (e) { }
                            recSubPoller = null;
                        }
                        if (typeof window._asReelsAutoplayCleanup === 'function') {
                            try { window._asReelsAutoplayCleanup(); } catch (e) { }
                            window._asReelsAutoplayCleanup = null;
                        }
                        if (typeof window._asAutoplayCleanup === 'function') {
                            try { window._asAutoplayCleanup(); } catch (e) { }
                            window._asAutoplayCleanup = null;
                        }

                        document.body.classList.remove('page-recommend-mode', 'as-cinema-open', 'theater-mode-active', 'as-theater-fullscreen-active');
                        document.body.classList.add('page-detail-mode');
                        document.documentElement.classList.remove('as-cinema-open', 'theater-mode-active');

                        // Xóa triệt để các style khóa cuộn trang
                        document.body.style.overflow = '';
                        document.body.style.height = '';
                        document.body.style.touchAction = '';
                        document.documentElement.style.overflow = '';
                        document.documentElement.style.height = '';

                        const mainHub = document.getElementById('asMainHub');
                        const detailView = document.getElementById('asDramaDetailView');
                        const recView = document.getElementById('asRecommendView');
                        const sView = document.getElementById('asSearchView');
                        const libView = document.getElementById('asLibraryView');
                        const footerWrap = document.getElementById('asSiteFooterWrap');

                        // Đóng rạp chiếu nếu đang mở
                        const modal = document.getElementById('asTheaterModal');
                        if (modal) {
                            modal.classList.remove('active', 'mobile-fs', 'cinema-fs');
                            modal.style.removeProperty('display');
                            modal.style.setProperty('display', 'none', 'important');
                            modal.style.pointerEvents = 'none';
                            modal.style.zIndex = '-9999';
                        }

                        // Đóng và vô hiệu hóa tất cả backdrop/drawer
                        const mBackdrop = document.getElementById('asMobileSheetBackdrop');
                        if (mBackdrop) {
                            mBackdrop.classList.remove('active');
                            mBackdrop.style.pointerEvents = 'none';
                            mBackdrop.style.display = 'none';
                        }
                        const rBackdrop = document.getElementById('asRecSheetBackdrop');
                        if (rBackdrop) {
                            rBackdrop.classList.remove('active');
                            rBackdrop.style.pointerEvents = 'none';
                            rBackdrop.style.display = 'none';
                        }
                        if (typeof closeMobileCinemaSheet === 'function') closeMobileCinemaSheet();
                        if (typeof closeRecEpisodeDrawer === 'function') closeRecEpisodeDrawer();
                        if (typeof closeToolPop === 'function') closeToolPop();

                        if (recView) {
                            recView.style.removeProperty('display');
                            recView.style.setProperty('display', 'none', 'important');
                            recView.style.pointerEvents = 'none';
                            const recVideo = document.getElementById('asRecVideoElement');
                            if (recVideo) recVideo.pause();
                        }
                        if (mainHub) {
                            mainHub.style.removeProperty('display');
                            mainHub.style.setProperty('display', 'none', 'important');
                            mainHub.style.pointerEvents = 'none';
                        }
                        if (sView) {
                            sView.style.removeProperty('display');
                            sView.style.setProperty('display', 'none', 'important');
                            sView.style.pointerEvents = 'none';
                        }
                        if (libView) {
                            libView.style.removeProperty('display');
                            libView.style.setProperty('display', 'none', 'important');
                            libView.style.pointerEvents = 'none';
                        }
                        if (detailView) {
                            detailView.style.removeProperty('display');
                            detailView.style.setProperty('display', 'block', 'important');
                            detailView.style.removeProperty('visibility');
                            detailView.style.setProperty('visibility', 'visible', 'important');
                            detailView.style.removeProperty('opacity');
                            detailView.style.setProperty('pointer-events', 'auto', 'important');
                            detailView.classList.remove('as-view-active-enter');
                            void detailView.offsetWidth;
                            detailView.classList.add('as-view-active-enter');
                        }
                        if (footerWrap) {
                            footerWrap.style.removeProperty('display');
                            footerWrap.style.display = '';
                        }
                        if (typeof syncTopNavActive === 'function') syncTopNavActive('detail');
                        if (typeof syncBottomNavActive === 'function') syncBottomNavActive('detail');
                        if (currentDetailDrama && currentDetailDrama.title) {
                            document.title = `${currentDetailDrama.title} - Phim Ngắn | APhim`;
                        }
                        // Cuộn tức thì (scroll mượt gây cảm giác chậm khi đổi trang)
                        window.scrollTo(0, 0);
                        updateDetailBackButton();
                        const backBtn = document.getElementById('asDetailBackBtn');
                        if (backBtn) backBtn.classList.remove('is-expanded');
                        if (dramaId && (!options || !options.isPopState)) {
                            try {
                                if (!window.location.pathname.includes(`/thong-tin/${dramaId}`)) {
                                    window.history.pushState({ view: 'detail', dramaId: dramaId }, '', `/phim-ngan/thong-tin/${dramaId}`);
                                }
                            } catch (e) { }
                        }
                    }

                    /* Hiện trạng thái đang tải trong khi chờ dữ liệu */
                    function showDetailLoading() {
                        const titleEl = document.getElementById('asDetailTitle');
                        if (titleEl) {
                            titleEl.dataset.loading = '1';
                            titleEl.textContent = 'Đang tải thông tin…';
                        }
                    }

                    /* =======================================================
                       ⚡ TÌM KIẾM TỪ HEADER: KHÔNG TẢI LẠI TRANG
                       Trước đây form header submit sang /phim-ngan/tim-kiem?q=...
                       phải tải lại toàn bộ trang (EJS + ảnh + JS) rất chậm.
                       Giờ chuyển view và chạy tìm ngay tại chỗ → phản hồi tức thì.
                       ======================================================= */
                    (function bindHeaderSearch() {
                        const runSearch = (rawQ) => {
                            const q = (rawQ || '').trim();
                            if (typeof showPhimNganView === 'function') showPhimNganView('search');
                            const inp = document.getElementById('asSearchInput');
                            if (inp) inp.value = q;
                            searchState.q = q;
                            try {
                                const url = new URL(window.location.href);
                                if (q) url.searchParams.set('q', q);
                                else url.searchParams.delete('q');
                                window.history.pushState({}, '', url.toString());
                            } catch (e) { }
                            if (typeof renderSearchResults === 'function') renderSearchResults();
                            const sView = document.getElementById('asSearchView');
                            if (sView) sView.scrollIntoView({ behavior: 'auto', block: 'start' });
                            if (typeof closeMobileSearchOverlay === 'function') closeMobileSearchOverlay();
                        };

                        const wire = () => {
                            document.querySelectorAll('form[data-pn-search]').forEach(form => {
                                if (form.dataset.pnWired) return;
                                form.dataset.pnWired = '1';
                                form.addEventListener('submit', function (ev) {
                                    ev.preventDefault();
                                    const input = form.querySelector('input[name="q"]') || form.querySelector('input[type="text"]');
                                    runSearch(input ? input.value : '');
                                });
                            });

                            // Nút "Bộ lọc" trong thanh tìm kiếm: mở trang tìm kiếm ngay, khỏi tải lại
                            document.querySelectorAll('a[data-pn-filter]').forEach(a => {
                                if (a.dataset.pnWired) return;
                                a.dataset.pnWired = '1';
                                a.addEventListener('click', function (ev) {
                                    ev.preventDefault();
                                    runSearch('');
                                });
                            });
                        };

                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', wire);
                        } else {
                            wire();
                        }
                    })();

                    async function openDramaDetail(dramaId, defaultEp = 1) {
                        const mainHub = document.getElementById('asMainHub');
                        const detailView = document.getElementById('asDramaDetailView');
                        if (!detailView) return;

                        // Ghi nhớ view và URL trước đó để khi thoát chi tiết sẽ quay lại đúng trang đó
                        const curPath = window.location.pathname;
                        if (!curPath.includes('/thong-tin/') && !curPath.includes('/xem/')) {
                            dramaOriginPath = curPath + (window.location.search || '');
                            if (curPath.endsWith('/de-xuat')) dramaOriginView = 'recommend';
                            else if (curPath.endsWith('/tim-kiem')) dramaOriginView = 'search';
                            else if (curPath.endsWith('/thu-vien')) dramaOriginView = 'library';
                            else dramaOriginView = 'home';
                        }

                        // Nếu đang fullscreen (rạp chiếu / trang đề xuất) thì thoát trước,
                        // tránh lớp fullscreen kẹt lại che toàn trang khi xem chi tiết
                        cleanupTheaterFs();
                        forceExitFullscreen();

                        // ⚡ Chuyển khung NGAY để user thấy phản hồi tức thì, không đợi mạng
                        switchToDetailView(dramaId);

                        // Đã tải trước (hover) hoặc từng xem -> render tức thì, khỏi chờ
                        const cached = PN_DETAIL_CACHE.get(dramaId);
                        if (cached) {
                            currentDetailDrama = cached;
                            currentActiveDrama = cached;
                            renderDramaDetailView(cached, defaultEp);
                            updateReadyEpisodesBadge(dramaId);
                            return;
                        }

                        showDetailLoading();
                        try {
                            const res = await fetch(`/phim-ngan/detail/${encodeURIComponent(dramaId)}`);
                            const json = await res.json();
                            if (json.success && json.data) {
                                PN_DETAIL_CACHE.set(dramaId, json.data);
                                currentDetailDrama = json.data;
                                currentActiveDrama = json.data;
                                renderDramaDetailView(json.data, defaultEp);
                                updateReadyEpisodesBadge(dramaId);
                            } else {
                                alert('Không thể tải thông tin phim!');
                            }
                        } catch (err) {
                            console.error(err);
                            alert('Có lỗi xảy ra khi tải thông tin phim!');
                        }
                    }

                    /* Nhận diện nhãn nút quay lại phù hợp theo luồng điều hướng */
                    function updateDetailBackButton() {
                        const textEl = document.getElementById('asDetailBackText');
                        if (!textEl) return;

                        let label = 'Quay lại Trang chủ';
                        const origin = dramaOriginView || '';
                        const path = dramaOriginPath || window.location.pathname || '';

                        if (origin === 'search' || path.includes('/tim-kiem')) {
                            label = 'Quay lại Tìm kiếm';
                        } else if (origin === 'recommend' || path.includes('/de-xuat')) {
                            label = 'Quay lại Đề xuất';
                        } else if (origin === 'library' || path.includes('/thu-vien')) {
                            label = 'Quay lại Thư viện';
                        } else {
                            label = 'Quay lại Trang chủ';
                        }

                        textEl.textContent = label;
                    }

                    let detailBackAutoCollapseTimer = null;

                    function handleDetailBackClick(e) {
                        if (e) {
                            e.preventDefault();
                            e.stopPropagation();
                        }
                        const btn = document.getElementById('asDetailBackBtn');
                        if (!btn) {
                            backToDramaHub();
                            return;
                        }

                        // Trên mobile (màn hình <= 1023px)
                        if (window.innerWidth <= 1023) {
                            const isExpanded = btn.classList.contains('is-expanded');
                            if (!isExpanded) {
                                // Lần ấn 1: Đổ ra dài để hiển thị nhãn quay lại
                                btn.classList.add('is-expanded');

                                // Tự động thu gọn lại icon sau 4.5 giây nếu không ấn tiếp
                                clearTimeout(detailBackAutoCollapseTimer);
                                detailBackAutoCollapseTimer = setTimeout(() => {
                                    btn.classList.remove('is-expanded');
                                }, 4500);

                                // Bắt sự kiện click ra ngoài màn hình để thu gọn lại icon
                                const onOutsideClick = (evt) => {
                                    if (!btn.contains(evt.target)) {
                                        btn.classList.remove('is-expanded');
                                        clearTimeout(detailBackAutoCollapseTimer);
                                        document.removeEventListener('click', onOutsideClick, true);
                                        document.removeEventListener('touchstart', onOutsideClick, true);
                                    }
                                };
                                setTimeout(() => {
                                    document.addEventListener('click', onOutsideClick, true);
                                    document.addEventListener('touchstart', onOutsideClick, true);
                                }, 50);

                                return;
                            }
                        }

                        // Lần ấn 2 (hoặc trên desktop): Thực hiện quay về trang chủ/trang trước
                        clearTimeout(detailBackAutoCollapseTimer);
                        btn.classList.remove('is-expanded');
                        backToDramaHub();
                    }
                    window.handleDetailBackClick = handleDetailBackClick;

                    function backToDramaHub() {
                        const detailView = document.getElementById('asDramaDetailView');
                        if (detailView) {
                            detailView.style.removeProperty('display');
                            detailView.style.setProperty('display', 'none', 'important');
                        }

                        cleanupTheaterFs();

                        const targetPath = (dramaOriginPath && !dramaOriginPath.includes('/xem/') && !dramaOriginPath.includes('/thong-tin/'))
                            ? dramaOriginPath
                            : '/phim-ngan';
                        const targetView = dramaOriginView || 'home';

                        showPhimNganView(targetView);
                        try {
                            window.history.pushState({ view: targetView }, '', targetPath);
                        } catch (e) { }
                        try {
                            window.dispatchEvent(new Event('scroll'));
                        } catch (e) { }
                    }

                    function renderDramaDetailView(drama, activeEpNo = 1) {
                        if (!drama) return;
                        if (drama.title) {
                            document.title = `${drama.title} - Xem Trọn Bộ Full HD Vietsub | Phim Ngắn APhim`;
                        }
                        const posterEl = document.getElementById('asDetailPoster');
                        const titleEl = document.getElementById('asDetailTitle');
                        const genresEl = document.getElementById('asDetailGenres');
                        const metaEl = document.getElementById('asDetailMeta');
                        const synopsisEl = document.getElementById('asDetailSynopsis');
                        const playHeroLabel = document.getElementById('asPlayHeroLabel');
                        const statusLabel = document.getElementById('asDetailStatusLabel');

                        const totalEps = drama.totalEpisodes || (drama.episodes ? drama.episodes.length : 1);
                        const viewsCount = drama.stats ? (drama.stats.views || 29) : 29;

                        if (posterEl) posterEl.src = drama.cover || '';
                        if (titleEl) {
                            titleEl.textContent = drama.title;
                            delete titleEl.dataset.loading;
                        }
                        if (genresEl) {
                            genresEl.textContent = Array.isArray(drama.labels) && drama.labels.length > 0
                                ? drama.labels.join(', ')
                                : (drama.genre || 'Ngọt sủng, Cưới trước yêu sau, Huyền huyễn & Tiên hiệp, Kinh dị & Bí ẩn');
                        }
                        if (metaEl) {
                            metaEl.textContent = `${totalEps} tập · Hoàn thành · ${viewsCount} lượt xem`;
                        }
                        if (synopsisEl) {
                            synopsisEl.textContent = drama.intro || 'Arthur bị mắc kẹt trong trò chơi hôn lễ chết chóc tại Trang viên Ravenhurst. Gắn với hệ thống thoát hiểm lãng mạn, anh phải giành được tình cảm của Cô Dâu Đẫm Máu Lilith mới sống sót.';
                        }
                        if (playHeroLabel) {
                            // Ghi nhớ tập đang chọn để nút "Xem" phát đúng tập (trước đây hardcode luôn tập 1)
                            currentDetailEpNo = Math.max(1, parseInt(activeEpNo, 10) || 1);
                            playHeroLabel.textContent = currentDetailEpNo > 1 ? `Xem tiếp tập ${currentDetailEpNo}` : 'Xem từ tập 1';
                        }
                        if (statusLabel) {
                            statusLabel.textContent = `Đang xem: tập ${activeEpNo}.`;
                        }

                        // Stats row
                        const viewsEl = document.getElementById('asRatingViews');
                        if (viewsEl) viewsEl.textContent = viewsCount;

                        // Thẻ Phần + gợi ý phim
                        renderDetailParts(drama);
                        renderDetailSuggestions();

                        // Reset trạng thái thu gọn tóm tắt
                        const synWrap = document.getElementById('asDetailSynopsis');
                        if (synWrap) synWrap.classList.add('collapsed');
                        const synBtn = document.getElementById('asDetailSynopsisToggle');
                        if (synBtn) synBtn.textContent = 'xem thêm';

                        // Render Tabs Phân Đoạn Tập & Grid
                        renderDetailEpisodeChunks(drama.episodes || [], activeEpNo);

                        // Đồng bộ trạng thái các nút hành động (Yêu thích, Lưu danh sách)
                        syncDetailActionButtons(drama);
                    }

                    // Thu gọn / mở rộng bản tóm tắt
                    function toggleDetailSynopsis() {
                        const el = document.getElementById('asDetailSynopsis');
                        const btn = document.getElementById('asDetailSynopsisToggle');
                        if (!el || !btn) return;
                        const collapsed = el.classList.toggle('collapsed');
                        btn.textContent = collapsed ? 'xem thêm' : 'thu gọn';
                    }

                    // Thẻ "Phần" + meta (Screenshot 1)
                    function renderDetailParts(drama) {
                        const titleEl = document.getElementById('asDetailPartsTitle');
                        const metaEl = document.getElementById('asDetailPartsMeta');
                        const tabsEl = document.getElementById('asDetailPartTabs');
                        const totalEps = drama.totalEpisodes || (drama.episodes ? drama.episodes.length : 1);
                        const partCount = totalEps >= 100 ? 2 : 1;

                        if (titleEl) titleEl.textContent = drama.title;
                        if (metaEl) metaEl.textContent = `${partCount} phần · ${totalEps} tập`;

                        if (tabsEl) {
                            tabsEl.innerHTML = '';
                            const p1 = document.createElement('button');
                            p1.className = 'as-detail-part-tab active';
                            p1.textContent = `Phần 1 · ${totalEps} tập`;
                            tabsEl.appendChild(p1);
                            if (partCount >= 2) {
                                const p2 = document.createElement('button');
                                p2.className = 'as-detail-part-tab';
                                p2.textContent = 'Phần 2 · 0 tập';
                                p2.disabled = true;
                                tabsEl.appendChild(p2);
                            }
                        }
                    }

                    // Hàng "Có thể bạn thích" (Screenshot 3)
                    function renderDetailSuggestions() {
                        const row = document.getElementById('asDetailSuggestRow');
                        const section = document.getElementById('asDetailSuggestSection');
                        if (!row) return;
