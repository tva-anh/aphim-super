                                            <div class="as-scroll-arrows">
                                                <button class="as-arrow-btn"
                                                    onclick="scrollCarousel('asTop10Carousel', -320)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2.5">
                                                        <polyline points="15 18 9 12 15 6" />
                                                    </svg>
                                                </button>
                                                <button class="as-arrow-btn"
                                                    onclick="scrollCarousel('asTop10Carousel', 320)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2.5">
                                                        <polyline points="9 18 15 12 9 6" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="as-top10-carousel" id="asTop10Carousel">
                                            <% topTenList.forEach((d, idx)=> { %>
                                                <div class="as-top10-item" onclick="openDramaDetail('<%= d.id %>')">
