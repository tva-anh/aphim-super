<body
    class="page-phim-ngan <%= (typeof pnView !== 'undefined' && pnView === 'recommend') ? 'page-recommend-mode' : '' %> <%= (typeof viewMode !== 'undefined' && viewMode === 'detail') ? 'page-detail-mode' : '' %> <%= (typeof viewMode !== 'undefined' && viewMode === 'player') ? 'page-player-mode' : '' %>"
    <%- (typeof viewMode !=='undefined' && viewMode==='player' ) ? ' style="overflow:hidden;"' : '' %>>
    <script>
        /* Đồng bộ ẩn floating dock khi đang xem rạp chiếu / reels toàn màn hình */
        (function () {
            var sync = function () {
                try {
                    var cinema = document.getElementById('asTheaterModal');
                    var reels = document.getElementById('asReelsFeed');
                    var busy = !!(cinema && cinema.classList.contains('active')) ||
                        !!(reels && reels.classList.contains('active'));
                    document.documentElement.classList.toggle('as-cinema-open', busy);
                } catch (e) { }
            };
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', sync);
            } else { sync(); }
            var mo = new MutationObserver(sync);
            document.addEventListener('DOMContentLoaded', function () {
                var cinema = document.getElementById('asTheaterModal');
                var reels = document.getElementById('asReelsFeed');
                if (cinema) mo.observe(cinema, { attributes: true, attributeFilter: ['class'] });
                if (reels) mo.observe(reels, { attributes: true, attributeFilter: ['class'] });
            });
        })();
    </script>

    <script>
        <% if (typeof initialDbLibrary !== 'undefined' && initialDbLibrary) { %>
            window._pnMongoLibrary = {
                loaded: true,
                loggedIn: true,
                history: <%- JSON.stringify(initialDbLibrary.history || []) %>,
                favorites: <%- JSON.stringify(initialDbLibrary.favorites || []) %>,
                playlists: <%- JSON.stringify(initialDbLibrary.playlists || []) %>
            };
        <% } else { %>
            window._pnMongoLibrary = null;
        <% } %>
    </script>

    <% if (typeof pnView !=='undefined' && ['recommend', 'search', 'library'].includes(pnView)) { %>
        <!-- Trang riêng: /de-xuat, /tim-kiem, /thu-vien → hiện đúng view, ẩn hub -->
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof showPhimNganView === 'function') showPhimNganView(<%- JSON.stringify(pnView) %>);
            });
        </script>
        <% } %>

            <!-- Main Header (Hidden on AllShorts via CSS) -->
            <%- include('partials/header') %>

                <!-- Dedicated AllShorts Header (Screenshot 1) -->
                <header class="as-top-navbar">
                    <div class="as-nav-left">
                        <a href="/phim-ngan" class="as-brand-logo">
                            <svg class="as-brand-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <rect x="3" y="8" width="4" height="8" rx="2" fill="#a3e635" />
                                <rect x="10" y="3" width="4" height="18" rx="2" fill="#a3e635" />
                                <rect x="17" y="6" width="4" height="12" rx="2" fill="#bef264" />
                            </svg>
                            <span class="as-brand-text">allshorts</span>
                        </a>
                        <nav class="as-nav-links">
                            <a href="/phim-ngan"
                                class="as-nav-link <%= (typeof pnView === 'undefined' || !pnView || pnView === 'home') ? 'active' : '' %>"
                                onclick="return handlePhimNganTabClick(event, 'home');">Trang chủ</a>
                            <a href="/phim-ngan/de-xuat"
                                class="as-nav-link <%= (typeof pnView !== 'undefined' && pnView === 'recommend') ? 'active' : '' %>"
                                onclick="return handlePhimNganTabClick(event, 'recommend');">Đề xuất</a>
                            <a href="/phim-ngan/tim-kiem"
                                class="as-nav-link <%= (typeof pnView !== 'undefined' && pnView === 'search') ? 'active' : '' %>"
                                onclick="return handlePhimNganTabClick(event, 'search');">Tìm kiếm</a>
                            <a href="/phim-ngan/thu-vien"
                                class="as-nav-link <%= (typeof pnView !== 'undefined' && pnView === 'library') ? 'active' : '' %>"
                                onclick="return handlePhimNganTabClick(event, 'library');">Thư viện</a>
                        </nav>
                    </div>

                    <div class="as-nav-right">
                        <div class="as-nav-search-wrap">
                            <input type="text" class="as-nav-search-input" placeholder="Tìm phim, thể loại..."
                                onkeyup="if(event.key==='Enter')document.getElementById('asNewReleasesList').scrollIntoView({behavior:'smooth'})">
                            <button class="as-nav-search-btn">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.5">
                                    <circle cx="11" cy="11" r="8" />
                                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                                </svg>
                            </button>
                        </div>

                        <button class="as-btn-install-app"
                            onclick="alert('Ứng dụng AllShorts đã sẵn sàng trên Android & iOS!')">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="7 10 12 15 17 10" />
                                <line x1="12" y1="15" x2="12" y2="3" />
                            </svg>
                            <span>Cài app</span>
                        </button>

                        <button class="as-nav-circle-btn" title="Ngôn ngữ"
                            onclick="alert('Ngôn ngữ hiện tại: Tiếng Việt')">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="2" y1="12" x2="22" y2="12" />
                                <path
                                    d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                            </svg>
                        </button>

                        <button class="as-nav-circle-btn as-nav-bell" title="Thông báo"
                            onclick="alert('Bạn không có thông báo mới')">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                            </svg>
                            <span class="as-nav-bell-dot"></span>
                        </button>

                        <div class="as-nav-avatar" title="Tài khoản cá nhân" onclick="alert('Tài khoản: Khách APhim')">
                            <img src="/images/avatar-default.png"
                                onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=AllShorts'"
                                alt="Avatar">
                        </div>
                    </div>
                </header>

                <main class="as-container" id="asMainHub"
                    style="<%= (typeof pnView !== 'undefined' && pnView && pnView !== 'home') ? 'display:none;' : '' %>">
                    <!-- =======================================================
             1. HERO SHOWCASE SLIDER (SCREENSHOT 1)
             ======================================================= -->
                    <% if (heroDramas && heroDramas.length> 0) {
                        const primaryHero = heroDramas[0];
                        %>
