                        <script>
                            function switchMovieTab(tabName) {
                                var panels = document.querySelectorAll('.ap-tab-panel');
                                panels.forEach(function (p) { p.classList.add('hidden'); });

                                var btns = document.querySelectorAll('.ap-tab-btn');
                                btns.forEach(function (b) {
                                    b.classList.remove('text-[#fcd576]', 'border-[#fcd576]', 'active');
                                    b.classList.add('text-white/85', 'border-transparent', 'font-bold');
                                });

                                var targetPanel = document.getElementById('tab-panel-' + tabName);
                                if (targetPanel) {
                                    targetPanel.classList.remove('hidden');
                                }

                                var targetBtn = document.getElementById('tab-btn-' + tabName);
                                if (targetBtn) {
                                    targetBtn.classList.remove('text-white/85', 'text-gray-400', 'border-transparent');
                                    targetBtn.classList.add('text-[#fcd576]', 'border-[#fcd576]', 'font-bold', 'active');
                                }
                            }

                            function toggleMobileMoreMovieInfo() {
                                var details = document.getElementById('movie-expandable-details');
                                var text = document.getElementById('toggleMoreMovieInfoText');
                                var icon = document.getElementById('toggleMoreMovieInfoIcon');
                                if (!details) return;
                                var isHidden = details.classList.contains('hidden');
                                if (isHidden) {
                                    details.classList.remove('hidden');
                                    details.classList.add('flex');
                                    if (text) text.textContent = 'Thu gọn';
                                    if (icon) icon.style.transform = 'rotate(180deg)';
                                } else {
                                    details.classList.add('hidden');
                                    details.classList.remove('flex');
                                    if (text) text.textContent = 'Xem thêm';
                                    if (icon) icon.style.transform = 'rotate(0deg)';
                                }
                            }

                            // Toggle 6 ô metadata trên Desktop (Xem thêm / Thu gọn)
                            function toggleDesktopMeta() {
                                var container = document.getElementById('movie-metadata-container');
                                var text = document.getElementById('toggleDesktopMetaText');
                                var icon = document.getElementById('toggleDesktopMetaIcon');
                                if (!container) return;
                                // dùng inline display để override class hidden
                                var isHidden = container.style.display === 'none' || container.style.display === '';
                                if (isHidden) {
                                    container.style.display = 'block';
                                    container.classList.remove('hidden');
                                    if (text) text.textContent = 'Thu gọn';
                                    if (icon) icon.style.transform = 'rotate(180deg)';
                                } else {
                                    container.style.display = 'none';
                                    container.classList.add('hidden');
                                    if (text) text.textContent = 'Xem thêm';
                                    if (icon) icon.style.transform = 'rotate(0deg)';
                                }
                            }
                        </script>

