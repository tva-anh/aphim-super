            <script>
                (function () {
                    var _prewarmed = false;
                    function prewarmWatchAssets() {
                        if (_prewarmed) return;
                        _prewarmed = true;
                        var assets = [
                            { href: '/css/watch-page.css?v=340', as: 'style' },
                            { href: '/js/watch.js?v=10098', as: 'script' }
                        ];
                        assets.forEach(function (item) {
                            try {
                                var link = document.createElement('link');
                                link.rel = 'prefetch';
                                link.as = item.as;
                                link.href = item.href;
                                document.head.appendChild(link);
                            } catch (e) { }
                        });
                    }

                    // Kích hoạt nạp trước tài nguyên xem phim KHI người dùng có ý định xem (Rê chuột hoặc chạm vào nút Xem Ngay hoặc Danh sách tập)
                    function attachIntentListeners() {
                        var watchBtn = document.getElementById('watchNowBtn');
                        if (watchBtn) {
                            watchBtn.addEventListener('mouseenter', prewarmWatchAssets, { passive: true, once: true });
                            watchBtn.addEventListener('touchstart', prewarmWatchAssets, { passive: true, once: true });
                        }
                        var epDesktop = document.getElementById('episodes-desktop');
                        if (epDesktop) {
                            epDesktop.addEventListener('mouseenter', prewarmWatchAssets, { passive: true, once: true });
                            epDesktop.addEventListener('touchstart', prewarmWatchAssets, { passive: true, once: true });
                        }
                        var reviewBtn = document.getElementById('headerRatingBtn');
                        if (reviewBtn) {
                            var prefetchReview = function () {
                                if (reviewBtn.dataset.prefetched) return;
                                reviewBtn.dataset.prefetched = 'true';
                                try {
                                    var l = document.createElement('link');
                                    l.rel = 'prefetch';
                                    l.href = reviewBtn.href;
                                    document.head.appendChild(l);
                                } catch (_) {}
                            };
                            reviewBtn.addEventListener('mouseenter', prefetchReview, { passive: true, once: true });
                            reviewBtn.addEventListener('touchstart', prefetchReview, { passive: true, once: true });
                        }
                    }
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', attachIntentListeners);
                    } else {
                        attachIntentListeners();
                    }
                })();
            </script>
