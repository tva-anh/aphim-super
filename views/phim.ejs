                            <div class="flex flex-wrap items-center gap-2 sm:gap-3 md:gap-4 flex-1 min-w-0">
                                <%
                                    let directWatchUrl = `/xem-phim/${typeof slug !== 'undefined' ? slug : ''}`;
                                    if (typeof movie !== 'undefined' && movie) {
                                        const isSingle = Boolean(
                                            movie.type === 'single' ||
                                            movie.type === 'movie' ||
                                            movie.chieu_rap === true ||
                                            movie.is_cinema === true ||
                                            String(movie.episode_total || '').trim() === '1' ||
