                                            })) ||
                                            (Array.isArray(movie.episodes) && movie.episodes.length > 0 && Math.max(...movie.episodes.map(s => (s.server_data || []).length)) === 1)
                                        );

                                        const reqVer = (typeof reqVersion !== 'undefined' && reqVersion ? String(reqVersion) : ((typeof req !== 'undefined' && req && req.query) ? String(req.query.version || '') : '')).toLowerCase();
                                        let catSlug = '';
                                        let epClean = '1';
                                        const epList = (typeof episodes !== 'undefined' && episodes && episodes.length > 0) ? episodes : (movie && movie.episodes ? movie.episodes : []);
                                        if (epList && epList.length > 0) {
                                            const firstVietsub = epList.find(s => {
                                                const sName = (s.original_server_name || s.server_name || '').toLowerCase();
                                                return !sName.includes('song ngữ') && !sName.includes('song ngu') && !sName.includes('bilingual') && !sName.includes('thuyết minh') && !sName.includes('lồng tiếng');
                                            });
                                            let s0 = firstVietsub || epList[0];
                                            if (reqVer === 'song-ngu') {
                                                const snMatch = epList.find(s => ((s.original_server_name || s.server_name || '').toLowerCase().includes('song ngữ') || (s.original_server_name || s.server_name || '').toLowerCase().includes('bilingual')));
                                                if (snMatch) { s0 = snMatch; catSlug = '-song-ngu'; }
                                            }
                                            if (s0 && s0.server_data && s0.server_data.length > 0) {
                                                const ep0 = s0.server_data[0];
                                                epClean = String(ep0.slug || '1').replace(/^tap-/, '').replace(/-song-ngu$/, '');
                                                if (!catSlug) {
                                                    const sName = (s0.original_server_name || s0.server_name || '').toLowerCase();
