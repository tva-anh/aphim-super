<body class="page-phim-detail bg-[#1f2331] text-gray-100 font-display min-h-screen w-full">
    <!-- Full-Bleed Movie Backdrop Hero Image Behind Header (Top 0 Pinned to Viewport Top) -->
    <div class="movie-hero-backdrop-wrap absolute top-0 left-0 right-0 w-full h-[620px] sm:h-[680px] lg:h-[980px] xl:h-[1040px] 2xl:h-[1100px] z-0 overflow-hidden pointer-events-none">
        <div class="relative w-full h-full bg-transparent">
            <%
                let ssrBackdropUrl = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
                let rawOriginBd = '';
                if (typeof movie !== 'undefined' && movie) {
                    if (movie.backdrop_url) {
                        ssrBackdropUrl = movie.backdrop_url;
                        rawOriginBd = movie.backdrop_url;
                    } else {
                        let rawBd = (movie.thumb_url || movie.poster_url || '').trim();
                        if (rawBd) {
                            rawBd = rawBd.replace(/(?:https?:\/\/[^\/]+)?\/?(?:uploads\/movies\/)+(upload\/vod\/)/, '$1');
                            if (rawBd.startsWith('http://') || rawBd.startsWith('https://')) {
                                rawOriginBd = rawBd;
                            } else {
                                let cleanBd = rawBd.replace(/^\//, '');
                                if (cleanBd.startsWith('img/')) {
                                    rawOriginBd = 'https://oncdn.vip/' + cleanBd;
                                } else if (cleanBd.startsWith('upload/') || cleanBd.startsWith('uploads/')) {
                                    rawOriginBd = 'https://phimimg.com/' + cleanBd;
                                } else {
                                    rawOriginBd = 'https://phimimg.com/uploads/movies/' + cleanBd;
                                }
                            }
                            ssrBackdropUrl = rawOriginBd;
                        }
                    }
                }
            %>
            <img id="movieHeroBackdrop" alt="Background"
                class="w-full h-full object-cover object-top transition-opacity duration-300 opacity-70 lg:opacity-40"
                src="<%= ssrBackdropUrl %>"
                data-fallback="<%= rawOriginBd %>"
                onerror="if(!this.dataset.tried && this.dataset.fallback){this.dataset.tried='1';this.src=this.dataset.fallback;}"
                fetchpriority="high" />

            <!-- ⚡ Zero-Latency Hydration: Nếu đã có ảnh sắc nét trong cache thì nạp tức thì 0ms không phải chờ -->
            <script>
                (function(){
                    try {
                        var slug = '<%= slug %>';
                        var el = document.getElementById('movieHeroBackdrop');
                        if (el && el.src && el.src.indexOf('image.tmdb.org') !== -1) return;
                        var c = sessionStorage.getItem('tmdb_hero_v5_' + slug) || localStorage.getItem('tmdb_hero_v5_' + slug);
                        if (c) {
                            var d = JSON.parse(c);
                            if (d && d.backdrop && el) {
                                el.src = d.backdrop;
                            }
                        }
                    } catch(e) {}
                })();
            </script>

            <div class="absolute inset-0 backdrop-gradient"></div>
            <div class="absolute inset-0 hero-dot-overlay" aria-hidden="true"></div>
        </div>
