                                                    else if (sName.includes('lồng tiếng') || sName.includes('long tieng')) catSlug = '-long-tieng';
                                                }
                                            }
                                        }

                                        if (isSingle) {
                                            directWatchUrl = `/xem-phim/${movie.slug}/full${catSlug}`;
                                        } else {
                                            directWatchUrl = `/xem-phim/${movie.slug}/tap-${epClean || '1'}${catSlug}`;
                                        }
                                    }
                                %>
