<!DOCTYPE html>
<html class="dark" lang="vi">

<head>
    <%- include('partials/head') %>
        <script id="dotlottie-script" src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.9.14/dist/dotlottie-wc.js"
            type="module"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js" defer></script>
        <style>
            /* ─── FULL SEAMLESS ZERO-PADDING BODY ON /phim (BACKDROP AT TOP 0) ─── */
            body.page-phim-detail,
            html:not(.light-mode) body.page-phim-detail {
                padding-top: 0 !important;
                background-color: #1f2331 !important;
                background: #1f2331 !important;
                color: #f1f5f9;
            }

            html.light-mode body.page-phim-detail {
                padding-top: 0 !important;
                background-color: #f5f0e6 !important;
                background: #f5f0e6 !important;
                color: #1c1917 !important;
            }

            main.movie-content-zone {
                background: transparent !important;
                padding-top: 84px !important;
            }

            /* ─── TRANSPARENT HEADER ON /phim (CINEMATIC BACKDROP PASSTHROUGH) ─── */
            body.page-phim-detail #sofa-header:not(.scrolled),
            body.page-phim-detail header#sofa-header:not(.scrolled),
            body.page-phim-detail header:not(.scrolled) {
                background: transparent !important;
                background-color: transparent !important;
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
                border: none !important;
                border-bottom: none !important;
                box-shadow: none !important;
                transition: background 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                    background-color 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                    backdrop-filter 0.35s ease,
                    -webkit-backdrop-filter 0.35s ease,
                    border-color 0.35s ease,
                    box-shadow 0.35s ease !important;
            }

            /* Scrolled state */
            body.page-phim-detail #sofa-header.scrolled,
            body.page-phim-detail header#sofa-header.scrolled {
                background: rgba(13, 18, 30, 0.9) !important;
                backdrop-filter: blur(20px) saturate(180%) !important;
                -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.55) !important;
            }

            html.light-mode body.page-phim-detail #sofa-header.scrolled,
            html.light-mode body.page-phim-detail header#sofa-header.scrolled {
                background: rgba(245, 240, 230, 0.94) !important;
                backdrop-filter: blur(20px) saturate(180%) !important;
                -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
                border-bottom: 1px solid #e7e0d3 !important;
                box-shadow: 0 4px 20px rgba(78, 64, 45, 0.08) !important;
            }

            /* 🎨 DEFAULT: HORIZONTAL BACKDROP GRADIENT (Fades lower, shows more image) 🎨 */
            .backdrop-gradient,
            html:not(.light-mode) .backdrop-gradient {
                background: linear-gradient(180deg,
                        rgba(15, 23, 42, 0.35) 0%,
                        rgba(15, 23, 42, 0.05) 40%,
                        rgba(31, 35, 49, 0.4) 70%,
                        rgba(31, 35, 49, 0.95) 90%,
                        #1f2331 100%) !important;
            }

            html.light-mode .backdrop-gradient {
                background: linear-gradient(180deg,
                        rgba(30, 25, 20, 0.25) 0%,
                        rgba(30, 25, 20, 0.02) 40%,
                        rgba(245, 240, 230, 0.4) 70%,
                        rgba(245, 240, 230, 0.95) 90%,
                        #f5f0e6 100%) !important;
            }

            /* 🎨 AGGRESSIVE: VERTICAL BACKDROP GRADIENT (Fades earlier to cover stretched image) 🎨 */
            .is-vertical-bg .backdrop-gradient,
            html:not(.light-mode) .is-vertical-bg .backdrop-gradient {
                background: linear-gradient(180deg,
                        rgba(15, 23, 42, 0.35) 0%,
                        rgba(15, 23, 42, 0.05) 20%,
                        rgba(31, 35, 49, 0.98) 45%,
                        #1f2331 60%,
                        #1f2331 100%) !important;
            }

            html.light-mode .is-vertical-bg .backdrop-gradient {
                background: linear-gradient(180deg,
                        rgba(30, 25, 20, 0.25) 0%,
                        rgba(30, 25, 20, 0.02) 20%,
                        rgba(245, 240, 230, 0.98) 45%,
                        #f5f0e6 60%,
                        #f5f0e6 100%) !important;
            }

            /* Removed #movieHeroBackdrop explicit filters to allow Tailwind blur classes to work */

            /* 📱 Mobile Movie Detail Backdrop: Extend long down across poster, title and buttons */
            @media (max-width: 768px) {
                .movie-hero-backdrop-wrap {
                    height: 980px !important;
                    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 82%, transparent 100%) !important;
                    mask-image: linear-gradient(to bottom, black 0%, black 82%, transparent 100%) !important;
                }

                html.light-mode .backdrop-gradient {
                    background: linear-gradient(180deg,
                            rgba(30, 25, 20, 0.22) 0%,
                            rgba(30, 25, 20, 0.04) 30%,
                            rgba(245, 240, 230, 0.85) 75%,
                            #f5f0e6 90%,
                            #f5f0e6 100%) !important;
                }

                html:not(.light-mode) .backdrop-gradient {
                    background: linear-gradient(180deg,
                            rgba(15, 23, 42, 0.3) 0%,
                            rgba(15, 23, 42, 0.06) 30%,
                            rgba(31, 35, 49, 0.85) 75%,
                            #1f2331 90%,
                            #1f2331 100%) !important;
                }
            }

            .custom-scrollbar::-webkit-scrollbar,
            .scrollbar-hide::-webkit-scrollbar {
                width: 0px !important;
                height: 0px !important;
                display: none !important;
            }

            .scrollbar-hide {
                scrollbar-width: none !important;
                -ms-overflow-style: none !important;
            }

            /* Mobile Action Buttons Symmetrical 3x2 Grid Alignment */
            @media (max-width: 639px) {
                .movie-actions-container {
                    display: grid !important;
                    grid-template-columns: repeat(3, 1fr) !important;
                    gap: 8px !important;
                    width: 100% !important;
                    margin-top: 12px !important;
                    margin-bottom: 16px !important;
                }

                .movie-actions-container>div:first-child,
                .movie-actions-container>div.ml-auto {
                    display: contents !important;
                }

                .movie-actions-container a,
                .movie-actions-container button,
                .movie-actions-container #watchNowBtn,
                .movie-actions-container #headerRatingBtn {
                    grid-column: span 1 / span 1 !important;
                    width: 100% !important;
                    margin-left: 0 !important;
                    height: 40px !important;
                    padding: 0 4px !important;
                    justify-content: center !important;
                    font-size: 11.5px !important;
                    box-sizing: border-box !important;
                }

                /* Thứ tự hàng nút 1 trên mobile: Lưu phim (trái) -> XEM NGAY (giữa) -> Thêm vào (phải) */
                .movie-actions-container #favoriteMovieBtn {
                    order: 1 !important;
                }

                .movie-actions-container #watchNowBtn {
                    order: 2 !important;
                }

                .movie-actions-container #saveMovieBtn {
                    order: 3 !important;
                }

                .movie-actions-container>div:first-child>button:nth-child(4) {
                    order: 4 !important;
                }

                .movie-actions-container>div:first-child>button:nth-child(5) {
                    order: 5 !important;
                }

                .movie-actions-container #headerRatingBtn {
                    order: 6 !important;
                }
            }
        </style>
</head>

<body class="page-phim-detail bg-[#1f2331] text-gray-100 font-display min-h-screen w-full">
    <!-- Ambient Background (7 Orbs for Full Coverage) -->
    <div class="ambient-bg">
        <div class="ambient-orb ambient-orb-1"></div>
        <div class="ambient-orb ambient-orb-2"></div>
        <div class="ambient-orb ambient-orb-3"></div>
        <div class="ambient-orb ambient-orb-4"></div>
        <div class="ambient-orb ambient-orb-5"></div>
        <div class="ambient-orb ambient-orb-6"></div>
        <div class="ambient-orb ambient-orb-7"></div>
        <div class="ambient-noise"></div>
        <div class="ambient-grain"></div>
    </div>
    <!-- Navigation -->
    <%- include('partials/header') %>

        <script>
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });
            }
        </script>

        <main
            class="relative pt-[78px] sm:pt-[86px] min-h-screen pb-20 movie-content-zone overflow-x-hidden w-full max-w-[100vw] m-0">
            <!-- Full-Bleed Movie Backdrop Hero Image Behind Header (Top 0 to Hero Bottom) -->
            <div class="movie-hero-backdrop-wrap absolute top-0 left-0 right-0 w-full h-[620px] sm:h-[680px] lg:h-[750px] z-0 overflow-hidden pointer-events-none"
                style="-webkit-mask-image: linear-gradient(to bottom, black 0%, black 88%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, black 88%, transparent 100%);">
                <div class="relative w-full h-full bg-transparent">
                    <img id="movieHeroBackdrop" alt="Background"
                        class="w-full h-full object-cover object-center transition-opacity duration-700 opacity-70 lg:opacity-40 blur-xl lg:blur-2xl"
                        src="<%= typeof movie !== 'undefined' && movie && (movie.thumb_url || movie.poster_url) ? ((movie.thumb_url || movie.poster_url).startsWith('http') ? (movie.thumb_url || movie.poster_url) : 'https://phimimg.com/' + (movie.thumb_url || movie.poster_url).replace(/^\//, '')) : 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7' %>"
                        fetchpriority="high" />
                    <div class="absolute inset-0 backdrop-gradient"></div>
                </div>
            </div>

            <div class="app-container relative z-10">
                <div
                    class="movie-breadcrumb-bar flex items-center flex-nowrap gap-1.5 sm:gap-2 text-xs sm:text-sm mb-3 sm:mb-6 font-bold overflow-hidden whitespace-nowrap w-full max-w-full [text-shadow:0_1px_4px_rgba(0,0,0,0.8)]">
                    <a class="text-white/80 hover:text-[#fcd576] transition-colors flex-shrink-0 font-bold whitespace-nowrap"
                        href="/">Trang chủ</a>
                    <span class="material-icons-round text-base text-white/60 flex-shrink-0">chevron_right</span>
                    <span id="breadcrumb-movie-name" class="text-white font-bold truncate flex-1 min-w-0"></span>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8 xl:gap-10 mt-0 relative z-10">
                    <div class="lg:col-span-4 xl:col-span-3 flex flex-col gap-4 lg:gap-6">
                        <style>
                            .custom-mobile-poster {
                                width: 100%;
                                max-width: 240px;
                                margin: 0 auto;
                            }

                            @media (min-width: 640px) {
                                .custom-mobile-poster {
                                    max-width: 260px;
                                }
                            }

                            @media (min-width: 1024px) {
                                .custom-mobile-poster {
                                    max-width: 275px;
                                    margin: 0;
                                }
                            }
                        </style>
                        <div
                            class="custom-mobile-poster mx-auto lg:mx-0 relative aspect-[2/3] rounded-[20px] lg:rounded-2xl overflow-hidden shadow-2xl shadow-black/90 lg:shadow-black/50 group bg-transparent">
                            <img id="movieDetailPoster" alt="Poster"
                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                                src="<%= typeof movie !== 'undefined' && movie && (movie.poster_url || movie.thumb_url) ? (movie.poster_url || movie.thumb_url) : 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7' %>"
                                fetchpriority="high" />
                            <div id="posterQualityBadge"
                                class="absolute top-4 left-4 text-xs font-bold px-3 py-1 rounded shadow-lg uppercase tracking-wider cinematic-gold-badge">
                                Full HD</div>
                        </div>
                        <!-- DESKTOP EPISODES (Hidden on mobile) -->
                        <div class="hidden lg:block w-full mt-2 sm:mt-3">
                            <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-3 movie-section-heading">
                                Danh sách tập phim
                            </h2>
                            <!-- Thanh tìm kiếm tập phim (Desktop) -->
                            <div id="episode-search-desktop" class="flex items-center gap-2 mb-4 w-full"
                                style="display: none;">
                                <div class="relative flex-1 w-full">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        class="absolute top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"
                                        style="left: 10px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                        stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                    </svg>
                                    <input type="text" id="search-episode-input-desktop" placeholder="Tìm tập..."
                                        class="w-full bg-white/5 border border-white/10 rounded-lg py-2 pr-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-[#fcd576]/50 transition-colors"
                                        style="padding-left: 32px !important;">
                                </div>
                                <button id="sort-episodes-btn-desktop"
                                    class="flex-shrink-0 bg-white/5 border border-white/10 rounded-lg w-[38px] h-[38px] flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                                    <span class="material-icons-round text-[18px]">swap_vert</span>
                                </button>
                            </div>

                            <!-- Grid 2 cột cân xứng 2 bên -->
                            <div class="max-h-[400px] overflow-y-auto custom-scrollbar pr-1 pb-2 w-full">
                                <div class="grid grid-cols-2 gap-2.5 w-full" id="episodes-desktop">
                                    <!-- JS will render episodes here -->
                                </div>
                            </div>
                        </div>

                        <!-- Top phim tuần này (Nằm ở Cột trái, canh ngang mục Diễn viên bên cột phải) -->
                        <aside id="top-weekly-sidebar" class="hidden lg:block w-full mt-6">
                            <!-- Nội dung được render từ js/top-weekly-sidebar.js -->
                        </aside>
                    </div>

                    <div
                        class="lg:col-span-8 xl:col-span-9 w-full min-w-0 flex flex-col justify-start items-start pb-0 text-left -mt-2 lg:mt-0">
                        <style>
                            .cinematic-gold-title {
                                font-family: 'Space Grotesk', 'Be Vietnam Pro', system-ui, sans-serif !important;
                                font-weight: 900 !important;
                                color: #ffffff !important;
                                -webkit-text-fill-color: #ffffff !important;
                                display: inline-block !important;
                                -webkit-font-smoothing: antialiased !important;
                                -moz-osx-font-smoothing: grayscale !important;
                                text-rendering: optimizeLegibility !important;
                                text-shadow: 0 2px 10px rgba(0, 0, 0, 0.95), 0 1px 3px rgba(0, 0, 0, 0.9) !important;
                                letter-spacing: -0.01em !important;
                                line-height: 1.2 !important;
                            }

                            html.light-mode .cinematic-gold-title {
                                color: #1c1917 !important;
                                -webkit-text-fill-color: #1c1917 !important;
                                text-shadow: none !important;
                            }

                            .cinematic-sub-title {
                                font-family: 'Space Grotesk', 'Be Vietnam Pro', system-ui, sans-serif !important;
                                font-weight: 700 !important;
                                color: #fcd576 !important;
                                -webkit-font-smoothing: antialiased !important;
                                -moz-osx-font-smoothing: grayscale !important;
                                text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9) !important;
                                letter-spacing: 0.5px !important;
                                display: block !important;
                                margin-top: 4px !important;
                                line-height: 1.3 !important;
                            }

                            html.light-mode .cinematic-sub-title {
                                color: #d97706 !important;
                                -webkit-text-fill-color: #d97706 !important;
                                text-shadow: none !important;
                            }

                            .cinematic-gold-btn {
                                background: linear-gradient(135deg, #FFEFA6 0%, #FCD576 40%, #D69F3D 100%) !important;
                                color: #ffffff !important;
                                font-weight: 800 !important;
                                box-shadow: 0 6px 20px rgba(214, 159, 61, 0.45) !important;
                                border: none !important;
                                outline: none !important;
                                text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6) !important;
                                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
                            }

                            .cinematic-gold-btn * {
                                color: #ffffff !important;
                                text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6) !important;
                            }

                            .cinematic-gold-btn:hover {
                                background: linear-gradient(135deg, #FFF6C8 0%, #FFE08C 40%, #E5AA45 100%) !important;
                                box-shadow: 0 8px 25px rgba(214, 159, 61, 0.65) !important;
                                transform: translateY(-2px) !important;
                                border: none !important;
                            }

                            .cinematic-gold-badge {
                                background: linear-gradient(135deg, #FFEFA6 0%, #FCD576 45%, #D69F3D 100%) !important;
                                color: #0d0f1a !important;
                                font-weight: 900 !important;
                                box-shadow: 0 4px 14px rgba(214, 159, 61, 0.5), inset 0 1px 2px rgba(255, 255, 255, 0.6) !important;
                                border: 1px solid rgba(255, 255, 255, 0.4) !important;
                                letter-spacing: 1px !important;
                            }

                            .cinematic-gold-bar {
                                background: linear-gradient(to bottom, #FFF4B8 0%, #FCD576 50%, #D69F3D 100%) !important;
                                box-shadow: 0 0 12px rgba(252, 213, 118, 0.6), 0 0 4px rgba(214, 159, 61, 0.8) !important;
                                border-radius: 9999px !important;
                            }

                            .cinematic-gold-rating {
                                background: linear-gradient(135deg, rgba(214, 159, 61, 0.2) 0%, rgba(252, 213, 118, 0.1) 100%) !important;
                                color: #fcd576 !important;
                                border: 1px solid rgba(252, 213, 118, 0.4) !important;
                                box-shadow: 0 4px 14px rgba(214, 159, 61, 0.25) !important;
                                font-weight: 800 !important;
                            }
                        </style>
                        <h1 class="mb-2 lg:mb-4 text-center lg:text-left w-full">
                            <span class="sr-only">Xem Phim <%= typeof movie !=='undefined' && movie && movie.name ?
                                    movie.name : 'Đang tải...' %> Vietsub Thuyết Minh Full HD - <%= typeof movie
                                        !=='undefined' && movie && movie.origin_name ? movie.origin_name : '' %></span>
                            <span class="block text-2xl sm:text-4xl lg:text-5xl cinematic-gold-title"
                                aria-hidden="true">
                                <%= typeof movie !=='undefined' && movie && movie.name ? movie.name : 'Đang tải...' %>
                            </span>
                            <span class="text-sm sm:text-xl lg:text-2xl cinematic-sub-title" aria-hidden="true">
                                <%= typeof movie !=='undefined' && movie && movie.origin_name ? movie.origin_name : ''
                                    %>
                            </span>
                        </h1>

                        <div
                            class="movie-info-container flex flex-nowrap justify-center lg:justify-start items-center gap-x-2 md:gap-4 mb-2 md:mb-3 lg:mb-4 text-[11px] sm:text-sm md:text-base text-center lg:text-left overflow-hidden w-full">
                            <span
                                class="flex items-center gap-1 px-3 py-1 rounded-full backdrop-blur-sm cinematic-gold-rating">
                                <span class="material-icons-round text-lg">star</span>
                                8.7/10
                            </span>
                            <span class="text-gray-500">•</span>
                            <span class="text-gray-300 font-medium">2022</span>
                            <span class="text-gray-500">•</span>
                            <span class="text-gray-300 font-medium">45-60 phút/tập</span>
                        </div>

                        <div
                            class="movie-actions-container flex flex-wrap items-center justify-between gap-3 sm:gap-4 mt-4 md:mt-6 lg:mt-7 mb-4 md:mb-6 lg:mb-7 w-full">
                            <!-- Nhóm các nút hành động bên trái (Xem ngay, Yêu thích, Thêm vào, Chia sẻ, Bình luận) -->
                            <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                                <a href="/xem-phim/<%= typeof slug !== 'undefined' ? slug : '' %>" id="watchNowBtn"
                                    class="group relative px-6 h-11 sm:h-12 lg:px-7 rounded-full transition-all duration-300 flex items-center justify-center gap-2 flex-shrink-0 cinematic-gold-btn shadow-xl hover:scale-105 active:scale-95">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-white flex-shrink-0"
                                        style="fill: #ffffff !important;" viewBox="0 0 24 24">
                                        <path d="M8 5v14l11-7z" />
                                    </svg>
                                    <span
                                        class="text-xs sm:text-sm whitespace-nowrap uppercase tracking-wider font-bold text-white">XEM
                                        NGAY</span>
                                </a>

                                <button id="favoriteMovieBtn"
                                    class="h-11 sm:h-12 px-4 sm:px-5 bg-white/10 hover:bg-white/20 text-gray-200 hover:text-white font-medium rounded-full backdrop-blur-md border border-white/10 hover:border-white/30 transition-all duration-300 flex items-center gap-2 shadow-md flex-shrink-0 cursor-pointer">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current flex-shrink-0" viewBox="0 0 24 24">
                                        <path
                                            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                                    </svg>
                                    <span class="text-xs sm:text-sm whitespace-nowrap">Lưu phim</span>
                                </button>

                                <button id="saveMovieBtn"
                                    class="h-11 sm:h-12 px-4 sm:px-5 bg-white/10 hover:bg-white/20 text-gray-200 hover:text-white font-medium rounded-full backdrop-blur-md border border-white/10 hover:border-white/30 transition-all duration-300 flex items-center gap-2 shadow-md flex-shrink-0 cursor-pointer">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current flex-shrink-0" viewBox="0 0 24 24">
                                        <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                    </svg>
                                    <span class="text-xs sm:text-sm whitespace-nowrap">Thêm vào</span>
                                </button>

                                <button
                                    onclick="if(typeof shareMovie==='function'){shareMovie();}else if(navigator.clipboard){navigator.clipboard.writeText(location.href);alert('Đã sao chép liên kết phim!');}"
                                    class="h-11 sm:h-12 px-4 sm:px-5 bg-white/10 hover:bg-white/20 text-gray-200 hover:text-white font-medium rounded-full backdrop-blur-md border border-white/10 hover:border-white/30 transition-all duration-300 flex items-center gap-2 shadow-md flex-shrink-0 cursor-pointer">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current flex-shrink-0" viewBox="0 0 24 24">
                                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
                                    </svg>
                                    <span class="text-xs sm:text-sm whitespace-nowrap">Chia sẻ</span>
