            <!-- ====== MOBILE SWIPE GUARD ====== -->
            <script>
                (function () {
                    var SWIPE_THRESHOLD = 8;
                    function initMobileSwipeGuard() {
                        var sliders = document.querySelectorAll('.overflow-x-auto, .snap-x, .scrollbar-hide, #heroThumbnails, .interests-wrapper, .mobile-thumb-wrapper, .cat-tab-container');
                        sliders.forEach(function (slider) {
                            if (slider.getAttribute('data-swipe-guard-attached')) return;
                            slider.setAttribute('data-swipe-guard-attached', 'true');
                            var startX = 0, startY = 0, isSwiping = false;
                            slider.addEventListener('touchstart', function (e) {
                                if (!e.touches || e.touches.length === 0) return;
                                startX = e.touches[0].clientX;
                                startY = e.touches[0].clientY;
                                isSwiping = false;
                                slider.setAttribute('data-swipe', 'pending');
                            }, { passive: true });
                            slider.addEventListener('touchmove', function (e) {
                                if (!e.touches || e.touches.length === 0) return;
                                var dx = Math.abs(e.touches[0].clientX - startX);
                                var dy = Math.abs(e.touches[0].clientY - startY);
                                if (dx > SWIPE_THRESHOLD || dy > SWIPE_THRESHOLD) {
                                    isSwiping = true;
                                    slider.setAttribute('data-swipe', 'swiping');
                                }
                            }, { passive: true });
                            slider.addEventListener('touchend', function () {
                                if (isSwiping) {
                                    slider.setAttribute('data-swipe', 'done');
                                    setTimeout(function () {
                                        slider.removeAttribute('data-swipe');
                                    }, 300);
                                } else {
                                    slider.removeAttribute('data-swipe');
                                }
                                isSwiping = false;
                            }, { passive: true });
                            slider.addEventListener('click', function (e) {
                                if (slider.getAttribute('data-swipe') === 'done') {
                                    e.preventDefault();
                                    e.stopPropagation();
                                }
                            }, true);
                        });
                    }
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', initMobileSwipeGuard);
                    } else {
                        initMobileSwipeGuard();
                    }
                    window.initMobileSwipeGuard = initMobileSwipeGuard;
                })();
            </script>

            <!-- ====== CINEMATIC GLASS HEADER SCROLL CONTROLLER ====== -->
            <script>
                (function () {
                    function checkHeaderScroll() {
                        const header = document.getElementById('sofa-header') || document.querySelector('header');
                        if (!header) return;
                        const scrollY = window.pageYOffset || document.documentElement.scrollTop || window.scrollY || 0;
                        if (scrollY > 40) {
                            header.classList.add('scrolled');
                            header.style.removeProperty('background');
                            header.style.removeProperty('background-color');
                            header.style.removeProperty('backdrop-filter');
                            header.style.removeProperty('-webkit-backdrop-filter');
                            header.style.removeProperty('box-shadow');
                            header.style.removeProperty('border');
                            header.style.removeProperty('border-bottom');
                        } else {
                            header.classList.remove('scrolled', 'sofa-header-scrolled');
                            header.style.setProperty('background', 'transparent', 'important');
                            header.style.setProperty('background-color', 'transparent', 'important');
                            header.style.setProperty('backdrop-filter', 'none', 'important');
                            header.style.setProperty('-webkit-backdrop-filter', 'none', 'important');
                            header.style.setProperty('box-shadow', 'none', 'important');
                            header.style.setProperty('border', 'none', 'important');
                            header.style.setProperty('border-bottom', 'none', 'important');
                        }
                    }

                    window.addEventListener('scroll', checkHeaderScroll, { passive: true });
                    window.addEventListener('load', checkHeaderScroll);
                    document.addEventListener('DOMContentLoaded', checkHeaderScroll);
                    checkHeaderScroll();
                })();
            </script>
