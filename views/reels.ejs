<!DOCTYPE html>
<html class="dark" lang="vi">

<head>
    <%- include('partials/head') %>
    <% if (typeof initialReels !== 'undefined' && initialReels && initialReels.length > 0 && initialReels[0].poster) { %>
    <link rel="preload" as="image" href="<%= initialReels[0].poster %>" fetchpriority="high">
    <% } %>
    <!-- 🎥 Google Video Rich Snippets (Schema.org VideoObject) -->
    <% if (typeof initialReels !== 'undefined' && initialReels && initialReels.length > 0) { 
        const primaryReel = initialReels[0];
    %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": "<%= (primaryReel.title || primaryReel.movieTitle || 'Review Phim').replace(/"/g, '\\"') %>",
      "description": "<%= (primaryReel.description || 'Xem video review phim chất lượng cao tại APhim').replace(/"/g, '\\"') %>",
      "thumbnailUrl": [
        "<%= primaryReel.poster || 'https://aphim.store/images/comment-mascot.webp' %>"
      ],
      "uploadDate": "2026-01-01T08:00:00+07:00",
      "contentUrl": "https://aphim.store/reels",
      "embedUrl": "https://www.youtube.com/embed/<%= primaryReel.yt %>"
    }
    </script>
    <% } %>
    <script>
        // Force Cinematic Deep Dark Mode
        document.documentElement.classList.remove('light-mode');
        document.documentElement.classList.add('dark');

        // 🛡️ Early Safety Stubs for Instant Tap Resiliency
        [
            'handleReelGestureTap', 'unlockSoundAndPlay', 'toggleLikeReel', 
            'openReelsCommentsDrawer', 'toggleBookmarkReel', 'shareCurrentReel', 
            'cyclePlaybackSpeed', 'seekReelProgress', 'openReelsOptionsSheet', 
            'closeReelsOptionsSheet', 'setReelPlaybackSpeed', 'setReelQuality', 
            'toggleRowSwitch', 'setReelAspect', 'toggleReelsFullscreen', 
            'copyCurrentReelLink', 'openCurrentReelDetail', 'handleDesktopDockLike', 
            'handleDesktopDockComment', 'handleDesktopDockBookmark', 'handleDesktopDockShare', 
            'scrollToPrevReel', 'scrollToNextReel', 'toggleAspectMode', 
            'scrollToReelIndex', 'closeReelsCommentsDrawer', 'sortDrawerComments', 
            'insertQuickReaction', 'toggleQuickEmojiPicker', 'submitReelComment', 
            'insertEmojiToComment', 'handleSearchBackdropClick', 'clearReelsSearchInput', 
            'closeReelsSearchModal', 'filterReelsByQuery', 'openReelsSearchModal',
            'openReelsHistoryModal', 'closeReelsHistoryModal', 'handleHistoryBackdropClick',
            'clearReelsWatchHistory', 'switchReelsTab', 'toggleMuteGlobal'
        ].forEach(function(fn) {
            if (!window[fn]) {
                window[fn] = function() {
                    console.log('[Reels Early Dispatch] Queued ' + fn + ' while scripts are loading...');
                };
            }
        });
    </script>
    <script src="/js/touch-speed.js"></script>
    <link rel="preconnect" href="https://www.youtube.com">
    <link rel="preconnect" href="https://i.ytimg.com">
    <link rel="preconnect" href="https://phimimg.com">
    <link rel="dns-prefetch" href="https://www.youtube.com">
    <link rel="dns-prefetch" href="https://i.ytimg.com">
    <link rel="stylesheet" href="/css/reels.css?v=441" />
    <style>
        /* 🚀 CLIPPED IFRAME GEOMETRY: Đẩy tiêu đề (top -65px) & logo YouTube/Shorts (bottom clip 90px) ra ngoài cho dọc 9:16 */
        .reels-global-player-host iframe,
        .reels-viewport.is-tab-reel .reels-global-player-host iframe {
            position: absolute !important;
            top: -65px !important;
            left: 0 !important;
            width: 100% !important;
            min-width: 100% !important;
            height: calc(100% + 155px) !important;
            min-height: calc(100% + 155px) !important;
            transform: none !important;
            border: none !important;
        }
        /* 🛡️ TẮT HOÀN TOÀN LỚP PHỦ GÓC DƯỚI TRÊN MÀN DỌC / MOBILE */
        .reels-global-player-host::after {
            display: none !important;
            content: none !important;
        }
        /* 📱 TIKTOK-STYLE SEAMLESS OVERLAYS: Gradient nhẹ nhàng mượt mà, video sáng trong suốt */
        .reel-top-mask {
            display: none !important;
        }
        .reel-bottom-mask {
            height: 140px !important;
            background: linear-gradient(0deg,
                rgba(6, 8, 15, 0.82) 0%,
                rgba(6, 8, 15, 0.4) 45%,
                transparent 100%
            ) !important;
            z-index: 5 !important;
            pointer-events: none !important;
        }
        /* 🌟 VÙNG XEM VIDEO: 100% trong suốt, video sáng trong và sắc nét */
        .reel-gradient-overlay {
            background: transparent !important;
            display: none !important;
        }


        .reels-actions-bar {
            position: absolute !important;
            right: 6px !important;
            left: auto !important;
            bottom: 125px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            gap: 13px !important;
            z-index: 35 !important;
        }
        .reel-bottom-info {
            position: relative !important;
            z-index: 20 !important;
            padding: 0 12px 6px !important;
            margin-right: 54px !important;
            margin-left: 0 !important;
            display: flex !important;
            flex-direction: column !important;
            gap: 6px !important;
        }
        .reels-desktop-action-dock {
            display: none !important;
        }
        .reels-desktop-nav-dock {
            display: none !important;
        }

        /* 🖥️ DESKTOP (≥ 1024px): 
           - Bên TRÁI ngoài màn chiếu: Cụm thao tác (Avatar +, Like, Comment, Lưu, Share, Tốc độ)
           - Bên PHẢI ngoài màn chiếu: Cụm điều hướng (Lên, Xuống, Xoay khung hình)
           - Trong màn chiếu video: 100% gọn gàng sạch sẽ */
        @media (min-width: 1024px) {
            .reels-desktop-action-dock {
                display: flex !important;
                position: absolute !important;
                right: calc(50% + 220px + 20px) !important;
                left: auto !important;
                top: 50% !important;
                transform: translateY(-50%) !important;
                flex-direction: column !important;
                align-items: center !important;
                gap: 16px !important;
                z-index: 60 !important;
            }
            .reels-desktop-nav-dock {
                display: flex !important;
                position: absolute !important;
                left: calc(50% + 220px + 20px) !important;
                right: auto !important;
                top: 50% !important;
                transform: translateY(-50%) !important;
                flex-direction: column !important;
                gap: 16px !important;
                z-index: 60 !important;
            }
            .reels-actions-bar {
                display: none !important; /* Ẩn cụm nút bên trong video trên desktop */
            }
            .reel-bottom-info {
                margin-right: 14px !important;
                margin-left: 0 !important;
            }
        }
        .reel-action-btn {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            background: transparent !important;
            border: none !important;
            color: #ffffff !important;
            cursor: pointer !important;
            text-decoration: none !important;
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
            padding: 0 !important;
        }
        .reel-action-btn:hover {
            transform: scale(1.12) !important;
        }
        .reel-avatar-btn {
            position: relative !important;
            margin-bottom: 8px !important;
            text-decoration: none !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
        }
        .reel-avatar-disc {
            width: 48px !important;
            height: 48px !important;
            border-radius: 50% !important;
            border: 2px solid #ffffff !important;
            overflow: hidden !important;
            background: #111728 !important;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.7), 0 0 10px rgba(255, 255, 255, 0.25) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            position: relative !important;
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease !important;
        }
        .reel-avatar-btn:hover .reel-avatar-disc {
            transform: scale(1.08) !important;
            border-color: #ff2b54 !important;
            box-shadow: 0 4px 18px rgba(255, 43, 84, 0.6) !important;
        }
        .reel-avatar-disc img {
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
            border-radius: 50% !important;
            transform: scale(1.22) !important;
            display: block !important;
        }
        .reel-avatar-plus-badge {
            position: absolute !important;
            bottom: -9px !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
            width: 25px !important;
            height: 25px !important;
            border-radius: 50% !important;
            background: linear-gradient(135deg, #ff2b54 0%, #ff1744 100%) !important;
            border: none !important; /* ⚡ BỎ HOÀN TOÀN VIỀN ĐEN */
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            box-shadow: 0 3px 12px rgba(255, 43, 84, 0.85) !important;
            z-index: 10 !important;
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease !important;
        }
        .reel-avatar-btn:hover .reel-avatar-plus-badge {
            transform: translateX(-50%) scale(1.15) !important;
            box-shadow: 0 0 16px rgba(255, 43, 84, 1) !important;
        }
        .reel-avatar-plus-badge svg {
            width: 14px !important;
            height: 14px !important;
            stroke: #ffffff !important;
            stroke-width: 3.5 !important;
        }
        .action-circle-icon {
            width: 42px !important;
            height: 42px !important;
            border-radius: 50% !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.9)) !important;
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }
        .action-circle-icon svg {
            width: 28px !important;
            height: 28px !important;
            stroke: #ffffff !important;
            color: #ffffff !important;
            display: block !important;
        }
        .action-circle-icon svg.like-icon,
        .action-circle-icon svg[fill="currentColor"] {
            fill: #ffffff !important;
        }
        .action-label {
            font-size: 11px !important;
            font-weight: 700 !important;
            margin-top: 1px !important;
            color: #ffffff !important;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95) !important;
            letter-spacing: -0.01em !important;
        }
        .btn-like.liked .action-circle-icon svg {
            fill: #ff2b54 !important;
            color: #ff2b54 !important;
            stroke: #ff2b54 !important;
            filter: drop-shadow(0 0 14px rgba(255, 43, 84, 0.85)) !important;
        }
        .btn-like.liked .action-label {
            color: #ff2b54 !important;
        }
        .btn-bookmark.saved .action-circle-icon svg {
            fill: #fcd576 !important;
            color: #fcd576 !important;
            stroke: #fcd576 !important;
            filter: drop-shadow(0 0 12px rgba(252, 213, 118, 0.8)) !important;
        }
        .btn-bookmark.saved .action-label {
            color: #fcd576 !important;
        }
        .btn-watch-movie {
            display: none !important;
        }
        .sidebar-last-watched-card::before {
            display: none !important;
            content: none !important;
        }
        /* 🎨 SIDEBAR BALANCED STYLES & UNIFORM 2-COLUMN GRID SYSTEM */
