        /* 🎚️ PROGRESS BAR INTERACTIVE SCRUBBER & TIME BADGES — ULTRA PROMINENT & CRISP */
        .reel-controls-bar {
            user-select: none !important;
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
            padding: 6px 14px 14px 14px !important;
