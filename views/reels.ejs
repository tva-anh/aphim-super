            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.7) !important;
        }
        .reel-progress-track:hover .reel-hover-time,
        .reel-progress-track.scrubbing .reel-hover-time {
            opacity: 1 !important;
        }

        /* 🌟 DYNAMIC ISLAND STATUS TOAST — FIXED TO VIEWPORT, ALWAYS CENTERED */
        .reels-toast {
            position: fixed !important;          /* ← fixed = luôn căn theo viewport, không bị ảnh hưởng bởi parent */
            top: auto !important;
            bottom: 80px !important;
            left: 50% !important;
            right: auto !important;
            transform: translateX(-50%) translateY(10px) !important;
            transform-origin: center bottom !important;
            width: max-content !important;
            max-width: min(88vw, 420px) !important;
            /* Glassmorphism pill */
            background: rgba(10, 13, 24, 0.92) !important;
            backdrop-filter: blur(28px) saturate(200%) !important;
            -webkit-backdrop-filter: blur(28px) saturate(200%) !important;
            border: 1px solid rgba(255, 255, 255, 0.14) !important;
            border-radius: 9999px !important;
            padding: 7px 18px 7px 10px !important;
            box-shadow:
                0 8px 32px rgba(0, 0, 0, 0.65),
                0 2px 8px rgba(0, 0, 0, 0.45),
                0 0 18px rgba(255, 43, 84, 0.12),
                inset 0 1px 1px rgba(255, 255, 255, 0.18) !important;
            z-index: 9999 !important;
            opacity: 0 !important;
            pointer-events: none !important;
            display: flex !important;
            align-items: center !important;
            gap: 8px !important;
            transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
            white-space: nowrap !important;
        }
        .reels-toast.show {
