            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.7), 0 0 10px rgba(255, 43, 84, 0.35) !important;
            text-shadow: 0 0 8px rgba(255, 59, 104, 0.8) !important;
        }
        .reel-duration {
            color: #f1f5f9 !important;
            background: rgba(13, 17, 28, 0.88) !important;
            border: 1px solid rgba(255, 255, 255, 0.22) !important;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.7) !important;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9) !important;
        }
        .reel-progress-track {
            flex: 1 !important;
            height: 7px !important;
            background: rgba(255, 255, 255, 0.25) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6), inset 0 1px 2px rgba(0, 0, 0, 0.4) !important;
            border-radius: 9999px !important;
            position: relative !important;
            cursor: pointer !important;
            touch-action: none !important;
            padding: 0 !important;
            margin: 0 !important;
            background-clip: border-box !important;
            transition: height 0.15s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.15s ease !important;
        }
        /* Expands hit target area to 38px for zero-fail clicks & silky dragging */
        .reel-progress-track::before {
            content: "" !important;
            position: absolute !important;
            top: -16px !important;
            bottom: -16px !important;
            left: 0 !important;
            right: 0 !important;
            cursor: pointer !important;
            z-index: 10 !important;
        }
        .reel-progress-track:hover,
        .reel-progress-track.scrubbing {
            height: 10px !important;
            background: rgba(255, 255, 255, 0.38) !important;
            border-color: rgba(255, 255, 255, 0.45) !important;
        }
        .reel-progress-buffer {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            bottom: 0 !important;
            height: 100% !important;
            width: 0% !important;
            background: rgba(255, 255, 255, 0.35) !important;
            border-radius: 9999px !important;
            pointer-events: none !important;
        }
        .reel-progress-fill {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            bottom: 0 !important;
            height: 100% !important;
            width: 0%;
            background: linear-gradient(90deg, #ff0055 0%, #ff2b54 60%, #ff5277 100%) !important;
            box-shadow: 0 0 14px rgba(255, 43, 84, 1), 0 0 4px #ff2b54, 0 0 25px rgba(255, 43, 84, 0.6) !important;
            border-radius: 9999px !important;
            pointer-events: none !important;
            z-index: 5 !important;
            will-change: width !important;
            transition: width 0.28s linear;
        }
        .reel-progress-track.scrubbing .reel-progress-fill {
            transition: none !important;
        }
        .reel-progress-thumb {
            position: absolute !important;
            right: -8px !important;
            top: 50% !important;
            transform: translateY(-50%) scale(1) !important;
            width: 16px !important;
            height: 16px !important;
            border-radius: 50% !important;
            background: #ffffff !important;
            box-shadow: 0 0 14px rgba(255, 43, 84, 1), 0 0 25px rgba(255, 43, 84, 0.8), 0 2px 6px rgba(0, 0, 0, 0.8) !important;
            border: 3.5px solid #ff2b54 !important;
            transition: transform 0.12s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.12s ease !important;
            pointer-events: none !important;
            z-index: 6 !important;
        }
        .reel-progress-track:hover .reel-progress-thumb,
        .reel-progress-track.scrubbing .reel-progress-thumb {
            transform: translateY(-50%) scale(1.4) !important;
            box-shadow: 0 0 24px rgba(255, 43, 84, 1), 0 0 12px #ffffff !important;
        }
        .reel-hover-time {
            position: absolute !important;
            bottom: 18px !important;
            transform: translateX(-50%) !important;
            padding: 4px 9px !important;
            border-radius: 6px !important;
            background: rgba(10, 14, 25, 0.95) !important;
            border: 1px solid rgba(255, 255, 255, 0.25) !important;
