                            <svg fill="none" stroke="currentColor" stroke-width="2.3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </button>

                        <!-- ⚙️ 3-Dots Menu -->
                        <button id="reels-options-btn"
                                class="reels-top-btn options-btn"
                                title="Tùy chọn Reels"
                                onclick="openReelsOptionsSheet()">
                            <svg fill="currentColor" viewBox="0 0 24 24">
                                <circle cx="12" cy="5" r="2.2"/>
                                <circle cx="12" cy="12" r="2.2"/>
                                <circle cx="12" cy="19" r="2.2"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Ambient Backdrop for 16:9 Cinema Mode -->
                <div class="reels-ambient-backdrop" id="reels-ambient-backdrop"></div>

                <!-- 🚀 DUAL GLOBAL PLAYER HOSTS (Zero-Lag Switch) -->
                <div class="reels-global-player-host active" id="reels-player-host-a" data-player="a"></div>
                <div class="reels-global-player-host" id="reels-player-host-b" data-player="b"></div>

                <!-- 🚀 DUAL NATIVE HTML5 MSE VIDEO HOSTS (Facebook / Meta Ultra-Low Latency Engine) -->
                <div class="reels-native-player-host" id="reels-native-host-a" data-player="native-a">
                    <video id="reels-native-video-a" playsinline webkit-playsinline preload="auto" loop></video>
                </div>
                <div class="reels-native-player-host" id="reels-native-host-b" data-player="native-b">
                    <video id="reels-native-video-b" playsinline webkit-playsinline preload="auto" loop></video>
                </div>

                <!-- ⏱️ Smart 10s YouTube Logo Shield (Compact mask directly covering YouTube watermark, auto-fades in 10s) -->
                <div class="reels-yt-logo-shield" id="reels-yt-logo-shield" aria-hidden="true"></div>

                <!-- Gradient Masks covering top and bottom edges -->
                <div class="reel-top-mask"></div>
                <div class="reel-bottom-mask"></div>

                <!-- Vertical Scroll Feed Container -->
                <div id="reels-feed-container" class="reels-feed">

                    <% if (initialReels && initialReels.length > 0) { %>
                        <% initialReels.forEach(function(item, index) { %>
                            <div class="reel-item" 
                                 id="reel-item-<%= index %>"
                                 data-index="<%= index %>"
                                 data-id="<%= item.id %>"
                                 data-yt="<%= item.yt %>"
                                 data-slug="<%= item.slug %>"
                                 data-title="<%= item.title %>"
                                 data-movie-title="<%= item.movieTitle %>"
                                 data-poster="<%= item.poster %>"
                                 data-backdrop="<%= item.backdrop %>"
                                 data-quality="<%= item.quality %>"
                                 data-year="<%= item.year %>"
                                 data-rating="<%= item.rating %>"
                                 data-categories="<%= Array.isArray(item.categories) ? item.categories.join(', ') : item.categories %>"
                                 data-author="<%= item.author %>"
                                 data-likes="<%= item.likes %>"
                                 data-comments="<%= item.comments %>"
                                 data-shares="<%= item.shares %>"
                                 data-watch-url="<%= item.watchUrl %>"
                                 data-aspect="<%= item.aspect || (currentTab === 'review' ? '16:9' : '9:16') %>"
                                 data-description="<%= item.description %>">

                                <!-- Media Layer Poster Placeholder (Fades out when playing) -->
                                <div class="reel-thumb-cover" id="thumb-<%= index %>" style="background-image: url('<%= item.poster %>');"></div>

                                <!-- Ambient Top/Bottom Gradient Overlay -->
                                <div class="reel-gradient-overlay"></div>

                                <!-- Gesture Tap Overlay (Single-tap pause/play, double-tap like) -->
                                <div class="reel-gesture-overlay" onclick="handleReelGestureTap(event, '<%= index %>')">
                                    <div class="reel-heart-burst" id="heart-burst-<%= index %>">
                                        <svg class="w-24 h-24" style="fill: #ff2b54 !important; color: #ff2b54 !important;" fill="#ff2b54" viewBox="0 0 24 24"><path fill="#ff2b54" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                                    </div>
                                    <div class="reel-play-indicator hidden" id="play-indicator-<%= index %>">
                                        <svg class="w-8 h-8 text-white fill-white ml-1" viewBox="0 0 24 24"><path fill="#ffffff" d="M8 5v14l11-7z"/></svg>
                                    </div>
                                </div>

                                <!-- Sound Unlock Prompt (Floating Banner - hidden when unmuted) -->
                                <div class="reels-sound-prompt hidden" id="sound-prompt-<%= index %>" onclick="unlockSoundAndPlay()">
                                    <svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                                    <span class="text-xs font-bold text-white">Chạm để bật âm thanh video</span>
                                </div>

                                <!-- Right Action Dock (TikTok / Reels Style - Pure White Crisp) -->
                                <div class="reels-actions-bar">
                                    <!-- 🎬 TikTok Circular Avatar with Play Watch Movie Badge -->
                                    <a href="<%= item.watchUrl %>" class="reel-action-btn reel-avatar-btn group" title="Xem phim <%= item.movieTitle %> ngay">
                                        <div class="reel-avatar-disc">
                                            <img src="<%= item.poster %>" alt="<%= item.movieTitle %>" data-yt="<%= item.yt %>" onerror="if(!this.dataset.triedYt && this.dataset.yt){ this.dataset.triedYt='1'; this.src='https://i.ytimg.com/vi/' + this.dataset.yt + '/hqdefault.jpg'; } else { this.src='/android-chrome-192x192.png'; }" />
                                        </div>
                                        <div class="reel-avatar-plus-badge reel-avatar-watch-badge" title="Xem phim <%= item.movieTitle %> ngay">
                                            <svg class="w-3 h-3 text-white fill-white ml-0.5" viewBox="0 0 24 24">
                                                <path fill="currentColor" d="M8 5v14l11-7z"/>
                                            </svg>
                                        </div>
                                    </a>

                                    <!-- Like Heart Button (White -> Red Glowing on Like) -->
                                    <button class="reel-action-btn btn-like" id="btn-like-<%= index %>" onclick="toggleLikeReel('<%= item.id %>', '<%= index %>')" title="Thích video này">
                                        <div class="action-circle-icon">
                                            <svg class="w-7 h-7 like-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                                        </div>
                                        <span class="action-label like-count"><%= item.likes %></span>
                                    </button>

                                    <!-- Comments Button (Pure White) -->
                                    <button class="reel-action-btn btn-comment" onclick="openReelsCommentsDrawer('<%= item.id %>', '<%= item.movieTitle %>')" title="Xem và gửi bình luận">
                                        <div class="action-circle-icon">
                                            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                                        </div>
                                        <span class="action-label"><%= item.comments %></span>
                                    </button>

                                    <!-- Bookmark Button (Pure White) -->
                                    <button class="reel-action-btn btn-bookmark" onclick="toggleBookmarkReel('<%= item.id %>', '<%= index %>')" title="Lưu lại xem sau">
                                        <div class="action-circle-icon">
                                            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                                        </div>
                                        <span class="action-label">Lưu</span>
                                    </button>

                                    <!-- Share Button (Pure White) -->
                                    <button class="reel-action-btn btn-share" onclick="shareCurrentReel('<%= item.slug %>', '<%= item.title %>')" title="Chia sẻ video">
                                        <div class="action-circle-icon">
                                            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                                        </div>
                                        <span class="action-label"><%= item.shares %></span>
                                    </button>

                                    <!-- Speed Button (Pure White) -->
                                    <button class="reel-action-btn btn-speed" onclick="cyclePlaybackSpeed()" title="Đổi tốc độ phát">
                                        <div class="action-circle-icon">
                                            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        </div>
                                        <span class="action-label speed-label-text">1.0x</span>
                                    </button>
                                </div>

                                <!-- 🎬 BOTTOM FLOATING TRANSLUCENT GLASS MOVIE CARD -->
                                <div class="reel-bottom-info">
                                    <a href="<%= item.watchUrl %>" class="reel-movie-glass-card" title="Xem phim <%= item.movieTitle %> ngay">
                                        <div class="reel-card-thumb-wrap">
                                            <img src="<%= item.poster %>" alt="<%= item.movieTitle %>" class="reel-card-thumb" data-yt="<%= item.yt %>" onerror="if(!this.dataset.triedYt && this.dataset.yt){ this.dataset.triedYt='1'; this.src='https://i.ytimg.com/vi/' + this.dataset.yt + '/hqdefault.jpg'; } else { this.src='/android-chrome-192x192.png'; }" />
                                            <div class="reel-card-thumb-play">
                                                <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                            </div>
                                        </div>
                                        <div class="reel-card-details">
                                            <div class="reel-card-row-top">
                                                <div class="reel-card-titles-wrap">
                                                    <span class="reel-card-name"><%= item.movieTitle %></span>
                                                    <span class="reel-card-year">(<%= item.year || '2026' %>)</span>
                                                    <div class="reel-card-rating-badge">
                                                        <svg class="rating-star-icon" viewBox="0 0 24 24" width="12" height="12" fill="#f59e0b"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                                                        <span><%= item.rating || '5.0' %></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="reel-card-origin"><%= item.originTitle || item.movieTitleVn || item.slug.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></div>
                                        </div>
                                    </a>

                                    <div class="reel-caption-text">
                                        <b class="text-amber-300 font-bold">@<%= item.author %>:</b> <%= item.description %>
                                    </div>
                                </div>

                                <!-- Scrubber Progress Bar with interactive Drag Thumb -->
                                <div class="reel-controls-bar">
                                    <span class="reel-current-time" id="time-current-<%= index %>">00:00</span>
                                    <div class="reel-progress-track" id="progress-track-<%= index %>" data-index="<%= index %>" onclick="seekReelProgress(event, '<%= index %>')">
                                        <div class="reel-hover-time" id="hover-time-<%= index %>">00:00</div>
                                        <div class="reel-progress-buffer" id="progress-buffer-<%= index %>"></div>
                                        <div class="reel-progress-fill" id="progress-fill-<%= index %>">
                                            <div class="reel-progress-thumb"></div>
                                        </div>
                                    </div>
                                    <span class="reel-duration" id="time-duration-<%= index %>"><%= item.duration || '00:00' %></span>
                                </div>

                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center h-full text-center p-6 space-y-4">
                            <h2 class="text-lg font-bold text-white">Đang tải video review mới nhất...</h2>
                            <p class="text-sm text-gray-400 max-w-xs">Hệ thống đang đồng bộ danh sách video từ kho phim. Vui lòng bấm làm mới.</p>
                            <a href="/reels" class="px-6 py-2.5 rounded-full bg-amber-400 text-black font-extrabold text-sm hover:scale-105 transition-transform shadow-lg">
                                Tải Lại Trang
                            </a>
                        </div>
                    <% } %>

                </div>

                <!-- =========================================================
                     ⚙️ REELS OPTIONS BOTTOM SHEET (Tùy chọn Reels - Compact & Modern Icons)
                     ========================================================= -->
                <div id="reels-options-backdrop" class="reels-options-backdrop" onclick="closeReelsOptionsSheet()">
                    <div id="reels-options-sheet" class="reels-options-sheet" onclick="event.stopPropagation()">
                        <!-- Drag Handle -->
                        <div class="sheet-drag-handle"></div>

                        <!-- Header -->
                        <div class="sheet-header">
                            <div class="sheet-title-wrap">
                                <span class="sheet-title">Tùy chọn Reels</span>
                            </div>
                            <button type="button" class="sheet-close-btn" onclick="closeReelsOptionsSheet()" title="Đóng">
                                <svg class="w-4 h-4 text-gray-300 hover:text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </div>

                        <div class="sheet-body">
                            <!-- 1. TỐC ĐỘ PHÁT -->
                            <div class="sheet-section">
                                <div class="sheet-section-head">
                                    <div class="sheet-section-title">Tốc độ phát</div>
                                    <span id="sheet-speed-val" class="sheet-val-badge">1.0x</span>
                                </div>
                                <div class="sheet-pill-grid">
                                    <button type="button" class="sheet-pill-btn" data-speed="0.75" onclick="setReelPlaybackSpeed(0.75)">0.75x</button>
                                    <button type="button" class="sheet-pill-btn active" data-speed="1.0" onclick="setReelPlaybackSpeed(1.0)">1.0x</button>
                                    <button type="button" class="sheet-pill-btn" data-speed="1.25" onclick="setReelPlaybackSpeed(1.25)">1.25x</button>
                                    <button type="button" class="sheet-pill-btn" data-speed="1.5" onclick="setReelPlaybackSpeed(1.5)">1.5x</button>
                                    <button type="button" class="sheet-pill-btn" data-speed="2.0" onclick="setReelPlaybackSpeed(2.0)">2.0x</button>
                                </div>
                            </div>

                            <!-- 2. CHẤT LƯỢNG HÌNH ẢNH -->
                            <div class="sheet-section">
                                <div class="sheet-section-head">
                                    <div class="sheet-section-title">Chất lượng hình ảnh</div>
                                    <span id="sheet-quality-val" class="sheet-val-badge">720p HD</span>
                                </div>
                                <div class="sheet-pill-grid quality-grid">
                                    <button type="button" class="sheet-pill-btn" data-quality="auto" onclick="setReelQuality('auto')">Tự động</button>
                                    <button type="button" class="sheet-pill-btn active" data-quality="720p" onclick="setReelQuality('720p')">720p HD</button>
                                    <button type="button" class="sheet-pill-btn" data-quality="1080p" onclick="setReelQuality('1080p')">1080p FHD</button>
                                </div>
                            </div>

                            <!-- 3. TỰ ĐỘNG CHUYỂN CLIP -->
                            <div class="sheet-row-toggle" onclick="toggleRowSwitch('sheet-toggle-autonext')">
                                <div class="sheet-toggle-info">
                                    <div class="sheet-toggle-title">Tự động chuyển clip</div>
                                    <div class="sheet-toggle-desc">Tự động cuộn xuống clip tiếp theo khi xem xong</div>
                                </div>
                                <label class="tiktok-toggle" onclick="event.stopPropagation()">
                                    <input type="checkbox" id="sheet-toggle-autonext" checked onchange="toggleReelAutoNext(this.checked)">
                                    <span class="tiktok-toggle-slider"></span>
                                </label>
                            </div>

                            <!-- 4. LẶP LẠI VIDEO -->
                            <div class="sheet-row-toggle" onclick="toggleRowSwitch('sheet-toggle-loop')">
                                <div class="sheet-toggle-info">
                                    <div class="sheet-toggle-title">Lặp lại video</div>
                                    <div class="sheet-toggle-desc">Phát lặp lại clip hiện tại thay vì chuyển tiếp</div>
                                </div>
                                <label class="tiktok-toggle" onclick="event.stopPropagation()">
                                    <input type="checkbox" id="sheet-toggle-loop" onchange="toggleReelLoop(this.checked)">
                                    <span class="tiktok-toggle-slider"></span>
                                </label>
                            </div>

                            <!-- 5. TỶ LỆ KHUNG HÌNH (ASPECT RATIO) -->
                            <div class="sheet-section">
                                <div class="sheet-section-head">
                                    <div class="sheet-section-title">Khung hình video</div>
                                    <span id="sheet-aspect-val" class="sheet-val-badge">Chuẩn Rạp 16:9</span>
                                </div>
                                <div class="sheet-pill-grid aspect-grid">
                                    <button type="button" class="sheet-pill-btn active" data-aspect="cinema" onclick="setReelAspect('cinema')">Chuẩn Rạp 16:9</button>
                                    <button type="button" class="sheet-pill-btn" data-aspect="vertical" onclick="setReelAspect('vertical')">Dọc 9:16</button>
                                    <button type="button" class="sheet-pill-btn" data-aspect="rotate" onclick="setReelAspect('rotate')">Xoay Ngang 90°</button>
                                </div>
                            </div>

                            <!-- 6. THAO TÁC NHANH -->
                            <div class="sheet-actions-grid">
                                <button type="button" class="sheet-action-item" onclick="toggleReelsFullscreen(); closeReelsOptionsSheet();">
                                    Phóng to / Rạp chiếu
                                </button>
                                <button type="button" class="sheet-action-item" onclick="copyCurrentReelLink()">
                                    Sao chép link
                                </button>
                                <button type="button" class="sheet-action-item" onclick="openCurrentReelDetail()">
                                    Chi tiết phim
                                </button>
                                <button type="button" class="sheet-action-item" onclick="openReelsSearchModal(); closeReelsOptionsSheet();">
                                    Tìm kiếm phim
                                </button>
                                <button type="button" class="sheet-action-item" onclick="openReelsHistoryModal(); closeReelsOptionsSheet();">
                                    Lịch sử xem
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- 🖥️ DESKTOP FLOATING ACTION DOCK (LEFT SIDE - TIKTOK DESKTOP STYLE) -->
            <% if (initialReels && initialReels[0]) { var first = initialReels[0]; %>
            <div class="reels-desktop-action-dock" id="reels-desktop-action-dock">
                <!-- Avatar with '+' Watch Movie Badge -->
                <a href="<%= first.watchUrl %>" class="desktop-dock-avatar-btn" id="desktop-dock-avatar-btn" title="Xem phim <%= first.movieTitle %> ngay">
                    <div class="desktop-dock-avatar-disc">
                        <img id="desktop-dock-avatar-img" src="<%= first.poster %>" alt="<%= first.movieTitle %>" onerror="this.src='/android-chrome-192x192.png';" />
                    </div>
                    <div class="desktop-dock-plus-badge" title="Xem phim <%= first.movieTitle %> ngay">
                        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                    </div>
                </a>

                <!-- Like Button -->
                <button class="desktop-dock-action-btn btn-like" id="desktop-dock-btn-like" onclick="handleDesktopDockLike()" title="Thích video này">
                    <div class="desktop-dock-circle-icon">
                        <svg class="w-7 h-7 like-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    </div>
                    <span class="desktop-dock-action-label" id="desktop-dock-like-count"><%= first.likes %></span>
                </button>

                <!-- Comments Button -->
                <button class="desktop-dock-action-btn btn-comment" id="desktop-dock-btn-comment" onclick="handleDesktopDockComment()" title="Xem và gửi bình luận">
                    <div class="desktop-dock-circle-icon">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    </div>
                    <span class="desktop-dock-action-label" id="desktop-dock-comment-count"><%= first.comments %></span>
                </button>

                <!-- Bookmark Button -->
                <button class="desktop-dock-action-btn btn-bookmark" id="desktop-dock-btn-bookmark" onclick="handleDesktopDockBookmark()" title="Lưu lại xem sau">
                    <div class="desktop-dock-circle-icon">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                    </div>
                    <span class="desktop-dock-action-label">Lưu</span>
                </button>

                <!-- Share Button -->
                <button class="desktop-dock-action-btn btn-share" id="desktop-dock-btn-share" onclick="handleDesktopDockShare()" title="Chia sẻ video">
                    <div class="desktop-dock-circle-icon">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                    </div>
                    <span class="desktop-dock-action-label" id="desktop-dock-share-count"><%= first.shares %></span>
                </button>

                <!-- Speed Button -->
                <button class="desktop-dock-action-btn btn-speed" onclick="cyclePlaybackSpeed()" title="Đổi tốc độ phát">
                    <div class="desktop-dock-circle-icon">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <span class="desktop-dock-action-label speed-label-text">1.0x</span>
                </button>
            </div>
            <% } %>

            <!-- 🖥️ DESKTOP FLOATING NAVIGATION DOCK (RIGHT SIDE) -->
            <div class="reels-desktop-nav-dock">
                <button class="desktop-dock-btn" onclick="scrollToPrevReel()" title="Video trước (Phím ↑ / K)">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
                </button>
                <button class="desktop-dock-btn" onclick="scrollToNextReel()" title="Video tiếp theo (Phím ↓ / J)">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <!-- 🎬 PHÓNG TO / RẠP CHIẾU TOÀN MÀN HÌNH (FULLSCREEN / THEATER MODE) -->
                <button class="desktop-dock-btn" id="reels-fullscreen-btn" onclick="toggleReelsFullscreen(event)" title="Phóng to / Rạp chiếu toàn màn hình (Phím F)">
                    <svg id="reels-fullscreen-icon" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/>
                    </svg>
                </button>
                <button class="desktop-dock-btn" id="reels-aspect-btn" onclick="toggleAspectMode()" title="Xoay khung hình (TikTok 9:16 / Rạp 16:9 / Xoay 90°)">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                </button>
            </div>
        </main>

        <!-- =========================================================
             🖥️ DESKTOP RIGHT INFO PANEL (Visible >= 1280px)
             ========================================================= -->
        <aside class="reels-desktop-info-panel" id="reels-desktop-info-panel">
            <% if (initialReels && initialReels[0]) { var first = initialReels[0]; %>
                <!-- 🎬 UNIFIED HERO POSTER CARD (Image wraps down below XEM NGAY button) -->
                <div class="info-panel-poster-wrap">
                    <img src="<%= first.poster %>" alt="<%= first.movieTitle %>" class="info-panel-poster-img" id="panel-hero-img" data-yt="<%= first.yt %>" onerror="if(!this.dataset.triedYt && this.dataset.yt){ this.dataset.triedYt='1'; this.src='https://i.ytimg.com/vi/' + this.dataset.yt + '/hqdefault.jpg'; } else { this.src='/android-chrome-512x512.png'; }" />
                    <div class="info-panel-badge-overlay">
                        <span class="info-panel-pill gold" id="panel-quality"><%= first.quality %></span>
                        <span class="info-panel-pill" id="panel-year"><%= first.year %></span>
                    </div>

                    <div class="info-panel-hero-header">
                        <div class="info-panel-title-block">
                            <div class="info-panel-title" id="panel-title"><%= first.movieTitle %></div>
                            <div class="info-panel-sub" id="panel-sub"><%= first.year %> • <%= Array.isArray(first.categories) ? first.categories.slice(0, 2).join(' • ') : first.categories %></div>
                        </div>

                        <!-- 🌟 TOP-RIGHT LUXURY CIRCULAR PLAY BUTTON -->
                        <a href="<%= first.watchUrl %>" class="info-panel-circle-play-cta" id="panel-watch-btn" title="Xem phim ngay (Tập 1)" aria-label="Xem phim ngay">
                            <div class="circle-play-badge">
                                <span class="circle-play-pulse"></span>
                                <svg class="circle-play-triangle" viewBox="0 0 24 24">
                                    <path d="M8 5v14l11-7z"/>
                                </svg>
                            </div>
                            <span class="circle-play-text">XEM NGAY</span>
                        </a>
                    </div>
                </div>

                <div class="info-panel-meta-row">
                    <div class="panel-rating-badge">
                        <svg class="w-3.5 h-3.5 fill-amber-400 text-amber-400" viewBox="0 0 24 24" style="width: 14px; height: 14px; flex-shrink: 0;"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        <span id="panel-rating" class="panel-rating-text"><%= first.rating %> / 10</span>
                    </div>
                    <div class="panel-category-pill">
                        <span id="panel-categories"><%= Array.isArray(first.categories) ? first.categories.join(' • ') : first.categories %></span>
                    </div>
                </div>

                <div class="info-panel-desc" id="panel-desc">
                    <%= first.description %>
                </div>

                <div class="info-panel-related-title">
                    <span>🎬 Review Tương Tự</span>
                </div>
                <div class="info-panel-related-list" id="panel-related-list">
                    <% initialReels.slice(1, 6).forEach(function(rel, rIdx) { %>
                        <div class="info-related-item" onclick="scrollToReelIndex('<%= rIdx + 1 %>')">
                            <div class="info-related-thumb-wrap">
                                <img src="<%= rel.poster %>" alt="<%= rel.movieTitle %>" class="info-related-thumb" data-yt="<%= rel.yt %>" onerror="if(!this.dataset.triedYt && this.dataset.yt){ this.dataset.triedYt='1'; this.src='https://i.ytimg.com/vi/' + this.dataset.yt + '/hqdefault.jpg'; } else { this.src='/android-chrome-192x192.png'; }" />
                                <span class="info-thumb-hd-badge">HD</span>
                            </div>
                            <div class="info-related-text">
                                <div class="info-related-title" title="<%= rel.movieTitle %>"><%= rel.movieTitle %></div>
                                <div class="info-related-meta">
                                    <span class="info-related-author" title="@<%= rel.author %>">@<%= rel.author %></span>
                                    <span class="info-related-dot">•</span>
                                    <span class="info-related-stat">
                                        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                                        <span><%= rel.likes %></span>
                                    </span>
                                </div>
                            </div>
                            <div class="info-related-play-icon" title="Xem review">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="#fcd576" style="width: 12px !important; height: 12px !important; min-width: 12px; max-width: 12px; flex-shrink: 0;"><path d="M8 5v14l11-7z"/></svg>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- 🌟 BỘ THỨ 2 DƯỚI REVIEW TƯƠNG TỰ: TOP REVIEW XEM NHIỀU -->
                <div class="info-panel-related-title mt-6 flex items-center justify-between">
                    <span>🔥 Top Review Xem Nhiều</span>
                    <span class="info-trending-badge">THỊNH HÀNH</span>
                </div>
                <div class="info-panel-related-list" id="panel-top-trending-list">
                    <% (initialReels.length > 6 ? initialReels.slice(6, 11) : initialReels.slice(0, 5)).forEach(function(topRel, tIdx) { %>
                        <div class="info-related-item" onclick="scrollToReelIndex('<%= (tIdx + 6) % initialReels.length %>')">
                            <div class="info-related-thumb-wrap relative flex-shrink-0">
                                <img src="<%= topRel.poster %>" alt="<%= topRel.movieTitle %>" class="info-related-thumb" data-yt="<%= topRel.yt %>" onerror="if(!this.dataset.triedYt && this.dataset.yt){ this.dataset.triedYt='1'; this.src='https://i.ytimg.com/vi/' + this.dataset.yt + '/hqdefault.jpg'; } else { this.src='/android-chrome-192x192.png'; }" />
                                <span class="info-rank-badge rank-<%= tIdx + 1 %>">#<%= tIdx + 1 %></span>
                            </div>
                            <div class="info-related-text">
                                <div class="info-related-title" title="<%= topRel.movieTitle %>"><%= topRel.movieTitle %></div>
                                <div class="info-related-meta">
                                    <span class="info-related-author" title="@<%= topRel.author %>">@<%= topRel.author %></span>
                                    <span class="info-related-dot">•</span>
                                    <span class="info-related-stat">
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        <span><%= topRel.views || '35.8K' %></span>
                                    </span>
                                </div>
                            </div>
                            <div class="info-related-play-icon" title="Xem review">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="#fcd576" style="width: 12px !important; height: 12px !important; min-width: 12px; max-width: 12px; flex-shrink: 0;"><path d="M8 5v14l11-7z"/></svg>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </aside>

    </div>

    <!-- =========================================================
         💬 COMMENTS SLIDE-OVER DRAWER (ULTRA LUXURY TIKTOK STYLE)
         ========================================================= -->
    <div class="reels-comments-backdrop" id="reels-comments-backdrop" onclick="closeReelsCommentsDrawer()"></div>
    <div class="reels-comments-drawer" id="reels-comments-drawer">
        <!-- Drag Handle on Mobile -->
        <div class="comments-drag-handle"></div>

        <!-- Header -->
        <div class="comments-drawer-header">
            <div class="comments-header-left">
                <div class="comments-header-icon-wrap">
                    <svg class="comments-header-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/>
                        <circle cx="8" cy="10" r="1.5"/>
                        <circle cx="12" cy="10" r="1.5"/>
                        <circle cx="16" cy="10" r="1.5"/>
                    </svg>
                </div>
                <div class="comments-header-titles">
                    <div class="flex items-center gap-2">
                        <span class="comments-title-text">Bình luận</span>
                        <span class="comments-count-pill" id="drawer-comments-badge">342</span>
                    </div>
                    <div class="comments-movie-sub" id="drawer-comments-movie">
                        <svg class="comments-movie-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"/></svg>
                        <span>Đang tải phim...</span>
                    </div>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                <button type="button" class="comments-close-btn" onclick="closeReelsCommentsDrawer()" title="Đóng (ESC)">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Filter/Sorting bar -->
        <div class="comments-sort-bar">
            <button type="button" class="comment-sort-btn active" onclick="sortDrawerComments('top', this)">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                    <path d="M17.66 11.2C17.43 10.9 17.15 10.64 16.89 10.38C16.22 9.78 15.46 9.35 14.82 8.72C13.33 7.26 13 4.85 13.9 3C13.29 3.23 12.72 3.59 12.22 4.07C9.9 6.27 9.17 9.8 10.42 12.74C10.47 12.87 10.53 13 10.57 13.13C10.59 13.2 10.6 13.24 10.6 13.28C10.6 13.34 10.56 13.39 10.5 13.41C10.44 13.43 10.38 13.41 10.34 13.37C10.28 13.31 10.23 13.24 10.18 13.16C9.18 11.66 9.27 9.69 9.88 8.16C8.07 9.4 7.08 11.61 7.15 13.84C7.23 16.5 8.92 18.84 11.39 19.67C13.86 20.5 16.64 19.65 18.23 17.61C19.82 15.57 19.88 12.73 18.42 10.63C18.2 10.32 17.94 10.05 17.66 9.8V11.2Z"/>
                </svg>
                <span>Phổ biến nhất</span>
            </button>
            <button type="button" class="comment-sort-btn" onclick="sortDrawerComments('newest', this)">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
                <span>Mới nhất</span>
            </button>
        </div>

        <!-- Comments List (Scrollbar Hidden) -->
        <div class="comments-scroll-body scrollbar-hide" id="drawer-comments-list">
            <!-- Rendered dynamically via JS with SVG icons -->
        </div>

        <!-- Quick Reaction Chips Bar -->
        <div class="comments-quick-chips">
            <button type="button" class="quick-chip-btn" onclick="insertQuickReaction('🔥 Siêu phẩm đáng xem!')">🔥 Siêu phẩm</button>
            <button type="button" class="quick-chip-btn" onclick="insertQuickReaction('❤️ Phim quá cuốn 10/10')">❤️ Quá cuốn</button>
            <button type="button" class="quick-chip-btn" onclick="insertQuickReaction('👏 Diễn xuất đỉnh chóp!')">👏 Đỉnh chóp</button>
            <button type="button" class="quick-chip-btn" onclick="insertQuickReaction('🤣 Hài xỉu luôn á')">🤣 Hài xỉu</button>
            <button type="button" class="quick-chip-btn" onclick="insertQuickReaction('🍿 Review tóm tắt hay lắm')">🍿 Hay lắm</button>
        </div>

        <!-- Bottom Input Form -->
        <div class="comments-input-area">
            <div class="comments-user-avatar">BẠN</div>
            <div class="comments-input-box">
                <input type="text" 
                       id="drawer-comment-input" 
                       class="comments-input-field" 
                       placeholder="Viết bình luận cho video này..." 
                       autocomplete="off"
                       spellcheck="false"
                       onkeydown="handleCommentInputKey(event)" />
                
                <div class="comments-input-actions">
                    <button type="button" class="comment-emoji-toggle-btn" onclick="toggleQuickEmojiPicker(event)" title="Chèn biểu cảm">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fcd576" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M8 14c1.5 2 6.5 2 8 0"></path>
                            <line x1="9" y1="9" x2="9.01" y2="9"></line>
                            <line x1="15" y1="9" x2="15.01" y2="9"></line>
                        </svg>
                    </button>
                    <button type="button" class="comment-send-btn" onclick="submitReelComment()" title="Gửi bình luận">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Floating Quick Emoji Picker -->
            <div class="comments-emoji-popover hidden" id="comments-emoji-popover">
                <div class="emoji-popover-arrow"></div>
                <div class="emoji-grid">
                    <span class="emoji-item" onclick="insertEmojiToComment('🔥')">🔥</span>
                    <span class="emoji-item" onclick="insertEmojiToComment('❤️')">❤️</span>
                    <span class="emoji-item" onclick="insertEmojiToComment('😍')">😍</span>
                    <span class="emoji-item" onclick="insertEmojiToComment('🤣')">🤣</span>
                    <span class="emoji-item" onclick="insertEmojiToComment('👏')">👏</span>
                    <span class="emoji-item" onclick="insertEmojiToComment('🍿')">🍿</span>
                    <span class="emoji-item" onclick="insertEmojiToComment('⭐')">⭐</span>
                    <span class="emoji-item" onclick="insertEmojiToComment('😭')">😭</span>
                    <span class="emoji-item" onclick="insertEmojiToComment('💯')">💯</span>
                    <span class="emoji-item" onclick="insertEmojiToComment('👍')">👍</span>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         🔍 SEARCH SPOTLIGHT MODAL (ENTERPRISE LUXURY GLASSMORPHISM)
         ========================================================= -->
    <div class="reels-search-modal-backdrop" id="reels-search-modal" onclick="handleSearchBackdropClick(event)">
        <div class="reels-search-dialog" onclick="event.stopPropagation()">
            <!-- Glowing Search Header with Search Icon & Quick Clear & Esc Badge -->
            <div class="reels-search-header">
                <div class="search-header-icon-wrap">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
                <input type="text" id="reels-search-input" class="reels-search-input" placeholder="Tìm kiếm phim, review, anime, diễn viên..." autocomplete="off" spellcheck="false" oninput="debounceReelsSearch(this.value)" />
                <button type="button" id="reels-search-clear-btn" class="search-clear-btn hidden" onclick="clearReelsSearchInput()" title="Xóa tìm kiếm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
                <button class="search-esc-badge" onclick="closeReelsSearchModal()" title="Đóng tìm kiếm (ESC)">
                    <span>ESC</span>
                </button>
            </div>

            <!-- Quick Filter Chips with SVG Icons -->
            <div class="reels-search-chips">
                <button class="search-chip" onclick="filterReelsByQuery('Chiếu Rạp')">
                    <svg class="chip-icon text-amber-300" viewBox="0 0 24 24" fill="currentColor"><path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"/></svg>
                    <span>Chiếu Rạp</span>
                </button>
                <button class="search-chip" onclick="filterReelsByQuery('Hành Động')">
                    <svg class="chip-icon text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    <span>Hành Động</span>
                </button>
                <button class="search-chip" onclick="filterReelsByQuery('Kinh Dị')">
                    <svg class="chip-icon text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 10h.01M15 10h.01M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"/></svg>
                    <span>Kinh Dị</span>
                </button>
                <button class="search-chip" onclick="filterReelsByQuery('Anime')">
                    <svg class="chip-icon text-amber-300" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <span>Anime</span>
                </button>
                <button class="search-chip" onclick="filterReelsByQuery('Hàn Quốc')">
                    <svg class="chip-icon text-pink-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    <span>Hàn Quốc</span>
                </button>
            </div>

            <div class="search-results-scroll custom-scroll">
                <div class="search-results-heading-row" id="search-results-heading-wrap">
                    <div class="flex items-center gap-2">
                        <span class="search-heading-icon">🔥</span>
                        <span class="search-heading-text" id="search-results-heading">GỢI Ý THỊNH HÀNH</span>
                    </div>
                    <span class="search-heading-badge">XEM NHIỀU NHẤT</span>
                </div>
                <div class="space-y-2.5" id="search-results-list">
                    <% if (initialReels && initialReels.length > 0) { %>
                        <% initialReels.slice(0, 5).forEach(function(sItem, sIdx) { %>
                            <div class="search-result-card" onclick="filterReelsByQuery('<%= sItem.movieTitle %>')">
                                <div class="search-card-thumb-wrap">
                                    <img src="<%= sItem.poster %>" class="search-card-thumb" alt="<%= sItem.movieTitle %>" onerror="this.src='/android-chrome-192x192.png';" />
                                    <span class="search-card-rank-badge rank-<%= sIdx + 1 %>">#<%= sIdx + 1 %></span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="search-card-title"><%= sItem.movieTitle %></div>
                                    <div class="search-card-sub">
                                        <span><%= sItem.year || '2026' %></span>
                                        <span class="search-card-dot">•</span>
                                        <span class="search-card-quality"><%= sItem.quality || 'FHD' %></span>
                                        <span class="search-card-dot">•</span>
                                        <span class="search-card-rating">⭐ <%= sItem.rating || '9.6' %></span>
                                    </div>
                                </div>
                                <span class="search-card-play-arrow">
                                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                </span>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="search-result-card" onclick="filterReelsByQuery('Mai')">
                            <div class="search-card-thumb-wrap">
                                <div class="search-card-thumb-placeholder">🎬</div>
                                <span class="search-card-rank-badge rank-1">#1</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="search-card-title">Mai (Trấn Thành)</div>
                                <div class="search-card-sub">2024 • <span class="search-card-quality">FHD</span> • ⭐ 9.8</div>
                            </div>
                            <span class="search-card-play-arrow"><svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Bottom Footer bar -->
            <div class="search-dialog-footer">
                <div class="flex items-center gap-1.5 text-[11px] text-gray-400">
                    <kbd class="search-kbd-key">↵</kbd>
                    <span>Chọn xem</span>
                </div>
                <div class="flex items-center gap-1.5 text-[11px] text-gray-400">
                    <kbd class="search-kbd-key">ESC</kbd>
                    <span>Đóng</span>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         📜 WATCH HISTORY MODAL (LOCALSTORAGE POWERED)
         ========================================================= -->
    <div class="reels-history-modal-backdrop" id="reels-history-modal" onclick="handleHistoryBackdropClick(event)">
        <div class="reels-history-dialog" onclick="event.stopPropagation()">
            <div class="history-header">
                <div class="history-title-wrap">
                    <svg class="w-5 h-5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="12" cy="12" r="9"/>
                        <polyline points="12 7 12 12 15 15"/>
                    </svg>
                    <span class="history-title">Lịch sử đã xem</span>
                    <span class="history-count-badge" id="history-count-badge">0 video</span>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" class="history-clear-btn" onclick="clearReelsWatchHistory()" title="Xóa toàn bộ lịch sử">Xóa tất cả</button>
                    <button type="button" class="sheet-close-btn" onclick="closeReelsHistoryModal()" title="Đóng (ESC)">
                        <svg class="w-4 h-4 text-gray-300 hover:text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="history-list-scroll custom-scroll" id="history-list-container">
                <!-- Dynamically populated via JS -->
            </div>
        </div>
    </div>

    <!-- =========================================================
         🔔 FLOATING TOAST NOTIFICATION (DYNAMIC ISLAND STYLE)
         ========================================================= -->
    <div id="reels-toast" class="reels-toast">
        <div class="reels-toast-icon-wrap" id="reels-toast-icon-wrap">
            <div class="toast-icon-badge badge-success">
                <svg class="w-3.5 h-3.5 text-emerald-300" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
        </div>
        <div class="reels-toast-content">
            <span id="reels-toast-msg">Đã sao chép liên kết video!</span>
        </div>
    </div>

    <!-- =========================================================
         🚀 CLIENT CONTROLLER
         ========================================================= -->
    <script src="/js/reels.js?v=441"></script>
</body>

</html>
