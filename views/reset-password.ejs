<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('partials/head') %>
    <style>
        /* ── Master 2-Column Auth Card Container ── */
        .ap-reset-modal-box {
            display: flex;
            width: 100%;
            max-width: 860px;
            min-height: 520px;
            background: #1c1f2c;
            border-radius: 28px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45), 0 0 40px rgba(245, 158, 11, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            overflow: hidden;
            position: relative;
            transition: all 0.3s ease;
        }

        /* ── Light / Cream Mode ── */
        html.light-mode .ap-reset-modal-box {
            background: #fbf7ef !important;
            border: 1px solid #e5dcce !important;
            box-shadow: 0 24px 60px rgba(78, 64, 45, 0.14), 0 0 35px rgba(217, 119, 6, 0.08) !important;
            color: #1c1917 !important;
        }

        /* ── Left Column (Cinema Poster Art) ── */
        .ap-auth-left {
            width: 44%;
            min-height: 100%;
            background-image: linear-gradient(to bottom, rgba(15, 18, 30, 0.05) 0%, rgba(15, 18, 30, 0.25) 45%, rgba(15, 18, 30, 0.88) 100%), url('https://phim.nguonc.com/public/images/Film/pxd9rc03EMMln3tVFdfd427Fpsi.jpg');
            background-size: cover;
            background-position: center top;
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            flex-shrink: 0;
            box-sizing: border-box;
        }
        @media (max-width: 768px) {
            .ap-auth-left {
                display: none;
            }
            .ap-reset-modal-box {
                max-width: 460px;
                min-height: auto;
                border-radius: 24px;
            }
        }

        .ap-auth-poster-title {
            font-size: 22px;
            font-weight: 900;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: -0.02em;
            margin: 0 0 8px 0;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
            line-height: 1.25;
        }
        .ap-auth-poster-sub {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.95);
            margin: 0;
            line-height: 1.5;
            text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
            font-weight: 500;
        }

        /* ── Right Column (Form Panel) ── */
        .ap-auth-right {
            width: 56%;
            padding: 56px 38px 36px 38px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            box-sizing: border-box;
        }
        @media (max-width: 768px) {
            .ap-auth-right {
                width: 100%;
                padding: 64px 22px 32px 22px;
                justify-content: flex-start;
            }
        }

        /* ── Close Button ── */
        .ap-auth-close-btn {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: rgba(255, 255, 255, 0.85);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            z-index: 30;
            outline: none;
        }
        .ap-auth-close-btn:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
            transform: scale(1.06);
        }
        html.light-mode .ap-auth-close-btn {
            background: #eae3d5 !important;
            border: 1px solid #d6cebf !important;
            color: #1c1917 !important;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06) !important;
        }
        html.light-mode .ap-auth-close-btn:hover {
            background: #ded5c4 !important;
            color: #d97706 !important;
        }

        /* ── Pill Tabs Switcher ── */
        .ap-auth-tabs-wrap {
            background: rgba(0, 0, 0, 0.28);
            border-radius: 9999px;
            padding: 4px;
            display: flex;
            margin-bottom: 16px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            width: 100%;
            box-sizing: border-box;
        }
        html.light-mode .ap-auth-tabs-wrap {
            background: #eae3d5 !important;
            border: 1px solid #d6cebf !important;
        }
        .ap-auth-tab-btn {
            flex: 1;
            border: none;
            background: transparent;
            color: rgba(255, 255, 255, 0.65);
            font-size: 13.5px;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 9999px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: center;
            text-decoration: none;
            display: inline-block;
        }
        .ap-auth-tab-btn.active {
            background: rgba(255, 255, 255, 0.28);
            color: #ffffff;
            font-weight: 800;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
        }
        html.light-mode .ap-auth-tab-btn {
            color: #57534e !important;
        }
        html.light-mode .ap-auth-tab-btn.active {
            background: #ffffff !important;
            color: #1c1917 !important;
            box-shadow: 0 2px 8px rgba(78, 64, 45, 0.12) !important;
        }

        /* ── Subtitle Prompt ── */
        .ap-auth-sub-desc {
            font-size: 13px;
            color: #9ca3af;
            margin: 0 0 16px 0;
            line-height: 1.45;
        }
        html.light-mode .ap-auth-sub-desc {
            color: #57534e !important;
        }

        /* ── Form Inputs ── */
        .ap-field-wrap {
            margin-bottom: 13px;
            position: relative;
        }
        .ap-form-input {
            width: 100%;
            box-sizing: border-box;
            background: rgba(0, 0, 0, 0.28);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 14px;
            padding: 12px 42px 12px 16px;
            color: #ffffff;
            font-size: 14px;
            font-family: inherit;
            outline: none;
            transition: all 0.2s ease;
        }
        .ap-form-input:focus {
            border-color: #fcd576;
            background: rgba(0, 0, 0, 0.4);
            box-shadow: 0 0 0 3px rgba(252, 213, 118, 0.18);
        }
        .ap-form-input::placeholder {
            color: rgba(255, 255, 255, 0.45);
            font-size: 13.5px;
        }
        html.light-mode .ap-form-input {
            background: #ffffff !important;
            border: 1.5px solid #dcd3c5 !important;
            color: #1c1917 !important;
            box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.03);
        }
        html.light-mode .ap-form-input:focus {
            border-color: #d97706 !important;
            box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.2) !important;
        }
        html.light-mode .ap-form-input::placeholder {
            color: #78716c !important;
        }

        /* ── Eye Toggle Button ── */
        .ap-pwd-toggle-btn {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #9ca3af;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2px;
            transition: color 0.2s;
        }
        .ap-pwd-toggle-btn:hover {
            color: #fcd576;
        }
        html.light-mode .ap-pwd-toggle-btn {
            color: #78716c !important;
        }
        html.light-mode .ap-pwd-toggle-btn:hover {
            color: #d97706 !important;
        }

        /* ── Strength Meter Bar ── */
        .strength-meter-bar {
            height: 4px;
            border-radius: 9999px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            width: 0%;
        }
        .strength-weak { width: 33%; background: #ef4444; }
        .strength-medium { width: 66%; background: #f59e0b; }
        .strength-strong { width: 100%; background: #10b981; }

        /* ── Checklist Items ── */
        .req-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11.5px;
            color: #9ca3af;
            transition: color 0.2s;
        }
        html.light-mode .req-item {
            color: #78716c;
        }
        .req-item.valid {
            color: #10b981 !important;
            font-weight: 600;
        }
        .req-item.valid svg {
            stroke: #10b981 !important;
        }

        /* ── Gold Action Button ── */
        .ap-auth-submit-btn {
            width: 100%;
            padding: 13px 20px;
            background: linear-gradient(135deg, #fcd576 0%, #f59e0b 100%);
            color: #0d0f1a;
            border: none;
            border-radius: 14px;
            font-size: 14.5px;
            font-weight: 800;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(217, 119, 6, 0.35);
            transition: all 0.2s ease;
            margin-top: 14px;
        }
        .ap-auth-submit-btn:hover {
            background: linear-gradient(135deg, #ffe08c 0%, #d97706 100%);
            box-shadow: 0 6px 18px rgba(217, 119, 6, 0.5);
            transform: translateY(-1px);
        }
        .ap-auth-submit-btn:active {
            transform: translateY(0);
        }
    </style>
</head>
<body class="bg-[#181921] text-gray-200 min-h-screen pt-24 md:pt-28 flex flex-col font-sans transition-colors duration-200">
    <%- include('partials/header') %>

    <main class="flex-grow flex items-center justify-center py-8 px-4 sm:px-6 relative overflow-hidden">
        <!-- Ambient Light Glows -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-amber-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

        <!-- 2-COLUMN AUTH MODAL CARD -->
        <div class="ap-reset-modal-box" id="resetCardContainer">
            
            <!-- LEFT COLUMN: Cinema Poster Art -->
            <div class="ap-auth-left" id="apAuthLeft">
                <div>
                    <!-- Logo / Brand Tag -->
                    <a href="/" class="inline-block transform hover:scale-105 transition-transform">
                        <img src="/images/logo.png" alt="APhim Cinema" class="h-8 w-auto drop-shadow-md" onerror="this.style.display='none'">
                    </a>
                </div>
                <div>
                    <h2 class="ap-auth-poster-title">KHÔI PHỤC MẬT KHẨU</h2>
                    <p class="ap-auth-poster-sub">
                        Tạo mật khẩu mới an toàn để tiếp tục thỏa sức thưởng thức hàng ngàn bộ phim Vietsub HD đỉnh cao.
                    </p>
                </div>
            </div>

            <!-- RIGHT COLUMN: Interactive Form -->
            <div class="ap-auth-right">
                
                <!-- Close Button X (Quay lại trang chủ) -->
                <a href="/" class="ap-auth-close-btn" title="Đóng / Quay lại trang chủ" aria-label="Đóng">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </a>

                <!-- STATE 1: ĐẶT LẠI MẬT KHẨU (TOKEN HỢP LỆ) -->
                <div id="resetFormState">
                    <!-- Segmented Tabs Navigation -->
                    <div class="ap-auth-tabs-wrap">
                        <button type="button" class="ap-auth-tab-btn" onclick="openLoginModalDirectly()">
                            Đăng nhập
                        </button>
                        <button type="button" class="ap-auth-tab-btn active">
                            Đặt lại mật khẩu
                        </button>
                    </div>

                    <p class="ap-auth-sub-desc">
                        Nhập mật khẩu mới cho tài khoản của bạn, hoặc <a href="javascript:void(0)" onclick="openLoginModalDirectly()" class="text-amber-500 font-bold hover:underline">quay lại đăng nhập</a>
                    </p>

                    <!-- Alert / Notification -->
                    <div id="statusAlert" class="hidden mb-3 p-3 rounded-xl text-xs font-semibold transition-all"></div>

                    <form id="resetPasswordForm" onsubmit="return handleResetPasswordSubmit(event)">
                        <!-- Input Mật khẩu mới -->
                        <div class="ap-field-wrap">
                            <input 
                                type="password" 
                                id="newPassword" 
                                name="newPassword" 
                                required 
                                autocomplete="new-password"
                                placeholder="Nhập mật khẩu mới..."
                                class="ap-form-input"
                                oninput="checkPasswordStrength(this.value)"
                            >
                            <button type="button" class="ap-pwd-toggle-btn" onclick="togglePasswordVisibility('newPassword', this)" title="Ẩn/hiện mật khẩu">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                        </div>

                        <!-- Strength Meter -->
                        <div class="mb-3">
                            <div class="w-full bg-black/10 dark:bg-white/10 h-1.5 rounded-full overflow-hidden mb-1">
                                <div id="strengthMeter" class="strength-meter-bar"></div>
                            </div>
                            <div class="flex justify-between items-center text-[11px] text-gray-500">
                                <span>Độ bảo mật: <strong id="strengthLabel" class="text-gray-400">Chưa nhập</strong></span>
                            </div>
                        </div>

                        <!-- Input Xác nhận mật khẩu mới -->
                        <div class="ap-field-wrap">
                            <input 
                                type="password" 
                                id="confirmPassword" 
                                name="confirmPassword" 
                                required 
                                autocomplete="new-password"
                                placeholder="Xác nhận mật khẩu mới..."
                                class="ap-form-input"
                                oninput="validateMatch()"
                            >
                            <button type="button" class="ap-pwd-toggle-btn" onclick="togglePasswordVisibility('confirmPassword', this)" title="Ẩn/hiện mật khẩu">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                            <p id="matchError" class="hidden text-[11px] text-red-500 font-medium mt-1">Mật khẩu xác nhận không khớp.</p>
                        </div>

                        <!-- Password Checklist -->
                        <div class="p-2.5 bg-black/[0.04] dark:bg-white/[0.04] border border-black/5 dark:border-white/5 rounded-xl space-y-1 mb-2">
                            <div id="reqLength" class="req-item">
                                <i data-lucide="circle-check" class="w-3.5 h-3.5 stroke-gray-400"></i>
                                <span>Tối thiểu 8 ký tự</span>
                            </div>
                            <div id="reqLetter" class="req-item">
                                <i data-lucide="circle-check" class="w-3.5 h-3.5 stroke-gray-400"></i>
                                <span>Có ít nhất 1 chữ cái (a-z, A-Z)</span>
                            </div>
                            <div id="reqNumber" class="req-item">
                                <i data-lucide="circle-check" class="w-3.5 h-3.5 stroke-gray-400"></i>
                                <span>Có ít nhất 1 chữ số (0-9)</span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" id="submitResetBtn" class="ap-auth-submit-btn">
                            <span id="btnText">Lưu Mật Khẩu Mới</span>
                        </button>
                    </form>
                </div>

                <!-- STATE 2: LIÊN KẾT HẾT HẠN HOẶC KHÔNG HỢP LỆ -->
                <div id="invalidTokenState" class="hidden text-center py-4">
                    <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-red-500/15 border border-red-500/30 text-red-500 mb-3">
                        <i data-lucide="shield-alert" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 dark:text-white mb-2">Liên kết không hợp lệ hoặc đã hết hạn</h3>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-6 leading-relaxed">
                        Mã bảo mật trong liên kết khôi phục của bạn đã hết hạn sử dụng. Vui lòng gửi lại yêu cầu để nhận mã mới.
                    </p>
                    <div class="space-y-2">
                        <button 
                            onclick="openForgotModalDirectly()"
                            class="ap-auth-submit-btn"
                            style="margin-top: 0;"
                        >
                            Gửi lại yêu cầu khôi phục
                        </button>
                        <a 
                            href="/" 
                            class="block w-full py-2.5 text-center text-xs font-bold text-gray-500 hover:text-amber-500 transition-colors"
                        >
                            Quay về trang chủ
                        </a>
                    </div>
                </div>

                <!-- STATE 3: THÀNH CÔNG -->
                <div id="successState" class="hidden text-center py-6">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-500 mb-4 animate-bounce">
                        <i data-lucide="check-circle-2" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 dark:text-white mb-2">Đổi mật khẩu thành công!</h3>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-6 leading-relaxed">
                        Mật khẩu tài khoản của bạn đã được cập nhật an toàn. Đang chuyển hướng bạn về trang chủ để đăng nhập...
                    </p>
                    <a 
                        href="/" 
                        class="ap-auth-submit-btn"
                        style="margin-top: 0; text-decoration: none;"
                    >
                        Về trang chủ ngay
                    </a>
                </div>

            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        let accessToken = '';

        function getAuthTokenFromUrl() {
            // Check hash fragment (#access_token=...&type=recovery)
            const hash = window.location.hash.substring(1);
            if (hash) {
                const params = new URLSearchParams(hash);
                const token = params.get('access_token');
                if (token) return token;
            }

            // Check query search string (?access_token=... or ?token=...)
            const searchParams = new URLSearchParams(window.location.search);
            return searchParams.get('access_token') || searchParams.get('token') || '';
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            accessToken = getAuthTokenFromUrl();

            const formState = document.getElementById('resetFormState');
            const invalidState = document.getElementById('invalidTokenState');

            if (!accessToken) {
                formState.classList.add('hidden');
                invalidState.classList.remove('hidden');
            } else {
                formState.classList.remove('hidden');
                invalidState.classList.add('hidden');
            }
        });

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            btn.innerHTML = isPassword 
                ? '<i data-lucide="eye-off" class="w-4 h-4"></i>' 
                : '<i data-lucide="eye" class="w-4 h-4"></i>';
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        function checkPasswordStrength(val) {
            const meter = document.getElementById('strengthMeter');
            const label = document.getElementById('strengthLabel');
            
            const hasLength = val.length >= 8;
            const hasLetter = /[A-Za-z]/.test(val);
            const hasNumber = /\d/.test(val);

            updateReqItem('reqLength', hasLength);
            updateReqItem('reqLetter', hasLetter);
            updateReqItem('reqNumber', hasNumber);

            let score = 0;
            if (hasLength) score++;
            if (hasLetter) score++;
            if (hasNumber) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            meter.className = 'strength-meter-bar';
            if (!val) {
                label.textContent = 'Chưa nhập';
                label.className = 'text-gray-400';
            } else if (score <= 1) {
                meter.classList.add('strength-weak');
                label.textContent = 'Yếu';
                label.className = 'text-red-500 font-bold';
            } else if (score === 2 || score === 3) {
                meter.classList.add('strength-medium');
                label.textContent = 'Trung bình';
                label.className = 'text-amber-500 font-bold';
            } else {
                meter.classList.add('strength-strong');
                label.textContent = 'Mạnh';
                label.className = 'text-emerald-500 font-bold';
            }

            validateMatch();
        }

        function updateReqItem(id, isValid) {
            const el = document.getElementById(id);
            if (!el) return;
            if (isValid) {
                el.classList.add('valid');
                el.querySelector('i')?.setAttribute('data-lucide', 'check-circle');
            } else {
                el.classList.remove('valid');
                el.querySelector('i')?.setAttribute('data-lucide', 'circle-check');
            }
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        function validateMatch() {
            const pwd = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;
            const err = document.getElementById('matchError');
            if (confirm && pwd !== confirm) {
                err.classList.remove('hidden');
                return false;
            } else {
                err.classList.add('hidden');
                return true;
            }
        }

        function showAlert(msg, type = 'error') {
            const alert = document.getElementById('statusAlert');
            alert.className = `p-3 rounded-xl text-xs font-semibold mb-3 ${
                type === 'error' 
                    ? 'bg-red-500/15 border border-red-500/30 text-red-500 dark:text-red-400' 
                    : 'bg-emerald-500/15 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400'
            }`;
            alert.textContent = msg;
            alert.classList.remove('hidden');
        }

        async function handleResetPasswordSubmit(e) {
            e.preventDefault();
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (newPassword !== confirmPassword) {
                showAlert('Mật khẩu xác nhận không khớp, vui lòng kiểm tra lại.', 'error');
                return false;
            }

            const passwordRegex = /^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d@$!%*#?&]{8,}$/;
            if (!passwordRegex.test(newPassword)) {
                showAlert('Mật khẩu phải có ít nhất 8 ký tự, gồm cả chữ cái và chữ số.', 'error');
                return false;
            }

            const btn = document.getElementById('submitResetBtn');
            const btnText = document.getElementById('btnText');
            btn.disabled = true;
            btnText.textContent = 'Đang lưu mật khẩu...';

            try {
                const response = await fetch('/api/auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        accessToken: accessToken,
                        newPassword: newPassword
                    })
                });

                const data = await response.json();

                if (data.success) {
                    document.getElementById('resetFormState').classList.add('hidden');
                    document.getElementById('successState').classList.remove('hidden');
                    if (typeof lucide !== 'undefined') lucide.createIcons();

                    setTimeout(() => {
                        window.location.href = '/';
                    }, 3000);
                } else {
                    showAlert(data.message || 'Không thể đặt lại mật khẩu. Vui lòng thử lại.', 'error');
                    btn.disabled = false;
                    btnText.textContent = 'Lưu Mật Khẩu Mới';
                }
            } catch (err) {
                console.error('Reset error:', err);
                showAlert('Lỗi kết nối máy chủ. Vui lòng thử lại sau.', 'error');
                btn.disabled = false;
                btnText.textContent = 'Lưu Mật Khẩu Mới';
            }

            return false;
        }

        function openLoginModalDirectly() {
            window.location.href = '/';
            setTimeout(() => {
                if (typeof window.openAuthModal === 'function') {
                    window.openAuthModal('login');
                }
            }, 300);
        }

        function openForgotModalDirectly() {
            window.location.href = '/';
            setTimeout(() => {
                if (typeof window.openAuthModal === 'function') {
                    window.openAuthModal('forgot');
                }
            }, 300);
        }
    </script>
</body>
</html>
