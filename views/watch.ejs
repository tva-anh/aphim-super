<!DOCTYPE html>
<html class="dark" lang="vi">

<head>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/watch-page.css?v=340" />
</head>

<body class="bg-[#1f2331] text-gray-100 font-display min-h-screen overflow-x-hidden w-full">
    <!-- Cinema Dimmer Overlay & Exit Indicator -->
    <div id="cinemaOverlay" onclick="toggleCinemaMode()" title="Nhấn vào đây để bật lại đèn"></div>
    <div id="cinemaExitHint" onclick="toggleCinemaMode()" style="visibility: hidden; opacity: 0; cursor: pointer;" title="Bấm để bật lại đèn">
        <span class="material-icons-round text-sm text-amber-400">theater_comedy</span>
        <span>Chế độ Rạp phim • Chạm bất kỳ đâu hoặc bấm phím <b>ESC / T</b> để bật đèn</span>
    </div>

    <!-- Navigation Header -->
    <%- include('partials/header') %>

        <!-- Main Container -->
        <main
            class="app-container relative z-10 pt-4 sm:pt-6 pb-16 md:pb-24 space-y-4.5 md:space-y-5 watch-main-container">

            <div class="space-y-2 watch-top-bar" style="margin-bottom: 14px !important;">
                <div class="flex items-center justify-between gap-2 flex-wrap sm:flex-nowrap w-full">
                    <div
                        class="flex items-center flex-nowrap gap-1.5 sm:gap-2 text-xs sm:text-sm font-bold select-none overflow-hidden whitespace-nowrap max-w-full watch-breadcrumb-bar flex-1 min-w-0">
                        <a class="hover:text-[#fcd576] transition-colors flex-shrink-0 text-white font-bold whitespace-nowrap"
                            href="/">Trang chủ</a>
                        <svg style="width: 12px !important; height: 12px !important; min-width: 12px !important; min-height: 12px !important; max-width: 12px !important; max-height: 12px !important; display: inline-block !important;"
                            class="text-gray-200 mx-0.5 flex-shrink-0" fill="none" stroke="currentColor"
                            stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                        <a id="breadcrumb-category"
                            class="hover:text-[#fcd576] transition-colors flex-shrink-0 text-white font-bold whitespace-nowrap"
                            href="/danh-sach?list=phim-bo">Phim Bộ</a>
                        <svg style="width: 12px !important; height: 12px !important; min-width: 12px !important; min-height: 12px !important; max-width: 12px !important; max-height: 12px !important; display: inline-block !important;"
                            class="text-gray-200 mx-0.5 flex-shrink-0" fill="none" stroke="currentColor"
                            stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                        <span id="breadcrumb-movie-name"
                            class="text-white font-extrabold truncate flex-1 min-w-0">...</span>
                        <span id="watchBreadcrumbEpName"
                            class="text-[#fcd576] font-extrabold flex-shrink-0 whitespace-nowrap">...</span>
                    </div>

                    <!-- 🎁 Watch-to-Earn Pill (Ẩn hoàn toàn cho khách, chỉ hiện khi đã đăng nhập tài khoản) -->
                    <div id="watchToEarnPill"
                        class="watch-to-earn-pill items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold select-none cursor-pointer transition-all flex-shrink-0 shadow-sm"
                        style="display: none;"
                        onclick="if(window.GamificationCore && typeof window.GamificationCore.handlePillClick === 'function') { window.GamificationCore.handlePillClick(event); }"
                        title="Xem phim tích luỹ Xu & XP mỗi ngày">
                        <span class="watch-to-earn-dot"
                            style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#f59e0b;box-shadow:0 0 8px #f59e0b;animation:pulse 2s infinite;"></span>
                        <span id="watchToEarnText" class="watch-to-earn-text font-extrabold text-xs">💎 Cày Xu: 0/15p</span>
                    </div>
                </div>

                <!-- Dismissible Warning Banner (Ultra-thin border, sleek left-aligned thin text, no border box on [Đổi trình phát]) -->
                <div id="dismissibleNotice"
                    class="mt-1.5 flex items-center justify-between bg-[#161822]/80 border border-white/10 rounded-lg px-3.5 py-1.5 text-xs text-gray-300 shadow-sm backdrop-blur-md transition-all"
                    style="margin-bottom: 14px !important;">
                    <div class="flex items-center gap-2 text-left justify-start min-w-0">
                        <span
                            class="material-icons-round text-amber-400/90 text-sm flex-shrink-0 notice-info-icon">info</span>
                        <span class="font-normal text-[11.5px] sm:text-[12.5px] text-gray-300 leading-snug">Nếu video bị
                            lỗi hoặc không tải được, bạn hãy bấm nút <span
                                class="text-white font-semibold notice-btn-highlight">[Đổi trình phát]</span> ở phần Cấu
                            hình để chuyển đổi trình phát nhé!</span>
                    </div>
                    <button type="button" onclick="document.getElementById('dismissibleNotice').remove()"
                        class="notice-close-btn text-gray-400 hover:text-white transition-colors p-1 ml-2 flex-shrink-0"
                        title="ng thng bo">
                        <span class="material-icons-round text-sm">close</span>
                    </button>
                </div>
            </div>

            <!-- Main 2-Column Grid Layout (70% Player Column / 30% Sticky Sidebar) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 items-start mb-24 pb-16">

                <!-- ================================================================= -->
                <!-- LEFT COLUMN: Player + Controls + Episodes + Gallery + Comments (~70%) -->
                <!-- ================================================================= -->
                <div class="lg:col-span-8 space-y-6" id="player-and-controls">

                    <!-- 2. Khung Player + Thanh điều khiển (Card dính liền hoà trộn hoàn toàn) -->
                    <div id="main-player-box"
                        class="relative w-full bg-black rounded-2xl overflow-hidden shadow-2xl border border-white/10 z-[9990] group">
                        <!-- Aspect 16:9 Video Player Box -->
                        <div class="relative w-full aspect-video bg-black overflow-hidden">
                            <div id="playerPlaceholder"
                                class="absolute inset-0 w-full h-full flex flex-col items-center justify-center cursor-pointer overflow-hidden group/overlay"
                                onclick="window.startActualPlayback && window.startActualPlayback()">

                                <!-- Ambient Cinematic Radial Backdrop -->
                                <div
                                    class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,_rgba(252,211,77,0.08)_0%,_rgba(18,20,29,0.95)_70%,_#0a0c10_100%)] pointer-events-none">
                                </div>

                                <!-- Center Glowing Dual-Ring Spinner & Play Icon -->
                                <div class="relative z-20 flex flex-col items-center justify-center gap-4">
                                    <div class="relative w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center">
                                        <!-- Outer Golden Spinning Ring -->
                                        <div
                                            class="absolute inset-0 rounded-full border-2 border-transparent border-t-[#fcd576] border-r-[#f59e0b] animate-spin shadow-[0_0_20px_rgba(252,211,77,0.5)]">
                                        </div>
                                        <!-- Inner Neon Violet Spinning Ring -->
                                        <div
                                            class="absolute inset-2 rounded-full border-2 border-transparent border-b-[#a855f7] border-l-[#818cf8] animate-[spin_1.5s_linear_infinite_reverse]">
                                        </div>
                                        <!-- Center Glowing Play Button Icon -->
                                        <div
                                            class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-gradient-to-tr from-[#f59e0b] to-[#fcd576] text-[#0a0c10] flex items-center justify-center shadow-[0_0_25px_rgba(245,158,11,0.6)] transform transition-transform duration-300 group-hover/overlay:scale-110">
                                            <span
                                                class="material-icons-round text-2xl sm:text-3xl ml-0.5">play_arrow</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- --- 3D CINEMATIC PREMIUM META BLOCK --- -->
                                <div class="player-overlay-meta absolute bottom-0 left-0 right-0 z-20 pointer-events-none"
                                    style="
                                    background: linear-gradient(to top, rgba(5,5,15,0.98) 0%, rgba(5,5,15,0.85) 40%, rgba(5,5,15,0.4) 70%, transparent 100%);
                                    padding: 60px 24px 20px 24px;
                                ">
                                    <!-- 3D Perspective Depth Container -->
                                    <div style="
                                    perspective: 800px;
                                    perspective-origin: 20% 100%;
                                ">
                                        <div class="player-meta-3d-card" style="
                                        transform: rotateX(1deg) rotateY(-0.5deg);
                                        transform-style: preserve-3d;
                                        display: flex;
                                        flex-direction: column;
                                        gap: 10px;
                                    ">
                                            <!-- Row 1: Studio Badge + Quality/Sub Badges -->
                                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">

                                                <!-- APHIM STUDIO Badge  3D Gold Foil -->
                                                <span class="badge-aphim-studio" style="
                                                position: relative;
                                                display: inline-flex;
                                                align-items: center;
                                                gap: 5px;
                                                background: linear-gradient(135deg, #ffe87c 0%, #f59e0b 45%, #b45309 100%);
                                                color: #0a0c10;
                                                font-weight: 900;
                                                font-size: 9.5px;
                                                letter-spacing: 1.5px;
                                                text-transform: uppercase;
                                                padding: 4px 11px;
                                                border-radius: 4px;
                                                border-top: 1px solid rgba(255,240,120,0.9);
                                                border-left: 1px solid rgba(255,240,120,0.6);
                                                border-right: 1px solid rgba(120,70,0,0.5);
                                                border-bottom: 1px solid rgba(120,70,0,0.5);
                                                box-shadow:
                                                    0 1px 0 rgba(255,255,255,0.35) inset,
                                                    0 -1px 0 rgba(0,0,0,0.3) inset,
                                                    2px 4px 12px rgba(245,158,11,0.55),
                                                    0 2px 4px rgba(0,0,0,0.6),
                                                    4px 6px 16px rgba(0,0,0,0.4);
                                                transform: translateZ(6px);
                                                text-shadow: 0 1px 0 rgba(255,255,255,0.4);
                                            ">
                                                    <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"
                                                        style="opacity:0.85">
                                                        <path
                                                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                    </svg>
                                                    APHIM STUDIO
                                                </span>

                                                <!-- Quality Badge  FHD -->
                                                <span id="playerQualityBadge" style="
                                                display: inline-flex;
                                                align-items: center;
                                                gap: 4px;
                                                background: rgba(15, 20, 40, 0.75);
                                                backdrop-filter: blur(8px);
                                                -webkit-backdrop-filter: blur(8px);
                                                border: 1px solid rgba(99,179,237,0.5);
                                                color: #93c5fd;
                                                font-weight: 800;
                                                font-size: 9.5px;
                                                letter-spacing: 1.2px;
                                                text-transform: uppercase;
                                                padding: 4px 10px;
                                                border-radius: 4px;
                                                box-shadow:
                                                    0 0 12px rgba(96,165,250,0.3),
                                                    0 2px 4px rgba(0,0,0,0.5),
                                                    inset 0 1px 0 rgba(147,197,253,0.15);
                                                transform: translateZ(4px);
                                            ">
                                                    <svg width="7" height="7" viewBox="0 0 24 24" fill="currentColor">
                                                        <circle cx="12" cy="12" r="10" />
                                                    </svg>
                                                    FHD
                                                </span>

                                                <!-- Sub/Dub Badge -->
                                                <span id="playerSubBadge" style="
                                                display: inline-flex;
                                                align-items: center;
                                                gap: 4px;
                                                background: rgba(40, 15, 65, 0.75);
                                                backdrop-filter: blur(8px);
                                                -webkit-backdrop-filter: blur(8px);
                                                border: 1px solid rgba(168,85,247,0.55);
                                                color: #d8b4fe;
                                                font-weight: 800;
                                                font-size: 9.5px;
                                                letter-spacing: 1.2px;
                                                text-transform: uppercase;
                                                padding: 4px 10px;
                                                border-radius: 4px;
                                                box-shadow:
                                                    0 0 12px rgba(168,85,247,0.35),
                                                    0 2px 4px rgba(0,0,0,0.5),
                                                    inset 0 1px 0 rgba(216,180,254,0.12);
                                                transform: translateZ(4px);
                                            ">
                                                    VIETSUB
                                                </span>

                                                <!-- Live CDN Status Pill -->
                                                <div class="badge-quality-sub" style="
                                                display: inline-flex;
                                                align-items: center;
                                                gap: 6px;
                                                background: rgba(10, 20, 10, 0.65);
                                                backdrop-filter: blur(8px);
                                                border: 1px solid rgba(52,211,153,0.45);
                                                padding: 4px 10px;
                                                border-radius: 4px;
                                                box-shadow:
                                                    0 0 10px rgba(52,211,153,0.25),
                                                    0 2px 4px rgba(0,0,0,0.5);
                                                transform: translateZ(4px);
                                            ">
                                                    <span style="
                                                    width: 6px; height: 6px;
                                                    border-radius: 50%;
                                                    background: #34d399;
                                                    box-shadow: 0 0 6px #34d399, 0 0 12px rgba(52,211,153,0.6);
                                                    animation: pulse-cdn 1.4s ease-in-out infinite;
                                                    flex-shrink: 0;
                                                "></span>
                                                    <span
                                                        style="color: #6ee7b7; font-weight: 700; font-size: 9px; letter-spacing: 0.9px; text-transform: uppercase; white-space: nowrap;">
                                                        CDN LIVE
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Row 2: Movie Title (3D Text Effect) -->
                                            <div
                                                style="transform: translateZ(10px); display: flex; flex-direction: column; gap: 4px;">
                                                <h1 id="playerMovieTitle" style="
                                                    margin: 0;
                                                    font-family: 'Inter', system-ui, sans-serif;
                                                    font-size: clamp(18px, 2.5vw, 32px);
                                                    font-weight: 900;
                                                    letter-spacing: -0.5px;
                                                    line-height: 1.15;
                                                    background: linear-gradient(135deg, #ffffff 0%, #fde68a 40%, #fbbf24 70%, #ffffff 100%);
                                                    -webkit-background-clip: text;
                                                    -webkit-text-fill-color: transparent;
                                                    background-clip: text;
                                                    filter: drop-shadow(0 2px 16px rgba(251,191,36,0.5)) drop-shadow(0 4px 8px rgba(0,0,0,0.9));
                                                    text-shadow: none;
                                                    animation: shimmer-title 3s ease-in-out infinite;
                                                ">
                                                    Đang tải dữ liệu phim...
                                                </h1>

                                                <!-- Episode name + status -->
                                                <div
                                                    style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                                    <span id="playerEpSubtitle" style="
                                                    color: rgba(203,213,225,0.75);
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                    letter-spacing: 0.3px;
                                                    text-shadow: 0 1px 4px rgba(0,0,0,0.8);
                                                ">Vui lòng chờ trong giây lát để hệ thống khởi tạo trình phát tốc độ
                                                        cao</span>
                                                </div>
                                            </div>

                                        </div><!-- /3d-card -->
                                    </div><!-- /perspective -->

                                </div><!-- /player-overlay-meta -->

                                <!-- 3D Meta Keyframe Animations (injected once) -->
                            </div>
                        </div>

                        <!-- 3. Thanh điều khiển DÍNH LIỀN ngay dưới ô chiếu phim (Thiết kế hiện đại chuẩn Image 1) -->
                        <div class="player-ctrl-bar w-full select-none" style="margin-top: 10px; margin-bottom: 8px;">
                            <div class="player-ctrl-bar-container w-full flex items-center justify-between flex-wrap gap-2 sm:gap-3 py-1.5 px-0">
                                
                                <!-- Nhóm bên trái: Yêu thích, Thêm vào -->
                                <div class="player-ctrl-bar-actions-row flex items-center gap-2 sm:gap-3">
                                    <!-- Yêu thích -->
                                    <button type="button" id="favoriteMovieBtn" class="player-ctrl-item" title="Yêu thích phim này">
                                        <svg class="player-item-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                        </svg>
                                        <span class="whitespace-nowrap hidden sm:inline-flex">Yêu thích</span>
                                    </button>

                                    <!-- Thêm vào (Playlist) -->
                                    <button type="button" id="saveMovieBtn" class="player-ctrl-item" title="Thêm vào danh sách phát">
                                        <svg class="player-item-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="12" y1="5" x2="12" y2="19"></line>
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                        </svg>
                                        <span class="whitespace-nowrap hidden sm:inline-flex">Thêm vào</span>
                                    </button>
                                </div>

                                <!-- Nhóm bên phải: Tự động chuyển tập, Auto skip intro, Rạp phim, Báo lỗi -->
                                <div class="player-ctrl-bar-toggles-row flex items-center gap-2 sm:gap-3.5 flex-wrap">
                                    <!-- Tự động chuyển tập -->
                                    <button type="button" id="btnAutoNext" onclick="toggleAutoNextBadge()" class="player-ctrl-item is-active" title="Tự động phát tập tiếp theo khi hết phim">
                                        <svg class="player-item-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polygon points="5 4 15 12 5 20 5 4"></polygon>
                                            <line x1="19" y1="5" x2="19" y2="19"></line>
                                        </svg>
                                        <span class="whitespace-nowrap hidden sm:inline-flex">Tự động chuyển tập</span>
                                        <span id="badgeAutoNext" class="badge-status-on hidden sm:inline-flex">ON</span>
                                        <input type="checkbox" id="toggleAutoNext" class="hidden" checked>
                                    </button>

                                    <!-- Auto skip intro -->
                                    <button type="button" id="btnAutoSkip" onclick="toggleAutoSkipBadge()" class="player-ctrl-item" title="Tự động bỏ qua đoạn giới thiệu đầu phim">
                                        <svg class="player-item-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="fill: none !important;">
                                            <polyline points="9 6 15 12 9 18" fill="none" style="fill: none !important;"></polyline>
                                            <line x1="19" y1="6" x2="19" y2="18" fill="none" style="fill: none !important;"></line>
                                        </svg>
                                        <span class="whitespace-nowrap hidden sm:inline-flex">Auto skip intro</span>
                                        <span id="badgeAutoSkip" class="badge-status-off hidden sm:inline-flex">OFF</span>
                                        <input type="checkbox" id="toggleAutoSkip" class="hidden">
                                    </button>

                                    <!-- Rạp phim -->
                                    <button type="button" id="cinemaModeBtn" onclick="toggleBadgeCinemaMode()" class="player-ctrl-item" title="Chế độ tắt đèn rạp phim">
                                        <svg class="player-item-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="fill: none !important;">
                                            <path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z" fill="none" style="fill: none !important;"></path>
                                            <path d="m6.2 5.3 3.1 3.9" fill="none" style="fill: none !important; stroke: currentColor !important;"></path>
                                            <path d="m12.4 3.4 3.1 4" fill="none" style="fill: none !important; stroke: currentColor !important;"></path>
                                            <path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" fill="none" style="fill: none !important;"></path>
                                        </svg>
                                        <span class="whitespace-nowrap hidden sm:inline-flex">Rạp phim</span>
                                        <span id="badgeCinema" class="badge-status-off hidden sm:inline-flex">OFF</span>
                                    </button>

                                    <!-- Báo lỗi -->
                                    <button type="button" onclick="reportError()" class="player-ctrl-item player-ctrl-report-btn hover:text-red-400" title="Báo cáo sự cố hoặc lỗi phim">
                                        <svg class="player-item-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="8" height="14" x="8" y="6" rx="4"></rect>
                                            <path d="m19 7-3 2"></path>
                                            <path d="m5 7 3 2"></path>
                                            <path d="m19 19-3-2"></path>
                                            <path d="m5 19 3-2"></path>
                                            <path d="M20 13h-4"></path>
                                            <path d="M4 13h4"></path>
                                            <path d="m10 4 1 2"></path>
                                            <path d="m14 4-1 2"></path>
                                        </svg>
                                        <span class="whitespace-nowrap hidden sm:inline-flex">Báo lỗi</span>
                                    </button>

                                    <!-- Trợ giúp / Phím tắt (?) (hiện trên Mobile theo Ảnh 2, ẩn Desktop) -->
                                    <button type="button" onclick="openShortcutsGuideModal()" class="player-ctrl-item player-ctrl-help-btn" title="Phím tắt & Hướng dẫn xem phim">
                                        <svg class="player-item-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="fill: none !important;">
                                            <circle cx="12" cy="12" r="10" fill="none" style="fill: none !important;"></circle>
                                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" fill="none" style="fill: none !important; stroke: currentColor !important;"></path>
                                            <line x1="12" y1="17" x2="12.01" y2="17" fill="none" style="fill: none !important; stroke: currentColor !important;"></line>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Khối "DANH SÁCH TẬP" (Giữ nguyên luồng Image 2, trang trí đẹp chuẩn Image 1) -->
                    <div class="w-full space-y-5">
                        <!-- Title Line: DANH SÁCH TẬP (1 TẬP) -->
                        <div style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 12px;"
                            class="flex items-center justify-between">
                            <h2 style="color: #ffffff; font-weight: 800; font-size: 17px; letter-spacing: 0.5px;"
                                class="flex items-center gap-2">
                                DANH SÁCH TẬP <span id="episode-count"
                                    style="color: #94a3b8; font-weight: 500; font-size: 13px; margin-left: 4px;">(1
                                    TẬP)</span>
                            </h2>
                        </div>

                        <!-- Main Server Selection Rows Grouped by Language (Vietsub / Thuyết Minh) -->
                        <div id="server-list" class="w-full space-y-2" style="margin-top: 14px;">
                            <!-- Dynamic Server Groups Rendered by JS -->
                        </div>

                        <!-- Search & Sort Row: [Tìm tập...]  ...  [Đảo thứ tự] -->
